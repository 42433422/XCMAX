# =============================================================================
# Production Docker Compose — copy to .env beside docker-compose.yml
# =============================================================================
# Generate secrets:
#   openssl rand -hex 32          # SECRET_KEY
#   openssl rand -hex 32          # LAN_LICENSE_SECRET
#   openssl rand -base64 24       # LAN_ADMIN_BOOTSTRAP_KEY (one-time first admin key)
#   openssl rand -base64 24       # POSTGRES_PASSWORD, REDIS_PASSWORD
#   openssl rand -base64 16       # GF_SECURITY_ADMIN_PASSWORD
#
# docker compose config  # must succeed before docker compose up
# =============================================================================

SECRET_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Production baseline: require LAN allowlist + first-level key activation.
# Local development remains disabled in `.env` / `.env.example`.
# Do not reuse SECRET_KEY for either LAN secret.
LAN_GUARD_ENABLED=1
LAN_LICENSE_SECRET=
LAN_ADMIN_BOOTSTRAP_KEY=
LAN_COOKIE_SECURE=1

# Optional overrides (defaults built from POSTGRES_PASSWORD / REDIS_PASSWORD)
# DATABASE_URL=postgresql+psycopg://xcagi:${POSTGRES_PASSWORD}@postgres:5432/xcagi
# CACHE_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# Monitoring stack (docker-compose.monitoring.yml)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# NeuroBus NN 路由策略：shadow=影子模式（记录 NN 决策但不实际路由）
# 切灰度：XCAGI_ROUTING_POLICY_ENABLED=1 + XCAGI_ROUTING_POLICY_CANARY_RATIO=0.1
XCAGI_ROUTING_POLICY_ENABLED=shadow
XCAGI_ROUTING_POLICY_CANARY_RATIO=0.0
