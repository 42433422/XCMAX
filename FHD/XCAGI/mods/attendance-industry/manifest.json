{
  "id": "attendance-industry",
  "name": "通用考勤模块",
  "version": "1.0.0",
  "author": "XCAGI",
  "description": "主系统共享考勤工作区：部门、人员、排班资源与考勤记录；客户模板转换按账号定制权益开放。",
  "primary": true,
  "legacy_mod_ids": ["taiyangniao-pro"],
  "dependencies": {
    "xcagi": ">=1.0.0"
  },
  "backend": {
    "entry": "blueprints",
    "init": "mod_init"
  },
  "frontend": {
    "routes": "frontend/routes",
    "pro_entry_path": "/attendance-industry",
    "menu": [
      {
        "id": "attendance-industry-workspace",
        "label": "考勤工作区",
        "icon": "fa-calendar",
        "path": "/attendance-industry"
      }
    ]
  },
  "onboarding": {
    "custom_line_hint": "通用考勤与账号定制分开交付：部门、人员使用共享工作区，表转换及模板规则走客户定制节点"
  },
  "hooks": {},
  "industry": {
    "id": "考勤",
    "name": "通用考勤能力",
    "description": "可与任意客户所属行业组合使用的考勤、排班与出勤统计能力",
    "units": {
      "primary": "天",
      "secondary": "小时",
      "primary_label": "出勤天数",
      "secondary_label": "工时",
      "spec_label": "班次",
      "conversion": { "天_to_小时": 8.0 }
    },
    "quantity_fields": {
      "primary_field": "days",
      "secondary_field": "hours",
      "spec_field": "shift",
      "primary_label": "出勤天数",
      "secondary_label": "工时",
      "spec_label": "班次"
    },
    "product_fields": {
      "name": "员工姓名",
      "model": "工号",
      "category": "部门",
      "price": "时薪",
      "unit": "单位"
    },
    "order_types": {
      "shipment": "考勤单",
      "receipt": "排班单",
      "return": "异常单"
    },
    "intent_keywords": {
      "create_order": ["录考勤", "登记出勤", "排班", "生成考勤单"],
      "quantity_unit": "天",
      "print_label": ["考勤表", "工时单", "标签"],
      "product": ["员工", "工号", "人员", "花名册"],
      "customer": ["部门", "班组", "项目"]
    },
    "print_config": {
      "printer_type": "PDF",
      "label_width": 80,
      "label_height": 50
    },
    "subsystems": {
      "products": {
        "label": "人员管理",
        "entity": "人员",
        "fields": [
          { "key": "model_number", "label": "工号", "type": "text", "semantic": "model" },
          {
            "key": "name",
            "label": "姓名",
            "type": "text",
            "required": true,
            "semantic": "entity_name"
          },
          {
            "key": "specification",
            "label": "班次",
            "type": "enum",
            "semantic": "spec",
            "validators": [{ "type": "oneOf", "params": ["早", "中", "晚"] }]
          },
          { "key": "price", "label": "时薪", "type": "number", "unit": "元", "semantic": "price" },
          { "key": "unit", "label": "单位", "type": "text" }
        ]
      },
      "customers": {
        "label": "部门管理",
        "entity": "部门",
        "fields": [
          {
            "key": "customer_name",
            "label": "部门名称",
            "type": "text",
            "required": true,
            "semantic": "entity_name"
          },
          { "key": "contact_person", "label": "主管", "type": "text" },
          { "key": "contact_phone", "label": "联系电话", "type": "text" },
          { "key": "address", "label": "上级部门", "type": "text" }
        ]
      },
      "orders": {
        "label": "考勤单",
        "entity": "考勤单",
        "fields": [
          { "key": "purchase_unit", "label": "部门", "type": "text", "semantic": "foreign_ref" },
          { "key": "product_name", "label": "事项说明", "type": "text", "semantic": "entity_name" },
          { "key": "model_number", "label": "关联编号", "type": "text", "semantic": "model" },
          {
            "key": "quantity_tins",
            "label": "数量 (天/次)",
            "type": "number",
            "unit": "天",
            "semantic": "primary_qty"
          },
          { "key": "tin_spec", "label": "班次", "type": "text", "semantic": "spec" },
          {
            "key": "quantity_kg",
            "label": "工时 (小时)",
            "type": "number",
            "unit": "小时",
            "semantic": "secondary_qty"
          },
          {
            "key": "unit_price",
            "label": "时薪",
            "type": "number",
            "unit": "元",
            "semantic": "price"
          },
          {
            "key": "amount",
            "label": "金额",
            "type": "number",
            "unit": "元",
            "semantic": "derived"
          }
        ]
      },
      "shipment-records": {
        "label": "考勤记录",
        "entity": "考勤记录",
        "fields": [
          { "key": "purchase_unit", "label": "部门", "type": "text", "semantic": "foreign_ref" },
          { "key": "product_name", "label": "事项说明", "type": "text", "semantic": "entity_name" },
          { "key": "model_number", "label": "关联编号", "type": "text", "semantic": "model" },
          {
            "key": "quantity_kg",
            "label": "工时 (小时)",
            "type": "number",
            "unit": "小时",
            "semantic": "secondary_qty"
          },
          {
            "key": "quantity_tins",
            "label": "数量 (天/次)",
            "type": "number",
            "unit": "天",
            "semantic": "primary_qty"
          },
          { "key": "tin_spec", "label": "班次", "type": "text", "semantic": "spec" },
          { "key": "unit_price", "label": "时薪", "type": "number", "semantic": "price" },
          { "key": "amount", "label": "金额", "type": "number", "semantic": "derived" }
        ]
      }
    }
  },
  "ui_labels": {
    "entity": "员工",
    "entity_plural": "人员",
    "query_title": "员工查询",
    "query_description": "查询与快速修改员工档案",
    "query_placeholder": "输入工号/员工姓名查询员工",
    "records": "考勤记录",
    "entity_list": "人员管理"
  },
  "ui_starter_pack": [
    {
      "label": "查员工信息",
      "hint": "示例：查询员工「张三」或工号 1001",
      "text": "查询工号1001的员工信息"
    },
    {
      "label": "登记出勤",
      "hint": "记录员工当天出勤与工时",
      "text": "给张三登记今天出勤1天8小时"
    },
    {
      "label": "生成考勤单",
      "hint": "按部门或员工生成考勤单",
      "text": "生成研发部本月考勤单"
    },
    {
      "label": "异常说明",
      "hint": "记录迟到、请假或缺卡",
      "text": "记录李四今天迟到30分钟，原因是交通拥堵"
    },
    {
      "label": "排班任务",
      "hint": "快速创建排班安排",
      "text": "给客服部生成明天早班排班单"
    }
  ],
  "workflow_employees": [
    {
      "id": "attendance_ai",
      "label": "考勤 AI 助手",
      "panel_title": "工作流 · 考勤 AI 助手",
      "panel_summary": "协助处理出勤记录、异常说明与排班相关问答。",
      "workflow_placeholder": true
    }
  ],
  "comms": {
    "exports": []
  },
  "import_templates": [],
  "samples": []
}
