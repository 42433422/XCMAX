{
  "name": "xcagi-frontend",
  "version": "1.0.0",
  "description": "XCAGI 前端测试配置",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint static/js/"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.6",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "@babel/core": "^8.0.6"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleFileExtensions": ["js", "json"],
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": ["static/js/**/*.js", "!static/js/**/*.test.js"]
  },
  "overrides": {
    "browserslist": "4.28.7",
    "brace-expansion@^1.0.0": "1.1.21",
    "js-yaml": "4.3.2",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
