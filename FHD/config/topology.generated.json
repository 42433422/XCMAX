{
  "_generated_from": "config/service_topology.yaml",
  "_note": "DO NOT EDIT BY HAND — run scripts/dev/service_topology_ssot.py generate --apply",
  "env_overrides": {
    "dev": {
      "fhd_api_listen_port": 42422,
      "host": "127.0.0.1",
      "modstore_listen_port": 8765,
      "scheme": "http"
    }
  },
  "host": "xiu-ci.com",
  "must_run_processes": [
    "web",
    "modstore-api",
    "modstore-scheduler"
  ],
  "nginx_routes": [
    {
      "path": "/fhd-api",
      "service": "fhd-api",
      "upstream_port": 5100
    },
    {
      "path": "/market",
      "service": "modstore",
      "upstream_port": 9999
    },
    {
      "path": "/v1",
      "service": "llm-gateway"
    },
    {
      "path": "/ws/im",
      "service": "im-ws"
    }
  ],
  "processes": [
    {
      "detect": "uvicorn app.fastapi_app",
      "must_run": true,
      "name": "web",
      "note": "FHD FastAPI 主进程（亦可能匹配 gunicorn）",
      "service": "fhd-api"
    },
    {
      "detect": "uvicorn modstore_server.app:app --host 127.0.0.1 --port 9999",
      "must_run": true,
      "name": "modstore-api",
      "note": "MODstore API :9999",
      "service": "modstore"
    },
    {
      "detect": "uvicorn modstore_server.app:app --host 127.0.0.1 --port 9990",
      "must_run": true,
      "name": "modstore-scheduler",
      "note": "loops/定时任务真正执行者 :9990",
      "service": "modstore-scheduler"
    },
    {
      "detect": "mobile_relay_desktop_client",
      "must_run": false,
      "name": "desktop-relay-poller",
      "note": "桌面端 4s 轮询中继",
      "service": "desktop-fhd"
    }
  ],
  "scheme": "https",
  "services": {
    "desktop-fhd": {
      "listen_port": 17500,
      "role": "relay-node",
      "runner": "electron-local"
    },
    "fhd-api": {
      "health": "/health",
      "hosts_relay_queue": true,
      "listen_port": 5000,
      "must_run": true,
      "nginx_upstream_port": 5100,
      "runner": "uvicorn/gunicorn (web)"
    },
    "im-ws": {
      "listen_port": null,
      "protocol": "wss"
    },
    "llm-gateway": {
      "listen_port": null
    },
    "mobile-lan-proxy": {
      "listen_port": 5011,
      "role": "mobile-lan-entry",
      "runner": "vite-proxy"
    },
    "modstore": {
      "health": "/api/health",
      "listen_port": 9999,
      "must_run": true,
      "nginx_upstream_port": 9999,
      "runner": "uvicorn modstore_server.app:app"
    },
    "modstore-scheduler": {
      "health": "/api/health",
      "listen_port": 9990,
      "must_run": true,
      "runner": "uvicorn modstore_server.app:app (scheduler)"
    }
  },
  "systemd_units": [
    {
      "must_run": true,
      "name": "fhd-full.service",
      "note": "生产 FHD API",
      "service": "fhd-api"
    },
    {
      "must_run": true,
      "name": "modstore.service",
      "note": "MODstore API :9999",
      "service": "modstore"
    },
    {
      "must_run": true,
      "name": "modstore-scheduler.service",
      "note": "MODstore scheduler :9990",
      "service": "modstore-scheduler"
    }
  ],
  "urls": {
    "FHD_API_BASE_URL": "https://xiu-ci.com/fhd-api",
    "IM_WS_URL": "wss://xiu-ci.com/ws/im",
    "LLM_V1_BASE_URL": "https://xiu-ci.com/v1",
    "MARKET_BASE_URL": "https://xiu-ci.com/market",
    "MARKET_CATALOG_URL": "https://xiu-ci.com/api/market/catalog",
    "SITE_ROOT_URL": "https://xiu-ci.com"
  }
}
