{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", "build/**/*.cjs"],
  "exclude": [
    "node_modules",
    "dist",
    "resources",
    "release",
    "e2e",
    "**/*.test.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
