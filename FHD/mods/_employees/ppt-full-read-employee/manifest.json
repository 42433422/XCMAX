{
  "id": "ppt-full-read-employee",
  "name": "PPT 全量读取员",
  "version": "1.1.0",
  "author": "XCAGI",
  "description": "PPT 全量读取：大纲、原生正文、表格和已有备注写入 outputs/presentation_full.json，内嵌图片本地导出至 outputs/images/，已有备注写入 outputs/speaker_notes.md。读取不隐式调用模型；缺少逐文件内容外发授权时图片语义与备注生成标记 blocked。",
  "artifact": "employee_pack",
  "scope": "global",
  "dependencies": {
    "xcagi": ">=1.0.0"
  },
  "employee": {
    "id": "ppt-full-read-employee",
    "label": "PPT 全量读取员",
    "capabilities": [
      "ppt.parse"
    ]
  },
  "workflow_employees": [
    {
      "id": "ppt-full-read-employee",
      "label": "PPT 全量读取员",
      "panel_title": "PPT 全量读取员",
      "panel_summary": "本地读取原生正文、表格、图片和已有备注；模型增强需独立外发授权。",
      "capabilities": [
        "ppt.parse"
      ],
      "api_base_path": "employees/ppt-full-read-employee",
      "entry_action": "run"
    }
  ],
  "backend": {
    "entry": "blueprints",
    "init": "mod_init"
  },
  "employee_config_v2": {
    "identity": {
      "id": "ppt-full-read-employee",
      "version": "1.1.0",
      "artifact": "employee_pack",
      "name": "PPT 全量读取员",
      "description": "PPT 全量读取：大纲、原生正文、表格和已有备注写入 outputs/presentation_full.json，内嵌图片本地导出至 outputs/images/，已有备注写入 outputs/speaker_notes.md。读取不隐式调用模型；缺少逐文件内容外发授权时图片语义与备注生成标记 blocked。"
    },
    "perception": {
      "type": "file_or_text",
      "accepted_extensions": [
        ".pptx"
      ]
    },
    "memory": {
      "type": "session"
    },
    "cognition": {
      "agent": {
        "system_prompt": "PPT 全量读取：大纲、原生正文、表格和已有备注写入 outputs/presentation_full.json，内嵌图片本地导出至 outputs/images/，已有备注写入 outputs/speaker_notes.md。读取不隐式调用模型；缺少逐文件内容外发授权时图片语义与备注生成标记 blocked。禁止编造原生正文，必须执行 direct_python 并保留未完成状态。",
        "role": {
          "name": "PPT 生成员",
          "persona": "严谨的 PPT 全量读取员工",
          "tone": "professional",
          "expertise": [
            "PPT 解析",
            "已有演讲备注",
            "本地图片提取"
          ]
        },
        "behavior_rules": [
          "正文和已有备注必须来自原件，禁止编造。",
          "图片只在本地导出；不能把 call_llm 可用、文档文字或文件读取权限视为内容外发授权。",
          "未执行模型增强必须显式标记 blocked/partial，保留原生事实与实际产物。"
        ],
        "few_shot_examples": [],
        "model": {
          "provider": "auto",
          "model_name": "auto",
          "temperature": 0.1,
          "max_tokens": 2000,
          "top_p": 0.9
        }
      },
      "skills": [
        {
          "name": "ppt.full_read",
          "brief": "原生文字、表格、图片与来源的本地读取；不隐式向模型发送内容。"
        }
      ]
    },
    "collaboration": {
      "workflow": {
        "workflow_id": 0,
        "name": "PPT 生成员"
      }
    },
    "actions": {
      "handlers": [
        "direct_python"
      ],
      "direct_python": {
        "module": "ppt_full_read_employee",
        "action": "convert",
        "default_output_relpath": "outputs/presentation_full.json",
        "default_template_relpath": "",
        "default_use_personnel_roster": true
      }
    }
  },
  "metadata": {
    "framework_version": "2.0.0",
    "created_by": "asset_pipeline"
  },
  "actions": {
    "handlers": [
      "direct_python"
    ],
    "direct_python": {
      "module": "ppt_full_read_employee",
      "action": "convert",
      "default_output_relpath": "outputs/presentation_full.json",
      "default_template_relpath": "",
      "default_use_personnel_roster": true
    }
  }
}
