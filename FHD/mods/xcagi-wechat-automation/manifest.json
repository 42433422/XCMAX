{
  "id": "xcagi-wechat-automation",
  "mod_level": 2,
  "mod_kind": "system_mod",
  "parent_mod_id": "xcagi-host-core",
  "composite_owner": "xcagi-erp",
  "lifecycle": "optional",
  "market_installable": false,
  "name": "微信桌面自动化 RPA 桥",
  "version": "1.0.0.0",
  "author": "成都修茈科技有限公司",
  "description": "可选 RPA 能力桥：通过 UI 自动化驱动微信桌面版发送消息/执行工作流。未安装时宿主回退到 wechat_cv_send（仅 Windows）。本 Mod 提供 /api/desktop/automation/* 路由与真实驱动接入点。",
  "primary": false,
  "dependencies": {
    "xcagi": ">=1.0.0.0"
  },
  "backend": {
    "entry": "blueprints",
    "init": "mod_init"
  },
  "frontend": {
    "routes": "",
    "menu": []
  },
  "hooks": {},
  "comms": {
    "exports": []
  },
  "config": {
    "routes_prefix": "/api/desktop/automation",
    "drivers": ["windows", "mac", "mcp"],
    "default_app_id": "wechat",
    "phase": "extraction_from_host"
  }
}
