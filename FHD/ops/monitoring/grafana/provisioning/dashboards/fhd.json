{
  "dashboard": {
    "id": null,
    "uid": "fhd-performance",
    "title": "FHD 后端性能监控",
    "tags": ["xcagi", "fhd", "performance"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "type": "graph",
        "title": "全局 P95 响应时间趋势",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(api_request_duration_seconds_bucket[5m])) by (le)) * 1000",
            "legendFormat": "P95",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"label": "毫秒", "format": "ms"},
          {"format": "short"}
        ],
        "thresholds": [
          {"value": 500, "color": "red"},
          {"value": 300, "color": "yellow"}
        ]
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "type": "graph",
        "title": "请求速率（按状态码）",
        "targets": [
          {
            "expr": "sum(rate(api_requests_total[5m])) by (status)",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"label": "请求/秒", "format": "reqps"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "type": "graph",
        "title": "错误率（5xx 占比）",
        "targets": [
          {
            "expr": "sum(rate(api_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(api_requests_total[5m])), 1)",
            "legendFormat": "5xx 占比",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"label": "百分比", "format": "percentunit"},
          {"format": "short"}
        ],
        "thresholds": [
          {"value": 0.01, "color": "green"},
          {"value": 0.05, "color": "red"}
        ]
      },
      {
        "id": 4,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "type": "graph",
        "title": "AI 请求速率（按状态）",
        "targets": [
          {
            "expr": "sum(rate(ai_requests_total[5m])) by (status)",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"label": "请求/秒", "format": "reqps"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 16},
        "type": "singlestat",
        "title": "活跃请求数",
        "targets": [
          {
            "expr": "active_requests",
            "legendFormat": "",
            "refId": "A"
          }
        ],
        "format": "short",
        "valueName": "current",
        "colorBackground": true,
        "thresholds": "300,500"
      },
      {
        "id": 6,
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 16},
        "type": "singlestat",
        "title": "熔断器状态 (0=关 1=半开 2=开)",
        "targets": [
          {
            "expr": "max(circuit_breaker_state)",
            "legendFormat": "",
            "refId": "A"
          }
        ],
        "format": "short",
        "valueName": "current"
      },
      {
        "id": 7,
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 16},
        "type": "singlestat",
        "title": "进程运行时间",
        "targets": [
          {
            "expr": "time() - process_start_time_seconds{job=\"fhd-backend\"}",
            "legendFormat": "",
            "refId": "A"
          }
        ],
        "format": "s",
        "valueName": "current"
      },
      {
        "id": 8,
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 16},
        "type": "singlestat",
        "title": "NeuroBus 事件发布总数",
        "targets": [
          {
            "expr": "sum(neurobus_events_published_total)",
            "legendFormat": "",
            "refId": "A"
          }
        ],
        "format": "short",
        "valueName": "current"
      }
    ],
    "templating": {
      "list": []
    },
    "time": {"from": "now-1h", "to": "now"},
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
    }
  }
}