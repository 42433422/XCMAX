    "disk_clean_threshold": {
      "value": 70,
      "floor": 60,
      "ceiling": 90,
      "unit": "percent",
      "source": "default"
    },
    "restart_count_cap": {
      "value": 3,
      "floor": 2,
      "ceiling": 6,
      "unit": "count",
      "source": "default"
    }
  }
