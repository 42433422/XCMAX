<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.xcmax.para-api</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__XCMAX_RUN_PARA_API__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__XCMAX_PARA_LOG_DIR__/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__XCMAX_PARA_LOG_DIR__/stderr.log</string>
  <key>WorkingDirectory</key>
  <string>__XCMAX_PARA_ROOT__</string>
</dict>
</plist>
