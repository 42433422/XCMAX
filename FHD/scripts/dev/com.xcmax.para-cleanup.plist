<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.xcmax.para-cleanup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__XCMAX_RUN_PARA_CLEANUP__</string>
    <string>--apply</string>
    <string>--reason</string>
    <string>scheduled</string>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>ThrottleInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>__XCMAX_PARA_LOG_DIR__/cleanup.log</string>
  <key>StandardErrorPath</key>
  <string>__XCMAX_PARA_LOG_DIR__/cleanup-error.log</string>
  <key>WorkingDirectory</key>
  <string>__XCMAX_PARA_ROOT__</string>
</dict>
</plist>
