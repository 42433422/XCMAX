#!/usr/bin/env bash
# Keep one transient Apple TSA failure from discarding an otherwise valid build.
# electron-builder invokes `codesign` once per nested Mach-O file; retrying the
# individual command is both faster and more reliable than rebuilding the app.

set -u

max_attempts="${XCAGI_CODESIGN_MAX_ATTEMPTS:-5}"
attempt=1

while :; do
  output_file="$(mktemp "${TMPDIR:-/tmp}/xcagi-codesign.XXXXXX")"
  /usr/bin/codesign "$@" >"${output_file}" 2>&1
  status=$?

  if [ "${status}" -eq 0 ]; then
    cat "${output_file}"
    rm -f "${output_file}"
    exit 0
  fi

  cat "${output_file}" >&2
  if [ "${attempt}" -ge "${max_attempts}" ] || \
    ! grep -Eqi 'timestamp.*(not available|unavailable|temporar|timed out|timeout|connection|network)|CSSMERR_TP_NOT_TRUSTED' "${output_file}"; then
    rm -f "${output_file}"
    exit "${status}"
  fi

  target="${!#:-}"
  if [ -n "${target}" ]; then
    rm -f "${target}.cstemp"
  fi
  rm -f "${output_file}"
  echo "[codesign] transient timestamp failure on attempt ${attempt}/${max_attempts}; retrying this file" >&2
  sleep $((attempt * 3))
  attempt=$((attempt + 1))
done
