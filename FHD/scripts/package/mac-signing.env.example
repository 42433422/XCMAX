# 复制为 mac-signing.env（gitignore），或运行 setup-mac-signing.sh
# App Store Connect API（公证 + 签发 Developer ID，推荐）
APP_STORE_CONNECT_API_KEY_ID=7Z63KLL35T
APP_STORE_CONNECT_API_ISSUER_ID=<从 App Store Connect → 集成 → API 页面复制>
APP_STORE_CONNECT_API_KEY_PATH=$HOME/.config/xcagi/private_keys/AuthKey_7Z63KLL35T.p8

# 回退：Apple ID + 专用密码
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=G26WSH472M

# electron-builder（setup 脚本自动探测）
# CSC_NAME=Developer ID Application: jialong Li (G26WSH472M)

# electron-updater 元数据 Ed25519
XCAGI_UPDATE_ED25519_PRIVATE_KEY_FILE=$HOME/.config/xcagi/update_ed25519_private.pem
