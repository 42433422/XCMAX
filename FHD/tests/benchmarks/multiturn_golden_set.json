{
  "_meta": {
    "name": "xcagi-multiturn-golden-set",
    "version": 1,
    "methodology": "τ-bench 方法论 + BFCL 多轮调用断言：对话剧本 → 状态断言 → pass^k 可靠性",
    "mode": "offline_scripted",
    "scoring": {
      "pass^1": "单次试验全部断言通过的任务占比",
      "pass^k": "k 次独立进程试验全部通过的任务占比",
      "per_task": "同题所有 checks 全部通过才算通过；任一条失败即整题失败"
    },
    "schema_notes": {
      "setup": "题目前置条件：候选实体、Excel 夹具、初始计划状态",
      "turns": "按顺序发送的用户消息；每条都是一次独立 HTTP 对话轮次",
      "scripted_model": "离线模式下替身模型的确定性输出（计划或翻译器返回）",
      "expect.actions": "期望的工具调用序列，tool_id+action 精确匹配，* 为通配",
      "expect.forbid_actions": "不得出现的工具调用",
      "expect.max_clarifications": "整段对话允许的追问次数上限",
      "expect.answer_contains": "最终回复必须包含的文本片段（用于核验真实业务结果）",
      "expect.answer_must_not_contain": "最终回复不得出现的文本片段（防止编造或错误话术）",
      "expect.error_code": "失败时必须暴露的错误码，不允许笼统成功",
      "expect.db_state": "写操作执行后的数据库终态断言",
      "expect.tool_call_count": "工具实际执行次数（用于幂等断言）",
      "expect.restart_between_turns": "在第 N 轮后重启后端进程，再继续后续轮次"
    }
  },
  "tasks": [
    {
      "task_id": "mt.clarify.letter_a_001",
      "domain": "multiturn",
      "category": "clarification_letter",
      "difficulty": "easy",
      "setup": {
        "candidates": [
          {"id": 31, "name": "澜宇电视柜", "model_number": "A100"},
          {"id": 42, "name": "澜宇电视柜", "model_number": "B200"}
        ],
        "plan": "clarify(ambiguous_target) → business_db.read",
        "question": "请选择要查询的型号：A. A100  B. B200"
      },
      "turns": ["A"],
      "expect": {
        "actions": [{"tool_id": "business_db", "action": "read"}],
        "resolved_id": "31",
        "max_clarifications": 1,
        "final_status": "completed"
      }
    },
    {
