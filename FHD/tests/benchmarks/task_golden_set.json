{
  "_meta": {
    "name": "xcagi-task-golden-set",
    "version": 2,
    "methodology": "tau-bench：指令 → 工具调用序列断言 + DB 终态断言 + pass^k 可靠性",
    "schema_notes": {
      "expect.actions": "期望的有序工具调用序列，tool_id+action 精确匹配；action 可用 * 通配",
      "expect.actions_any_of": "可接受的动作序列备选（与 actions 互斥）",
      "expect.forbid_actions": "计划中不得出现的工具调用",
      "expect.no_actions": "计划不得产生任何业务工具节点（如闲聊/否定）",
      "expect.db_state": "执行后的数据库终态断言；entity 映射与字段名复用 business_db_write_verification._model_config（SSOT）",
      "db_state.op": "exists | absent | count（count 需 count 字段）",
      "db_state.where": "使用 _model_config field_map 的载荷侧字段名（如 unit_name）"
    }
  },
  "tasks": [
    {
      "task_id": "customers.create.explicit_001",
      "domain": "customers",
      "difficulty": "easy",
      "instruction": "请把客户 星光贸易 写入数据库",
      "approvals": [{"tool_id": "business_db", "action": "write", "params": {"entity": "customers", "operation": "upsert", "payload": {"unit_name": "星光贸易", "customer_name": "星光贸易"}}}],
      "expect": {
        "actions_any_of": [
          [{"tool_id": "business_db", "action": "write"}],
          [{"tool_id": "customers", "action": "create"}]
        ],
        "forbid_actions": [
          {"tool_id": "business_db", "action": "delete"}
        ],
        "db_state": [
          {"entity": "customers", "op": "exists", "where": {"unit_name": "星光贸易"}}
        ]
      }
    },
    {
      "task_id": "customers.create.with_contact_002",
      "domain": "customers",
      "difficulty": "medium",
      "instruction": "新增客户 蓝天科技，联系人张三，电话13800000001",
      "approvals": [{"tool_id": "business_db", "action": "write", "params": {"entity": "customers", "operation": "upsert", "payload": {"unit_name": "蓝天科技", "customer_name": "蓝天科技", "contact_person": "张三", "contact_phone": "13800000001"}}}],
      "expect": {
        "actions_any_of": [
          [{"tool_id": "business_db", "action": "write"}],
          [{"tool_id": "customers", "action": "create"}]
        ],
        "db_state": [
          {
            "entity": "customers",
            "op": "exists",
            "where": {"unit_name": "蓝天科技", "contact_person": "张三", "contact_phone": "13800000001"}
          }
        ]
      }
    },
    {
      "task_id": "customers.query.by_name_003",
      "domain": "customers",
      "difficulty": "easy",
      "instruction": "查一下客户 星光贸易 的信息",
      "fixtures": [{"entity": "customers", "values": {"unit_name": "星光贸易", "contact_person": "李明", "contact_phone": "13800000002"}}, {"entity": "customers", "values": {"unit_name": "其他客户", "contact_person": "王华"}}],
      "expect": {
        "returned_records": [{"tool_id": "customers", "action": "query", "count": 1, "includes": [{"customer_name": "星光贸易", "contact_person": "李明"}]}],
        "actions_any_of": [
          [{"tool_id": "customers", "action": "query"}],
          [{"tool_id": "business_db", "action": "read"}]
        ],
        "forbid_actions": [
          {"tool_id": "business_db", "action": "write"},
          {"tool_id": "customers", "action": "create"}
        ]
      }
    },
