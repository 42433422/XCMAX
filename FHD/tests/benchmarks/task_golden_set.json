        "db_state": [{"entity": "sales_orders", "op": "count", "count": 1, "where": {"customer_name": "星光贸易", "state": "quote", "total_amount": 100}}, {"entity": "sales_order_items", "op": "count", "count": 1, "where": {"product_name": "报价产品", "quantity": 2, "unit_price": 50, "amount": 100}}],
        "forbid_actions": [
