      "expect": {
        "returned_records": [{"tool_id": "customers", "action": "query", "count": 2, "includes": [{"customer_name": "星光贸易", "contact_person": "李明"}, {"customer_name": "其他客户", "contact_person": "王华"}]}],
        "actions_any_of": [
          [{"tool_id": "customers", "action": "query"}],
          [{"tool_id": "business_db", "action": "read"}]
