    {
      "task_id": "sales.order.create_010",
      "domain": "sales",
      "difficulty": "medium",
      "instruction": "给客户星光贸易下订单，产品A100，数量10",
      "fixtures": [{"entity": "customers", "values": {"unit_name": "星光贸易"}}, {"entity": "products", "values": {"name": "订单产品", "model_number": "A100"}}],
      "answers": [{"tool_id": "sales", "action": "create_order", "parameters": {"items.0.unit_price": 50}}],
      "approvals": [{"tool_id": "sales", "action": "create_order", "params": {"customer_name": "星光贸易", "items": [{"model_number": "A100", "quantity": 10, "unit_price": 50}]}}],
