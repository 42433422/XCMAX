      "answers": [{"tool_id": "sales", "action": "quote", "parameters": {"items.0.quantity": 2, "items.0.unit_price": 50}}],
      "approvals": [{"tool_id": "sales", "action": "quote", "params": {"customer_name": "星光贸易", "items": [{"model_number": "A100", "quantity": 2, "unit_price": 50}]}}],
