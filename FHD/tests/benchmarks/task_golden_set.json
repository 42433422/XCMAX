        "actions": [{"tool_id": "clarify", "action": "ask"}, {"tool_id": "sales", "action": "create_order"}],
        "db_state": [{"entity": "sales_orders", "op": "count", "count": 1, "where": {"customer_name": "星光贸易", "state": "confirmed", "total_amount": 500}}, {"entity": "sales_order_items", "op": "count", "count": 1, "where": {"product_name": "订单产品", "quantity": 10, "unit_price": 50, "amount": 500}}],
        "forbid_actions": [
          {"tool_id": "business_db", "action": "delete"}
        ]
      }
