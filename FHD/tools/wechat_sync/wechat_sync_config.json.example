{
  "_说明": "微信同步代理配置。复制本文件为 wechat_sync_config.json 后填写；该文件含 token，已被 .gitignore 排除，禁止提交/外发。优先级：CLI 参数 > 环境变量 > 本文件 > 内置默认。",
  "server_url": "https://xiu-ci.com/fhd-api",
  "token": "填入服务器 AUTONOMY_WEBHOOK_TOKEN 或 MODSTORE_OPS_INGEST_TOKEN 之一",
  "tenant_id": 1,
  "interval": 300,
  "limit": 50,
  "contacts": [],
  "log_file": "wechat_sync.log",
  "_字段说明": {
    "server_url": "服务器 FHD API 地址；生产 https://xiu-ci.com/fhd-api，本机调试 http://127.0.0.1:5100",
    "token": "服务器摄取接口认证 token，与 /root/fhd-full.env 中 AUTONOMY_WEBHOOK_TOKEN 或 MODSTORE_OPS_INGEST_TOKEN 同源",
    "tenant_id": "租户 ID；不填则由服务器按 token 解析",
    "interval": "循环间隔秒数，最小 30",
    "limit": "每联系人每轮最多拉取条数",
    "contacts": "只同步这些联系人显示名，留空 [] 表示同步全部联系人",
    "log_file": "运行日志文件名，置空 \"\" 关闭日志落盘"
  }
}
