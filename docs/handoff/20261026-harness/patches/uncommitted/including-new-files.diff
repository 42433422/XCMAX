+def material_batch_ids(params):
+    ids = params.get("material_ids", params.get("ids"))
+    if (
+        not isinstance(ids, list)
+        or not ids
+        or any(type(value) is not int or value <= 0 for value in ids)
+        or len(set(ids)) != len(ids)
+        or ("ids" in params and "material_ids" in params and params["ids"] != ids)
+    ):
+        raise ValueError("material batch requires distinct positive integer ids")
+    return ids
+
+
+def prepare_action_verification(spec, params):
+    """Capture owned active targets locally, after approval and before dispatch."""
+    if (spec.tool_id, spec.action) != ("materials", "batch_delete"):
+        return None
+    from app.db.models.material import Material
+    from app.db.session import get_db
+    from app.infrastructure.tenant_scope import tenant_id_for_write
+
+    ids, tenant = material_batch_ids(params), tenant_id_for_write()
+    with get_db() as db:
+        rows = db.query(Material).filter(Material.tenant_id == tenant, Material.id.in_(ids)).all()
+        if len(rows) != len(ids) or any(row.is_active != 1 for row in rows):
+            raise ValueError("material batch targets unavailable")
+    return tenant, tuple(ids)
+
+
+def _verify_material_batch(params, result, before_state):
+    from app.db.models.material import Material
+    from app.db.session import get_db
+    from app.infrastructure.tenant_scope import tenant_id_for_write
+
+    evidence = {"verified": False, "method": "tenant_material_batch_readback"}
+    try:
+        ids, tenant = material_batch_ids(params), tenant_id_for_write()
+        evidence.update(tenant_id=tenant, record_ids=ids, state="unverified")
+        if before_state != (tenant, tuple(ids)):
+            evidence["reason"] = "missing_original_active_targets"
+        elif type(result.get("deleted_count")) is not int or result["deleted_count"] != len(ids):
+            evidence["reason"] = "deleted_count_mismatch"
+        else:
+            with get_db() as db:
+                rows = (
+                    db.query(Material)
+                    .filter(Material.tenant_id == tenant, Material.id.in_(ids))
+                    .all()
+                )
+                verified = len(rows) == len(ids) and all(row.is_active == 0 for row in rows)
+            evidence.update(verified=verified, state="inactive" if verified else "unverified")
+            if not verified:
+                evidence["reason"] = "targets_not_inactive"
+    except RECOVERABLE_ERRORS:
+        evidence["reason"] = "readback_unavailable"
+    return {**result, "business_verification": evidence}, evidence["verified"] is True
+
+
 def verify_action_result(
