+@pytest.mark.parametrize("fault", ["no_effect", "partial", "wrong_count", "lost_receipt"])
+def test_material_batch_verifier_does_not_trust_service_success(
+    trusted_actor, approved_tool_context, monkeypatch, fault
+):
+    from app.application.material_app_service import MaterialApplicationService
+    from app.db.models.material import Material
+
+    actor = trusted_actor(permissions=["tool.materials.batch_delete"])
+    read = _material_batch_rows(actor)
+    before = read()
+    original = MaterialApplicationService.batch_delete_materials
+
+    def dispatch(service, ids):
+        if fault == "no_effect":
+            return {"success": True, "deleted_count": len(ids)}
+        if fault == "partial":
+            with actor.factory.begin() as db:
+                db.query(Material).filter_by(id=ids[0], tenant_id=7).update({"is_active": 0})
+            return {"success": True, "deleted_count": len(ids)}
+        result = original(service, ids)
+        if fault == "lost_receipt":
+            raise RuntimeError("receipt lost after commit")
+        return {**result, "deleted_count": 1}
+
+    monkeypatch.setattr(MaterialApplicationService, "batch_delete_materials", dispatch)
+    step = AgentStep(
+        node_id="batch", tool_id="materials", action="batch_delete", params={"ids": [1, 2]}
+    )
+    result = AgentToolExecutor().execute(
+        step, runtime_context=approved_tool_context(actor, step, business_action_id="faulty-batch")
+    )
+    assert result["success"] is False and result["outcome"] == "unknown", result
+    assert result["retryable"] is False
+    after = read()
+    assert [row for row in before if row["id"] not in {1, 2}] == [
+        row for row in after if row["id"] not in {1, 2}
+    ]
+    expected_inactive = 0 if fault == "no_effect" else 1 if fault == "partial" else 2
+    assert sum(row["is_active"] == 0 for row in after if row["id"] in {1, 2}) == expected_inactive
+
