+_BOUND_MODEL = ContextVar("workflow_decision_model", default=None)
+
+
+@contextmanager
+def decision_model_scope(client, model, check):
+    binding = SimpleNamespace(client=client, model=model, check=check, usage=[])
+    token = _BOUND_MODEL.set(binding)
+    try:
+        yield binding
+    finally:
+        _BOUND_MODEL.reset(token)
+
+
+class _BoundDecisionTransport:
+    def __init__(self, binding):
+        self.binding = binding
+
+    def post(self, url, *, headers, json):
+        from app.application.agent_orchestrator.model_turn_runtime import model_transport
+
+        content = None
+        client = self.binding.client
+        request = {key: value for key, value in json.items() if key != "model"}
+        if getattr(client, "is_modstore_openai_compatible", False) is True:
+            adapter = copy(client.adapter)
+            adapter.timeout = min(20.0, float(adapter.timeout))
+            client = type(client)(adapter)
+        else:
+            request["timeout"] = httpx.Timeout(20.0, connect=10.0)
+            if callable(getattr(client, "with_options", None)):
+                client = client.with_options(max_retries=0)
+        for event in model_transport(
+            client,
+            self.binding.model,
+            request,
+            check=self.binding.check,
+        ):
+            if event["type"] == "usage":
+                self.binding.usage.append(event["completion"])
+            elif event["type"] == "decision":
+                if event["decision"]["calls"]:
+                    raise ValueError("工作流单步协议需要 JSON 正文，不能改用 SDK 工具批次")
+                content = event["decision"]["content"]
+        if content is None:
+            raise ValueError("工作流模型未返回完整 JSON 决策")
+        return SimpleNamespace(
+            status_code=200, json=lambda: {"choices": [{"message": {"content": content}}]}
+        )
