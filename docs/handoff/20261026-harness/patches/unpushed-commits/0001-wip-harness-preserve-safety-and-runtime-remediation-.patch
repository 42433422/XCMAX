+def authorize_agent_tool(
+    tool_id: str, action: str, params: dict, runtime_context: dict
+) -> dict[str, Any] | None:
+    """Recheck a server-bound actor and the existing business RBAC before each call."""
+    binding = runtime_context.get("_actor_authorization")
+    if binding is None:
+        return None  # Legacy internal runs have not yet migrated to authenticated actors.
+    from app.application.agent_orchestrator.tool_spec import get_tool_action_spec
+    from app.application.tenant_rbac_policy import role_belongs_to_user
+    from app.db import HostSessionLocal
+    from app.db.models.user import User
+    from app.services.auth_service import get_auth_service
+    from app.utils.operational_errors import RECOVERABLE_ERRORS
+
+    denied = {
+        "success": False,
+        "error_code": "tool_permission_denied",
+        "message": "无权执行该工具动作",
+    }
+    if not isinstance(binding, dict) or not str(binding.get("user_id") or "").isdigit():
+        return denied
+    try:
+        with HostSessionLocal() as db:
+            user = db.get(User, int(binding["user_id"]))
+            if (
+                user is None
+                or not user.is_active
+                or not role_belongs_to_user(user.role, user.tenant_id)
+            ):
+                return denied
+            actual = {
+                "user_id": str(user.id),
+                "tenant_id": str(user.tenant_id or ""),
+                "role": str(user.role or ""),
+                "tier": str(user.tier or "").strip().lower(),
+            }
+            if actual != binding or str(runtime_context.get("user_id") or "") != actual["user_id"]:
+                return denied
+            spec = get_tool_action_spec(tool_id, action)
+            if spec is None:
+                return denied
+            auth = get_auth_service()
+            permissions = set(auth.get_user_permissions(user))
+            if spec.permission in permissions:
+                return None
+            if user.role == "admin" and user.tier == "admin" and user.tenant_id is None:
+                return None
+            read = action in {
+                "view",
+                "read",
+                "list",
+                "query",
+                "preview",
+                "analyze",
+                "extract",
+                "export",
+                "diff_versions",
+            } or action.startswith(("query_", "get_", "list_"))
+            domain = {
+                "customers": "customer",
+                "products": "product",
+                "materials": "material",
+                "shipment_records": "shipment",
+                "shipment_orders": "shipment",
+                "inventory": "product",
+                "purchase": "material",
+                "suppliers": "material",
+                "sales": "shipment",
+                "mrp": "material",
+            }.get(tool_id)
+            if tool_id == "business_db":
+                domain = {
+                    "customers": "customer",
+                    "purchase_units": "customer",
+                    "products": "product",
+                    "materials": "material",
+                    "shipment_records": "shipment",
+                    "shipment_orders": "shipment",
+                }.get(str(params.get("entity") or ""))
+            required = f"{domain}.{'view' if read else 'edit'}" if domain else spec.permission
+            if tool_id in {"dataset_rag", "memory_v2"}:
+                required = f"dataset.{'read' if read else 'write'}"
+            elif tool_id in {
+                "ocr",
+                "excel_analysis",
+                "excel_vector_index",
+                "excel_analyzer",
+                "excel_toolkit",
+                "excel_import",
+                "unit_products_import",
+                "template_extract",
+                "business_docking",
+                "document_template",
+                "generate_office_document",
+                "label_template_generator",
+                "template_preview",
+            }:
+                required = "etl.read" if read else "etl.execute"
+            elif tool_id in {"settings", "desktop_automation", "system_maintenance"}:
+                required = "admin.system_config"
+            elif tool_id in {"print", "printer_list"}:
+                required = "print.label"
+            elif action in {"approve", "approve_order"} and domain == "shipment":
+                required = "shipment.approve"
+            return None if required in permissions else denied
+    except RECOVERABLE_ERRORS:
+        return denied
