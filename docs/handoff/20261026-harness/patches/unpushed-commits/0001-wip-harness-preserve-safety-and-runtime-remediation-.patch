diff --git a/FHD/tests/test_scripts/test_harness_acceptance.py b/FHD/tests/test_scripts/test_harness_acceptance.py
new file mode 100644
index 0000000000..da91acdab3
--- /dev/null
+++ b/FHD/tests/test_scripts/test_harness_acceptance.py
@@ -0,0 +1,93 @@
+"""Synthetic evidence tests validate the gate; they are never runtime acceptance."""
+
+import hashlib
+import json
+
+import pytest
+
+from evals.harness_acceptance import CHECKLIST_IDS, main, require_acceptance
+
+SHA = "a" * 40
+
+
+@pytest.fixture
+def bundle(tmp_path):
+    def write(name, value):
+        data = json.dumps(value).encode()
+        (tmp_path / name).write_bytes(data)
+        return {"path": name, "sha256": hashlib.sha256(data).hexdigest()}
+
+    raw = write("raw.json", {"synthetic_gate_unit_test": True})
+    cases = [{"checklist_id": key, "source_sha": SHA, "execution_mode": "macos_real",
+              "passed": True, "captured_at": "2026-10-25T00:00:00Z", "planner": "planner",
+              "verifier": "readback", "evidence": raw} for key in sorted(CHECKLIST_IDS)]
+    trial = {"task_id": "synthetic", "source_sha": SHA, "execution_mode": "macos_real",
+             "model": "synthetic_gate_test", "run_id": "synthetic", "tool_selection_correct": True,
+             "business_completed": True, "restart_recovered": True, "unauthorized_executions": 0,
+             "duplicate_writes": 0, "false_completions": 0, "tenant_leaks": 0,
+             "latency_ms": 10, "cost_units": 1, "readback_evidence": raw}
+    manifest = {"schema_version": 1, "source_sha": SHA, "tracked_source_dirty": False,
+                "platform": "macos", "installed_identity": {"build_sha": SHA, "backend_sha": SHA,
+                "ui_sha": SHA, "arch": "arm64", "artifact": raw},
+                "checklist_artifact": write("cases.json", cases),
+                "trials_artifact": write("trials.json", [trial])}
+    write("harness_acceptance.json", manifest)
+    return tmp_path, manifest, cases, trial, write
+
+
+def test_gate_checks_all_76_and_computes_measurements(bundle):
+    directory, *_ = bundle
+    result = require_acceptance(directory, SHA)
+    assert result["closed"] == 76 and result["business_completion_rate"] == 1
+    assert result["p95_latency_ms"] == 10
+
+
+@pytest.mark.parametrize("field,value", [
+    ("source_sha", "b" * 40), ("tracked_source_dirty", True), ("platform", "windows"),
+])
+def test_wrong_source_dirty_tree_or_wrong_platform_rejected(bundle, field, value):
+    directory, manifest, _, _, write = bundle
+    manifest[field] = value
+    write("harness_acceptance.json", manifest)
+    with pytest.raises(ValueError):
+        require_acceptance(directory, SHA)
+
+
+@pytest.mark.parametrize("mutation", ["fixture", "missing", "duplicate", "self_verified", "failed"])
+def test_incomplete_or_self_reported_checklist_rejected(bundle, mutation):
+    directory, manifest, cases, _, write = bundle
+    if mutation == "missing":
+        cases.pop()
+    elif mutation == "duplicate":
+        cases[-1] = cases[0]
+    elif mutation == "fixture":
+        cases[0]["execution_mode"] = "fixture_local"
+    elif mutation == "self_verified":
+        cases[0]["verifier"] = "planner"
+    else:
+        cases[0]["passed"] = False
+    manifest["checklist_artifact"] = write("cases.json", cases)
+    write("harness_acceptance.json", manifest)
+    with pytest.raises(ValueError):
+        require_acceptance(directory, SHA)
+
+
+@pytest.mark.parametrize("field,value", [
+    ("business_completed", False), ("tool_selection_correct", False), ("restart_recovered", False),
+    ("duplicate_writes", 1), ("tenant_leaks", 1), ("latency_ms", float("nan")), ("cost_units", -1),
+])
+def test_measured_failures_cannot_publish(bundle, field, value):
+    directory, manifest, _, trial, write = bundle
+    trial[field] = value
+    manifest["trials_artifact"] = write("trials.json", [trial])
+    write("harness_acceptance.json", manifest)
+    with pytest.raises(ValueError):
+        require_acceptance(directory, SHA)
+
+
+def test_tampered_raw_evidence_and_absent_bundle_fail_closed(bundle, tmp_path):
+    directory, *_ = bundle
+    (directory / "raw.json").write_text("tampered")
+    with pytest.raises(ValueError):
+        require_acceptance(directory, SHA)
+    assert main(["--evidence-dir", str(tmp_path / "missing"), "--source-sha", SHA]) == 1
