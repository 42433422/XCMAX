index fdf47ef4e6..eee77ac52b 100644
--- a/FHD/app/application/agent_orchestrator/run_control.py
+++ b/FHD/app/application/agent_orchestrator/run_control.py
@@ -10,6 +10,7 @@ RunControl = Literal["pause", "cancel"]
 
 _LOCK = threading.RLock()
 _CONTROLS: dict[str, RunControl] = {}
+_CONTROL_USERS: dict[str, int] = {}
 _OPERATION_LOCKS: dict[str, threading.RLock] = {}
 
 
@@ -30,6 +31,22 @@ def clear_run_control(run_id: str) -> None:
         _CONTROLS.pop(run_id, None)
 
 
+def retain_run_control(run_id: str) -> None:
+    with _LOCK:
+        _CONTROL_USERS[run_id] = _CONTROL_USERS.get(run_id, 0) + 1
+
+
+def release_run_control(run_id: str) -> None:
+    """Keep cancellation visible until every nested producer has stopped."""
+    with _LOCK:
+        remaining = _CONTROL_USERS.get(run_id, 1) - 1
+        if remaining > 0:
+            _CONTROL_USERS[run_id] = remaining
+        else:
+            _CONTROL_USERS.pop(run_id, None)
+            _CONTROLS.pop(run_id, None)
+
+
 @contextmanager
 def run_operation_lock(run_id: str) -> Iterator[None]:
     """Serialize state-changing operations for one run within this service process."""
