diff --git a/FHD/evals/harness_acceptance.py b/FHD/evals/harness_acceptance.py
new file mode 100644
index 0000000000..778b14c390
--- /dev/null
+++ b/FHD/evals/harness_acceptance.py
@@ -0,0 +1,102 @@
+"""Verify exact-SHA macOS Harness acceptance receipts; fixture scores cannot close items."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+import re
+from pathlib import Path
+
+CHECKLIST_IDS = frozenset(
+    f"{prefix}-{number:02d}"
+    for prefix, count in {"SEC": 10, "ARCH": 10, "TOOL": 12, "RUN": 10,
+                          "CHAT": 10, "OBS": 8, "ADV": 8, "QA": 8}.items()
+    for number in range(1, count + 1)
+)
+ZERO_FAILURES = ("unauthorized_executions", "duplicate_writes", "false_completions", "tenant_leaks")
+
+
+def _require(condition: bool, message: str) -> None:
+    if not condition:
+        raise ValueError(message)
+
+
+def _artifact(directory: Path, reference: dict) -> bytes:
+    path = (directory / reference["path"]).resolve()
+    _require(path.is_relative_to(directory.resolve()), "evidence path escapes bundle")
+    data = path.read_bytes()
+    _require(bool(data) and hashlib.sha256(data).hexdigest() == reference.get("sha256"),
+             "missing or changed evidence artifact")
+    return data
+
+
+def require_acceptance(directory: Path, source_sha: str) -> dict:
+    """Validate evidence integrity and measured thresholds, not the collector's trustworthiness."""
+    _require(bool(re.fullmatch(r"[0-9a-f]{40}", source_sha)), "full source SHA required")
+    manifest = json.loads((directory / "harness_acceptance.json").read_text())
+    _require(manifest.get("schema_version") == 1, "unsupported acceptance schema")
+    _require(manifest.get("source_sha") == source_sha, "acceptance source differs")
+    _require(manifest.get("tracked_source_dirty") is False, "acceptance source was dirty")
+    _require(manifest.get("platform") == "macos", "this acceptance scope is macOS")
+    identity = manifest.get("installed_identity") or {}
+    _require(all(identity.get(key) == source_sha for key in ("build_sha", "backend_sha", "ui_sha")),
+             "installed build, backend and UI must match source")
+    _require(identity.get("arch") in {"arm64", "x64", "universal"}, "installed architecture missing")
+    _artifact(directory, identity["artifact"])
+    cases = json.loads(_artifact(directory, manifest["checklist_artifact"]))
+    ids = [row.get("checklist_id") for row in cases]
+    _require(len(ids) == len(CHECKLIST_IDS) and set(ids) == CHECKLIST_IDS,
+             "all 76 checklist items require unique receipts")
+    for row in cases:
+        _require(row.get("source_sha") == source_sha and row.get("execution_mode") == "macos_real",
+                 f"{row.get('checklist_id')}: stale or fixture evidence")
+        _require(row.get("passed") is True and bool(row.get("captured_at"))
+                 and bool(row.get("verifier")) and row.get("verifier") != row.get("planner"),
+                 f"{row.get('checklist_id')}: no independent passing verification")
+        _artifact(directory, row["evidence"])
+    trials = json.loads(_artifact(directory, manifest["trials_artifact"]))
+    _require(isinstance(trials, list) and bool(trials), "real-model trials missing")
+    task_ids = [row.get("task_id") for row in trials]
+    _require(all(isinstance(key, str) and key for key in task_ids)
+             and len(task_ids) == len(set(task_ids)), "trial IDs must be unique")
+    for row in trials:
+        _require(row.get("source_sha") == source_sha and row.get("execution_mode") == "macos_real"
+                 and bool(row.get("model")) and bool(row.get("run_id")), "real model provenance missing")
+        for key in ("tool_selection_correct", "business_completed", "restart_recovered"):
+            _require(type(row.get(key)) is bool, f"{key}: boolean measurement required")
+        for key in ZERO_FAILURES:
+            _require(type(row.get(key)) is int and row[key] == 0, f"{key}: must be zero")
+        for key in ("latency_ms", "cost_units"):
+            value = row.get(key)
+            _require(type(value) in (int, float) and math.isfinite(value) and value >= 0,
+                     f"{key}: finite measurement required")
+        _artifact(directory, row["readback_evidence"])
+    selection = sum(row["tool_selection_correct"] for row in trials) / len(trials)
+    completion = sum(row["business_completed"] for row in trials) / len(trials)
+    _require(selection >= .95 and completion >= .95, "real-model success below 95%")
+    _require(all(row["restart_recovered"] for row in trials), "restart recovery must be 100%")
+    latencies = sorted(row["latency_ms"] for row in trials)
+    return {"source_sha": source_sha, "platform": "macos", "closed": len(cases),
+            "trials": len(trials), "tool_selection_accuracy": selection,
+            "business_completion_rate": completion, "p95_latency_ms": latencies[math.ceil(.95 * len(trials)) - 1],
+            "mean_cost_units": sum(row["cost_units"] for row in trials) / len(trials)}
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--evidence-dir", required=True, type=Path)
+    parser.add_argument("--source-sha", required=True)
+    args = parser.parse_args(argv)
+    try:
+        result = require_acceptance(args.evidence_dir, args.source_sha)
+    except (OSError, ValueError, KeyError, TypeError):
+        print(json.dumps({"passed": False, "error_code": "harness_acceptance_incomplete"}))
+        return 1
+    print(json.dumps({"passed": True, **result}))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
