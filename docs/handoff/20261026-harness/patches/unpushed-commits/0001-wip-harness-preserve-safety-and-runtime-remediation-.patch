+def test_stream_close_keeps_cancellation_visible_until_producer_stops():
+    import threading
+    from types import SimpleNamespace
+
+    from app.application.agent_orchestrator.run_control import get_run_control
+    from app.fastapi_routes.domains.conversation.stream_helpers import (
+        _xcagi_guarded_planner_stream_events,
+    )
+
+    release, finished = threading.Event(), threading.Event()
+    seen, states = {}, []
+
+    def source(*args, runtime_context, **kwargs):
+        seen.update(runtime_context)
+        try:
+            yield {"type": "token", "text": "started"}
+            release.wait(timeout=2)
+            states.append(get_run_control(seen["_stream_control_id"]))
+        finally:
+            finished.set()
+
+    api = SimpleNamespace(
+        chat_stream_sse_events=source,
+        _xcagi_chat_timeout_seconds=lambda: 3,
+        _xcagi_stream_first_token_timeout_seconds=lambda: 1,
+        _xcagi_stream_idle_notice_seconds=lambda: 1,
+    )
+    body = SimpleNamespace(message="hello", system_prompt=None, db_write_token=None)
+    stream = _xcagi_guarded_planner_stream_events(
+        body, runtime_context={}, workspace_root="", client=None, _api=api
+    )
+    try:
+        assert next(stream)["type"] == "tool_progress"
+        assert next(stream)["text"] == "started"
+        stream.close()
+        assert get_run_control(seen["_stream_control_id"]) == "cancel"
+    finally:
+        release.set()
+    assert finished.wait(timeout=2)
+    assert states == ["cancel"]
