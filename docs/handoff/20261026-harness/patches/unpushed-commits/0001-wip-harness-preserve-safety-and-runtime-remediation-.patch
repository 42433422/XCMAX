+def unsafe_replay_step_ids(run: AgentRun) -> list[str]:
+    """Historical claims cannot make a committed or in-flight write replay safe."""
+    from app.application.agent_orchestrator.tool_spec import get_tool_action_spec
+
+    unsafe = []
+    for step in run.steps:
+        if step.status not in {"completed", "running"}:
+            continue
+        spec = get_tool_action_spec(step.tool_id, step.action)
+        if not (step.idempotent and spec and spec.idempotent):
+            unsafe.append(step.step_id)
+    return unsafe
+
