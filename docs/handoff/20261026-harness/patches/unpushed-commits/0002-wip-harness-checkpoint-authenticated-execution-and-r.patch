+@pytest.mark.parametrize("existing", [False, True])
+def test_real_sqlite_delete_requires_http_consumed_grant_and_replays_original_action_once(
+    trusted_actor, monkeypatch, existing
+):
+    from fastapi import FastAPI
+    from fastapi.testclient import TestClient
+
+    from app.application.agent_orchestrator.run_sql_repository import SQLAlchemyAgentRunRepository
+    from app.application.agent_orchestrator.task_execution_sql_repository import (
+        SQLAlchemyTaskExecutionRepository,
+    )
+    from app.application.facades import tools_facade
+    from app.db.models.purchase_unit import PurchaseUnit
+    from app.fastapi_routes.domains.agent.routes import router
+    from app.infrastructure.tenant_scope import tenant_scope
+
+    actor = trusted_actor(permissions=["customer.edit"])
+    monkeypatch.setattr("app.db.session.SessionLocal", actor.factory)
+    repository = SQLAlchemyAgentRunRepository(session_factory=actor.factory, auto_create=False)
+    queue = SQLAlchemyTaskExecutionRepository(session_factory=actor.factory, auto_create=False)
+    monkeypatch.setattr(
+        "app.application.agent_orchestrator.run_repository._agent_run_repository", repository
+    )
+    monkeypatch.setattr(
+        "app.application.agent_orchestrator.task_execution_repository._task_execution_repository",
+        queue,
+    )
+    monkeypatch.setattr(
+        "app.fastapi_routes.domains.agent.routes.notify_agent_task_dispatcher", lambda: None
+    )
+    with tenant_scope(actor.tenant_id), actor.factory.begin() as db:
+        row = PurchaseUnit(unit_name="Needs explicit approval", tenant_id=actor.tenant_id)
+        db.add(row)
+        db.flush()
+        record_id = row.id
+    calls = []
+    real_dispatch = tools_facade.execute_registered_workflow_tool
+
+    def dispatch(*args, **kwargs):
+        calls.append(args[:2])
+        return real_dispatch(*args, **kwargs)
+
+    monkeypatch.setattr(tools_facade, "execute_registered_workflow_tool", dispatch)
+    step = AgentStep("delete", "customers", "delete", params={"id": record_id}, risk="low")
+    original = {**actor.context, "business_action_id": "original-delete-action"}
+    initial = dict(original)
+    if existing:
+        pending_run = AgentRun(
+            user_id=str(actor.user_id),
+            message="已有待运行任务",
+            status="running",
+            steps=[step],
+            metadata={"runtime_context": dict(original)},
+        )
+        repository.save(pending_run)
+        initial.update(run_id=pending_run.run_id, step_id=step.step_id)
+    blocked = AgentToolExecutor().execute(
+        step, runtime_context={**initial, "approved": True, "route_confirmed": True}
+    )
+    assert blocked["outcome"] == "waiting_approval" and calls == []
+    waiting_run = repository.get(blocked["run_id"])
+    assert waiting_run.status == "waiting_user" and waiting_run.steps[0].status == "waiting_user"
+    if existing:
+        assert waiting_run.run_id == pending_run.run_id
+    with tenant_scope(actor.tenant_id), actor.factory() as db:
+        assert db.get(PurchaseUnit, record_id).is_active is True
+    app = FastAPI()
+    app.include_router(router)
+    client = TestClient(app)
+
+    def approve_and_execute(pending):
+        run_id = pending["run_id"]
+        visible = client.get(f"/api/agent/runs/{run_id}", headers=actor.headers)
+        assert visible.status_code == 200 and "_tool_approval_grants" not in visible.text
+        token = visible.json()["approval"]["grant"]
+        waiting = repository.get(run_id)
+        untouched = list(calls)
+        unconsumed = AgentToolExecutor().execute(
+            waiting.steps[0],
+            runtime_context={
+                **original,
+                "run_id": run_id,
+                "step_id": waiting.steps[0].step_id,
+                "approval_grant": token,
+                "approved": True,
+            },
+        )
+        assert unconsumed["outcome"] == "waiting_approval" and calls == untouched
+        accepted = client.post(
+            f"/api/agent/runs/{run_id}/continue",
+            headers=actor.headers,
+            json={"approval_grant": token},
+        )
+        assert accepted.status_code == 202, accepted.text
+        run = repository.get(run_id)
+        current_step = run.steps[0]
+        return (
+            AgentToolExecutor().execute(
+                current_step,
+                runtime_context={
+                    **original,
+                    "run_id": run_id,
+                    "step_id": current_step.step_id,
+                    "business_action_id": "caller-cannot-change-approved-action",
+                },
+            ),
+            run,
+            current_step,
+        )
+
+    first, run, current_step = approve_and_execute(blocked)
+    assert first["success"] and first["business_verification"]["verified"], first
+    with tenant_scope(actor.tenant_id), actor.factory() as db:
+        deleted = db.get(PurchaseUnit, record_id)
+        assert deleted is None or deleted.is_active is False
+    replay = AgentToolExecutor().execute(
+        current_step,
+        runtime_context={
+            **original,
+            "run_id": run.run_id,
+            "step_id": current_step.step_id,
+            "business_action_id": "another-forged-action",
+        },
+    )
+    assert replay["business_action_replayed"] and calls == [("customers", "delete")]
+    modified = AgentStep("different", "customers", "delete", params={"id": record_id + 1})
+    changed = AgentToolExecutor().execute(
+        modified,
+        runtime_context={
+            **original,
+            "run_id": run.run_id,
+            "step_id": current_step.step_id,
+        },
+    )
+    assert changed["outcome"] == "waiting_approval" and calls == [("customers", "delete")]
+    again = AgentToolExecutor().execute(step, runtime_context=original)
+    second, _, _ = approve_and_execute(again)
+    assert second["business_action_replayed"] and calls == [("customers", "delete")]
+    run.status = "cancelled"
+    repository.save(run)
+    cancelled = AgentToolExecutor().execute(
+        current_step,
+        runtime_context={
+            **original,
+            "run_id": run.run_id,
+            "step_id": current_step.step_id,
+        },
+    )
+    assert cancelled["outcome"] == "cancelled" and calls == [("customers", "delete")]
