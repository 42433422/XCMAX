+"""Persist business action claims independently of run retries."""
+
+import sqlalchemy as sa
+
+from alembic import op
+
+revision = "2026_10_25_business_actions"
+down_revision = "2026_10_20_refund_permission"
+branch_labels = None
+depends_on = None
+
+
+def upgrade():
+    if "agent_business_actions" in sa.inspect(op.get_bind()).get_table_names():
+        return
+    op.create_table(
+        "agent_business_actions",
+        sa.Column("action_key", sa.String(64), primary_key=True),
+        sa.Column("tenant_id", sa.String(128), nullable=False),
+        sa.Column("mod_id", sa.String(128), nullable=False),
+        sa.Column("business_action_id", sa.String(256), nullable=False),
+        sa.Column("tool_id", sa.String(128), nullable=False),
+        sa.Column("action", sa.String(64), nullable=False),
+        sa.Column("user_id", sa.String(128), nullable=False),
+        sa.Column("fingerprint", sa.String(64), nullable=False),
+        sa.Column("owner", sa.String(64), nullable=False),
+        sa.Column("run_id", sa.String(96), nullable=False),
+        sa.Column("state", sa.String(32), nullable=False),
+        sa.Column("receipt_json", sa.Text(), nullable=False),
+        sa.Column("created_at", sa.String(48), nullable=False),
+        sa.Column("updated_at", sa.String(48), nullable=False),
+    )
+
+
+def downgrade():
+    op.drop_table("agent_business_actions")
