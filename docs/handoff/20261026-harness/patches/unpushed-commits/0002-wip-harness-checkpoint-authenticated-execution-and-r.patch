+        for _ in range(4):
+            nested = original.get("reconciliation_evidence", {}).get("receipt")
+            if not isinstance(nested, dict):
+                break
+            original = nested
+        with (
+            agent_mod_execution_scope(context.get("_mod_authorization")),
+            tenant_scope(int(context["tenant_id"]) if context.get("tenant_id") else None),
+        ):
+            checked, verified = verify_action_result(
+                spec, params, original, runtime_context=context
+            )
+        if not verified:
+            return unknown_action(action_key=key, receipt=receipt)
+        checked = {
+            **checked,
+            "business_action_id": context["business_action_id"],
+            "reconciled": True,
+        }
+        with self._runs.transaction() as db:
+            db.query(AgentBusinessActionRecord).filter_by(
+                action_key=key, fingerprint=fingerprint
+            ).filter(AgentBusinessActionRecord.state == "unknown").update(
+                {
+                    "state": "completed",
+                    "receipt_json": json.dumps(checked, ensure_ascii=False),
+                    "updated_at": utc_now_iso(),
+                },
+                synchronize_session=False,
+            )
+        return checked
