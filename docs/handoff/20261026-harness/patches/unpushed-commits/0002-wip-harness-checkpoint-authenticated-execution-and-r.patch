+@pytest.mark.parametrize("batch", [False, True])
+@pytest.mark.parametrize("authenticated", [False, True])
+def test_real_http_unified_chat_binds_same_session_and_strips_body_proof(
+    trusted_actor, monkeypatch, batch, authenticated
+):
+    from fastapi import FastAPI
+    from fastapi.testclient import TestClient
+
+    from app.fastapi_routes import ai_intent
+    from app.infrastructure.tenant_scope import current_tenant_id
+
+    actor = trusted_actor(mod_id="test-private-mod")
+    other = trusted_actor(tenant_id=99)
+    captured = []
+
+    def respond(message, user_id, remote_addr, source, mode, context):
+        captured.append((context, user_id, current_tenant_id()))
+        denial = authorize_agent_tool("customers", "query", {}, context)
+        assert (denial is None) is authenticated
+        return {"success": True, "response": "自然语言回复", "context": context}
+
+    monkeypatch.setattr("app.domain.app_pure.ai_chat_helpers.unified_chat_single_payload", respond)
+    monkeypatch.setattr(
+        "app.application.agent_orchestrator.chat_trace.attach_chat_trace_run",
+        lambda payload, **_: payload,
+    )
+    app = FastAPI()
+    app.include_router(ai_intent.router)
+    body = {"user_id": str(other.user_id), "context": other.context}
+    body.update({"messages": ["你好", "继续"]} if batch else {"message": "你好"})
+    response = TestClient(app).post(
+        "/api/ai/chat-unified" + ("/batch" if batch else ""),
+        json=body,
+        headers=actor.headers if authenticated else {},
+    )
+    assert response.status_code == 200 and response.json()["success"]
+    assert "_actor_authorization" not in response.text and "_mod_authorization" not in response.text
+    assert len(captured) == (2 if batch else 1)
+    for context, user_id, tenant in captured:
+        if authenticated:
+            assert context["_actor_authorization"] == actor.context["_actor_authorization"]
+            assert context["_mod_authorization"] == actor.context["_mod_authorization"]
+            assert user_id == str(actor.user_id) and tenant == actor.tenant_id
+        else:
+            assert not user_id and tenant is None
+            assert "_actor_authorization" not in context and "_mod_authorization" not in context
+
