+def test_default_employee_discovers_and_previews_real_workbook_within_budget(
+    trusted_actor, tmp_path, monkeypatch
+):
+    from openpyxl import Workbook
+
+    from app.application.agent_orchestrator.context_window_manager import _estimate_prompt_tokens
+    from app.application.employee_runtime.agent_loop import run_employee_agent_loop
+
+    monkeypatch.setenv("WORKSPACE_ROOT", str(tmp_path))
+    monkeypatch.setenv("XCAGI_DATA_DIR", str(tmp_path))
+    actor = trusted_actor(permissions=["etl.read"])
+    source = tmp_path / "input.xlsx"
+    workbook = Workbook()
+    workbook.active.append(["客户", "金额"])
+    workbook.active.append(["甲", 12])
+    workbook.save(source)
+    original = source.read_bytes()
+    arguments = [
+        ("query_tool_catalog", {"query": "excel_analyzer preview"}),
+        (
+            "execute_erp_capability",
+            {
+                "tool_id": "excel_analyzer",
+                "action": "preview",
+                "params": {"file_path": str(source)},
+            },
+        ),
+    ]
+    completions = [
+        _completion(
+            SimpleNamespace(
+                id=f"call-{i}", function=SimpleNamespace(name=name, arguments=json.dumps(args))
+            )
+        )
+        for i, (name, args) in enumerate(arguments)
+    ] + [_completion()]
+    captured = []
+
+    def complete(**payload):
+        captured.append(json.loads(json.dumps(payload)))
+        return completions.pop(0)
+
+    with (
+        patch("app.infrastructure.llm.client.require_api_key"),
+        patch("app.infrastructure.llm.client.get_openai_compatible_client") as client,
+    ):
+        client.return_value.chat.completions.create.side_effect = complete
+        result = run_employee_agent_loop(
+            employee_id="e",
+            system_prompt="助手",
+            task="分析Excel结构",
+            runtime_context=actor.context,
+            model="test",
+        )
+    assert result["ok"] is True, result
+    assert len(captured) == 3 and len(result["tool_calls"]) == 2
+    assert all(call["success"] for call in result["tool_calls"])
+    assert all(
+        _estimate_prompt_tokens(
+            [
+                *payload["messages"],
+                {"role": "system", "content": json.dumps(payload["tools"], ensure_ascii=False)},
+            ]
+        )
+        <= 8000
+        for payload in captured
+    )
+    receipt = json.loads(
+        next(
+            message["content"]
+            for message in captured[2]["messages"]
+            if message.get("tool_call_id") == "call-1"
+        )
+    )
+    assert receipt["result"]["structure"]["max_row"] == 2
+    assert source.read_bytes() == original
