--- /dev/null
+++ b/FHD/app/application/agent_orchestrator/tool_receipt.py
@@ -0,0 +1,68 @@
+"""Classify execution receipts before interpreting success or replay safety."""
+
+from collections.abc import Mapping
+from typing import Any, Literal
+
+ReceiptOutcome = Literal[
+    "success", "failure", "pending", "unknown", "waiting_approval", "cancelled"
+]
+
+
+def tool_receipt_outcome(output: Mapping[str, Any] | None) -> ReceiptOutcome:
+    """A missing receipt or contradictory success flag never proves completion.
+
+    This classifies transport evidence; business read-back validation remains the
+    responsibility of the tool's verifier.
+    """
+    if not isinstance(output, Mapping):
+        return "unknown"
+    outcome = str(output.get("outcome") or output.get("execution_state") or "").lower()
+    status = str(output.get("status") or "").lower()
+    if not outcome and status in {
+        "unknown",
+        "waiting_approval",
+        "waiting_user",
+        "pending",
+        "running",
+        "queued",
+        "in_progress",
+        "accepted",
+        "awaiting_approval",
+        "cancelled",
+        "failure",
+        "failed",
+    }:
+        outcome = status
+    if output.get("reconciliation_required") or outcome == "unknown":
+        return "unknown"
+    if (
+        output.get("pending_approval")
+        or output.get("requires_token")
+        or outcome
+        in {
+            "waiting_approval",
+            "waiting_user",
+            "awaiting_approval",
+        }
+    ):
+        return "waiting_approval"
+    if output.get("pending") or outcome in {
+        "pending",
+        "running",
+        "queued",
+        "in_progress",
+        "accepted",
+    }:
+        return "pending"
+    if output.get("cancelled") or outcome == "cancelled":
+        return "cancelled"
+    if (
+        outcome in {"failure", "failed"}
+        or output.get("success") is False
+        or output.get("ok") is False
+        or output.get("error")
+    ):
+        return "failure"
+    if outcome and outcome not in {"success", "completed"}:
+        return "unknown"
+    return "success" if output.get("success") is True else "unknown"
