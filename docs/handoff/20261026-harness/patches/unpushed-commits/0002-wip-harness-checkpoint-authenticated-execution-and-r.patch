+def test_unique_action_claim_survives_threads_runs_and_new_repository(action_db):
+    engine, factory = action_db
+    spec = ToolActionSpecV2("fixture", "write")
+    context = {"tenant_id": "7", "user_id": "1", "business_action_id": "order-42"}
+
+    def invoke(index):
+        ledger = BusinessActionLedger(factory)
+        claim, receipt = ledger.claim(spec, {"quantity": 2}, {**context, "run_id": f"run-{index}"})
+        if claim:
+            with engine.begin() as db:
+                db.execute(text("INSERT INTO effects(value) VALUES ('submitted')"))
+            return ledger.finish(claim, {"success": True, "record_id": 42}, verified=True)
+        return receipt
+
+    with ThreadPoolExecutor(max_workers=8) as pool:
+        receipts = list(pool.map(invoke, range(16)))
+    with engine.connect() as db:
+        assert db.execute(text("SELECT COUNT(*) FROM effects")).scalar_one() == 1
+    assert any(receipt.get("success") for receipt in receipts)
+    claim, receipt = BusinessActionLedger(factory).claim(
+        spec, {"quantity": 2}, {**context, "run_id": "restart"}
+    )
+    assert claim is None and receipt["business_action_replayed"] and receipt["record_id"] == 42
+    assert (
+        BusinessActionLedger(factory).claim(spec, {"quantity": 3}, context)[1]["error_code"]
+        == "business_action_conflict"
+    )
+    assert (
+        BusinessActionLedger(factory).claim(spec, {"quantity": 2}, {**context, "user_id": "2"})[1][
+            "error_code"
+        ]
+        == "business_action_conflict"
+    )
