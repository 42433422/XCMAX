+"""Real sessions and formal approval on the legacy HTTP tool entry points."""
+
+import importlib
+
+import pytest
+from fastapi import Body, FastAPI, Request
+from fastapi.testclient import TestClient
+
+from tests.fixtures.backend_ci_isolation import trusted_actor as trusted_actor
+
+
+@pytest.fixture
+def runtime(monkeypatch, tmp_path, trusted_actor):
+    from app.application.agent_orchestrator.run_sql_repository import SQLAlchemyAgentRunRepository
+    from app.application.agent_orchestrator.task_execution_sql_repository import (
+        SQLAlchemyTaskExecutionRepository,
+    )
+
+    actor = trusted_actor()
+    # Compat raw SQL and ORM readback must address the same actual fixture DB,
+    # including the spawned tool process's documented pytest database path.
+    with actor.factory() as db:
+        (tmp_path / ".pytest_products.db").symlink_to(db.get_bind().url.database)
+    monkeypatch.setenv("WORKSPACE_ROOT", str(tmp_path))
+    repo = SQLAlchemyAgentRunRepository(session_factory=actor.factory, auto_create=False)
+    queue = SQLAlchemyTaskExecutionRepository(session_factory=actor.factory, auto_create=False)
+    monkeypatch.setattr(
+        "app.application.agent_orchestrator.run_repository._agent_run_repository", repo
+    )
+    monkeypatch.setattr(
+        "app.application.agent_orchestrator.task_execution_repository._task_execution_repository",
+        queue,
+    )
+    monkeypatch.setattr(
+        "app.fastapi_routes.domains.agent.routes.notify_agent_task_dispatcher", lambda: None
+    )
+    monkeypatch.setenv("MODEL_USAGE_LEDGER_PATH", str(tmp_path / "usage.json"))
+    monkeypatch.setenv("MODEL_USAGE_WALLET_BACKEND", "audit")
+    monkeypatch.delenv("MODEL_USAGE_WALLET_REQUIRED", raising=False)
+    return actor, repo, queue
+
+
+def _client(module, helper, action):
+    from app.fastapi_routes.domains.agent.routes import router
+
+    target = getattr(importlib.import_module(module), helper)
+    app = FastAPI()
+    app.include_router(router)
+
+    @app.post("/legacy-action")
+    def invoke(request: Request, body: dict = Body(default_factory=dict)):
+        return target(request=request, action=action, params=body, route_path="/legacy-action")
+
+    return TestClient(app)
+
+
+@pytest.mark.parametrize(
+    "module,helper",
+    [
+        ("inventory", "_run_inventory_agent"),
+        ("materials", "_run_materials_agent"),
+        ("purchase", "_run_purchase_agent"),
+        ("xcagi_compat_product", "_run_products_compat_agent"),
+        ("print_agent_helpers", "run_print_agent"),
+        ("domains.customer.agent_helpers", "run_customers_agent"),
+    ],
+)
+def test_legacy_tool_helpers_reject_unsigned_header_and_body_identity(module, helper, monkeypatch):
+    monkeypatch.delenv("FHD_ALLOW_X_USER_ID_HEADER", raising=False)
+    with _client(f"app.fastapi_routes.{module}", helper, "create") as client:
+        response = client.post("/legacy-action", json={"user_id": "7"}, headers={"X-User-ID": "7"})
+    assert response.status_code == 401
+
+
+def test_customer_http_read_and_approved_write_use_the_real_session(runtime):
+    from app.application.agent_orchestrator import AgentOrchestrator
+    from app.db.models.purchase_unit import PurchaseUnit
+    from app.infrastructure.tenant_scope import tenant_scope
+
+    actor, repo, queue = runtime
+    with _client(
+        "app.fastapi_routes.domains.customer.agent_helpers", "run_customers_agent", "create"
+    ) as client:
+        result = client.post(
+            "/legacy-action",
+            json={"unit_name": "HTTP customer"},
+            headers={**actor.headers, "X-User-ID": "spoofed"},
+        )
+        assert result.status_code == 200, result.text
+        pending = result.json()
+        assert pending["success"] is False and pending["pending_approval"] is True
+        run = repo.get(pending["run_id"])
+        context = run.metadata["runtime_context"]
+        assert run.user_id == context["user_id"] == str(actor.user_id)
+        assert context["tenant_id"] == str(actor.tenant_id)
+        assert context["_actor_authorization"] == actor.context["_actor_authorization"]
+        assert "route_confirmed" not in context
+        with tenant_scope(actor.tenant_id), actor.factory() as db:
+            assert db.query(PurchaseUnit).count() == 0
+        accepted = client.post(
+            f"/api/agent/runs/{run.run_id}/continue",
+            headers=actor.headers,
+            json={"approval_grant": pending["approval"]["grant"]},
+        )
+        assert accepted.status_code == 202, accepted.text
+        assert queue.claim("http-customer", lease_seconds=30).run_id == run.run_id
+        finished = AgentOrchestrator().execute_dispatched_run(run.run_id)
+        assert finished.status == "completed", finished.steps[0].output
+    with _client(
+        "app.fastapi_routes.domains.customer.agent_helpers", "run_customers_agent", "query"
+    ) as client:
+        response = client.post(
+            "/legacy-action", json={"keyword": "HTTP customer"}, headers=actor.headers
+        )
+    assert response.json()["success"] is True, response.text
+    assert "_actor_authorization" not in response.text
+    with tenant_scope(actor.tenant_id), actor.factory() as db:
+        assert db.query(PurchaseUnit).filter_by(unit_name="HTTP customer").count() == 1
+
+
+def test_inventory_helper_cannot_replace_tenant_from_payload(runtime):
+    actor, _, _ = runtime
+    with _client("app.fastapi_routes.inventory", "_run_inventory_agent", "stock_in") as client:
+        response = client.post(
+            "/legacy-action",
+            headers=actor.headers,
+            json={
+                "product_id": 1,
+                "warehouse_id": 1,
+                "quantity": 10,
+                "tenant_id": actor.tenant_id + 1,
+            },
+        )
+    assert response.status_code == 403
+
+
+def test_inventory_http_approval_executes_one_real_movement(runtime):
+    from app.application.agent_orchestrator import AgentOrchestrator
+    from app.db.models.inventory import InventoryLedger, InventoryTransaction, Warehouse
+    from app.db.models.product import Product
+    from app.infrastructure.tenant_scope import tenant_scope
+
+    actor, repo, queue = runtime
+    with tenant_scope(actor.tenant_id), actor.factory.begin() as db:
+        product = Product(name="HTTP stock", model_number="HTTP-1")
+        warehouse = Warehouse(code="HTTP", name="HTTP warehouse")
+        db.add_all([product, warehouse])
+        db.flush()
+        product_id, warehouse_id = product.id, warehouse.id
+    with _client("app.fastapi_routes.inventory", "_run_inventory_agent", "stock_in") as client:
+        pending = client.post(
+            "/legacy-action",
+            headers=actor.headers,
+            json={"product_id": product_id, "warehouse_id": warehouse_id, "quantity": 10},
+        ).json()
+        assert pending["success"] is False and pending["pending_approval"] is True
+        run_id = pending["run_id"]
+        response = client.post(
+            f"/api/agent/runs/{run_id}/continue",
+            headers=actor.headers,
+            json={"approval_grant": pending["approval"]["grant"]},
+        )
+        assert response.status_code == 202, response.text
+        assert queue.claim("inventory-http", lease_seconds=30).run_id == run_id
+        finished = AgentOrchestrator().execute_dispatched_run(run_id)
+        assert finished.status == "completed", finished.steps[0].output
+        replay = client.post(
+            f"/api/agent/runs/{run_id}/continue",
+            headers=actor.headers,
+            json={"approval_grant": pending["approval"]["grant"]},
+        )
+        assert replay.status_code == 403
+    assert repo.get(run_id).tool_calls[0].output["business_verification"]["verified"] is True
+    with tenant_scope(actor.tenant_id), actor.factory() as db:
+        assert db.query(InventoryTransaction).count() == 1
+        assert db.query(InventoryLedger).one().quantity == 10
+
