+    repository = SQLAlchemyAgentRunRepository(session_factory=actor.factory)
+    service = TraceRunService(
+        repository,
+        TraceRecorder(ModelUsageRecorder(Mock(), Mock()), Mock(), get_tool_action_spec),
+        Mock(side_effect=AssertionError("must not create a second execution plan")),
+    )
+    monkeypatch.setattr(
+        "app.application.agent_orchestrator.chat_trace._run_service", lambda: service
+    )
+    body = Mock(return_value={"success": True, "result": {"outputs": []}})
+    agent = EmployeeAgent(pack_id)
+    monkeypatch.setattr(agent, "_run_authenticated", body)
+    payload = {"invoke_mode": "interactive_chat", "source": "employee_im"} if conversation else {}
+    first = agent.run("处理任务", payload, runtime_context=context)
+    second = agent.run("处理任务", payload, runtime_context=context)
+    assert first["run_id"] == second["run_id"]
+    assert first["success"] is conversation
+    assert first["business_completed"] is False
+    stored = repository.get(first["run_id"])
+    assert stored.status == ("completed" if conversation else "failed")
+    assert stored.final_output["business_result"]["success"] is False
+    if conversation:
+        assert stored.final_output["business_result"]["executed"] is False
+    assert stored.final_output["employee_result"]["business_completed"] is False
+    conflict = agent.run("不同任务", payload, runtime_context=context)
+    assert conflict["error_code"] == "employee_task_conflict"
+    body.assert_called_once()
+
