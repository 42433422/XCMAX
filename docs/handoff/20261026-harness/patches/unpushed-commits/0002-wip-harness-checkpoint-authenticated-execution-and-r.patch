+@pytest.mark.parametrize("entry", ["knowledge", "tools", "shared"])
+@pytest.mark.parametrize(
+    "role,tenant_id,tier",
+    [("viewer", 7, "enterprise"), ("admin", 7, "enterprise"), ("admin", None, "admin")],
+)
+def test_real_http_dataset_target_tenant_never_replaces_signed_identity(
+    tmp_path, monkeypatch, trusted_actor, reviewed_agent_http, entry, role, tenant_id, tier
+):
+    from fastapi import APIRouter, Body
+
+    from app.fastapi_routes.domains.agent.route_support import (
+        agent_node_output,
+        start_registered_http_action,
+    )
+    from app.fastapi_routes.tools_execute import router as tools_router
+
+    storage = tmp_path / "target-tenant.json"
+    monkeypatch.setenv("DATASET_RAG_STORE_PATH", str(storage))
+    monkeypatch.setattr(dataset_rag_module, "_dataset_rag_app_service", None)
+    service = DatasetRagApplicationService(storage_path=storage, rebuild_workers_enabled=False)
+    for target in ("7", "8"):
+        assert service.ingest_document(
+            dataset_id="targets",
+            tenant_id=target,
+            source=f"{target}.md",
+            text=f"Private tenant {target} evidence.",
+            chunk_strategy="fixed",
+        )["success"]
+    actor = trusted_actor(role=role, tenant_id=tenant_id, tier=tier)
+    shared = APIRouter()
+
+    @shared.post("/shared-dataset-query")
+    def query(request: Request, body: dict = Body(default_factory=dict)):
+        run, node_id = start_registered_http_action(
+            request=request,
+            tool_id="dataset_rag",
+            action="query",
+            params=body,
+            source="scope-test",
+            route_path="/shared-dataset-query",
+        )
+        return agent_node_output(run, node_id)
+
+    http = reviewed_agent_http(actor, knowledge_router, tools_router, shared)
+    for target in ("7", "8"):
+        params = {
+            "dataset_id": "targets",
+            "tenant_id": target,
+            "query": "Private tenant evidence",
+            "include_answer": False,
+        }
+        url, body = {
+            "knowledge": (
+                "/api/knowledge/v1/datasets/targets/query",
+                {key: value for key, value in params.items() if key != "dataset_id"},
+            ),
+            "tools": (
+                "/api/tools/execute",
+                {"tool_id": "dataset_rag", "action": "query", "params": params},
+            ),
+            "shared": ("/shared-dataset-query", params),
+        }[entry]
+        result = http.request("POST", url, json=body)
+        allowed = tenant_id is None or target == str(tenant_id)
+        assert result.output["success"] is allowed, result.output
+        if allowed:
+            assert result.output["tenant_id"] == target
+            assert all(
+                chunk["metadata"]["tenant_id"] == target for chunk in result.output["chunks"]
+            )
+        else:
+            assert result.output["error_code"] == "dataset_permission_denied"
+        if result.run:
+            assert result.run.metadata["runtime_context"].get("tenant_id", "") == actor.context.get(
+                "tenant_id", ""
+            )
+            assert result.run.user_id == str(actor.user_id)
+    if entry != "knowledge":
+        params["actor_id"] = "another-actor"
+        body = (
+            {"tool_id": "dataset_rag", "action": "query", "params": params}
+            if entry == "tools"
+            else params
+        )
+        rejected = http.request("POST", url, json=body)
+        assert rejected.response.status_code == 403
+        assert rejected.output["detail"]["code"] == "TOOL_SCOPE_MISMATCH"
