diff --git a/FHD/app/utils/async_bridge.py b/FHD/app/utils/async_bridge.py
new file mode 100644
index 0000000000..f506ee8e53
--- /dev/null
+++ b/FHD/app/utils/async_bridge.py
@@ -0,0 +1,25 @@
+"""Run an async operation at a sync boundary without changing the caller's loop."""
+
+from __future__ import annotations
+
+import asyncio
+from collections.abc import Awaitable
+from concurrent.futures import ThreadPoolExecutor
+from contextvars import copy_context
+from typing import TypeVar
+
+_T = TypeVar("_T")
+
+
+def run_async(operation: Awaitable[_T]) -> _T:
+    """Carry trusted request/model context into an isolated event loop.
+
+    Async callers should await directly or offload the sync boundary with
+    ``asyncio.to_thread`` so the request loop remains responsive.
+    """
+
+    async def wait_for_value() -> _T:
+        return await operation
+
+    with ThreadPoolExecutor(max_workers=1) as pool:
+        return pool.submit(copy_context().run, asyncio.run, wait_for_value()).result()
