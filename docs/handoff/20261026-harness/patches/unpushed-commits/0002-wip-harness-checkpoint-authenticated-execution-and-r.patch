+def _relevance(query: str, text: str) -> int:
+    from app.services.tools_execution.registry import ACTION_ALIASES
+
+    query, text = query.lower(), text.lower()
+    tokens = set(re.findall(r"[a-z0-9_]{3,}", query))
+    for phrase in re.findall(r"[\u4e00-\u9fff]+", query):
+        tokens.update(phrase[i : i + 2] for i in range(len(phrase) - 1))
+    tokens.update(action for alias, action in ACTION_ALIASES.items() if alias in query)
+    return sum(min(len(token), 8) for token in tokens if token in text)
+
+
+def _authorized_parameters(tool_id, action, schema, context):
+    from app.infrastructure.auth.agent_mod_scope import authorize_agent_tool
+
+    schema = deepcopy(schema)
+    entity = (schema.get("properties") or {}).get("entity")
+    if tool_id in {"business_db", "business_db_read", "business_db_write"} and isinstance(
+        entity, dict
+    ):
+        values = entity.get("enum") or []
+        allowed = [
+            value
+            for value in values
+            if authorize_agent_tool(tool_id, action, {"entity": value}, context) is None
+        ]
+        if not allowed:
+            return None
+        entity["enum"] = allowed
+    elif authorize_agent_tool(tool_id, action, {}, context) is not None:
+        return None
+    return schema
+
+
+def _authorized_catalog(candidates, context):
+    from app.application.agent_orchestrator.tool_spec import tool_spec_snapshot
+    from app.application.tools.registered_capabilities import (
+        ERP_CAPABILITY_TOOL_NAME,
+        TOOL_CATALOG_NAME,
+        registered_capability_catalog,
+    )
+    from app.infrastructure.auth.agent_mod_scope import validate_actor_context
+
+    if validate_actor_context(context):
+        return []
+    rows = []
+    with tool_spec_snapshot() as specs:
+
+        def add(name, spec, description, schema, constraint=None):
+            if spec is None:
+                return
+            parameters = _authorized_parameters(spec.tool_id, spec.action, schema, context)
+            if parameters is not None:
+                if constraint:
+                    parameters = {"allOf": [parameters, constraint]}
+                rows.append(
+                    {
+                        "name": name,
+                        "tool_id": spec.tool_id,
+                        "action": spec.action,
+                        "description": description,
+                        "parameters": parameters,
+                        "risk": spec.risk,
+                        "read_only": spec.read_only,
+                    }
+                )
+
+        for entry in candidates:
+            function = entry.get("function") or {}
+            name = str(function.get("name") or "")
+            if name == TOOL_CATALOG_NAME:
+                continue
+            if name == ERP_CAPABILITY_TOOL_NAME:
+                properties = (function.get("parameters") or {}).get("properties") or {}
+                tool_ids = (properties.get("tool_id") or {}).get("enum")
+                actions = (properties.get("action") or {}).get("enum")
+                for capability in registered_capability_catalog()["capabilities"]:
+                    if tool_ids is not None and capability["tool_id"] not in tool_ids:
+                        continue
+                    for action in capability["actions"]:
+                        if actions is not None and action not in actions:
+                            continue
+                        spec = specs.get((capability["tool_id"], action))
+                        if spec:
+                            add(
+                                name,
+                                spec,
+                                capability["description"],
+                                spec.input_schema,
+                                properties.get("params"),
+                            )
+            else:
+                add(
+                    name,
+                    specs.get((name, "execute")),
+                    str(function.get("description") or ""),
+                    function.get("parameters") or {},
+                )
+    return rows
+
+
+def query_tool_catalog(params: dict[str, Any], context: dict[str, Any]) -> dict[str, Any]:
+    from app.application.agent_orchestrator.context_window_manager import _estimate_prompt_tokens
+
+    base = _base_tool_specs()
+    scope = context.get("_employee_tool_names")
+    candidates = []
+    for name, entry in base.items():
+        if scope is not None and name not in scope:
+            continue
+        entry = deepcopy(entry)
+        schema = (context.get("_employee_tool_schemas") or {}).get(name)
+        if schema is not None:
+            entry["function"]["parameters"] = schema
+        candidates.append(entry)
+    rows = _authorized_catalog(candidates, context)
+    query = str(params.get("query") or "")
+    rows.sort(
+        key=lambda row: -_relevance(query, f"{row['tool_id']} {row['action']} {row['description']}")
+    )
+    offset, limit = int(params.get("offset", 0)), int(params.get("limit", 3))
+    selected = []
+    for row in rows[offset : offset + limit]:
+        row = {**row, "description": row["description"][:240]}
+        if (
