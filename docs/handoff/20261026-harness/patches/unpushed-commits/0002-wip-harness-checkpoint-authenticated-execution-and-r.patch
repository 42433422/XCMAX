+
+
+def select_employee_tools(task, candidates, context, messages, token_budget):
+    """Select authorized registered tools without exceeding the actual request budget."""
+    from app.application.agent_orchestrator.context_window_manager import _estimate_prompt_tokens
+    from app.application.tools.registered_capabilities import (
+        ERP_CAPABILITY_TOOL_NAME,
+        TOOL_CATALOG_NAME,
+        build_registered_capability_tool_definition,
+        build_tool_catalog_definition,
+    )
+    from app.infrastructure.auth.agent_mod_scope import validate_actor_context
+
+    if not candidates or validate_actor_context(context):
+        return []
+    query = task
+    for message in reversed(messages):
+        calls = message.get("tool_calls") or []
+        found = False
+        for call in calls:
+            fn = call.get("function") or {}
+            if fn.get("name") == TOOL_CATALOG_NAME:
+                from app.application.tools.workflow_tools.dispatch import parse_arguments
+
+                query = str(parse_arguments(fn.get("arguments") or "{}").get("query") or task)
+                found = True
+                break
+        if found:
+            break
+    rows = _authorized_catalog(candidates, context)
+    names = {row["name"] for row in rows}
+    ranked = []
+    for entry in candidates:
+        fn = entry.get("function") or {}
+        name = fn.get("name")
+        if name not in names:
+            continue
+        if name == ERP_CAPABILITY_TOOL_NAME:
+            entry = deepcopy(entry)
+            compact = build_registered_capability_tool_definition(
+                tool_ids=sorted({row["tool_id"] for row in rows if row["name"] == name})
+            )
+            entry["function"]["description"] = compact["function"]["description"]
+            entry["function"]["parameters"]["properties"]["tool_id"]["enum"] = compact["function"][
+                "parameters"
+            ]["properties"]["tool_id"]["enum"]
+        else:
+            entry = deepcopy(entry)
+            entry["function"]["parameters"] = next(
+                row["parameters"] for row in rows if row["name"] == name
+            )
+        score = max(
+            _relevance(query, f"{row['tool_id']} {row['action']} {row['description']}")
+            for row in rows
+            if row["name"] == name
+        )
+        if score or len(names) == 1:
+            ranked.append((score, entry))
+    ranked.sort(key=lambda pair: -pair[0])
+    selected = []
+    for entry in [build_tool_catalog_definition(), *[entry for _, entry in ranked]]:
+        projected = [
+            {"type": "function", "function": item["function"]} for item in [*selected, entry]
+        ]
+        if (
+            _estimate_prompt_tokens(
+                [
+                    *messages,
+                    {"role": "system", "content": json.dumps(projected, ensure_ascii=False)},
+                ]
+            )
+            <= token_budget
+        ):
+            selected.append(entry)
+    return selected
