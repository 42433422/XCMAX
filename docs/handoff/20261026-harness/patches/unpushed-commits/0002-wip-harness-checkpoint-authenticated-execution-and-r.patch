+def test_process_crash_after_business_commit_never_replays(action_db):
+    engine, factory = action_db
+    code = """
+import sys
+from sqlalchemy import create_engine, text
+from sqlalchemy.orm import sessionmaker
+from app.application.agent_orchestrator.business_action_ledger import BusinessActionLedger
+from app.application.agent_orchestrator.tool_spec import ToolActionSpecV2
+engine=create_engine(sys.argv[1])
+claim, receipt=BusinessActionLedger(sessionmaker(bind=engine)).claim(
+    ToolActionSpecV2("fixture","write"), {},
+    {"tenant_id":"7","user_id":"1","business_action_id":"crash","run_id":sys.argv[2]})
+if claim:
+    with engine.begin() as db: db.execute(text("INSERT INTO effects(value) VALUES ('committed')"))
+    import os; os._exit(23)
+assert receipt["outcome"]=="unknown" and receipt["retryable"] is False
+"""
+    workers = [
+        subprocess.Popen(
+            [sys.executable, "-c", code, str(engine.url), f"process-{index}"],
+            cwd=Path(__file__).resolve().parents[2],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+        )
+        for index in range(4)
+    ]
+    codes = []
+    for worker in workers:
+        _, stderr = worker.communicate(timeout=30)
+        assert worker.returncode in {0, 23}, stderr.decode()
+        codes.append(worker.returncode)
+    assert codes.count(23) == 1
+    restarted = subprocess.run(
+        [sys.executable, "-c", code, str(engine.url), "after-restart"], capture_output=True
+    )
+    assert restarted.returncode == 0, restarted.stderr.decode()
+    with engine.connect() as db:
+        assert db.execute(text("SELECT COUNT(*) FROM effects")).scalar_one() == 1
