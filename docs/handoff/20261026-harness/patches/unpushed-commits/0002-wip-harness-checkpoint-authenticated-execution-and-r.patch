+@pytest.mark.parametrize(
+    "tool,via_service", [("customers", False), ("customers", True), ("materials", False)]
+)
+def test_public_governed_writes_isolate_two_tenants_without_opening_legacy_reads(
+    runtime, trusted_actor, monkeypatch, tool, via_service
+):
+    from app.application.agent_orchestrator import AgentOrchestrator
+    from app.db.models.material import Material
+    from app.db.models.purchase_unit import PurchaseUnit
+    from app.fastapi_routes.domains.agent.routes import router as agent_router
+    from app.fastapi_routes.domains.customer.routes import router as customer_router
+    from app.fastapi_routes.materials import router as material_router
+    from app.infrastructure.tenant_scope import tenant_scope
+
+    actor, repo, queue = runtime
+    other = trusted_actor(tenant_id=actor.tenant_id + 1)
+    monkeypatch.setenv("XCAGI_ERP_CUSTOMERS_VIA_SERVICE", "1" if via_service else "0")
+    monkeypatch.setenv("XCAGI_DISABLE_ERP_CUSTOMERS_VIA_SERVICE", "0" if via_service else "1")
+    app = FastAPI()
+    app.include_router(agent_router)
+    app.include_router(customer_router if tool == "customers" else material_router)
+    path = "/customers" if tool == "customers" else "/api/materials"
+    model = PurchaseUnit if tool == "customers" else Material
+    name_column = "unit_name" if tool == "customers" else "name"
+
+    def approve(client, principal, response):
+        payload = response.json()
+        assert response.status_code in {200, 202}, response.text
+        assert payload["success"] is False and payload["pending_approval"] is True
+        run_id = payload["run_id"]
+        accepted = client.post(
+            f"/api/agent/runs/{run_id}/continue",
+            headers=principal.headers,
+            json={"approval_grant": payload["approval"]["grant"]},
+        )
+        assert accepted.status_code == 202, accepted.text
+        assert queue.claim("public-http", lease_seconds=30).run_id == run_id
+        return AgentOrchestrator().execute_dispatched_run(run_id)
+
+    ids = []
+    with TestClient(app) as client:
+        for index, principal in enumerate([actor, other]):
+            name = f"Tenant {index} entity"
+            body = {"name": name, "material_code": f"HTTP-{index}"}
+            completed = approve(
+                client, principal, client.post(path, headers=principal.headers, json=body)
+            )
+            assert completed.status == "completed", completed.steps[0].output
+            with tenant_scope(principal.tenant_id), principal.factory() as db:
+                row = (
+                    db.query(model)
+                    .filter_by(tenant_id=principal.tenant_id, **{name_column: name})
+                    .one()
+                )
+                ids.append(row.id)
+            assert repo.get(completed.run_id).metadata["runtime_context"]["tenant_id"] == str(
+                principal.tenant_id
+            )
+        changed = approve(
+            client,
+            actor,
+            client.put(
+                f"{path}/{ids[1]}", headers=actor.headers, json={"name": "Cross-tenant overwrite"}
+            ),
+        )
+        assert changed.status != "completed"
+        with tenant_scope(other.tenant_id), other.factory() as db:
+            assert (
+                getattr(db.query(model).filter_by(id=ids[1]).one(), name_column)
+                == "Tenant 1 entity"
+            )
+        # The bounded write migration does not open unreviewed legacy reads/imports.
+        assert client.get(path, headers=actor.headers).status_code == 403
+        if tool == "customers":
+            assert (
+                client.post(
+                    "/customers/import",
+                    headers=actor.headers,
+                    files={"file": ("contacts.csv", b"name\nX\n")},
+                ).status_code
+                == 403
+            )
