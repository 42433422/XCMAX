+def agent_node_output(run: Any, node_id: str) -> dict[str, Any]:
+    output = dict(
+        (getattr(run, "final_output", {}) or {}).get("node_outputs", {}).get(node_id) or {}
+    )
+    if not output:
+        step = next(
+            (item for item in (getattr(run, "steps", None) or []) if item.node_id == node_id), None
+        )
+        output = dict(step.output or {}) if step else {}
+    output.setdefault("success", run.status == "completed")
+    if run.status != "completed":
+        output["success"] = False
+        if run.error:
+            output.setdefault("message", run.error)
+    output["agent_status"] = run.status
+    if run.run_id:
+        output.update(run_id=run.run_id, agent_run_id=run.run_id)
+    if isinstance(output.get("data"), dict):
+        output["data"] = {**output["data"], "run_id": run.run_id, "agent_run_id": run.run_id}
+    from app.application.agent_orchestrator.run_models import AgentRun
+
+    approval = (
+        issue_approval_grant(run, principal_id=run.user_id) if isinstance(run, AgentRun) else None
+    )
+    if approval:
+        output.update(pending_approval=True, approval=approval)
+    return cast("dict[str, Any]", redact_internal_errors(output))
