+def ensure_tool_approval(step: AgentStep, spec: Any, context: dict[str, Any]) -> dict | None:
+    """Only a signed, durably consumed approval permits a mutating dispatch."""
+    if spec.read_only and spec.risk != "high":
+        return None
+    from app.application.agent_orchestrator.run_repository import get_agent_run_repository
+    from app.utils.operational_errors import RECOVERABLE_ERRORS
+
+    run = None
+    try:
+        repository = get_agent_run_repository()
+        run_id, step_id = str(context.get("run_id") or ""), str(context.get("step_id") or "")
+        candidate = repository.get(run_id) if run_id else None
+        if candidate is not None and (
+            candidate.user_id == str(context.get("user_id") or "")
+            and _scope_hash(candidate.metadata.get("runtime_context") or {}, candidate.user_id)
+            == _scope_hash(context, candidate.user_id)
+        ):
+            if candidate.status == "cancelled":
+                return {
+                    "success": False,
+                    "outcome": "cancelled",
+                    "retryable": False,
+                    "error_code": "tool_cancelled",
+                    "message": "任务已取消，未执行工具",
+                }
+            stored = next((item for item in candidate.steps if item.step_id == step_id), None)
+            if stored and (
+                stored.tool_id == step.tool_id
+                and stored.action == spec.action
+                and _params_hash(stored) == _params_hash(step)
+            ):
+                run = candidate
+                token = (run.metadata.get(_EVIDENCE_KEY) or {}).get(step_id, "")
+                try:
+                    claims = jwt.decode(
+                        token,
+                        _secret(),
+                        algorithms=[_ALGORITHM],
+                        audience=_AUDIENCE,
+                        issuer=_ISSUER,
+                        options={
+                            "verify_exp": False,
+                            "require": ["exp", "iat", "aud", "iss", "sub", "jti"],
+                        },
+                    )
+                    expected = _action_claims(run, stored, run.user_id)
+                    receipt = _consumed_evidence(repository, str(claims["jti"]))
+                    consumed_at = (
+                        datetime.fromisoformat(receipt["consumed_at"]).timestamp() if receipt else 0
+                    )
+                    if (
+                        all(str(claims.get(key) or "") == value for key, value in expected.items())
+                        and receipt
+                        and receipt["run_id"] == run_id
+                        and receipt["step_id"] == step_id
+                        and int(claims["iat"]) - 1 <= consumed_at <= int(claims["exp"])
+                    ):
+                        context["business_action_id"] = claims["business_action_id"]
+                        return None
+                except (jwt.PyJWTError, TypeError, ValueError, KeyError):
+                    pass
+                if stored.status != "waiting_user" or run.status != "waiting_user":
+                    stored.status, run.status = "waiting_user", "waiting_user"
+                    run.add_event(
+                        "step.waiting_user", "工具动作需要明确用户审批", {"step_id": step_id}
+                    )
+                    run = repository.save(run)
+        if run is None:
+            pending = AgentStep(
+                node_id=step.node_id,
+                tool_id=step.tool_id,
+                action=spec.action,
+                params=dict(step.params),
+                risk=spec.risk,
+                idempotent=spec.idempotent,
+                status="waiting_user",
+            )
+            run = AgentRun(
+                user_id=str(context["user_id"]),
+                message=str(context.get("message") or f"确认 {spec.tool_id}.{spec.action}"),
+                status="waiting_user",
+                steps=[pending],
+                metadata={"runtime_context": dict(context), "source": "tool_approval_required"},
+            )
+            run.add_event(
+                "step.waiting_user", "工具动作需要明确用户审批", {"step_id": pending.step_id}
+            )
+            run = repository.save(run)
+            step_id = pending.step_id
+        return {
+            "success": False,
+            "outcome": "waiting_approval",
+            "pending_approval": True,
+            "error_code": "tool_approval_required",
+            "message": "请在任务审批页面确认后继续执行",
+            "run_id": run.run_id,
+            "agent_run_id": run.run_id,
+            "step_id": step_id,
+            "retryable": False,
+        }
+    except RECOVERABLE_ERRORS:
+        logger.exception("tool approval evidence unavailable; dispatch refused")
+        return {
+            "success": False,
+            "outcome": "waiting_approval",
+            "pending_approval": True,
+            "error_code": "tool_approval_storage_unavailable",
+            "message": "审批凭证暂时不可核验，未执行工具",
+            "retryable": False,
+        }
+
