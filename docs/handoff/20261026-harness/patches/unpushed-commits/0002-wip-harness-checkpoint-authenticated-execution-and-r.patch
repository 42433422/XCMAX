+def test_real_http_approval_renews_only_same_actor_and_rejects_body_binding(
+    trusted_actor, monkeypatch, mod_id
+):
+    from fastapi import FastAPI
+    from fastapi.testclient import TestClient
+
+    from app.application.agent_orchestrator import InMemoryAgentRunRepository
+    from app.application.agent_orchestrator.approval_grant import issue_approval_grant
+    from app.application.agent_orchestrator.task_execution_repository import (
+        InMemoryTaskExecutionRepository,
+    )
+    from app.db.models.agent_approval import AgentApprovalConsumption
+    from app.fastapi_routes.domains.agent import routes
+
+    original = trusted_actor(mod_id=mod_id)
+    replacement = trusted_actor(user_id=original.user_id, mod_id=mod_id)
+    with original.factory.begin() as db:
+        db.get(UserSession, original.session_row_id).expires_at = utc_now_naive() - timedelta(
+            seconds=1
+        )
+    run = AgentRun(
+        user_id=str(original.user_id),
+        message="approve",
+        status="waiting_user",
+        steps=[
+            AgentStep(
+                node_id="write",
+                tool_id="customers",
+                action="create",
+                params={"unit_name": "pending"},
+                status="waiting_user",
+            )
+        ],
+    )
+    run.metadata["runtime_context"] = original.context
+    repository = InMemoryAgentRunRepository()
+    repository.save(run)
+    monkeypatch.setattr(
+        "app.application.agent_orchestrator.orchestrator.get_agent_run_repository",
+        lambda: repository,
+    )
+    monkeypatch.setattr(routes, "get_agent_run_repository", lambda: repository)
+    monkeypatch.setattr(
+        "app.fastapi_routes.domains.agent.route_support.get_task_execution_repository",
+        lambda: InMemoryTaskExecutionRepository(),
+    )
+    monkeypatch.setattr(routes, "_enqueue_run", lambda *args, **kwargs: None)
+    app = FastAPI()
+    app.include_router(routes.router)
+    client = TestClient(app)
+    grant = issue_approval_grant(run, principal_id=str(original.user_id))["grant"]
+    rejected = client.post(
+        f"/api/agent/runs/{run.run_id}/continue",
+        headers=replacement.headers,
+        json={
+            "approval_grant": grant,
+            "runtime_context": {
+                "_actor_authorization": replacement.context["_actor_authorization"]
+            },
+        },
+    )
+    assert rejected.status_code == 400
+    with original.factory() as db:
+        assert db.query(AgentApprovalConsumption).count() == 0
+    accepted = client.post(
+        f"/api/agent/runs/{run.run_id}/continue",
+        headers=replacement.headers,
+        json={"approval_grant": grant},
+    )
+    assert accepted.status_code == 202
+    renewed = repository.get(run.run_id).metadata["runtime_context"]
+    assert renewed["_actor_authorization"] == replacement.context["_actor_authorization"]
+    assert validate_actor_context(renewed) is None
+    assert "proof" not in accepted.text
+
