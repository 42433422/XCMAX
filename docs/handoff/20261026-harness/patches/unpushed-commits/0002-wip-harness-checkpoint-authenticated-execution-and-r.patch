diff --git a/FHD/app/application/agent_orchestrator/business_action_ledger.py b/FHD/app/application/agent_orchestrator/business_action_ledger.py
new file mode 100644
index 0000000000..592f0481b5
--- /dev/null
+++ b/FHD/app/application/agent_orchestrator/business_action_ledger.py
@@ -0,0 +1,249 @@
+"""Unique durable tool claims in the existing host task database."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import uuid
+from typing import Any
+
+from sqlalchemy.exc import IntegrityError
+
+from app.application.agent_orchestrator.run_models import utc_now_iso
+from app.application.agent_orchestrator.run_sql_repository import SQLAlchemyAgentRunRepository
+from app.db.models.agent import AgentBusinessActionRecord
+
+
+def canonical_hash(value: Any) -> str:
+    encoded = json.dumps(
+        value, sort_keys=True, ensure_ascii=False, separators=(",", ":"), allow_nan=False
+    )
+    return hashlib.sha256(encoded.encode()).hexdigest()
+
+
+def _action_identity(spec, params: dict, context: dict) -> tuple[str, str]:
+    mod = context.get("_mod_authorization") or {}
+    key = canonical_hash(
+        [
+            str(context.get("tenant_id") or ""),
+            str(mod.get("mod_id") or ""),
+            str(context.get("business_action_id") or "").strip(),
+        ]
+    )
+    fingerprint = canonical_hash(
+        [
+            str(context.get("user_id") or ""),
+            spec.owner_mod_id,
+            spec.tool_id,
+            spec.action,
+            spec.version,
+            params,
+        ]
+    )
+    return key, fingerprint
+
+
+def unknown_action(**evidence: Any) -> dict[str, Any]:
+    return {
+        "success": False,
+        "outcome": "unknown",
+        "error_code": "business_action_reconciliation_required",
+        "retryable": False,
+        "reconciliation_required": True,
+        "message": "原业务动作可能已提交，必须核对原回执；禁止再次执行",
+        "reconciliation_evidence": evidence,
+    }
+
+
+class BusinessActionLedger:
+    def __init__(self, session_factory=None):
+        # Production requires the real migration, never an ad hoc shadow database.
+        self._runs = SQLAlchemyAgentRunRepository(
+            session_factory=session_factory, auto_create=False
+        )
+
+    def claim(self, spec, params: dict, context: dict) -> tuple[dict[str, str] | None, dict | None]:
+        mod = context.get("_mod_authorization") or {}
+        identity = str(context.get("business_action_id") or "").strip()
+        if not identity or len(identity) > 256:
+            return None, {
+                "success": False,
+                "error_code": "business_action_id_required",
+                "retryable": False,
+                "message": "写工具需要稳定的 business_action_id，重试必须复用原动作身份",
+            }
+        tenant, user = str(context.get("tenant_id") or ""), str(context.get("user_id") or "")
+        mod_id = str(mod.get("mod_id") or "")
+        key, fingerprint = _action_identity(spec, params, context)
+        owner, now = uuid.uuid4().hex, utc_now_iso()
+        try:
+            with self._runs.transaction() as db:
+                db.add(
+                    AgentBusinessActionRecord(
+                        action_key=key,
+                        tenant_id=tenant,
+                        user_id=user,
+                        mod_id=mod_id,
+                        business_action_id=identity,
+                        tool_id=spec.tool_id,
+                        action=spec.action,
+                        fingerprint=fingerprint,
+                        owner=owner,
+                        run_id=str(context.get("run_id") or ""),
+                        state="claimed",
+                        receipt_json="{}",
+                        created_at=now,
+                        updated_at=now,
+                    )
+                )
+                db.flush()
+        except IntegrityError:
+            with self._runs.transaction(read_only=True) as db:
+                existing = db.get(AgentBusinessActionRecord, key)
+                if existing is None:
+                    raise
+                if existing.fingerprint != fingerprint or existing.user_id != user:
+                    return None, {
+                        "success": False,
+                        "error_code": "business_action_conflict",
+                        "retryable": False,
+                        "message": "业务动作身份已绑定其他操作者、参数或工具版本",
+                    }
+                receipt = json.loads(existing.receipt_json)
+                if existing.state in {"completed", "pending", "waiting_approval"}:
+                    return None, {
+                        **receipt,
+                        "business_action_replayed": True,
+                        "business_action_id": identity,
+                    }
+                return None, unknown_action(
+                    action_key=key,
+                    business_action_id=identity,
+                    original_run_id=existing.run_id,
+                    receipt=receipt,
+                )
+        return {"action_key": key, "owner": owner, "business_action_id": identity}, None
+
+    def record_receipt(self, claim: dict[str, str], result: dict) -> None:
+        """Persist the dispatch receipt before an independent readback can fail."""
+        with self._runs.transaction() as db:
+            updated = (
+                db.query(AgentBusinessActionRecord)
+                .filter_by(action_key=claim["action_key"], owner=claim["owner"], state="claimed")
+                .update(
+                    {
+                        "receipt_json": json.dumps(result, ensure_ascii=False, allow_nan=False),
+                        "updated_at": utc_now_iso(),
+                    },
+                    synchronize_session=False,
+                )
+            )
+            if updated != 1:
+                raise RuntimeError("business action receipt owner changed")
+
+    def finish(self, claim: dict[str, str], result: dict, *, verified: bool) -> dict:
+        from app.application.agent_orchestrator.tool_receipt import tool_receipt_outcome
+
+        outcome = tool_receipt_outcome(result)
+        complete = verified and outcome == "success"
+        waiting = outcome in {"pending", "waiting_approval"}
+        with self._runs.transaction(read_only=True) as db:
+            record = db.get(AgentBusinessActionRecord, claim["action_key"])
+            original = json.loads(record.receipt_json) if record is not None else {}
+        receipt = (
+            result
+            if complete
+            else (
+                {**result, "success": False, "outcome": outcome, "retryable": False}
+                if waiting
+                else unknown_action(
+                    receipt=original or result,
+                    verification_receipt=result,
+                    business_action_id=claim["business_action_id"],
+                )
+            )
+        )
+        receipt = {**receipt, "business_action_id": claim["business_action_id"]}
+        if not complete and not waiting and result.get("error_code"):
