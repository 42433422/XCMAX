+def start_registered_http_action(
+    *,
+    request: Any,
+    tool_id: str,
+    action: str,
+    params: dict[str, Any],
+    source: str,
+    route_path: str,
+    node_id: str | None = None,
+    message: str = "",
+    context: dict[str, Any] | None = None,
+    runtime: Any = None,
+    intent: str | None = None,
+) -> tuple[Any, str]:
+    """Bind an HTTP action to its real session; approval stays in the Agent API."""
+    from fastapi import HTTPException
+
+    from app.application.agent_orchestrator.tool_spec import get_tool_action_spec
+    from app.application.workflow.workflow_types import PlanGraph, WorkflowNode
+    from app.infrastructure.auth.agent_mod_scope import authorize_agent_tool
+
+    trusted = request_runtime_context(
+        request,
+        {
+            **dict(context or {}),
+            "source": source,
+            "route": route_path,
+            "request_path": str(request.url.path),
+        },
+    )
+    spec = get_tool_action_spec(tool_id, action)
+    if spec is None:
+        raise HTTPException(status_code=400, detail=f"未注册的工具动作: {tool_id}.{action}")
+    for key in ("user_id", "actor_id", "tenant_id"):
+        if (
+            key in params
+            and str(params[key]) != str(trusted.get(key) or "")
+            and not (tool_id == "dataset_rag" and key == "tenant_id")
+        ):
+            raise HTTPException(status_code=403, detail={"code": "TOOL_SCOPE_MISMATCH"})
+    if {"_runtime_context", "_actor_authorization", "_mod_authorization"}.intersection(params):
+        raise HTTPException(status_code=403, detail={"code": "TOOL_SCOPE_MISMATCH"})
+    denied = authorize_agent_tool(tool_id, spec.action, params, trusted)
+    if denied:
+        raise HTTPException(status_code=403, detail=denied)
+    node_id = node_id or f"{tool_id}_{spec.action}"
+    plan = PlanGraph(
+        plan_id=intent or node_id,
+        intent=intent or node_id,
+        risk_level=spec.risk,
+        todo_steps=[f"执行 {tool_id}.{spec.action}"],
+        nodes=[
+            WorkflowNode(
+                node_id=node_id,
+                tool_id=tool_id,
+                action=spec.action,
+                params=dict(params),
+                risk=spec.risk,
+                idempotent=spec.idempotent,
+            )
+        ],
+        metadata={"source": source, "route": route_path},
+    )
+    run = (runtime or AgentOrchestrator()).start_run_from_plan(
+        user_id=trusted["user_id"],
+        message=message or f"{tool_id}.{spec.action}",
+        plan=plan,
+        runtime_context=trusted,
+    )
+    return run, node_id
+
