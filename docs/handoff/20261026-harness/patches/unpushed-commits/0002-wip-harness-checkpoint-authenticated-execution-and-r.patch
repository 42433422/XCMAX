+def test_concurrent_employee_requests_enter_body_once_after_database_claim(
+    employee_mods_root, monkeypatch, trusted_actor
+):
+    import threading
+    from concurrent.futures import ThreadPoolExecutor
+    from unittest.mock import Mock
+
+    from app.application.agent_orchestrator.run_repository import SQLAlchemyAgentRunRepository
+    from app.application.agent_orchestrator.tool_spec import get_tool_action_spec
+    from app.application.agent_orchestrator.trace_model_usage import ModelUsageRecorder
+    from app.application.agent_orchestrator.trace_recording import TraceRecorder
+    from app.application.agent_orchestrator.trace_runs import TraceRunService
+    from app.application.employee_runtime.agent import EmployeeAgent
+
+    pack_id = "csv-full-read-employee"
+    _write_csv_read_pack(employee_mods_root, pack_id)
+    actor = trusted_actor(mod_id=pack_id)
+    repository = SQLAlchemyAgentRunRepository(session_factory=actor.factory)
+    service = TraceRunService(
+        repository,
+        TraceRecorder(ModelUsageRecorder(Mock(), Mock()), Mock(), get_tool_action_spec),
+        Mock(),
+    )
+    monkeypatch.setattr(
+        "app.application.agent_orchestrator.chat_trace._run_service", lambda: service
+    )
+    barrier = threading.Barrier(2)
+    claim = repository.claim_first_task_run
+
+    def simultaneous_claim(run):
+        barrier.wait(timeout=10)
+        return claim(run)
+
+    monkeypatch.setattr(repository, "claim_first_task_run", simultaneous_claim)
+    body = Mock(return_value={"success": False, "message": "test callback reached"})
+    monkeypatch.setattr(EmployeeAgent, "_run_authenticated", body)
+    context = {**actor.context, "task_id": "one-concurrent-task"}
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        results = list(
+            pool.map(
+                lambda _: EmployeeAgent(pack_id).run("same", runtime_context=context), range(2)
+            )
+        )
+    assert len({result["run_id"] for result in results}) == 1
+    assert (
+        len(repository.list_task_runs(user_id=str(actor.user_id), task_id=context["task_id"])) == 1
+    )
+    body.assert_called_once()
+
