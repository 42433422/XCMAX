+def test_excel_trace_uses_session_owner_and_anonymous_never_calls_parser(runtime, monkeypatch):
+    from unittest.mock import Mock
+
+    from app.fastapi_routes.domains.excel.routes import router
+
+    actor, repo, _ = runtime
+    parser = Mock()
+    parser.parse_single.return_value = {"success": True, "data": {"product": "example"}}
+    monkeypatch.setattr(
+        "app.application.facades.excel_facade.get_ai_product_parser", lambda: parser
+    )
+    app = FastAPI()
+    app.include_router(router)
+    with TestClient(app) as client:
+        assert client.post("/api/ai/parse-single", json={"text": "one"}).status_code == 401
+        parser.parse_single.assert_not_called()
+        response = client.post(
+            "/api/ai/parse-single", headers=actor.headers, json={"text": "one", "user_id": "forged"}
+        )
+    assert response.status_code == 200, response.text
+    run = repo.get(response.json()["run_id"])
+    assert run.user_id == str(actor.user_id)
+    assert (
+        run.metadata["runtime_context"]["_actor_authorization"]
+        == actor.context["_actor_authorization"]
+    )
+    assert "_actor_authorization" not in response.text
+
