+def test_first_task_claim_arbitrates_processes_and_survives_winner_crash(tmp_path):
+    engine = create_engine(f"sqlite:///{tmp_path / 'task-claim.db'}")
+    factory = sessionmaker(bind=engine)
+    repository = SQLAlchemyAgentRunRepository(session_factory=factory)
+    repository._ensure_schema()
+    with engine.begin() as db:
+        db.execute(text("CREATE TABLE task_effects (id INTEGER PRIMARY KEY, quantity INTEGER)"))
+    program = r"""
+import json, logging, os, sys
+logging.disable(logging.CRITICAL)
+from sqlalchemy import create_engine, text
+from sqlalchemy.orm import sessionmaker
+from app.application.agent_orchestrator.run_sql_repository import SQLAlchemyAgentRunRepository
+from app.application.agent_orchestrator.trace_runs import TraceRunService
+engine=create_engine(sys.argv[1], connect_args={"timeout":20})
+repository=SQLAlchemyAgentRunRepository(session_factory=sessionmaker(bind=engine),auto_create=False)
+run,claimed=TraceRunService(repository,None,None).claim_employee_run(
+    message="stock in 10", runtime_context={"task_id":"one-task","user_id":"actor","tenant_id":"7"},
+    employee_id="employee",fingerprint="original-content",response_kind="business_action")
+if claimed:
+    with engine.begin() as db: db.execute(text("INSERT INTO task_effects(quantity) VALUES (10)"))
+print(json.dumps({"claimed":claimed,"run_id":run.run_id,
+                  "fingerprint":run.metadata["employee_request_fingerprint"]}),flush=True)
+if claimed: os._exit(23)
+"""
+    try:
+        workers = [
+            subprocess.Popen(
+                [sys.executable, "-c", program, str(engine.url)],
+                cwd=Path(__file__).resolve().parents[2],
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+            )
+            for _ in range(4)
+        ]
+        receipts = []
+        for worker in workers:
+            output, error = worker.communicate(timeout=30)
+            assert worker.returncode in {0, 23}, error.decode()
+            receipts.append(json.loads(output))
+        assert sum(item["claimed"] for item in receipts) == 1
+        assert len({item["run_id"] for item in receipts}) == 1
+        restarted = subprocess.run(
+            [sys.executable, "-c", program, str(engine.url)],
+            capture_output=True,
+            timeout=30,
+        )
+        assert restarted.returncode == 0, restarted.stderr.decode()
+        assert json.loads(restarted.stdout)["claimed"] is False
+        with engine.connect() as db:
+            assert db.execute(text("SELECT SUM(quantity) FROM task_effects")).scalar_one() == 10
+            assert db.execute(text("SELECT COUNT(*) FROM agent_runs")).scalar_one() == 1
+            assert db.execute(text("SELECT run_count FROM agent_tasks")).scalar_one() == 1
+    finally:
+        engine.dispose()
+
+
