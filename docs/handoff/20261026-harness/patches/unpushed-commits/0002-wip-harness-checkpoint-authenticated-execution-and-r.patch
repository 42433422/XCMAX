+        """Read back the original saved result; never dispatch a replacement write."""
+        from app.application.agent_orchestrator.business_action_verification import (
+            verify_action_result,
+        )
+        from app.infrastructure.auth.agent_mod_scope import (
+            agent_mod_execution_scope,
+            authorize_agent_tool,
+        )
+        from app.infrastructure.tenant_scope import tenant_scope
