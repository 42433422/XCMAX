diff --git a/FHD/tests/test_dev/test_capability_center_code_date.py b/FHD/tests/test_dev/test_capability_center_code_date.py
index b0ba80f9ff..26b3cc0dca 100644
--- a/FHD/tests/test_dev/test_capability_center_code_date.py
+++ b/FHD/tests/test_dev/test_capability_center_code_date.py
@@ -18,6 +18,23 @@ MODULE = importlib.util.module_from_spec(SPEC)
 SPEC.loader.exec_module(MODULE)
 
 
+def test_runtime_cache_and_untracked_files_do_not_establish_source(tmp_path, monkeypatch):
+    subprocess.run(["git", "init", "-q", str(tmp_path)], check=True)
+    monkeypatch.setattr(MODULE, "REPO_ROOT", tmp_path)
+    monkeypatch.setattr(MODULE, "e", lambda rel: tmp_path / rel)
+    cache = tmp_path / "legacy/__pycache__"
+    cache.mkdir(parents=True)
+    (cache / "retired.pyc").write_bytes(b"runtime-cache")
+    assert not MODULE.path_exists("legacy")
+    source = tmp_path / "legacy/source.py"
+    source.write_text("pass\n", encoding="utf-8")
+    assert not MODULE.path_exists("legacy")
+    subprocess.run(["git", "-C", str(tmp_path), "add", "legacy/source.py"], check=True)
+    assert MODULE.path_exists("legacy")
+    source.unlink()
+    assert not MODULE.path_exists("legacy")
+
+
 @pytest.mark.parametrize(
     "commit_time, expected",
     [
