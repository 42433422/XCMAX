+    # Directories require tracked source; runtime caches cannot establish an impl.
+    # Media may be archive-only
     # (MANIFEST-verified, blob not mounted) and still count as present so CI
     # --check matches a fully materialized tree.
     if not rel or urlsplit(rel).scheme:
@@ -190,7 +191,17 @@ def path_exists(rel: str) -> bool:
         path = e(rel)
     except ValueError:
         return False
-    if path.exists():
+    if path.is_dir():
+        tracked = git("ls-files", "-z", "--", rel, cwd=REPO_ROOT)
+        if tracked is None:
+            raise RuntimeError(f"Cannot verify source directory: {rel}")
+        return any(
+            (REPO_ROOT / name).is_file()
+            and "__pycache__" not in Path(name).parts
+            and Path(name).suffix not in {".pyc", ".pyo"}
+            for name in tracked.split("\0") if name
+        )
+    if path.is_file():
         return True
     return evidence_state(rel)["exists"]
 
