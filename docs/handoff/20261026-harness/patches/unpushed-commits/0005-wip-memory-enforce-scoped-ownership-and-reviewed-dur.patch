index 89293d4c3c..7f65039c13 100644
--- a/FHD/app/application/agent_orchestrator/business_action_verification.py
+++ b/FHD/app/application/agent_orchestrator/business_action_verification.py
@@ -2,6 +2,7 @@
 
 from __future__ import annotations
 
+import json
 from decimal import Decimal
 
 from app.application.agent_orchestrator.tool_receipt import tool_receipt_outcome
@@ -13,6 +14,8 @@ def verify_action_result(
 ) -> tuple[dict, bool]:
     if tool_receipt_outcome(result) != "success":
         return result, False
+    if spec.tool_id == "memory_v2":
+        return _verify_memory_v2(spec.action, params, result, runtime_context or {})
     if result.get("source") == f"employee_pack:{spec.tool_id}" and isinstance(
         result.get("output"), dict
     ):
@@ -217,3 +220,79 @@ def verify_action_result(
         return {**result, "business_verification": evidence}, bool(evidence["verified"])
     except RECOVERABLE_ERRORS:
         return result, False
+
+
+def _verify_memory_v2(action, params, result, context):
+    """Reopen the persisted owner snapshot; a handler's success alone is insufficient."""
+    from app.application.memory_v2_facade import get_user_memory_service, memory_v2_owner_id
+
+    returned = result.get("candidate" if action == "propose_candidate" else "memory")
+    returned = returned if isinstance(returned, dict) else {}
+    record_id = str(returned.get("memory_id") or "")
+    try:
+        owner = memory_v2_owner_id(context)
+        service = get_user_memory_service()
+        if service._store._backend is None:
+            return {**result, "business_verification": {"verified": False}}, False
+        record = next(
+            (row for row in service.list_memories(owner) if row.get("memory_id") == record_id),
+            None,
+        )
+
+        def same(left, right):
+            return json.dumps(left, sort_keys=True, ensure_ascii=False) == json.dumps(
+                right, sort_keys=True, ensure_ascii=False
+            )
+
+        verified = bool(record_id and record and same(returned, record))
+        if action == "propose_candidate":
+            verified = (
+                verified
+                and all(
+                    same(record.get(key), params.get(key))
+                    for key in ("memory_type", "key", "value")
+                )
+                and record.get("status")
+                in (
+                    {"pending", "rejected"}
+                    if result.get("created")
+                    else {"pending", "active", "rejected"}
+                )
+            )
+        else:
+            verified = verified and record_id == params.get("memory_id")
+            expected = {"confirm": "active", "reject": "rejected", "delete": "deleted"}.get(action)
+            if expected:
+                verified = verified and record.get("status") == expected
+            if action == "confirm":
+                verified = (
+                    verified
+                    and record.get("source_policy") != "blocked"
+                    and record.get("eligible_for_planner") is not False
+                )
+            patch = (
+                params.get("correction") or {}
+                if action == "confirm"
+                else params
+                if action == "correct"
+                else {}
+            )
+            verified = verified and all(
+                same(record.get(key), value)
+                for key, value in patch.items()
+                if key in {"memory_type", "key", "value"}
+                and (action != "correct" or value is not None)
+            )
+            if params.get("reason"):
+                reason_key = {
+                    "reject": "rejected_reason",
+                    "delete": "deleted_reason",
+                    "correct": "last_correction_reason",
+                }.get(action)
+                verified = (
+                    verified and bool(reason_key) and record.get(reason_key) == params["reason"]
+                )
+        evidence = {"verified": bool(verified), "memory_id": record_id, "owner_id": owner}
+    except (ValueError, *RECOVERABLE_ERRORS):
+        evidence = {"verified": False, "memory_id": record_id}
+    return {**result, "business_verification": evidence}, evidence["verified"]
