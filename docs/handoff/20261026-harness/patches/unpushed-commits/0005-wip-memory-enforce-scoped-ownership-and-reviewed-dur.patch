+    expect(memory.memoryV2Error.value).toContain('缺少可核对')
+    expect(memory.memoryV2Draft.key).toBe('language')
+    expect(mocks.list).not.toHaveBeenCalled()
+  })
+
+  it('rejects a fresh grant when persisted step parameters differ from the review', async () => {
+    const { memory } = setup()
+    await memory.createMemoryV2Candidate()
