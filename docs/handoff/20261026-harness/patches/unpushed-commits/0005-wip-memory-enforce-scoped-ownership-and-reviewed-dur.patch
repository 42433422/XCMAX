+  return {
+    success: true,
+    data: {
+      run_id: 'memory-run',
+      user_id: '1',
+      message: '记忆变更',
+      status,
+      steps: [
+        {
+          step_id: 'step-1',
+          node_id: 'memory',
+          tool_id: 'memory_v2',
+          action: 'propose_candidate',
+          params: { key: 'language', value: '中文' },
+          risk: 'medium',
+          status: verified ? 'completed' : 'waiting_user',
+          output: verified ? { success: true, business_verification: { verified: true } } : {},
+        },
+      ],
+    },
+    approval: {
+      grant: 'fresh-grant',
+      run_id: 'memory-run',
+      step_id: 'step-1',
+      tool_id: 'memory_v2',
+      action: 'propose_candidate',
+      expires_at: 9999999999,
+    },
+  }
+}
+
+let scopes: EffectScope[] = []
+function setup() {
+  const account = ref<User | null>(user())
+  const scope = effectScope()
+  scopes.push(scope)
+  const memory = scope.run(() => useSettingsMemory(account))!
+  memory.memoryV2Draft.key = 'language'
+  memory.memoryV2Draft.value = '中文'
+  return { memory, account }
+}
+
+beforeEach(() => {
+  vi.resetAllMocks()
+  mods.activeModId = 'mod-a'
+  mocks.list.mockResolvedValue({ success: true, memories: [] })
+  mocks.summary.mockResolvedValue({ success: true, summary: { total: 0, by_status: {}, by_type: {} } })
+  mocks.createCandidate.mockResolvedValue({ success: false, pending_approval: true, run_id: 'memory-run', agent_status: 'waiting_user' })
+  mocks.getRun.mockResolvedValue(snapshot())
+  mocks.review.mockResolvedValue(false)
+})
+afterEach(() => {
+  scopes.forEach((scope) => scope.stop())
+  scopes = []
+  vi.useRealTimers()
+})
+
+describe('settings memory durable approvals', () => {
+  it('keeps 202 writes pending and reads self without default/user/chat owner selectors', async () => {
+    const { memory } = setup()
+    await memory.loadMemoryV2()
+    expect(mocks.list).toHaveBeenCalledWith({ status: undefined, memoryType: undefined })
+    expect(mocks.summary).toHaveBeenCalledWith()
