+"""Shared schema templates retain action contracts and independent mutable state."""
+
+from __future__ import annotations
+
+import pytest
+
+from app.application.agent_orchestrator.tool_spec import (
+    get_tool_action_spec,
+    tool_spec_snapshot,
+    validate_tool_call,
+    validate_tool_result,
+)
+from app.application.agent_orchestrator.tool_spec_data import (
+    _SPECIAL_INPUT_SCHEMAS,
+    _SPECIAL_OUTPUT_SCHEMAS,
+)
+
+
+def _mutable_ids(value):
+    if isinstance(value, dict):
+        return {id(value)}.union(*(_mutable_ids(item) for item in value.values()))
+    if isinstance(value, list):
+        return {id(value)}.union(*(_mutable_ids(item) for item in value))
+    return set()
+
+
+def test_action_templates_and_built_specs_are_independent():
+    with tool_spec_snapshot():
+        for attribute, templates in (
+            ("input_schema", _SPECIAL_INPUT_SCHEMAS),
+            ("output_schema", _SPECIAL_OUTPUT_SCHEMAS),
+        ):
+            template_ids, built_ids = set(), set()
+            for key, template in templates.items():
+                spec = get_tool_action_spec(*key)
+                assert spec is not None, key
+                actual = getattr(spec, attribute)
+                assert actual == template, key
+                source_ids, actual_ids = _mutable_ids(template), _mutable_ids(actual)
+                assert not source_ids.intersection(template_ids), key
+                assert not actual_ids.intersection(built_ids | source_ids), key
+                template_ids.update(source_ids)
+                built_ids.update(actual_ids)
+
+
+@pytest.mark.parametrize(
+    "tool,action,payload,valid",
+    [
+        ("business_db", "read", {"entity": "customers"}, True),
+        ("business_db", "read", {"entity": "sessions"}, False),
+        ("sales", "quote", {"customer_name": "Acme", "items": [{"quantity": 1}]}, False),
+        ("ocr", "recognize_and_extract", {}, False),
+        ("excel_analyzer", "preview", {"file_path": "input.xlsx", "output_json": None}, False),
+        ("label_template_generator", "preview", {"image_path": "label.png"}, True),
+        (
+            "label_template_generator",
+            "preview",
+            {"image_path": "label.png", "output_file": "out.py"},
+            False,
+        ),
+    ],
+)
+def test_shared_input_contracts_keep_strict_constraints(tool, action, payload, valid):
+    assert validate_tool_call(tool, action, payload).ok is valid
+
+
+def test_output_variants_keep_their_own_required_fields_and_types():
+    with tool_spec_snapshot():
+        query = get_tool_action_spec("excel_analysis", "query")
+        assert "message" not in query.output_schema["properties"]
+        assert not validate_tool_result("employee", "execute", {"success": True}).ok
+        assert not validate_tool_result("business_db", "read", {"success": True, "data": {}}).ok
+        assert validate_tool_result("business_db", "read", {"success": True, "data": []}).ok
