+    mocks.getRun.mockResolvedValueOnce(snapshot()).mockResolvedValueOnce(changed)
+    await memory.approveMemoryV2Operation()
+    expect(memory.memoryV2Error.value).toContain('任务内容已变化')
+    expect(mocks.continueRun).not.toHaveBeenCalled()
+  })
+
+  it.each(['account', 'mod', 'epoch'])('invalidates review before consuming its grant on %s change', async (change) => {
+    const { memory, account } = setup()
+    await memory.createMemoryV2Candidate()
+    let confirm!: (value: boolean) => void
+    mocks.review.mockImplementation(
+      () =>
+        new Promise<boolean>((resolve) => {
+          confirm = resolve
+        }),
+    )
+    const approving = memory.approveMemoryV2Operation()
+    await flushPromises()
+    if (change === 'account') {
+      account.value = { ...user(), id: 2 }
+      account.value = user()
+    } else if (change === 'mod') {
+      mods.activeModId = 'mod-b'
+      mods.activeModId = 'mod-a'
