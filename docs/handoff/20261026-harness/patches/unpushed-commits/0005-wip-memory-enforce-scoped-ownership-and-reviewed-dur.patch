+    expect(mocks.list).toHaveBeenCalledTimes(1)
+    expect(mocks.review).not.toHaveBeenCalled()
+    expect(mocks.continueRun).not.toHaveBeenCalled()
+  })
+
+  it('shows the existing review dialog and never consumes a grant after cancel', async () => {
+    const { memory } = setup()
+    await memory.createMemoryV2Candidate()
+    await memory.approveMemoryV2Operation()
+    expect(mocks.review).toHaveBeenCalledWith(expect.stringContaining('language'), expect.objectContaining({ confirmText: '审批并执行' }))
+    expect(mocks.continueRun).not.toHaveBeenCalled()
+  })
+
+  it('only refreshes and clears the draft after explicit review, execution and verified readback', async () => {
+    vi.useFakeTimers()
+    const { memory } = setup()
+    await memory.createMemoryV2Candidate()
+    mocks.review.mockResolvedValue(true)
+    const queued = snapshot('queued')
+    mocks.continueRun.mockResolvedValue(queued)
+    mocks.getRun.mockResolvedValueOnce(snapshot()).mockResolvedValueOnce(snapshot()).mockResolvedValue(queued)
+    await memory.approveMemoryV2Operation()
+    expect(mocks.continueRun).toHaveBeenCalledWith('memory-run', { approval_grant: 'fresh-grant' })
+    expect(memory.memoryV2Draft.key).toBe('language')
+    expect(mocks.list).not.toHaveBeenCalled()
+    mocks.getRun.mockResolvedValue(snapshot('completed', true))
+    await vi.advanceTimersByTimeAsync(1500)
+    expect(memory.memoryV2Draft.key).toBe('')
+    expect(memory.memoryV2RunId.value).toBe('')
+    expect(mocks.list).toHaveBeenCalledTimes(1)
+    expect(memory.memoryV2OperationStatus.value).toContain('通过读回核验')
+  })
+
+  it.each(['unknown', 'waiting_approval', 'accepted'])(
+    'never treats a conflicting second step %s as verified completion',
+    async (signal) => {
+      const run = snapshot('completed', true)
+      run.data!.steps!.push({
+        ...run.data!.steps![0],
+        step_id: 'step-2',
+        output: {
+          success: true,
+          business_verification: { verified: true },
+          ...(signal === 'waiting_approval' ? { requires_token: true } : { outcome: signal }),
+        },
+      })
+      mocks.getRun.mockResolvedValue(run)
+      const { memory } = setup()
+      await memory.createMemoryV2Candidate()
+      expect(memory.memoryV2Draft.key).toBe('language')
+      expect(memory.memoryV2CanApprove.value).toBe(false)
+      expect(memory.memoryV2OperationStatus.value).toContain('尚未核验')
+      expect(mocks.list).not.toHaveBeenCalled()
+      expect(mocks.continueRun).not.toHaveBeenCalled()
+    },
+  )
+
+  it.each(['confirm', 'reject', 'correct', 'delete'])(
+    'waits for %s approval and readback before refreshing self records',
+    async (action) => {
+      const pending = snapshot()
+      pending.data!.steps![0].action = action
+      pending.approval!.action = action
+      mocks.getRun.mockResolvedValue(pending)
+      const completed = snapshot('completed', true)
+      completed.data!.steps![0].action = action
+      mocks.continueRun.mockResolvedValue(completed)
+      const record: MemoryV2Record = {
+        memory_id: 'memory-1',
+        memory_type: 'preference',
+        key: 'language',
+        value: '中文',
+        status: 'active',
+      }
+      const { memory } = setup()
+      mocks[action === 'delete' ? 'remove' : action].mockResolvedValue({
+        success: false,
+        run_id: 'memory-run',
+        pending_approval: true,
+      })
+      memory.startMemoryV2Edit(record)
+      memory.memoryV2Edit.value = 'English'
+      if (action === 'confirm') await memory.confirmMemoryV2(record)
+      else if (action === 'reject') await memory.rejectMemoryV2(record)
+      else if (action === 'correct') await memory.saveMemoryV2Edit(record)
+      else await memory.deleteMemoryV2(record)
+      expect(mocks.list).not.toHaveBeenCalled()
+      expect(mocks.continueRun).not.toHaveBeenCalled()
+      expect(memory.memoryV2Edit.memoryId).toBe('memory-1')
+      mocks.review.mockResolvedValue(true)
+      await memory.approveMemoryV2Operation()
+      expect(mocks.continueRun).toHaveBeenCalledOnce()
+      expect(mocks.list).toHaveBeenCalledOnce()
+      expect(memory.memoryV2OperationStatus.value).toContain('通过读回核验')
+      if (action === 'correct' || action === 'delete') {
+        expect(memory.memoryV2Edit.memoryId).toBe('')
+      }
+    },
+  )
+
+  it('requires independent proof from every expected action', async () => {
+    const run = snapshot('completed', true)
+    run.data!.steps!.push({ ...run.data!.steps![0], step_id: 'step-2', output: { success: true } })
+    mocks.getRun.mockResolvedValue(run)
+    const { memory } = setup()
+    await memory.createMemoryV2Candidate()
+    expect(memory.memoryV2Draft.key).toBe('language')
+    expect(memory.memoryV2OperationStatus.value).toContain('尚未核验')
+    expect(mocks.list).not.toHaveBeenCalled()
+  })
+
+  it('rejects a verified receipt for a different memory action', async () => {
+    const run = snapshot('completed', true)
+    run.data!.steps![0].action = 'delete'
+    mocks.getRun.mockResolvedValue(run)
+    const { memory } = setup()
+    await memory.createMemoryV2Candidate()
+    expect(memory.memoryV2Draft.key).toBe('language')
+    expect(memory.memoryV2Error.value).toContain('任务记录无效')
+    expect(mocks.list).not.toHaveBeenCalled()
+  })
+
+  it('does not trust success without any durable run or verifier', async () => {
