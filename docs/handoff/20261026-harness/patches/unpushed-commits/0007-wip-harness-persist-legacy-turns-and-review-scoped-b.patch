+# Adapter-only tests retain storage and normalization branches. Actual session,
+# grant, queue, spawn and SQL evidence live in test_product_compat_boundaries.
+_PRODUCT_WRITES = [
+    ("create", "products_add", "products_pg_insert_row", {"name": "New"}),
+    ("update", "products_update", "products_pg_update_row", {"id": 1, "name": "Updated"}),
+    ("delete", "products_delete", "products_pg_delete_row", {"id": 1}),
+    ("batch_delete", "products_batch_delete", "products_pg_batch_delete_rows", {"ids": [1, 2]}),
+]
+
+
+@pytest.mark.parametrize("action,service_method,storage_method,payload", _PRODUCT_WRITES)
+def test_product_adapter_calls_the_service_with_normalized_fields(
+    action, service_method, storage_method, payload
+):
+    from app.legacy.routes.product import compat_routes as routes
+
+    expected = (
+        {**payload, "product_name": "New", "name_or_model": "New", "unit_name": "个"}
+        if action == "create"
+        else payload
+    )
+    with (
+        patch(
+            "app.mod_sdk.erp_products_facade.is_erp_products_via_service_enabled", return_value=True
+        ),
+        patch(
+            f"app.mod_sdk.erp_products_facade.{service_method}", return_value={"success": True}
+        ) as service,
+        patch(f"app.legacy.routes.product.compat_routes.{storage_method}") as storage,
+    ):
+        result = routes._execute_products_compat_action(action, payload)
+    assert result["success"] is True
+    service.assert_called_once_with(None, expected)
+    storage.assert_not_called()
+
+
+@pytest.mark.parametrize("action,service_method,storage_method,payload", _PRODUCT_WRITES)
+def test_product_adapter_preserves_raw_storage_success_receipts(
+    action, service_method, storage_method, payload
+):
+    from app.legacy.routes.product import compat_routes as routes
+
+    stored = 10 if action == "create" else (2, 0) if action == "batch_delete" else None
+    with (
+        patch(
+            "app.mod_sdk.erp_products_facade.is_erp_products_via_service_enabled",
+            return_value=False,
+        ),
+        patch(
+            f"app.legacy.routes.product.compat_routes.{storage_method}", return_value=stored
+        ) as storage,
+    ):
+        result = routes._execute_products_compat_action(action, payload)
+    assert result["success"] is True and routes._products_compat_status_code(result) == 200
+    storage.assert_called_once()
+    if action == "create":
+        assert result["data"]["id"] == 10
+        assert storage.call_args.args[0] == {
+            "name": "New",
+            "product_name": "New",
+            "name_or_model": "New",
+            "unit_name": "个",
+        }
+    elif action == "update":
+        assert storage.call_args.args == (1, payload)
+    elif action == "delete":
+        storage.assert_called_once_with(1)
+    else:
+        storage.assert_called_once_with([1, 2])
+        assert result["deleted"] == 2 and result["skipped"] == []
+
