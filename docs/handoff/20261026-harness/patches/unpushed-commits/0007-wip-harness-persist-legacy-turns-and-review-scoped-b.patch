+@pytest.mark.parametrize("action,service_method,storage_method,payload", _PRODUCT_WRITES)
+def test_product_adapter_storage_errors_remain_explicit_failures(
+    action, service_method, storage_method, payload
+):
+    from app.legacy.routes.product import compat_routes as routes
+
+    with (
+        patch(
+            "app.mod_sdk.erp_products_facade.is_erp_products_via_service_enabled",
+            return_value=False,
+        ),
+        patch(
+            f"app.legacy.routes.product.compat_routes.{storage_method}",
+            side_effect=RuntimeError("db error"),
+        ),
+    ):
+        result = routes._execute_products_compat_action(action, payload)
+    assert result["success"] is False and result["error_code"] == "tool_exception"
