+def _seed_target(runtime, scope="user"):
+    actor, http, service, _ = runtime
+    record = service.capture_conversation_turn(
+        access_context=agent_dataset_access_context(actor.context),
+        user_message="我喜欢合成审批目标",
+        scope=scope,
+    )["candidates"][0]
+    return actor, http, service, record["memory_id"]
+
+
+def _finish_pending(http, run_id, actor):
+    from app.application.agent_orchestrator import AgentOrchestrator
+
+    review = http.client.get(f"/api/agent/runs/{run_id}", headers=actor.headers)
+    token = review.json()["approval"]["grant"]
+    assert (
+        http.client.post(
+            f"/api/agent/runs/{run_id}/continue",
+            headers=actor.headers,
+            json={"approval_grant": token},
+        ).status_code
+        == 202
+    )
+    assert http.queue.claim("persy-test", lease_seconds=60).run_id == run_id
+    run = AgentOrchestrator().execute_dispatched_run(run_id)
+    http.queue.finish(run_id, "persy-test", "completed" if run.status == "completed" else "blocked")
+    return run, token
+
+
+@pytest.mark.parametrize("scope", ["user", "tenant"])
+def test_persy_http_approval_binds_owner_and_replay_is_once(
+    runtime, trusted_actor, approved_tool_context, scope
+):
+    from app.application.agent_orchestrator.run_models import AgentStep
+    from app.application.agent_orchestrator.task_background import task_execution_context
+    from app.application.agent_orchestrator.tool_executor import AgentToolExecutor
+
+    actor, http, service, memory_id = _seed_target(runtime, scope)
+    member, foreign = trusted_actor(), trusted_actor(tenant_id=8)
+    path = f"/api/knowledge/v1/datasets/persy-knowledge/memories/{memory_id}/confirm"
+    start = http.client.post(path, headers=actor.headers, json={})
+    assert start.status_code == 202 and start.json()["pending_approval"] is True
+    assert start.json()["task_id"]
+    run_id = start.json()["run_id"]
+    pending = http.repository.get(run_id)
+    params = pending.steps[0].params
+    assert params["target_scope"] == scope and len(params["target_digest"]) == 64
+    assert params["target_snapshot"]["status"] == "pending"
+    assert (
+        service.list_memories(access_context=agent_dataset_access_context(actor.context))[
+            "memories"
+        ][0]["status"]
+        == "pending"
+    )
+    token = http.client.get(f"/api/agent/runs/{run_id}", headers=actor.headers).json()["approval"][
+        "grant"
+    ]
+    for outsider in (member, foreign):
+        assert (
+            http.client.post(
+                f"/api/agent/runs/{run_id}/continue",
+                headers=outsider.headers,
+                json={"approval_grant": token},
+            ).status_code
+            == 403
+        )
+    run, token = _finish_pending(http, run_id, actor)
+    output = run.steps[0].output
+    assert run.status == "completed" and output["business_verification"]["verified"] is True
+    assert output["business_verification"]["target_scope"] == scope
+    assert (
+        http.client.post(
+            f"/api/agent/runs/{run_id}/continue",
+            headers=actor.headers,
+            json={"approval_grant": token},
+        ).status_code
+        == 403
+    )
+    context = {
+        **run.metadata["runtime_context"],
+        **task_execution_context(run, run.steps[0]),
+        "run_id": run_id,
+        "step_id": run.steps[0].step_id,
+    }
+    before_replay = service.memory_service._store._memory_path.read_bytes()
+    replay = AgentToolExecutor().execute(run.steps[0], runtime_context=context)
+    assert replay.pop("business_action_replayed") is True
+    assert replay == output
+    retry_step = AgentStep(
+        node_id=run.steps[0].node_id,
+        tool_id="persy_memory",
+        action="write",
+        params=dict(params),
+    )
+    retry_context = approved_tool_context(
+        actor, retry_step, business_action_id=context["business_action_id"]
+    )
+    assert retry_context["run_id"] != run_id
+    replay = AgentToolExecutor().execute(retry_step, runtime_context=retry_context)
+    assert replay.pop("business_action_replayed") is True
+    assert replay == output
+    assert service.memory_service._store._memory_path.read_bytes() == before_replay
+    assert (
+        service.memory_service.list_memories(str(actor.user_id) if scope == "user" else "tenant:7")[
+            0
+        ]["status"]
+        == "active"
+    )
+
