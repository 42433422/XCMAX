+def agent_http_status(payload: dict[str, Any], *, failure_status: int = 400) -> int:
+    """An accepted or uncertain action has a task to inspect, not a success receipt."""
+    from app.application.agent_orchestrator.tool_receipt import tool_receipt_outcome
+
+    if (
+        payload.get("pending_approval")
+        or payload.get("agent_status")
+        in {"waiting_user", "blocked", "queued", "running", "retrying"}
+        or tool_receipt_outcome(payload) in {"pending", "unknown", "waiting_approval"}
+    ):
+        return 202
+    if payload.get("success") is True:
+        return 200
+    hinted = payload.get("http_status_code")
+    if type(hinted) is int and 400 <= hinted <= 599:
+        return hinted
+    return 500 if payload.get("error_code") == "tool_exception" else failure_status
+
+
 def success(data: Any, **extra: Any) -> dict[str, Any]:
