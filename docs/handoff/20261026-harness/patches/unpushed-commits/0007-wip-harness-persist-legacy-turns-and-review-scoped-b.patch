+def test_anonymous_text_remains_available_but_tool_context_cannot_impersonate_run(monkeypatch):
+    client = Mock()
+    client.chat.completions.create.return_value = SimpleNamespace(
+        choices=[SimpleNamespace(message=SimpleNamespace(content="你好", tool_calls=[]))]
+    )
+    monkeypatch.setattr(adapter, "_get_workflow_tool_registry", lambda: [])
+    assert adapter.chat("你好", client=client)["response"] == "你好"
+    dispatch = Mock()
+    result = adapter.append_tool_messages(
+        [],
+        [_call()],
+        workspace_root=None,
+        runtime_context={"run_id": "other-user-run"},
+        execute_tool=dispatch,
+    )
+    assert result["error_code"] == "tool_identity_required" and "run_id" not in result
+    dispatch.assert_not_called()
