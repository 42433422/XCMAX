 }
 
+export function hasMatchingApproval(snapshot: AgentRunResponse | null): boolean {
+  const approval = snapshot?.approval
+  return Boolean(
+    snapshot?.success === true &&
+    snapshot.data?.status === 'waiting_user' &&
+    !runHasUncertainReceipt(snapshot.data) &&
+    snapshot.capabilities?.approve !== false &&
+    approval?.grant &&
+    approval.run_id === snapshot.data.run_id &&
+    snapshot.data.steps?.some(
+      (step) => step.step_id === approval.step_id && step.tool_id === approval.tool_id && step.action === approval.action,
+    ),
+  )
+}
+
+function reviewIdentity(snapshot: AgentRunResponse): string {
+  const approval = snapshot.approval
+  return JSON.stringify({
+    runId: snapshot.data?.run_id,
+    steps: snapshot.data?.steps?.map((step) => [step.step_id, step.tool_id, step.action, step.risk, step.params]),
+    approval: [approval?.run_id, approval?.step_id, approval?.tool_id, approval?.action],
+  })
+}
+
+/** Review persisted inputs, then bind every fresh/retried grant to that exact review. */
+export async function reviewAndApproveRun(runId: string, options: ApproveOptions = {}): Promise<AgentRunResponse | null> {
+  const mods = getActivePinia() ? useModsStore() : null
+  let scopeCurrent = true
+  const stop = watch(
+    () => productReadScopeKey(mods?.activeModId || ''),
+    () => {
+      scopeCurrent = false
+    },
+    { flush: 'sync' },
+  )
+  const isCurrent = () => scopeCurrent && (!options.isCurrent || options.isCurrent())
+  try {
+    return await reviewCurrentRun(runId, { ...options, isCurrent })
+  } finally {
+    stop()
+  }
+}
+
+async function reviewCurrentRun(runId: string, options: ApproveOptions): Promise<AgentRunResponse | null> {
+  const snapshot = await agentRunsApi.getRun(runId)
+  if (options.isCurrent && !options.isCurrent()) return null
+  if (!String(snapshot.approval?.grant || '').trim()) throw new Error(APPROVAL_GRANT_MISSING_MESSAGE)
+  if (snapshot.data?.run_id !== runId || !hasMatchingApproval(snapshot)) {
+    throw new Error('任务当前不可审批，请刷新核对执行状态')
+  }
+  if (options.validateSnapshot && !options.validateSnapshot(snapshot)) {
+    throw new Error('任务内容已变化，请重新审阅后审批')
+  }
+  const reviewed = reviewIdentity(snapshot)
+  const details = snapshot.data
+    .steps!.map(
+      (step) =>
+        `${step.description || `${step.tool_id}.${step.action}`}（${step.risk || '未知'}风险）\n${JSON.stringify(step.params || {}, null, 2)}`,
+    )
+    .join('\n\n')
+  const confirmed = await appConfirm(`请审阅实际目标、变更内容及风险。审批后将执行，保存结果仍需独立核验。\n\n${details}`, {
+    title: '审阅任务变更',
+    danger: true,
+    confirmText: '审批并执行',
+  })
+  if (!confirmed || (options.isCurrent && !options.isCurrent())) return null
+  return approveRunWithFreshGrant(runId, {
+    ...options,
+    validateSnapshot: (current) =>
+      Boolean(
+        current.data?.run_id === runId &&
+        hasMatchingApproval(current) &&
+        reviewIdentity(current) === reviewed &&
+        (!options.validateSnapshot || options.validateSnapshot(current)),
+      ),
+  })
+}
+
 function isForbidden(error: unknown): boolean {
   return Boolean(error && typeof error === 'object' && (error as { status?: unknown }).status === 403)
 }
