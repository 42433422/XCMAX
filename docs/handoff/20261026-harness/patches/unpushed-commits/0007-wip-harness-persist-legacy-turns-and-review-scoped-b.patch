@@ -0,0 +1,62 @@
+"""Public product mutations retain tenant ownership and reviewed receipts."""
+
+import pytest
+
+from app.fastapi_routes.domains.product import routes
+from tests.fixtures.backend_ci_isolation import reviewed_agent_http as reviewed_agent_http
+from tests.fixtures.backend_ci_isolation import trusted_actor as trusted_actor
+
+
+@pytest.mark.parametrize("verb", ["POST", "PUT", "PATCH"])
+def test_product_reviewed_updates_and_deletes_use_actual_tenant_data(
+    verb, tmp_path, monkeypatch, local_tools, trusted_actor, reviewed_agent_http
+):
+    from app.db.models.product import Product
+    from app.infrastructure.tenant_scope import tenant_scope
+
+    actor, other = trusted_actor(), trusted_actor(tenant_id=8)
+    monkeypatch.setattr("app.db.session.SessionLocal", actor.factory)
+    monkeypatch.setenv("WORKSPACE_ROOT", str(tmp_path))
+    ids = []
+    for principal in (actor, other):
+        with tenant_scope(principal.tenant_id), principal.factory.begin() as db:
+            row = Product(name="产品", model_number=f"HTTP-{principal.tenant_id}", price=12.5)
+            db.add(row)
+            db.flush()
+            ids.append(row.id)
+    http = reviewed_agent_http(actor, routes.router)
+    assert (
+        http.client.request(
+            verb, f"/api/products/{ids[0]}", json={"id": ids[1], "name": "错目标"}
+        ).status_code
+        == 400
+    )
+    cross = http.request(verb, f"/api/products/{ids[1]}", json={"name": "跨租户改写"})
+    assert cross.response.status_code == 202, cross.response.text
+    assert cross.run.status != "completed"
+    updated = http.request(
+        verb, f"/api/products/{ids[0]}", json={"name": "更新产品", "price": 13.0}
+    )
+    assert updated.response.status_code == 202, updated.response.text
+    assert updated.run.status == "completed", updated.output
+    assert updated.output["business_verification"]["verified"] is True
+    with tenant_scope(actor.tenant_id), actor.factory() as db:
+        row = db.query(Product).one()
+        assert row.name == "更新产品" and float(row.price) == 13.0
+    removed = http.request("DELETE", f"/api/products/{ids[0]}")
+    assert removed.run.status == "completed", removed.output
+    assert removed.output["business_verification"]["verified"] is True
+    with tenant_scope(other.tenant_id), actor.factory() as db:
+        row = db.query(Product).one()
+        assert row.name == "产品" and float(row.price) == 12.5
+    assert http.client.get("/api/products/search").status_code == 403
+    assert http.client.post("/api/products/import/price-list-template").status_code == 403
+    assert (
+        http.client.request(
+            verb,
+            f"/api/products/{ids[1]}",
+            headers={"X-Session-ID": "", "X-User-ID": str(actor.user_id)},
+            json={"name": "伪造"},
+        ).status_code
+        == 401
+    )
