+@pytest.mark.parametrize("stage", ["admission", "intent"])
+def test_storage_failure_never_dispatches_or_calls_model(
+    trusted_actor, reviewed_agent_http, monkeypatch, stage
+):
+    actor = trusted_actor()
+    http = reviewed_agent_http(actor)
+    execute = Mock(side_effect=AssertionError("must not dispatch"))
+    client = SimpleNamespace(chat=SimpleNamespace(completions=SimpleNamespace(create=execute)))
+    if stage == "admission":
+        monkeypatch.setattr(
+            http.repository, "claim_first_task_run", Mock(side_effect=OSError("db"))
+        )
+        with pytest.raises(OSError):
+            adapter.chat("查询", runtime_context=actor.context, client=client)
+    else:
+        run, context = _admit(actor)
+        monkeypatch.setattr(http.repository, "save", Mock(side_effect=OSError("db")))
+        with pytest.raises(OSError):
+            adapter.append_tool_messages(
+                [], [_call()], workspace_root=None, runtime_context=context, execute_tool=execute
+            )
+        assert not http.repository.get(run.run_id).tool_calls
+    execute.assert_not_called()
