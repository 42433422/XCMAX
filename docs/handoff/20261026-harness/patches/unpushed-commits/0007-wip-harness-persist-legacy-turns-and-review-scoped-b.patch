@@ -296,3 +310,80 @@ def _verify_memory_v2(action, params, result, context):
     except (ValueError, *RECOVERABLE_ERRORS):
         evidence = {"verified": False, "memory_id": record_id}
     return {**result, "business_verification": evidence}, evidence["verified"]
+
+
+def _verify_persy_memory(params, result, context):
+    from app.application.agent_orchestrator.business_action_ledger import canonical_hash
+    from app.application.persy_memory_app_service import get_persy_memory_app_service
+    from app.application.persy_memory_utils import _memory_owners, _public_memory_record
+    from app.infrastructure.auth.agent_mod_scope import agent_dataset_access_context
+
+    evidence = {
+        "verified": False,
+        "memory_id": params["memory_id"],
+        "operation": params["operation"],
+        "target_scope": params["target_scope"],
+    }
+    try:
+        service = get_persy_memory_app_service().memory_service
+        if service._store._backend is None:
+            return {**result, "business_verification": evidence}, False
+        access = agent_dataset_access_context(context)
+        owner = dict(_memory_owners(access)).get(params["target_scope"])
+        record = (
+            next(
+                (
+                    row
+                    for row in service.list_memories(owner)
+                    if row.get("memory_id") == params["memory_id"]
+                ),
+                None,
+            )
+            if owner
+            else None
+        )
+        returned = result.get("memory")
+        persisted = _public_memory_record(record, params["target_scope"]) if record else {}
+        # Strength is a time-derived display field, never persistence evidence.
+        verified = bool(
+            record
+            and isinstance(returned, dict)
+            and canonical_hash({key: value for key, value in returned.items() if key != "strength"})
+            == canonical_hash({key: value for key, value in persisted.items() if key != "strength"})
+        )
+        operation = params["operation"]
+        before = params["target_snapshot"]
+        state = {
+            "confirm": "active",
+            "reject": "rejected",
+            "delete": "deleted",
+            "correct": before["status"],
+        }[operation]
+        verified = verified and record["status"] == state
+        patch = params.get("patch") or {}
+        for key in ("key", "value", "memory_type"):
+            expected = (
+                patch.get(key, before[key])
+                if operation == "confirm" or operation == "correct" and patch.get(key) is not None
+                else before[key]
+            )
+            verified = verified and canonical_hash(record.get(key)) == canonical_hash(expected)
+        if operation == "confirm":
+            verified = (
+                verified
+                and record.get("source_policy") != "blocked"
+                and record.get("eligible_for_planner") is not False
+            )
+        if operation == "confirm" and "confidence" in patch:
+            verified = verified and record.get("confidence") == patch["confidence"]
+        if params.get("reason") and operation != "confirm":
+            key = {
+                "reject": "rejected_reason",
+                "delete": "deleted_reason",
+                "correct": "last_correction_reason",
+            }[operation]
+            verified = verified and record.get(key) == params["reason"]
+        evidence["verified"] = bool(verified)
+    except RECOVERABLE_ERRORS:
+        pass
+    return {**result, "business_verification": evidence}, evidence["verified"]
