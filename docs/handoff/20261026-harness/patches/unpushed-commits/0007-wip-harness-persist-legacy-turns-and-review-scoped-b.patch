+@pytest.mark.parametrize("scenario", ["normal", "anonymous", "save_failure"])
+@pytest.mark.parametrize("owner", ["compat", "domain"])
+@pytest.mark.parametrize("asynchronous", [False, True])
+def test_both_public_stream_owners_admit_before_model_and_replay_exact_receipt(
+    trusted_actor, reviewed_agent_http, monkeypatch, owner, asynchronous, scenario
+):
+    from app.fastapi_routes import xcagi_compat_chat_helpers as compat
+    from app.fastapi_routes import xcagi_compat_chat_stream as stream
+    from app.fastapi_routes.domains.conversation import helpers as domain
+
+    actor = trusted_actor()
+    http = reviewed_agent_http(actor)
+    api = compat if owner == "compat" else domain
+    from starlette.requests import Request
+
+    request = actor.request if scenario != "anonymous" else Request({"type": "http", "headers": []})
+    if scenario == "save_failure":
+        monkeypatch.setattr(
+            http.repository, "claim_first_task_run", Mock(side_effect=OSError("save failed"))
+        )
+    monkeypatch.setattr(stream, "_classify_and_submit_client_issue", lambda *a, **k: None)
+    monkeypatch.setattr(api, "_ensure_chat_db_read_authorized", lambda *a, **k: (True, None))
+    monkeypatch.setattr(api, "_ensure_vector_index_if_needed", lambda *a: None)
+    model = Mock(is_modstore_openai_compatible=False)
+
+    def complete(**kwargs):
+        saved = http.repository.list_recent(user_id=str(actor.user_id))
+        if scenario == "anonymous":
+            assert not saved
+            delta = SimpleNamespace(content="匿名纯聊", tool_calls=[])
+        elif not saved[0].tool_calls:
+            call = _call()
+            call.index = 0
+            delta = SimpleNamespace(content=None, tool_calls=[call])
+        else:
+            assert saved[0].tool_calls[0].output["success"]
+            delta = SimpleNamespace(content="独立读回完成", tool_calls=[])
+        return iter([SimpleNamespace(choices=[SimpleNamespace(delta=delta, finish_reason="stop")])])
+
+    model.chat.completions.create.side_effect = complete
+    monkeypatch.setattr(api, "create_modstore_openai_client_from_request", lambda request: model)
+    body = api.XcagiCompatChatBody(
+        message="你好",
+        user_id="spoofed",
+        context={"conversation_id": "chat", "turn_id": "stream-turn"},
+    )
+
+    def consume():
+        if asynchronous:
+
+            async def collect():
+                return [
+                    chunk
+                    async for chunk in api._xcagi_planner_stream_bytes_async(
+                        request, body, ai_tier="p1"
+                    )
+                ]
+
+            chunks = asyncio.run(collect())
+        else:
+            chunks = list(api._xcagi_planner_stream_bytes(request, body, ai_tier="p1"))
+        return [
+            json.loads(line[6:])
+            for chunk in chunks
+            for line in chunk.decode().splitlines()
+            if line.startswith("data: ")
+        ]
+
+    if scenario == "save_failure":
+        with pytest.raises(OSError, match="save failed"):
+            consume()
+        model.chat.completions.create.assert_not_called()
+        return
+    first = next(event["result"] for event in consume() if event["type"] == "done")
+    second = next(event["result"] for event in consume() if event["type"] == "done")
+    if scenario == "anonymous":
+        assert "run_id" not in first and "run_id" not in second
+        assert not http.repository.list_recent()
+        return
+    assert first["run_id"] == second["run_id"]
+    assert model.chat.completions.create.call_count == 2
+    stored = http.repository.get(first["run_id"])
+    assert stored.user_id == str(actor.user_id) and stored.status == "completed"
+    assert len(stored.tool_calls) == 1 and stored.tool_calls[0].output["success"]
+
