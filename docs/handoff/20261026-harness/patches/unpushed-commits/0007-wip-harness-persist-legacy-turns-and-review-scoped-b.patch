@@ -76,6 +113,27 @@ class SQLAlchemyAgentRunRepository:
             return previous, False
         return self.get(run.run_id) or copy.deepcopy(run), True
 
+    def save_tool_intent(self, run: AgentRun) -> str | None:
+        """Check unresolved writes and persist the new intent under one DB actor lock."""
+        from app.db.models.agent import AgentRunRecord
+        from app.db.models.user import User
+
+        with self.transaction() as db:
+            actor = db.query(User).filter(User.id == int(run.user_id))
+            if db.get_bind().dialect.name == "sqlite":
+                # Acquire SQLite's write transaction before reading conflict state.
+                found = actor.update({User.is_active: User.is_active}, synchronize_session=False)
+            else:
+                found = actor.with_for_update().one_or_none() is not None
+            if not found:
+                raise ValueError("持久任务的真实账号不存在，未执行工具")
+            for record in db.query(AgentRunRecord).filter(AgentRunRecord.user_id == run.user_id):
+                previous = self._record_to_run(record)
+                if previous is not None and unresolved_tool_conflict(run, previous):
+                    return previous.run_id
+            self.save_in_session(db, run)
+        return None
+
     def save_claimed(self, run: AgentRun, *, owner_id: str, execution_count: int) -> AgentRun:
