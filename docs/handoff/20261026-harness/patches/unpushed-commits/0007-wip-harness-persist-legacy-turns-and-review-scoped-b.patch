+        return context, None
+    if isinstance(context.get("_legacy_execution_lease"), LegacyExecutionLease):
+        return context, None
+    run = start_legacy_chat_run(message=user_message, runtime_context=context)
+    return (
+        (context, replay_legacy_run(run))
+        if run.metadata.get("admission_replayed")
+        else (legacy_execution_context(run), None)
+    )
+
+
+def _finish(user_message, context, payload):
+    from app.application.agent_orchestrator.chat_trace import finalize_legacy_chat_run
+
+    if not context.get("run_id") or not context.get("_legacy_execution_lease"):
+        return payload
+    return finalize_legacy_chat_run(
+        context["run_id"],
+        payload,
+        message=user_message,
+        runtime_context={
+            key: value for key, value in context.items() if key != "_legacy_execution_lease"
+        },
+    )
+
+
+def chat(user_message: str, *, runtime_context=None, **options):
+    context, replay = _admit(user_message, runtime_context)
+    owns_completion = context.get("_legacy_execution_lease") is not (runtime_context or {}).get(
+        "_legacy_execution_lease"
+    )
+    if replay is not None:
+        return replay
+    try:
+        reply = _chat(user_message, runtime_context=context, **options)
+    except Exception:
+        # This is the synchronous request boundary: a failed model/transport must
+        # not leave a runnable task that a reconnect can dispatch from scratch.
+        if owns_completion:
+            _finish(
+                user_message,
+                context,
+                {
+                    "success": False,
+                    "message": "对话执行中断，请查询原任务核对",
+                },
+            )
+        raise
+    payload = json.loads(reply) if isinstance(reply, str) else reply
+    result = _finish(user_message, context, payload) if owns_completion else payload
+    return json.dumps(result, ensure_ascii=False) if isinstance(reply, str) else result
+
+
+def chat_stream_text(user_message: str, *, runtime_context=None, **options):
