+def test_legacy_write_uses_same_run_formal_http_grant_then_real_readback(
+    trusted_actor, reviewed_agent_http
+):
+    from app.db.models.purchase_unit import PurchaseUnit
+    from app.infrastructure.tenant_scope import tenant_scope
+
+    actor = trusted_actor()
+    http = reviewed_agent_http(actor)
+    run, context = _admit(actor, message="创建客户")
+    params = {"entity": "customers", "operation": "create", "payload": {"unit_name": "正式客户"}}
+    receipt = adapter.append_tool_messages(
+        [], [_call("business_db_write", params)], workspace_root=None, runtime_context=context
+    )
+    assert receipt["pending_approval"] and receipt["run_id"] == run.run_id
+    waiting = http.repository.get(run.run_id)
+    assert waiting.status == "waiting_user"
+    assert waiting.steps[0].tool_id == "business_db" and waiting.steps[0].action == "write"
+    with tenant_scope(actor.tenant_id), actor.factory() as db:
+        assert db.query(PurchaseUnit).filter_by(unit_name="正式客户").count() == 0
+    review = http.client.get(f"/api/agent/runs/{run.run_id}")
+    assert review.status_code == 200, review.text
+    approved = http.client.post(
+        f"/api/agent/runs/{run.run_id}/continue",
+        json={"approval_grant": review.json()["approval"]["grant"]},
+    )
+    assert approved.status_code == 202, approved.text
+    claim = http.queue.claim("legacy-test", lease_seconds=60)
+    assert claim.run_id == run.run_id
+    completed = AgentOrchestrator().execute_dispatched_run(run.run_id)
+    assert completed.status == "completed", completed.to_dict()
+    assert completed.steps[0].output["business_verification"]["verified"]
+    with tenant_scope(actor.tenant_id), actor.factory() as db:
+        rows = (
+            db.query(PurchaseUnit).filter_by(unit_name="正式客户", tenant_id=actor.tenant_id).all()
+        )
+        assert len(rows) == 1
+    replay, _ = _admit(actor, message="创建客户", task_id="new-caller-task")
+    assert replay.run_id == run.run_id and replay.metadata["admission_replayed"]
+
