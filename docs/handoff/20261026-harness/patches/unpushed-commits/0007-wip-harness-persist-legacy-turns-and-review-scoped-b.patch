+            idempotent=True,
+            cost_units=0,
+        ),
+    )
+    original_admit, original_append = runtime._admit, adapter.append_tool_messages
+    original_reset = adapter.reset_planner_tool_dedup_state
+    standalone = None
+
+    def admit(message, context):
+        return original_admit(message, {**dict(context or {}), **actor.context})
+
+    def append(messages, calls, *, runtime_context=None, **kwargs):
+        nonlocal standalone
+        context = dict(runtime_context or {})
+        if "_legacy_execution_lease" not in context:
+            if standalone is None:
+                standalone, _ = admit("transport unit call", context)
+            context = standalone
+        return original_append(messages, calls, runtime_context=context, **kwargs)
+
+    def reset():
+        nonlocal standalone
+        standalone = None
+        original_reset()
+
+    monkeypatch.setattr(runtime, "_admit", admit)
+    monkeypatch.setattr(adapter, "append_tool_messages", append)
+    monkeypatch.setattr(adapter, "reset_planner_tool_dedup_state", reset)
+    for name, value in (
+        ("append_tool_messages", append),
+        ("reset_planner_tool_dedup_state", reset),
+    ):
+        if hasattr(request.module, name):
+            monkeypatch.setattr(request.module, name, value)
+    return SimpleNamespace(actor=actor, repository=repository)
