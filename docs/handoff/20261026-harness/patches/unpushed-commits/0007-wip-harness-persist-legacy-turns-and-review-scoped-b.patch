 from app.utils.operational_errors import RECOVERABLE_ERRORS
 
 
+def unresolved_tool_conflict(run: AgentRun, previous: AgentRun) -> bool:
+    """Conservative tool-domain fence until contracts define narrower write resources."""
+    from .tool_receipt import tool_receipt_outcome
+    from .tool_spec import get_tool_action_spec
+
+    if (
+        run.run_id == previous.run_id
+        or run.user_id != previous.user_id
+        or tenant_id_of_run(run) != tenant_id_of_run(previous)
+        or mod_id_of_run(run) != mod_id_of_run(previous)
+    ):
+        return False
+    domain = _write_domain(run.tool_calls[-1])
+    for call in previous.tool_calls:
+        if _write_domain(call) != domain or call.metadata.get("not_dispatched"):
+            continue
+        spec = get_tool_action_spec(call.tool_id, call.action)
+        if not call.metadata.get("read_only", bool(spec and spec.read_only)) and (
+            not call.output or tool_receipt_outcome(call.output) in {"unknown", "pending"}
+        ):
+            return True
+    return False
+
+
+def _write_domain(call) -> str:
+    if call.tool_id == "business_db":
+        from app.domain.shared_services.tools_workflow_common import _normalize_business_db_entity
+
+        return _normalize_business_db_entity(call.params.get("entity")) or "business_db"
+    return {
+        "update_customer": "customers",
+        "delete_customer": "customers",
+        "update_order": "shipment_records",
+        "delete_order": "shipment_records",
+    }.get(call.tool_id, call.tool_id)
+
