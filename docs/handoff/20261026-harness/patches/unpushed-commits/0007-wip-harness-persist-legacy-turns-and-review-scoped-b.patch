+def test_process_restart_cannot_replace_unknown_write_with_new_caller_ids(
+    trusted_actor, reviewed_agent_http
+):
+    actor = trusted_actor()
+    http = reviewed_agent_http(actor)
+    runs = [_admit(actor, turn=f"independent-{i}")[0] for i in range(4)]
+    program = r"""
+import json, os, sys
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+from app.application.agent_orchestrator.run_sql_repository import SQLAlchemyAgentRunRepository
+from app.application.agent_orchestrator.run_models import AgentStep, ToolCall
+repository=SQLAlchemyAgentRunRepository(session_factory=sessionmaker(bind=create_engine(sys.argv[1])),auto_create=False)
+run=repository.get(sys.argv[2])
+step=AgentStep("write", "business_db", "write", params={"entity":"customers","operation":"create","payload":{"unit_name":"same"}},status="running")
+run.steps.append(step)
+run.tool_calls.append(ToolCall(step.step_id,"write","business_db","write",params=step.params))
+conflict=repository.save_tool_intent(run)
+print(json.dumps({"run_id":run.run_id,"conflict":conflict}),flush=True)
+if not conflict: os._exit(23)
+"""
+    with actor.factory() as db:
+        url = str(db.get_bind().url)
+    workers = [
+        subprocess.Popen(
+            [sys.executable, "-c", program, url, run.run_id],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+        )
+        for run in runs
+    ]
+    receipts = []
+    for worker in workers:
+        output, error = worker.communicate(timeout=30)
+        assert worker.returncode in {0, 23}, error.decode()
+        receipts.append(json.loads(output))
+    winner = next(item["run_id"] for item in receipts if not item["conflict"])
+    assert sum(not item["conflict"] for item in receipts) == 1
+    assert all(item["conflict"] == winner for item in receipts if item["conflict"])
+    restarted, context = _admit(actor, turn="changed-client-id", task_id="changed-task")
+    execute = Mock(side_effect=AssertionError("unknown original write must not be replayed"))
+    params = {"entity": "customers", "operation": "create", "payload": {"unit_name": "different"}}
+    result = adapter.append_tool_messages(
+        [],
+        [_call("business_db_write", params)],
+        workspace_root=None,
+        runtime_context=context,
+        execute_tool=execute,
+    )
+    assert result["error_code"] == "reconcile_original_task"
+    assert result["original_run_id"] == winner and result["outcome"] == "unknown"
+    execute.assert_not_called()
+    for index, (tool_name, action_params) in enumerate(
+        [
+            (
+                "execute_erp_capability",
+                {"tool_id": "customers", "action": "delete", "params": {"id": 1}},
+            ),
+            ("delete_customer", {"customer_id": 1}),
+        ]
+    ):
+        alias, alias_context = _admit(actor, turn=f"changed-alias-{index}")
+        receipt = adapter.append_tool_messages(
+            [],
+            [_call(tool_name, action_params)],
+            workspace_root=None,
+            runtime_context=alias_context,
+            execute_tool=execute,
+        )
+        assert receipt["error_code"] == "reconcile_original_task"
+        assert receipt["original_run_id"] == winner
+    execute.assert_not_called()
+    assert http.repository.get(restarted.run_id).status == "failed"
+    # Uncertain writes do not lock unrelated pure chat or safe reads.
+    read, read_context = _admit(actor, turn="new-read")
+    adapter.append_tool_messages([], [_call()], workspace_root=None, runtime_context=read_context)
+    assert http.repository.get(read.run_id).tool_calls[0].output["success"]
+
