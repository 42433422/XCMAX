+@pytest.mark.parametrize("tamper", ["params", "scope", "snapshot", "storage"])
+def test_persy_reviewed_target_or_parameters_change_cannot_apply(runtime, tamper):
+    actor, http, service, memory_id = _seed_target(runtime)
+    start = http.client.post(
+        f"/api/knowledge/v1/datasets/persy-knowledge/memories/{memory_id}/confirm",
+        headers=actor.headers,
+        json={},
+    )
+    run_id = start.json()["run_id"]
+    token = http.client.get(f"/api/agent/runs/{run_id}", headers=actor.headers).json()["approval"][
+        "grant"
+    ]
+    run = http.repository.get(run_id)
+    if tamper == "storage":
+        # Simulate another already-authorized writer after the user reviewed this snapshot.
+        service.memory_service.correct_memory(
+            str(actor.user_id), memory_id, value="changed-after-review"
+        )
+        finished, _ = _finish_pending(http, run_id, actor)
+        assert finished.status != "completed"
+        assert finished.steps[0].output["error_code"] == "persy_memory_target_changed"
+    else:
+        if tamper == "params":
+            run.steps[0].params["patch"] = {"value": "forged"}
+        elif tamper == "scope":
+            run.steps[0].params["target_scope"] = "tenant"
+        else:
+            run.steps[0].params["target_snapshot"]["value"] = "forged"
+        http.repository.save(run)
+        assert (
+            http.client.post(
+                f"/api/agent/runs/{run_id}/continue",
+                headers=actor.headers,
+                json={"approval_grant": token},
+            ).status_code
+            == 403
+        )
+    assert service.memory_service.list_memories(str(actor.user_id))[0]["status"] == "pending"
+
