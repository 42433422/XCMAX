+"""Real session/SQL admission and formal approval; only model transport is synthetic."""
+
+import asyncio
+import json
+import subprocess
+import sys
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from app.application.agent_orchestrator import chat_trace
+from app.application.agent_orchestrator.orchestrator import AgentOrchestrator
+from app.application.agent_orchestrator.trace_runs import legacy_execution_context
+from app.legacy.chat import legacy_chat_adapter as adapter
+from tests.fixtures import backend_ci_isolation
+
+trusted_actor = backend_ci_isolation.trusted_actor
+reviewed_agent_http = backend_ci_isolation.reviewed_agent_http
+
+
+def _call(name="business_db_read", params=None, call_id="call-1"):
+    return SimpleNamespace(
+        id=call_id,
+        function=SimpleNamespace(
+            name=name, arguments=json.dumps(params or {"entity": "customers"})
+        ),
+    )
+
+
+def _admit(actor, *, turn="turn-1", message="查询客户", **context):
+    run = chat_trace.start_legacy_chat_run(
+        message=message,
+        runtime_context={
+            **actor.context,
+            "conversation_id": "conversation",
+            "turn_id": turn,
+            **context,
+        },
+    )
+    return run, legacy_execution_context(run)
+
+
+def test_real_turn_claim_binds_scope_and_content_and_preserves_legitimate_repeated_text(
+    trusted_actor, reviewed_agent_http
+):
+    actor = trusted_actor()
+    http = reviewed_agent_http(actor)
+    first, _ = _admit(actor, task_id="caller-task", run_id="caller-run", local_user_id="victim")
+    repeat, _ = _admit(actor, task_id="replacement-task")
+    assert repeat.run_id == first.run_id and repeat.metadata["admission_replayed"]
+    assert first.user_id == str(actor.user_id) and first.run_id != "caller-run"
+    assert first.metadata["task_context"]["task_id"] != "caller-task"
+    with pytest.raises(ValueError, match="绑定不同请求"):
+        _admit(actor, message="改写原请求")
+    separate, _ = _admit(actor, turn="turn-2")
+    other, _ = _admit(trusted_actor(), task_id="caller-task")
+    assert len({first.run_id, separate.run_id, other.run_id}) == 3
+    assert len(http.repository.list_recent(user_id=str(actor.user_id))) == 2
+
+
+def test_real_sql_read_intent_is_committed_before_dispatch_and_same_call_replays(
+    trusted_actor, reviewed_agent_http, monkeypatch
+):
+    from app.application.tools.workflow import execute_workflow_tool
+
+    actor = trusted_actor()
+    http = reviewed_agent_http(actor)
+    run, context = _admit(actor)
+    actual = Mock(wraps=execute_workflow_tool)
+
+    def dispatch(*args, **kwargs):
+        saved = http.repository.get(run.run_id)
+        assert len(saved.steps) == len(saved.tool_calls) == 1
+        assert saved.tool_calls[0].status == "running" and not saved.tool_calls[0].output
+        assert saved.steps[0].params == {"entity": "customers"}
+        return actual(*args, **kwargs)
+
+    for _ in range(2):
+        adapter.append_tool_messages(
+            [], [_call()], workspace_root=None, runtime_context=context, execute_tool=dispatch
+        )
+    actual.assert_called_once()
+    stored = http.repository.get(run.run_id)
+    assert stored.tool_calls[0].output["success"] is True
+    assert stored.tool_calls[0].metadata["independent_verification"]["verified"]
+    chat_trace.finalize_legacy_chat_run(run.run_id, {"response": "读完"}, message="查询客户")
+    stored = http.repository.get(run.run_id)
+    assert stored.status == "completed" and len(stored.tool_calls) == 1
+    with pytest.raises(ValueError, match="绑定不同动作"):
+        # Completed turns replay at admission; the call binding is checked on active turns.
+        active, ctx = _admit(actor, turn="active-read")
+        adapter.append_tool_messages(
+            [],
+            [_call()],
+            workspace_root=None,
+            runtime_context=ctx,
+            execute_tool=execute_workflow_tool,
+        )
+        adapter.append_tool_messages(
+            [],
+            [_call(params={"entity": "products"})],
+            workspace_root=None,
+            runtime_context=ctx,
+            execute_tool=execute_workflow_tool,
+        )
+
