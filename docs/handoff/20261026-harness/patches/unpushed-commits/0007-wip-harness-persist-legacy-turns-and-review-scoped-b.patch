+@pytest.mark.parametrize("fault", ["disk", "cache"])
+def test_persy_real_dispatch_without_durable_readback_stays_unknown(
+    runtime, approved_tool_context, monkeypatch, fault
+):
+    import json
+
+    from app.application.agent_orchestrator.run_models import AgentStep
+    from app.application.agent_orchestrator.tool_executor import AgentToolExecutor
+    from app.infrastructure.user_memory.json_storage import JsonMemoryStorage
+
+    actor, _, service, memory_id = _seed_target(runtime)
+    target = service.prepare_mutation(runtime_context=actor.context, memory_id=memory_id)
+    target.pop("success")
+    step = AgentStep(
+        node_id="persy-fault",
+        tool_id="persy_memory",
+        action="write",
+        params={**target, "operation": "confirm"},
+    )
+    context = approved_tool_context(actor, step)
+    if fault == "cache":
+        monkeypatch.setattr(service.memory_service._store, "_backend", None)
+    else:
+        read = JsonMemoryStorage.read
+
+        def fail_after_commit(storage):
+            rows = read(storage)
+            if any(
+                record["status"] == "active"
+                for record in rows[str(actor.user_id)].memory_v2_records
+            ):
+                raise OSError("test-owned readback fault")
+            return rows
+
+        monkeypatch.setattr(JsonMemoryStorage, "read", fail_after_commit)
+    result = AgentToolExecutor().execute(step, runtime_context=context)
+    assert result["success"] is False and result["outcome"] == "unknown"
+    on_disk = json.loads(service.memory_service._store._memory_path.read_text())[
+        str(actor.user_id)
+    ]["memory_v2_records"][0]
+    assert on_disk["status"] == ("active" if fault == "disk" else "pending")
+
