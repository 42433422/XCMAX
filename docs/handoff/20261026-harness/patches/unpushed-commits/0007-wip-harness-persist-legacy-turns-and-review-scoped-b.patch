+export function runHasUncertainReceipt(run: AgentRun): boolean {
+  const recovery = run.metadata?.recovery as { state?: string } | undefined
+  const nodeOutputs = asRecord(run.final_output?.node_outputs)
+  const outputs = [run.final_output, ...Object.values(nodeOutputs).map(asRecord), ...(run.steps || []).map((step) => step.output)]
+  const completed = ['completed', 'success'].includes(run.status)
+  return (
+    run.status === 'unknown' ||
+    recovery?.state === 'manual_reconciliation_required' ||
+    outputs.some((output) => {
+      const signals = [output?.outcome, output?.execution_state, output?.status].map((value) =>
+        String(value || '')
+          .trim()
+          .toLowerCase(),
+      )
+      return (
+        output?.reconciliation_required === true ||
+        signals.some((value) => ['unknown', 'pending', 'accepted', 'inflight', 'in_progress'].includes(value)) ||
+        (completed &&
+          (output?.success === false ||
+            output?.pending_approval === true ||
+            output?.requires_token === true ||
+            signals.some((value) =>
+              [
+                'waiting',
+                'waiting_approval',
+                'waiting_user',
+                'pending_approval',
+                'approval_required',
+                'failed',
+                'failure',
+                'fail',
+                'error',
+                'cancelled',
+                'canceled',
+                'blocked',
+                'running',
+                'queued',
+                'retrying',
+              ].includes(value),
+            )))
+      )
+    })
+  )
+}
+
+export function runHasUnverifiedWrites(run: AgentRun): boolean {
+  if (!['completed', 'success'].includes(run.status)) return false
+  if (!run.steps?.length) {
+    const metadata = asRecord(run.metadata)
+    const plans = [asRecord(metadata.plan), asRecord(metadata.provided_plan)]
+    const declared = [...plans.flatMap((plan) => asArray(plan.nodes)), ...(run.tool_calls || [])]
+    return (
+      metadata.requires_approval === true ||
+      plans.some((plan) => asRecord(plan.metadata).requires_approval === true) ||
+      declared.some(
+        (node) => WRITE_ACTIONS.has(asString(asRecord(node).action)) || ['medium', 'high'].includes(asString(asRecord(node).risk)),
+      )
+    )
+  }
+  return (run.steps || []).some((step) => {
+    if (!WRITE_ACTIONS.has(step.action) && !['medium', 'high'].includes(step.risk || '')) return false
+    const proof = step.output?.business_verification as { verified?: boolean } | undefined
+    return (
+      step.status !== 'completed' ||
+      step.output?.success !== true ||
+      step.output?.pending_approval === true ||
+      step.output?.requires_token === true ||
+      proof?.verified !== true
+    )
+  })
+}
