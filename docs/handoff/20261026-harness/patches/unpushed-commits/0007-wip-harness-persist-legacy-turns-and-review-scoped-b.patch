+def test_persy_readback_rejects_wrong_target_owner_and_forged_receipt(
+    runtime, trusted_actor, approved_tool_context
+):
+    from app.application.agent_orchestrator.business_action_verification import (
+        verify_action_result,
+    )
+    from app.application.agent_orchestrator.run_models import AgentStep
+    from app.application.agent_orchestrator.tool_executor import AgentToolExecutor
+    from app.application.agent_orchestrator.tool_spec import get_tool_action_spec
+
+    actor, _, service, memory_id = _seed_target(runtime)
+    target = service.prepare_mutation(runtime_context=actor.context, memory_id=memory_id)
+    target.pop("success")
+    params = {**target, "operation": "confirm"}
+    step = AgentStep(node_id="persy-proof", tool_id="persy_memory", action="write", params=params)
+    result = AgentToolExecutor().execute(step, runtime_context=approved_tool_context(actor, step))
+    assert result["business_verification"]["verified"] is True
+    before = service.memory_service._store._memory_path.read_bytes()
+    forged = {**result, "memory": {**result["memory"], "memory_id": "wrong-target"}}
+    for checked_params, receipt, context in (
+        ({**params, "memory_id": "wrong-target"}, result, actor.context),
+        (params, forged, actor.context),
+        (params, result, trusted_actor().context),
+    ):
+        checked, verified = verify_action_result(
+            get_tool_action_spec("persy_memory", "write"),
+            checked_params,
+            receipt,
+            runtime_context=context,
+        )
+        assert verified is False and checked["business_verification"]["verified"] is False
+    assert service.memory_service._store._memory_path.read_bytes() == before
