@@ -0,0 +1,281 @@
+"""Exact receipt replay uses actual sessions, durable SQL and the formal HTTP queue."""
+
+from copy import deepcopy
+from unittest.mock import Mock
+
+import pytest
+
+from app.application.agent_orchestrator import chat_trace
+from app.application.agent_orchestrator.orchestrator import AgentOrchestrator
+from app.application.agent_orchestrator.trace_runs import legacy_execution_context
+from app.application.tools.workflow import execute_workflow_tool
+from tests.fixtures import backend_ci_isolation
+
+trusted_actor = backend_ci_isolation.trusted_actor
+reviewed_agent_http = backend_ci_isolation.reviewed_agent_http
+
+
+def _claim(actor, kernel):
+    service = chat_trace._run_service()
+    if kernel == "legacy":
+        run = service.claim_legacy_run(
+            message="动态业务任务",
+            runtime_context={**actor.context, "conversation_id": "chat", "turn_id": "turn"},
+        )
+        return service, run, legacy_execution_context(run), {}
+    run, claimed = service.claim_employee_run(
+        message="动态业务任务",
+        runtime_context={**actor.context, "task_id": "employee-task"},
+        employee_id="employee",
+        fingerprint="original-request",
+        response_kind="json",
+    )
+    assert claimed
+    return service, run, dict(run.metadata["runtime_context"]), {"employee_id": "employee"}
+
+
+def _dispatch(
+    service, run, context, options, *, call_id="call", params=None, execute=None, write=False
+):
+    name = "business_db_write" if write else "business_db_read"
+    params = params if params is not None else {"entity": "customers", "limit": 1}
+    return service.dispatch_tool(
+        run.run_id,
+        **options,
+        call_id=call_id,
+        tool_name=name,
+        params=params,
+        runtime_context=context,
+        dispatch=execute or (lambda ctx: execute_workflow_tool(name, params, runtime_context=ctx)),
+    )
+
+
+@pytest.mark.parametrize("kernel", ["legacy", "employee"])
+def test_approval_updates_original_call_then_replays_verified_business_receipt(
+    trusted_actor, reviewed_agent_http, kernel
+):
+    from app.db.models.purchase_unit import PurchaseUnit
+    from app.infrastructure.tenant_scope import tenant_scope
+
+    actor = trusted_actor()
+    http = reviewed_agent_http(actor)
+    service, run, context, options = _claim(actor, kernel)
+    params = {"entity": "customers", "operation": "create", "payload": {"unit_name": "原始回执"}}
+    pending = _dispatch(service, run, context, options, params=params, write=True)
+    assert pending["outcome"] == "waiting_approval"
+    forbidden = Mock(side_effect=AssertionError("receipt replay must never dispatch"))
+    waiting = http.repository.get(run.run_id)
+    assert (
+        _dispatch(service, run, context, options, params=params, execute=forbidden, write=True)
+        == pending
+    )
+    assert http.repository.get(run.run_id).to_dict() == waiting.to_dict()
+    with tenant_scope(actor.tenant_id), actor.factory() as db:
+        assert db.query(PurchaseUnit).filter_by(unit_name="原始回执").count() == 0
+    review = http.client.get(f"/api/agent/runs/{run.run_id}")
+    assert review.status_code == 200, review.text
+    approved = http.client.post(
+        f"/api/agent/runs/{run.run_id}/continue",
+        json={"approval_grant": review.json()["approval"]["grant"]},
+    )
+    assert approved.status_code == 202, approved.text
+    assert http.queue.claim("dynamic-receipt-test", lease_seconds=60).run_id == run.run_id
+    completed = AgentOrchestrator().execute_dispatched_run(run.run_id)
+    assert completed.status == "completed", completed.to_dict()
+    assert len(completed.steps) == len(completed.tool_calls) == 1
+    call = completed.tool_calls[0]
+    assert call.call_id == "call" and call.step_id == waiting.steps[0].step_id
+    assert call.metadata["model_params"] == params
+    assert call.output == completed.steps[0].output
+    assert call.output["business_verification"]["verified"] is True
+    assert call.metadata["independent_verification"]["verified"] is True
+    assert call.status == "completed" and call.finished_at
+    assert call.metadata["usage_ledger"]["usage_key"] == f"{run.run_id}:call:tool_call"
+    assert sum(event.event_type == "billing.recorded" for event in completed.events) == 1
+    before = http.repository.get(run.run_id).to_dict()
+    for _ in range(2):
+        replay = _dispatch(
+            service, run, context, options, params=params, execute=forbidden, write=True
+        )
+        assert replay == call.output
+        replay["business_verification"]["verified"] = False
+    assert http.repository.get(run.run_id).to_dict() == before
+    forbidden.assert_not_called()
+    with tenant_scope(actor.tenant_id), actor.factory() as db:
+        rows = (
+            db.query(PurchaseUnit).filter_by(unit_name="原始回执", tenant_id=actor.tenant_id).all()
+        )
+        assert len(rows) == 1
+        assert str(rows[0].id) in str(call.output["business_verification"])
+
+
+@pytest.mark.parametrize("kernel", ["legacy", "employee"])
+@pytest.mark.parametrize(
+    "receipt",
+    [{}, {"success": False, "outcome": "unknown", "receipt_id": "original", "retryable": False}],
+)
+def test_missing_or_unknown_receipt_remains_unresolved_on_replay(
+    trusted_actor, reviewed_agent_http, kernel, receipt
+):
+    actor = trusted_actor()
+    http = reviewed_agent_http(actor)
+    service, run, context, options = _claim(actor, kernel)
+    original = _dispatch(service, run, context, options, execute=Mock(return_value=receipt))
+    stored = http.repository.get(run.run_id)
+    if not receipt:
+        # A crash after durable intent, before any receipt was stored.
+        stored.tool_calls[0].output = {}
+        http.repository.save(stored)
+    before = http.repository.get(run.run_id).to_dict()
+    forbidden = Mock(side_effect=AssertionError("unresolved call cannot dispatch"))
+    replay = _dispatch(service, run, context, options, execute=forbidden)
+    assert replay["outcome"] == "unknown" and replay["retryable"] is False
+    if receipt:
+        assert replay == original == stored.tool_calls[0].output
+        assert replay["receipt_id"] == receipt["receipt_id"]
+    else:
+        assert replay["reconciliation_required"] is True
+    assert http.repository.get(run.run_id).to_dict() == before
+    forbidden.assert_not_called()
+
+
+def test_changed_approved_step_cannot_replace_original_dynamic_call(
+    trusted_actor, reviewed_agent_http
+):
+    actor = trusted_actor()
+    http = reviewed_agent_http(actor)
+    service, run, context, options = _claim(actor, "legacy")
+    params = {"entity": "customers", "operation": "create", "payload": {"unit_name": "原客户"}}
+    assert _dispatch(service, run, context, options, params=params, write=True)["pending_approval"]
+    waiting = http.repository.get(run.run_id)
+    step = waiting.steps[0]
+    step.params["payload"]["unit_name"] = "篡改客户"
+    before = waiting.to_dict()
+    executor = Mock()
+    with pytest.raises(ValueError, match="审批调用已绑定不同动作"):
+        AgentOrchestrator(repository=http.repository, tool_executor=executor)._execute_step(
+            waiting, step, runtime_context=context, node_outputs={}
+        )
+    assert waiting.to_dict() == before
+    executor.execute.assert_not_called()
+    executor.execute_with_deadline.assert_not_called()
+
+
+@pytest.mark.parametrize("kernel", ["legacy", "employee"])
+@pytest.mark.parametrize(
+    "outer,inner,expected",
+    [
+        ({"success": False}, {"success": True}, "failure"),
+        ({"outcome": "unknown"}, {"success": True}, "unknown"),
+        ({"outcome": "waiting_approval"}, {"success": True}, "waiting_approval"),
+        ({"outcome": "pending"}, {"success": True}, "pending"),
+        ({"outcome": "cancelled"}, {"success": True}, "cancelled"),
+        ({"success": True}, {"outcome": "unknown"}, "unknown"),
+        ({"success": False}, {"outcome": "unknown"}, "unknown"),
+        ({"success": True}, {"success": False}, "failure"),
+        ({"success": True}, {"success": True}, "success"),
+    ],
+)
+def test_outer_or_inner_non_success_cannot_be_upgraded_by_nested_success(
+    trusted_actor, reviewed_agent_http, kernel, outer, inner, expected
+):
+    actor = trusted_actor()
+    http = reviewed_agent_http(actor)
+    service, run, context, options = _claim(actor, kernel)
+    dispatched = Mock(return_value={**outer, "result": {**inner, "data": []}})
+    args = {"tool_id": "business_db", "action": "read", "params": {"entity": "customers"}}
+    receipt = service.dispatch_tool(
+        run.run_id,
+        **options,
+        call_id="nested",
+        tool_name="execute_erp_capability",
+        params=args,
+        runtime_context=context,
+        dispatch=dispatched,
+    )
+    stored = http.repository.get(run.run_id)
+    call = stored.tool_calls[0]
+    assert receipt["result"] == {**inner, "data": []}
+    assert call.output == receipt
+    assert call.metadata["independent_verification"]["verified"] is (expected == "success")
+    assert (call.status == "completed") is (expected == "success")
+    if expected != "success":
+        assert receipt["success"] is False and receipt["outcome"] == expected
+    assert (
+        service.dispatch_tool(
+            run.run_id,
+            **options,
+            call_id="nested",
+            tool_name="execute_erp_capability",
+            params=args,
+            runtime_context=context,
+            dispatch=dispatched,
+        )
+        == receipt
+    )
+    dispatched.assert_called_once()
+
+
+@pytest.mark.parametrize("kernel", ["legacy", "employee"])
+@pytest.mark.parametrize("status", ["completed", "cancelled", "paused", "blocked"])
+def test_stopped_run_replays_exact_call_without_changing_state_or_running_new_call(
+    trusted_actor, reviewed_agent_http, kernel, status
+):
+    actor = trusted_actor()
+    http = reviewed_agent_http(actor)
+    service, run, context, options = _claim(actor, kernel)
+    receipt = _dispatch(service, run, context, options)
+    assert receipt["success"] is True
+    stopped = http.repository.get(run.run_id)
+    stopped.status = status
+    stopped.metadata["recovery"] = {"state": "manual_reconciliation_required"}
+    http.repository.save(stopped)
+    before = http.repository.get(run.run_id).to_dict()
+    forbidden = Mock(side_effect=AssertionError("stopped run cannot dispatch"))
+    assert _dispatch(service, run, context, options, execute=forbidden) == receipt
+    with pytest.raises(ValueError, match="绑定不同动作"):
+        _dispatch(
+            service,
+            run,
+            context,
+            options,
+            params={"entity": "customers", "limit": True},
+            execute=forbidden,
+        )
+    new = _dispatch(service, run, context, options, call_id="new-call", execute=forbidden)
+    assert new["outcome"] == "unknown" and new["retryable"] is False
+    assert http.repository.get(run.run_id).to_dict() == before
+    forbidden.assert_not_called()
+
+
+@pytest.mark.parametrize("kernel", ["legacy", "employee"])
+@pytest.mark.parametrize(
+    "attack", ["missing_actor", "foreign_actor", "foreign_tenant", "foreign_mod", "revoked_session"]
+)
+def test_persisted_receipt_requires_current_authenticated_scope(
+    trusted_actor, reviewed_agent_http, kernel, attack
+):
+    from app.db.models.user import Session
+
+    actor = trusted_actor()
+    http = reviewed_agent_http(actor)
+    service, run, context, options = _claim(actor, kernel)
+    assert _dispatch(service, run, context, options)["success"]
+    forged = deepcopy(context)
+    if attack == "missing_actor":
+        forged.pop("_actor_authorization")
+    elif attack == "foreign_actor":
+        forged.update(trusted_actor().context)
+    elif attack == "foreign_tenant":
+        forged.update(trusted_actor(tenant_id=8).context)
+    elif attack == "foreign_mod":
+        forged.update(trusted_actor(user_id=actor.user_id, mod_id="other-mod").context)
+    else:
+        with actor.factory.begin() as db:
+            db.delete(db.get(Session, actor.session_row_id))
+    before = http.repository.get(run.run_id).to_dict()
+    forbidden = Mock(side_effect=AssertionError("unauthorized replay cannot dispatch"))
+    with pytest.raises(ValueError):
+        _dispatch(service, run, forged, options, execute=forbidden)
+    assert http.repository.get(run.run_id).to_dict() == before
+    forbidden.assert_not_called()
