+def test_batch_verifier_rejects_tampered_receipts_and_actual_database_fields(
+    corruption, batch_runtime, approved_tool_context, monkeypatch
+):
+    from app.application.agent_orchestrator.tool_executor import AgentToolExecutor
+    from app.application.facades import tools_facade
+    from app.db.models.product import Product
+    from app.infrastructure.tenant_scope import tenant_scope
+
+    actor, step = batch_runtime, _batch_step([{"name": "A"}, {"name": "B"}])
+    context = approved_tool_context(actor, step)
+    dispatch = tools_facade.execute_registered_workflow_tool
+
+    def corrupted(*args):
+        result = dispatch(*args)
+        if corruption == "wrong_id":
+            result["product_ids"][0] = 999999
+            result["products"][0]["product_id"] = 999999
+        elif corruption == "wrong_owner":
+            result["products"][0]["tenant_id"] = 8
+        elif corruption == "partial":
+            result["product_ids"].pop()
+            result["products"].pop()
+        elif corruption == "count":
+            result["success_count"] = 1
+        elif corruption == "proof":
+            result["creation_proof"] = "0" * 64
+        elif corruption == "claim_owner":
+            from app.db.models.agent import AgentBusinessActionRecord
+
+            with actor.factory.begin() as db:
+                db.query(AgentBusinessActionRecord).one().owner = "another-dispatch-owner"
+        else:
+            with tenant_scope(actor.tenant_id), actor.factory.begin() as db:
+                row = db.get(Product, result["product_ids"][0])
+                if corruption == "db_owner":
+                    row.tenant_id = 8
+                elif corruption == "db_id":
+                    row.id = 999999
+                elif corruption == "missing":
+                    db.delete(row)
+                else:
+                    row.name = "实际被替换"
+        return result
+
+    monkeypatch.setattr(tools_facade, "execute_registered_workflow_tool", corrupted)
+    result = AgentToolExecutor().execute(step, runtime_context=context)
+    assert result["outcome"] == "unknown" and not result["success"]
+    assert len(_rows(actor)) == (1 if corruption in {"db_owner", "missing"} else 2)
