+def _verify_product_batch(params, result, context):
+    from sqlalchemy.exc import SQLAlchemyError
+
+    from app.application.agent_orchestrator.business_action_ledger import product_batch_creation
+    from app.application.business_db_write_verification import _model_config, _same_value
+    from app.db.models.product import Product
+    from app.db.session import get_db
+    from app.infrastructure.tenant_scope import tenant_id_for_write
+
+    evidence = {"verified": False, "product_ids": result.get("product_ids", [])}
+    checked = {**result, "business_verification": evidence}
+    try:
+        submitted, ids = params.get("products"), result.get("product_ids")
+        tenant = tenant_id_for_write()
+        if (
+            not isinstance(submitted, list)
+            or not submitted
+            or not isinstance(ids, list)
+            or len(ids) != len(submitted)
+            or any(type(value) is not int or value <= 0 for value in ids)
+            or len(set(ids)) != len(ids)
+            or type(result.get("success_count")) is not int
+            or result["success_count"] != len(submitted)
+            or type(result.get("failed_count")) is not int
+            or result["failed_count"] != 0
+            or str(tenant) != str(context.get("tenant_id") or "")
+        ):
+            return checked, False
+        manifest = [
+            {"index": index, "product_id": product_id, "tenant_id": tenant}
+            for index, product_id in enumerate(ids)
+        ]
+        creation = product_batch_creation(
+            params, context, states={"claimed", "unknown", "completed"}
+        )
+        proof = result.get("creation_proof")
+        if (
+            result.get("products") != manifest
+            or not isinstance(proof, str)
+            or not hmac.compare_digest(proof, creation.receipt_proof(manifest))
+        ):
+            return checked, False
+        data = result.get("data") or {}
+        if any(
+            key in data and data[key] != result[key]
+            for key in ("success_count", "failed_count", "product_ids")
+        ):
+            return checked, False
+        _, aliases, _ = _model_config("products")
+        with get_db() as db:
+            rows = (
+                db.query(Product).filter_by(tenant_id=tenant, created_at=creation.created_at).all()
+            )
+            by_id = {row.id: row for row in rows}
+            if len(rows) != len(ids) or set(by_id) != set(ids):
+                return checked, False
+            for product_id, wanted in zip(ids, submitted):
+                row = by_id[product_id]
+                expected = {
+                    "price": 0,
+                    "description": "",
+                    "model_number": None,
+                    "specification": None,
+                    "quantity": None,
+                    "category": None,
+                    "brand": None,
+                    "unit": "个",
+                    "is_active": 1,
+                }
+                expected.update({aliases.get(key, key): value for key, value in wanted.items()})
+                if any(
+                    not hasattr(row, key) or not _same_value(getattr(row, key), value)
+                    for key, value in expected.items()
+                ) or any(
+                    not hasattr(row, aliases.get(key, key))
+                    or not _same_value(getattr(row, aliases.get(key, key)), value)
+                    for key, value in wanted.items()
+                ):
+                    return checked, False
+        evidence.update(verified=True, tenant_id=tenant, count=len(ids))
+        return checked, True
+    except (SQLAlchemyError, *RECOVERABLE_ERRORS):
+        return checked, False
+
+
