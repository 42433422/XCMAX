+def test_batch_readback_failure_remains_unknown_then_reconciles_without_reexecution(
+    batch_runtime, approved_tool_context, monkeypatch
+):
+    from contextlib import contextmanager
+
+    from app.application.agent_orchestrator.business_action_ledger import BusinessActionLedger
+    from app.application.agent_orchestrator.tool_executor import AgentToolExecutor
+    from app.application.agent_orchestrator.tool_spec import get_tool_action_spec
+    from app.application.facades import tools_facade
+    from app.db import session
+
+    actor, step = batch_runtime, _batch_step()
+    context = approved_tool_context(actor, step, business_action_id="batch:readback-fault")
+    dispatch, actual_db = tools_facade.execute_registered_workflow_tool, session.get_db
+
+    @contextmanager
+    def unavailable():
+        raise OSError("independent readback unavailable")
+        yield  # pragma: no cover
+
+    def persisted_but_readback_unavailable(*args):
+        result = dispatch(*args)
+        monkeypatch.setattr(session, "get_db", unavailable)
+        return result
+
+    monkeypatch.setattr(
+        tools_facade, "execute_registered_workflow_tool", persisted_but_readback_unavailable
+    )
+    result = AgentToolExecutor().execute(step, runtime_context=context)
+    assert result["outcome"] == "unknown" and len(_rows(actor)) == 1
+    replay_step = _batch_step()
+    replay_context = approved_tool_context(
+        actor, replay_step, business_action_id="batch:readback-fault"
+    )
+    assert (
+        AgentToolExecutor().execute(replay_step, runtime_context=replay_context)["outcome"]
+        == "unknown"
+    )
+    monkeypatch.setattr(session, "get_db", actual_db)
+    recovered = BusinessActionLedger().reconcile(
+        get_tool_action_spec("products", "batch_create"), step.params, context
+    )
+    assert recovered["reconciled"] and recovered["business_verification"]["verified"]
+    assert len(_rows(actor)) == 1
 
 
