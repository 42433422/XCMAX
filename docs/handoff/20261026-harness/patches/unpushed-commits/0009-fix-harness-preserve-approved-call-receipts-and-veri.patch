@@ -43,6 +46,59 @@ def _action_identity(spec, params: dict, context: dict) -> tuple[str, str]:
     return key, fingerprint
 
 
+@dataclass(frozen=True)
+class ProductBatchCreation:
+    action_key: str
+    fingerprint: str
+    owner: str
+    created_at: datetime
+
+    def receipt_proof(self, products: list[dict]) -> str:
+        from app.application.agent_orchestrator.approval_grant import _secret
+
+        return hmac.new(
+            _secret().encode(),
+            canonical_hash(
+                [
+                    "products.batch_create.receipt.v1",
+                    self.action_key,
+                    self.fingerprint,
+                    self.owner,
+                    products,
+                ]
+            ).encode(),
+            hashlib.sha256,
+        ).hexdigest()
+
+
+def product_batch_creation(
+    params: dict, context: dict, *, states: set[str]
+) -> ProductBatchCreation:
+    """Read the existing immutable claim; this is evidence, never write authorization."""
+    from app.application.agent_orchestrator.tool_spec import get_tool_action_spec
+
+    spec = get_tool_action_spec("products", "batch_create")
+    key, fingerprint = _action_identity(spec, params, context)
+    with BusinessActionLedger()._runs.transaction(read_only=True) as db:
+        record = db.get(AgentBusinessActionRecord, key)
+        if (
+            record is None
+            or record.fingerprint != fingerprint
+            or record.state not in states
+            or record.user_id != str(context.get("user_id") or "")
+            or record.tenant_id != str(context.get("tenant_id") or "")
+            or record.tool_id != "products"
+            or record.action != "batch_create"
+        ):
+            raise ValueError("产品批次缺少匹配的持久业务动作")
+        return ProductBatchCreation(
+            record.action_key,
+            record.fingerprint,
+            record.owner,
+            datetime.fromisoformat(record.created_at).astimezone(UTC).replace(tzinfo=None),
+        )
+
+
 def unknown_action(**evidence: Any) -> dict[str, Any]:
