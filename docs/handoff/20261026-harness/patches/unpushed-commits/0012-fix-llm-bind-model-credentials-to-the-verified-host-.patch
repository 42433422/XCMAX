@@ -0,0 +1,265 @@
+"""Real host identities and SQL credentials; synthetic provider transport, no live-model score."""
+
+import json
+from datetime import timedelta
+from unittest.mock import Mock
+
+import httpx
+import pytest
+from starlette.requests import Request
+
+from app.db.models.user import Session as UserSession
+from app.db.models.user import User
+from app.domain.shared_services.conversation import modstore_adapter as adapters
+from app.infrastructure.auth.agent_principal import require_agent_principal
+from app.infrastructure.llm import client
+from app.infrastructure.llm.providers import registry
+from app.utils.time import utc_now_naive
+from tests.fixtures.backend_ci_isolation import trusted_actor as trusted_actor
+
+
+def _request(headers=None, cookie=""):
+    values = dict(headers or {})
+    if cookie:
+        values["Cookie"] = f"session_id={cookie}"
+    return Request(
+        {
+            "type": "http",
+            "method": "POST",
+            "path": "/api/ai/chat",
+            "headers": [(key.lower().encode(), value.encode()) for key, value in values.items()],
+        }
+    )
+
+
+def _set_token(actor, token):
+    with actor.factory.begin() as db:
+        db.get(UserSession, actor.session_row_id).market_access_token = token
+
+
+@pytest.fixture
+def identities(trusted_actor, monkeypatch):
+    from app.fastapi_routes import market_account
+
+    monkeypatch.setattr(market_account, "_MARKET_SESSION_TOKENS", {})
+    monkeypatch.setattr(market_account, "_MARKET_SESSION_REFRESH_TOKENS", {})
+    monkeypatch.setenv("XCAGI_MARKET_BASE_URL", "https://model-owner.invalid")
+    monkeypatch.setenv("XCAGI_LLM_CHAT_FAILOVER", "0")
+    monkeypatch.delenv("FHD_ALLOW_X_USER_ID_HEADER", raising=False)
+    monkeypatch.delenv("XCAGI_WEB_JWT_AUTH", raising=False)
+    return trusted_actor
+
+
+@pytest.mark.parametrize("other_tenant", [7, 8])
+@pytest.mark.parametrize(
+    "credential", ["header_cookie", "cookie", "bearer_session", "web", "web_cookie", "mobile"]
+)
+def test_model_credentials_and_principal_select_the_same_real_session(
+    identities, monkeypatch, credential, other_tenant
+):
+    owner = identities(tenant_id=7)
+    other = identities(tenant_id=other_tenant)
+    _set_token(owner, "synthetic-owner-token")
+    _set_token(other, "synthetic-other-token")
+    headers, cookie = {}, ""
+    if credential == "header_cookie":
+        headers["X-Session-ID"], cookie = owner.session_id, other.session_id
+    elif credential == "cookie":
+        cookie = owner.session_id
+    elif credential == "bearer_session":
+        headers["Authorization"] = f"Bearer {owner.session_id}"
+    else:
+        if credential.startswith("web"):
+            from app.security.web_jwt import issue_web_tokens
+
+            monkeypatch.setenv("XCAGI_WEB_JWT_AUTH", "1")
+            token = issue_web_tokens(user_id=owner.user_id, session_id=owner.session_id)
+        else:
+            from app.security.mobile_jwt import issue_mobile_tokens
+
+            token = issue_mobile_tokens(user_id=owner.user_id, session_id=owner.session_id)
+        if credential == "web_cookie":
+            cookie = token["access_token"]
+        else:
+            headers["Authorization"] = f"Bearer {token['access_token']}"
+    request = _request(headers, cookie)
+    assert require_agent_principal(request, x_user_id=None).user_id == str(owner.user_id)
+    seen = []
+
+    def transport(outbound):
+        seen.append((outbound.headers.get("Authorization"), outbound.read()))
+        assert outbound.url.path == "/api/llm/chat"
+        payload = json.loads(outbound.content)
+        assert (payload["provider"], payload["model"]) == ("xiaomi", "mimo-v2.5-pro")
+        return httpx.Response(200, json={"choices": [{"message": {"content": "synthetic reply"}}]})
+
+    monkeypatch.setattr(
+        adapters,
+        "_httpx_sync_client",
+        lambda **kwargs: httpx.Client(transport=httpx.MockTransport(transport), **kwargs),
+    )
+    model_client = adapters.create_modstore_openai_client_from_request(request)
+    with client.llm_client_scope(model_client, "xiaomi/mimo-v2.5-pro"):
+        output = client.get_openai_compatible_client().chat.completions.create(
+            messages=[{"role": "user", "content": "Synthetic routing probe"}],
+            model=client.resolve_chat_model(),
+        )
+    assert output.choices[0].message.content == "synthetic reply"
+    assert output.model == "xiaomi/mimo-v2.5-pro"
+    assert len(seen) == 1 and seen[0][0] == "Bearer synthetic-owner-token"
+    assert b'"user_id"' not in seen[0][1]
+    assert model_client.adapter.user_id is None
+
+
+@pytest.mark.parametrize(
+    "invalid", ["expired", "disabled", "unresolved", "jwt_wrong_owner", "jwt_bad_signature"]
+)
+def test_invalid_identity_never_borrows_cookie_environment_or_latest_owner(
+    identities, monkeypatch, invalid
+):
+    from app.security.web_jwt import issue_web_tokens
+
+    owner, other = identities(), identities()
+    _set_token(owner, "synthetic-owner-token")
+    _set_token(other, "synthetic-other-token")
+    supplied = owner.session_id
+    if invalid == "expired":
+        with owner.factory.begin() as db:
+            db.get(UserSession, owner.session_row_id).expires_at = utc_now_naive() - timedelta(
+                seconds=1
+            )
+    elif invalid == "disabled":
+        with owner.factory.begin() as db:
+            db.get(User, owner.user_id).is_active = False
+    elif invalid == "unresolved":
+        supplied = "synthetic-unknown-session"
+    else:
+        monkeypatch.setenv("XCAGI_WEB_JWT_AUTH", "1")
+        supplied = issue_web_tokens(user_id=owner.user_id, session_id=other.session_id)[
+            "access_token"
+        ]
+        if invalid == "jwt_bad_signature":
+            supplied = supplied.rsplit(".", 1)[0] + ".invalid-signature"
+    monkeypatch.setenv("MODSTORE_AUTH_TOKEN", "synthetic-host-token")
+    request = _request({"X-Session-ID": supplied}, other.session_id)
+    adapter = adapters.ModstorePlatformAdapter.from_request(
+        request,
+        session_id=other.session_id,
+        auth_token="synthetic-explicit-other-token",
+    )
+    assert adapter.auth_token == "" and adapter.user_id is None
+    assert adapter.refresh_token_from_session(request=request, session_id=other.session_id) is False
+
+
+def test_missing_current_token_falls_back_only_to_verified_owner(identities):
+    owner = identities()
+    other = identities()
+    _set_token(owner, "synthetic-owner-token")
+    _set_token(other, "synthetic-other-token")
+    newer_session = identities(user_id=owner.user_id)
+    adapter = adapters.ModstorePlatformAdapter.from_request(newer_session.request)
+    assert adapter.auth_token == "synthetic-owner-token"
+
+
+@pytest.mark.asyncio
+async def test_explicit_llm_port_provider_cannot_replace_the_scoped_account(
+    identities, monkeypatch
+):
+    from app.domain.neuro.cognition.llm_port import LLMPort
+
+    owner = identities()
+    _set_token(owner, "synthetic-current-owner-token")
+    monkeypatch.setenv("MODSTORE_PLATFORM_URL", "https://other-host.invalid")
+    monkeypatch.setenv("MODSTORE_AUTH_TOKEN", "synthetic-other-host-token")
+    seen = []
+
+    def transport(request):
+        seen.append(request.headers["Authorization"])
+        assert request.url.host == "model-owner.invalid"
+        return httpx.Response(200, json={"choices": [{"message": {"content": "owner reply"}}]})
+
+    monkeypatch.setattr(
+        adapters,
+        "_httpx_sync_client",
+        lambda **kwargs: httpx.Client(transport=httpx.MockTransport(transport), **kwargs),
+    )
+    registry._register_llm_port_source()
+    with client.llm_client_scope(
+        adapters.create_modstore_openai_client_from_request(owner.request), "xiaomi/mimo-v2.5-pro"
+    ):
+        assert (
+            await LLMPort().chat(
+                [{"role": "user", "content": "Synthetic explicit-provider probe"}],
+                provider="modstore",
+            )
+            == "owner reply"
+        )
+    assert seen == ["Bearer synthetic-current-owner-token"]
+
+
+def test_active_mod_cannot_replace_the_host_session_token(identities, monkeypatch, tmp_path):
+    from sqlalchemy import create_engine
+
+    from app import db as host_db
+    from app.db.db_base import Base
+    from app.request_active_mod_ctx import reset_request_active_mod_id, set_request_active_mod_id
+
+    owner = identities(mod_id="model-owner-probe")
+    _set_token(owner, "synthetic-host-owner-token")
+    url = f"sqlite:///{tmp_path / 'business-mod.sqlite'}"
+    engine = create_engine(url)
+    Base.metadata.create_all(engine)
+    engine.dispose()
+    monkeypatch.setenv("XCAGI_MOD_DATABASE_URL_MODEL_OWNER_PROBE", url)
+    marker = set_request_active_mod_id("model-owner-probe")
+    try:
+        with host_db.SessionLocal() as business_db:
+            assert str(business_db.bind.url) == url
+            assert business_db.query(UserSession).count() == 0
+        assert (
+            adapters.ModstorePlatformAdapter.from_request(owner.request).auth_token
+            == "synthetic-host-owner-token"
+        )
+    finally:
+        reset_request_active_mod_id(marker)
+
+
+@pytest.mark.asyncio
+async def test_unscoped_llm_port_never_selects_an_existing_user_account(identities, monkeypatch):
+    from app.domain.neuro.cognition import llm_port
+    from app.fastapi_routes import market_account
+
+    owner = identities()
+    _set_token(owner, "synthetic-existing-user-token")
+    for name in (
+        "OPENAI_API_KEY",
+        "DEEPSEEK_API_KEY",
+        "XCAUTO_API_KEY",
+        "XCAUTO_PAT",
+        "XIUCI_API_KEY",
+        "MODSTORE_AUTH_TOKEN",
+        "MIMO_API_KEY",
+        "XIAOMI_API_KEY",
+    ):
+        monkeypatch.delenv(name, raising=False)
+    latest = Mock(side_effect=AssertionError("Ownerless market fallback is forbidden"))
+    monkeypatch.setattr(market_account, "latest_session_market_token", latest)
+    monkeypatch.setattr(registry, "_registry", None)
+    registry._register_llm_port_source()
+    port = llm_port.LLMPort()
+    assert port.is_available is False
+    assert await port.chat([{"role": "user", "content": "Synthetic no-owner probe"}]) is None
+    latest.assert_not_called()
+
