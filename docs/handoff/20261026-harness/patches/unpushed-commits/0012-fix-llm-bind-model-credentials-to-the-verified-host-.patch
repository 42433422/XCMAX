+    monkeypatch.setenv("XCAGI_GUARDRAILS_ENABLED", "0")
+    selected = registry.LLMProviderRegistry().resolve()
+    assert selected.provider_id == "modstore" and selected.is_configured
+    assert selected._adapter.auth_token == "synthetic-system-token"
