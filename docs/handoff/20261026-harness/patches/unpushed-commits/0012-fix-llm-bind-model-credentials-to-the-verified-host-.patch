+def verified_model_session_id(request: Request) -> str:
+    """Select model credentials from the very session that authorized the actor."""
+    from app.db import HostSessionLocal
+    from app.db.models.user import Session as UserSession
+    from app.infrastructure.auth.agent_principal import require_agent_principal
+    from app.utils.time import utc_now_naive
+
+    if not session_id_from_request(request):
+        return ""
+    principal = require_agent_principal(request, x_user_id=None)
+    binding = principal.actor_authorization or {}
+    if type(binding.get("session_row_id")) is not int:
+        return ""
+    with HostSessionLocal() as db:
+        row = db.get(UserSession, binding.get("session_row_id"))
+        if (
+            row is not None
+            and str(row.user_id) == principal.user_id
+            and row.expires_at > utc_now_naive()
+            and row.user is not None
+            and row.user.is_active
+        ):
+            return row.session_id
+    return ""
 
 
