+@pytest.mark.parametrize("fault", ["missing_file", "wrong_target", "old_unchanged_output"])
+def test_independent_employee_readback_cannot_confirm_wrong_or_old_artifact(employee_http, fault):
+    from app.application.agent_orchestrator.business_action_verification import verify_action_result
+    from app.application.agent_orchestrator.tool_spec import get_tool_action_spec
+    from app.application.employee_runtime.loader import prepare_employee_tool_call
+
+    case = employee_http
+    result = case.http.request(
+        "POST",
+        f"/api/mod/{case.pack.pack_id}/employees/{case.pack.pack_id}/run",
+        json={"file_path": case.upload()["file_path"]},
+    )
+    assert result.run.status == "completed", result.output
+    step = result.run.steps[0]
+    context = {**result.run.metadata["runtime_context"], **result.run.metadata["task_context"]}
+    path = Path(result.output["business_verification"]["artifacts"][0]["path"])
+    output = json.loads(json.dumps(result.output))
+    if fault == "missing_file":
+        path.unlink()
+    elif fault == "wrong_target":
+        output["output"]["result"]["outputs"][0]["output"]["items"][0]["output_path"] = str(
+            case.workspace / "other.json"
+        )
+    else:
+        raw = {key: value for key, value in step.params.items() if key != "execution_snapshot"}
+        raw["output_path"] = str(path)
+        _, _, prepared = prepare_employee_tool_call(
+            case.pack.pack_id,
+            "execute",
+            raw,
+            {**case.actor.context, "task_id": "new-action-with-old-output"},
+        )
+        step.params, context = (
+            prepared,
+            {**case.actor.context, "task_id": "new-action-with-old-output"},
+        )
+    checked, verified = verify_action_result(
+        get_tool_action_spec(case.pack.pack_id, "execute"),
+        step.params,
+        output,
+        runtime_context=context,
+    )
+    assert verified is False
+    assert checked["business_verification"]["verified"] is False
+
