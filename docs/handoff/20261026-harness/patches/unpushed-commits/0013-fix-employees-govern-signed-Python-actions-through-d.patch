+def test_same_task_two_calls_keep_distinct_reviewed_artifacts(employee_http):
+    from app.application.agent_orchestrator import AgentOrchestrator
+    from app.application.employee_runtime.loader import prepare_employee_tool_call
+    from app.application.workflow.workflow_types import PlanGraph, WorkflowNode
+
+    case = employee_http
+    inputs = [case.upload(content=f"value\n{value}\n".encode()) for value in ("one", "two")]
+    context = {**case.actor.context, "task_id": "two-conversions-one-task"}
+    nodes = []
+    for i, upload in enumerate(inputs):
+        tool, action, params = prepare_employee_tool_call(
+            case.pack.pack_id,
+            "execute",
+            {"file_path": upload["file_path"], "user_request": "读取CSV"},
+            {**context, "call_id": f"model-call-{i}"},
+        )
+        nodes.append(
+            WorkflowNode(
+                node_id=f"model-call-{i}",
+                tool_id=tool,
+                action=action,
+                params=params,
+                risk="high",
+                idempotent=False,
+            )
+        )
+    run = AgentOrchestrator().start_run_from_plan(
+        user_id=str(case.actor.user_id),
+        message="读取两份CSV",
+        plan=PlanGraph(
+            plan_id="two-files",
+            intent="convert",
+            todo_steps=["one", "two"],
+            nodes=nodes,
+            risk_level="high",
+        ),
+        runtime_context=context,
+    )
+    assert run.status == "waiting_user"
+    run = _finish_review(case, run.run_id)
+    assert run.status == "waiting_user"
+    first = Path(run.steps[0].output["business_verification"]["artifacts"][0]["path"])
+    original = first.read_bytes()
+    run = _finish_review(case, run.run_id)
+    assert run.status == "completed", [step.output for step in run.steps]
+    second = Path(run.steps[1].output["business_verification"]["artifacts"][0]["path"])
+    assert first != second and first.read_bytes() == original
+    assert json.loads(original)["rows"] == [{"value": "one"}]
+    assert json.loads(second.read_text())["rows"] == [{"value": "two"}]
