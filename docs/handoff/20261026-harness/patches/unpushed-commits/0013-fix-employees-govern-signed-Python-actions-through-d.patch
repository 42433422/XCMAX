+def execute_controlled_employee_action(
+    employee_id: str, task: str, params: dict, context: dict
+) -> dict:
+    """Private leaf of the registered executor; never re-admit an approved task."""
+    from app.application.agent_orchestrator.tool_executor import registered_dispatch_is_controlled
+    from app.application.employee_runtime.agent import EmployeeAgent
+    from app.application.employee_runtime.loader import (
+        load_employee_pack_from_disk,
+        manifest_actions_handlers,
+        validate_employee_execution_snapshot,
+    )
+
+    if not registered_dispatch_is_controlled(employee_id, "execute"):
+        return {
+            "success": False,
+            "error_code": "employee_tool_control_required",
+            "message": "员工动作必须经统一工具执行器",
+        }
+    pack = load_employee_pack_from_disk(employee_id)
+    payload = {
+        **dict(params.get("input") or {}),
+        **{
+            key: value
+            for key, value in params.items()
+            if key not in {"input", "execution_snapshot"}
+        },
+    }
+    context = dict(context)
+    snapshot = {}
+    try:
+        if "direct_python" in manifest_actions_handlers(pack["manifest"]):
+            snapshot = validate_employee_execution_snapshot(employee_id, params, context)
+            context["workspace_root"] = snapshot["workspace_root"]
+            payload.update(
+                workspace_root=snapshot["workspace_root"],
+                output_path=snapshot["output_path"],
+                output_relpath=snapshot["output_path"],
+            )
+            for item in snapshot["inputs"]:
+                payload[item["parameter"]] = item["path"]
+        from app.application.agent_orchestrator.run_repository import get_agent_run_repository
+
+        repository = get_agent_run_repository()
+        run = repository.get(str(context.get("run_id") or ""))
+        if run is None:
+            raise ValueError("员工执行缺少持久运行记录")
+        run.metadata["employee_id"] = employee_id
+        repository.save(run)
+        context["_employee_run_id"] = run.run_id
+        result = EmployeeAgent(employee_id)._run_authenticated(
+            task,
+            payload,
+            user_id=int(context["user_id"]),
+            workspace_root=context.get("workspace_root"),
+            session_id=context.get("session_id"),
+            runtime_context=context,
+        )
+        if snapshot.get("output_kind") == "structured_result" and result.get("success") is True:
+            from app.application.shipment_excel_etl_security import open_etl_output_file
+
+            outputs = result["result"]["outputs"]
+            saved = outputs[0].get("output", outputs[0]) if len(outputs) == 1 else outputs
+            with open_etl_output_file(
+                snapshot["output_path"], workspace_root=snapshot["workspace_root"]
+            ) as stream:
+                stream.write(
+                    json.dumps(saved, sort_keys=True, ensure_ascii=False, allow_nan=False).encode()
+                )
+            outputs.append({"handler": "durable_result", "output_path": snapshot["output_path"]})
+        return result
+    except ValueError as exc:
+        return {
+            "success": False,
+            "error_code": "employee_execution_snapshot_changed",
+            "message": str(exc),
+            "retryable": False,
+        }
+
+
 __all__ = ["execute_employee_task_local"]
