+@pytest.mark.parametrize("boundary", ["manifest_blocked", "prohibited_employee_execute"])
+def test_formal_grant_never_overrides_employee_hard_risk_boundaries(
+    employee_http, monkeypatch, tmp_path, boundary
+):
+    from app.application.tools.workflow import invalidate_workflow_tool_registry
+    from app.infrastructure.mods.package import ModPackage
+
+    case = employee_http
+    if boundary == "manifest_blocked":
+        path = case.pack.source_dir / "manifest.json"
+        manifest = json.loads(path.read_text())
+        manifest["version"] = "2.0.0"
+        manifest["employee_config_v2"]["identity"]["version"] = "2.0.0"
+        manifest["employee_config_v2"]["risk_level"] = "blocked"
+        path.write_text(json.dumps(manifest))
+        package = ModPackage(str(case.pack.source_dir)).create_package(
+            str(tmp_path / "blocked-pack"),
+            include_signature=True,
+            private_key=str(case.pack.private_key_path),
+        )
+        with monkeypatch.context() as installation:
+            installation.setattr(
+                "app.mod_sdk.employee_runtime.refresh_employee_pack_runtime", lambda _pack_id: None
+            )
+            ok, message = case.pack.registry.install_from_package(package, verify_signature=True)
+        assert ok, message
+        invalidate_workflow_tool_registry()
+    else:
+        import yaml
+
+        boundaries = Path(__file__).parents[2] / "config/autonomy_boundaries.yaml"
+        configured = yaml.safe_load(boundaries.read_text())
+        configured["prohibited_actions"].append(
+            {"action": "employee_execute", "reason": "isolated hard prohibition"}
+        )
+        path = tmp_path / "boundaries.yaml"
+        path.write_text(yaml.safe_dump(configured))
+        monkeypatch.setenv("XCAGI_AUTONOMY_BOUNDARIES_PATH", str(path))
+    run = _start(case)
+    completed = _finish_review(case, run.run_id)
+    assert any(event.event_type == "step.approved" for event in completed.events)
+    assert completed.status != "completed"
+    assert completed.steps[0].output["success"] is False
+    assert not any(case.workspace.rglob("data.json"))
+
