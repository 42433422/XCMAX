+def _bundled_employee_identity(pdir: Path) -> bool:
+    import sys
+
+    from app.mod_sdk.duty_roster import _collect_ids_from_blocks
+
+    host = Path(__file__).resolve().parents[3]
+    roots = [(host / "mods", host / "config")]
+    if getattr(sys, "frozen", False):
+        bundle = Path(sys._MEIPASS).resolve()
+        roots.extend((bundle / rel, bundle / "config") for rel in ("mods", "XCAGI/mods"))
+    for root, config in roots:
+        if pdir.parent != root / "_employees":
+            continue
+        manifest = json.loads((pdir / "manifest.json").read_text())
+        if (
+            manifest.get("id") != pdir.name
+            or manifest.get("artifact") != "employee_pack"
+            or (manifest.get("employee") or {}).get("id") != pdir.name
+        ):
+            return False
+        roster = json.loads((config / "duty_roster.json").read_text())
+        registered = set(
+            _collect_ids_from_blocks(roster.get("departments") or roster.get("areas") or {})
+        )
+        catalog = root / "xcagi-office-employee-pack-bridge/config/office_pack_catalog.json"
+        if catalog.is_file():
+            registered.update(json.loads(catalog.read_text()).get("pack_ids") or [])
+        return pdir.name in registered
+    return False
