+@pytest.fixture
+def signed_employee_pack(tmp_path, monkeypatch):
+    """Factory installing the real CSV worker; the PEM environment survives spawn.
+
+    Call ``factory(version="1.0.0", pack_id="csv-full-read-employee", ... )``.
+    The result exposes mods_root, employee_root, pack_dir, source_dir, package_path,
+    private_key_path, public_key_path, registry, manifest and refresh_calls.
+    ``entry_source`` replaces only the HTTP entry, for import-boundary probes.
+    ``install=False`` leaves a package ready for a caller-controlled installation.
+    """
+    key = Ed25519PrivateKey.generate()
+    private_key = tmp_path / "employee-test-private.pem"
+    private_key.write_bytes(
+        key.private_bytes(
+            serialization.Encoding.PEM,
+            serialization.PrivateFormat.PKCS8,
+            serialization.NoEncryption(),
+        )
+    )
+    public_key = tmp_path / "employee-test-public.pem"
+    public_key.write_bytes(
+        key.public_key().public_bytes(
+            serialization.Encoding.PEM, serialization.PublicFormat.SubjectPublicKeyInfo
+        )
+    )
+    monkeypatch.setenv("XCAGI_MOD_PUBLIC_KEY", str(public_key))
+    monkeypatch.delenv("XCAGI_REQUIRE_SIGNED_MODS", raising=False)
+    monkeypatch.delenv("XCAGI_DISABLE_MODS", raising=False)
+    mods_root = tmp_path / "mods"
+    mods_root.mkdir()
+    monkeypatch.setenv("XCAGI_MODS_ROOT", str(mods_root))
+    monkeypatch.setattr(mod_manager, "_employee_pack_routes_registered", set())
+    source_pack = Path(__file__).resolve().parents[2] / "mods/_employees/csv-full-read-employee"
+    sequence = 0
+
+    def factory(
+        version="1.0.0",
+        *,
+        pack_id="csv-full-read-employee",
+        entry_source=None,
+        signed=True,
+        install=True,
+    ):
+        nonlocal sequence
+        sequence += 1
+        source = tmp_path / f"source-{sequence}"
+        shutil.copytree(source_pack, source, ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))
+        manifest = json.loads((source / "manifest.json").read_text())
+        manifest.update(id=pack_id, version=version)
+        manifest["employee"]["id"] = pack_id
+        manifest["employee_config_v2"]["identity"].update(id=pack_id, version=version)
+        if entry_source is not None:
+            manifest["backend"]["entry"] = "entry"
+            (source / "backend/entry.py").write_text(entry_source)
+        (source / "manifest.json").write_text(json.dumps(manifest, ensure_ascii=False))
+        package = Path(
+            ModPackage(str(source)).create_package(
+                str(tmp_path / "packages"),
+                include_signature=signed,
+                private_key=str(private_key) if signed else None,
+            )
+        )
+        registry = EmployeeRegistry(str(mods_root))
+        refresh_calls = []
+        result = None
+        if install:
+            # Installation is real; importing application-wide routes is a separate probe.
+            with monkeypatch.context() as installation:
+                installation.setattr(
+                    "app.mod_sdk.employee_runtime.refresh_employee_pack_runtime",
+                    refresh_calls.append,
+                )
+                result = registry.install_from_package(str(package), verify_signature=signed)
+            assert result[0], result[1]
+        return SimpleNamespace(
+            mods_root=mods_root,
+            employee_root=mods_root / "_employees",
+            pack_dir=mods_root / "_employees" / pack_id,
+            source_dir=source,
+            pack_id=pack_id,
+            package_path=package,
+            private_key_path=private_key,
+            public_key_path=public_key,
+            registry=registry,
+            manifest=manifest,
+            refresh_calls=refresh_calls,
+            result=result,
+        )
+
+    return factory
+
+
+def _entry(marker: Path, value="executed"):
+    return (
+        "from pathlib import Path\n"
+        f"Path({str(marker)!r}).write_text({value!r})\n"
+        "def register_fastapi_routes(app, mod_id):\n"
+        f"    app.state.employee_version = {value!r}\n"
+    )
+
+
+def _register(pack):
+    app = FastAPI()
+    ok = mod_manager.register_employee_pack_routes(
+        app, mod_manager.ModManager(str(pack.mods_root)), pack.pack_id, force=True
+    )
+    return ok, app
+
