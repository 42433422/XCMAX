+def _verify_employee_artifacts(pack_id, params, result, context):
+    from pathlib import Path
+
+    from app.application.employee_runtime.loader import (
+        _employee_file_snapshot,
+        validate_employee_execution_snapshot,
+    )
+    from app.mod_sdk.employee_tool_registry import _office_output_paths
+
+    evidence = {"verified": False, "method": "artifact_hash_readback"}
+    try:
+        body = validate_employee_execution_snapshot(pack_id, params, context, before=False)
+        paths = _office_output_paths(pack_id, result["output"])
+        expected = {item["path"] for item in body["outputs"]}
+        if not paths or not set(paths).issubset(expected):
+            return {**result, "business_verification": evidence}, False
+        artifacts = [
+            _employee_file_snapshot(Path(item["path"]), context) for item in body["outputs"]
+        ]
+        verified = all(
+            item["size_bytes"] > 0 and item != original["before"]
+            for item, original in zip(artifacts, body["outputs"])
+        )
+        if body.get("output_kind") == "structured_result":
+            from app.application.agent_orchestrator.business_action_ledger import canonical_hash
+            from app.application.shipment_excel_etl_security import open_etl_input_file
+
+            outputs = [
+                item
+                for item in result["output"]["result"]["outputs"]
+                if item.get("handler") != "durable_result"
+            ]
+            expected_result = outputs[0].get("output", outputs[0]) if len(outputs) == 1 else outputs
+            with open_etl_input_file(
+                body["output_path"], workspace_root=body["workspace_root"]
+            ) as stream:
+                verified = verified and canonical_hash(json.load(stream)) == canonical_hash(
+                    expected_result
+                )
+            evidence["method"] = "structured_result_readback"
+        evidence.update(
+            verified=verified,
+            artifacts=artifacts,
+            paths=paths,
+            tenant_id=body["scope"][0],
+            actor_id=body["scope"][1],
+            mod_id=body["scope"][2],
+            pack_id=pack_id,
+            code_sha256=body["code_sha256"],
+        )
+    except RECOVERABLE_ERRORS:
+        pass
+    return {**result, "business_verification": evidence}, evidence["verified"] is True
+
+
 def _verify_product_batch(params, result, context):
     from sqlalchemy.exc import SQLAlchemyError
 
