+"""Real signed-pack admission, durable approval, spawn and owner-scoped artifacts."""
+
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from app.fastapi_routes import platform_shell_routes, tools_execute
+from tests.fixtures.backend_ci_isolation import reviewed_agent_http as reviewed_agent_http
+from tests.fixtures.backend_ci_isolation import trusted_actor as trusted_actor
+from tests.test_infrastructure.test_employee_signed_archive import (
+    signed_employee_pack as signed_employee_pack,
+)
+
+
+@pytest.fixture
+def employee_http(tmp_path, monkeypatch, signed_employee_pack, trusted_actor, reviewed_agent_http):
+    from app.application.tools.workflow import invalidate_workflow_tool_registry
+    from app.mod_sdk.employee_pack_runtime import build_employee_pack
+
+    pack = signed_employee_pack()
+    actor = trusted_actor(mod_id=pack.pack_id)
+    workspace = tmp_path / "workspace"
+    workspace.mkdir()
+    monkeypatch.setenv("WORKSPACE_ROOT", str(workspace))
+    monkeypatch.setenv(
+        "XCAGI_MOD_DATABASE_URLS", json.dumps({pack.pack_id: str(actor.factory.kw["bind"].url)})
+    )
+    invalidate_workflow_tool_registry()
+    http = reviewed_agent_http(actor, platform_shell_routes.router, tools_execute.router)
+    build_employee_pack(
+        pack.pack_id, "csv_full_read_employee", "CSV", str(pack.pack_dir / "backend")
+    )["register_fastapi_routes"](http.client.app, pack.pack_id)
+
+    def upload(owner=actor, content=b"a,b\n1,2\n"):
+        result = http.client.post(
+            "/api/platform-shell/chat-office-file-upload",
+            headers=owner.headers,
+            files={"file": ("sample.csv", content, "text/csv")},
+        )
+        assert result.status_code == 200, result.text
+        return result.json()["data"]
+
+    return SimpleNamespace(pack=pack, actor=actor, http=http, upload=upload, workspace=workspace)
+
+
+def test_signed_employee_http_uses_fresh_grant_sql_queue_spawn_and_owner_readback(employee_http):
+    case = employee_http
+    uploaded = case.upload()
+    result = case.http.request(
+        "POST",
+        f"/api/mod/{case.pack.pack_id}/employees/{case.pack.pack_id}/run",
+        json={"file_path": uploaded["file_path"], "user_request": "读取 CSV"},
+    )
+    assert result.response.status_code == 202, result.response.text
+    assert result.run.status == "completed", json.dumps(result.output, ensure_ascii=False)
+    evidence = result.output["business_verification"]
+    assert evidence["verified"] is True
+    assert evidence["tenant_id"] == str(case.actor.tenant_id)
+    assert evidence["actor_id"] == str(case.actor.user_id)
+    assert evidence["mod_id"] == case.pack.pack_id
+    assert len(result.run.steps) == 1
+    assert {"step.waiting_user", "step.approved"} <= {
+        event.event_type for event in result.run.events
+    }
+    actual = Path(evidence["artifacts"][0]["path"])
+    assert actual.is_relative_to(case.workspace / "mod-workspaces")
+    data = json.loads(actual.read_text())
+    assert data["rows"] == [{"a": "1", "b": "2"}]
+
+
+def _finish_review(case, run_id, *, before_dispatch=None):
+    from app.application.agent_orchestrator import AgentOrchestrator
+
+    review = case.http.client.get(f"/api/agent/runs/{run_id}")
+    assert review.status_code == 200, review.text
+    token = review.json()["approval"]["grant"]
+    if before_dispatch:
+        before_dispatch()
+    continued = case.http.client.post(
+        f"/api/agent/runs/{run_id}/continue", json={"approval_grant": token}
+    )
+    assert continued.status_code == 202, continued.text
+    claimed = case.http.queue.claim("employee-governed-test", lease_seconds=60)
+    assert claimed is not None and claimed.run_id == run_id
+    run = AgentOrchestrator().execute_dispatched_run(run_id)
+    case.http.queue.finish(
+        run_id, "employee-governed-test", "completed" if run.status == "completed" else "blocked"
+    )
+    return run
+
+
+def _start(case, uploaded=None):
+    uploaded = uploaded or case.upload()
+    response = case.http.client.post(
+        f"/api/mod/{case.pack.pack_id}/employees/{case.pack.pack_id}/run",
+        json={"file_path": uploaded["file_path"], "user_request": "读取 CSV"},
+    )
+    assert response.status_code == 202, response.text
+    run = case.http.repository.get(response.json()["run_id"])
+    assert run.status == "waiting_user"
+    assert not any(case.workspace.rglob("data.json"))
+    return run
+
+
+def test_model_erp_employee_uses_original_snapshot_and_exact_receipt_replay(employee_http):
+    from app.application.agent_orchestrator.business_harness import ensure_business_harness_context
+    from app.application.agent_orchestrator.chat_trace import _run_service
+    from app.application.tools import execute_workflow_tool
+
+    case = employee_http
+    uploaded = case.upload()
+    context = ensure_business_harness_context(case.actor.context)
+    service = _run_service()
+    run, claimed = service.claim_employee_run(
+        message="读取CSV",
+        runtime_context=context,
+        employee_id=case.pack.pack_id,
+        fingerprint="erp-regression",
+        response_kind="business_action",
+    )
+    assert claimed
+    args = {
+        "tool_id": "employee",
+        "action": "execute",
+        "params": {
+            "employee_id": case.pack.pack_id,
+            "task": "读取 CSV",
+            "input": {"file_path": uploaded["file_path"]},
+        },
+    }
+    callbacks = []
+
+    def dispatch(ctx):
+        callbacks.append(ctx)
+        return execute_workflow_tool("execute_erp_capability", args, runtime_context=ctx)
+
+    output = service.dispatch_tool(
+        run.run_id,
+        employee_id=case.pack.pack_id,
+        call_id="model-call-1",
+        tool_name="execute_erp_capability",
+        params=args,
+        runtime_context=context,
+        dispatch=dispatch,
+    )
+    assert output["success"] is False
+    pending = case.http.repository.get(run.run_id)
+    assert pending.status == "waiting_user", output
+    assert len(pending.steps) == len(pending.tool_calls) == 1
+    saved = pending.steps[0]
+    assert saved.tool_id == case.pack.pack_id
+    assert saved.params["execution_snapshot"]["body"]["params_sha256"]
+    original_params = json.loads(json.dumps(saved.params))
+    completed = _finish_review(case, run.run_id)
+    assert completed.status == "completed", completed.steps[0].output
+    assert completed.steps[0].params == original_params
+    assert completed.steps[0].output["business_verification"]["verified"] is True
+    artifact = Path(completed.steps[0].output["business_verification"]["artifacts"][0]["path"])
+    before = artifact.stat().st_mtime_ns
+    # Replaying the original model call reads the exact receipt, even if current input changed.
+    (case.workspace / uploaded["file_path"]).write_bytes(b"a,b\n9,9\n")
+    replay = service.dispatch_tool(
+        run.run_id,
+        employee_id=case.pack.pack_id,
+        call_id="model-call-1",
+        tool_name="execute_erp_capability",
+        params=args,
+        runtime_context=context,
+        dispatch=dispatch,
+    )
+    assert replay == completed.tool_calls[0].output
+    assert len(callbacks) == 1
+    assert artifact.stat().st_mtime_ns == before
+
+
+@pytest.mark.parametrize("change", ["input", "code", "snapshot", "params", "output"])
+def test_reviewed_snapshot_changes_never_execute_employee_python(employee_http, change):
+    case = employee_http
+    uploaded = case.upload()
+    run = _start(case, uploaded)
+    step = run.steps[0]
+
+    def change_after_review():
+        if change == "input":
+            (case.workspace / uploaded["file_path"]).write_bytes(b"a,b\n9,9\n")
+        elif change == "code":
+            worker = next((case.pack.pack_dir / "backend" / "employees").glob("*.py"))
+            worker.write_text(worker.read_text() + "\n# changed after review\n")
+        else:
+            if change == "snapshot":
+                step.params["execution_snapshot"]["body"]["code_sha256"] = "0" * 64
+            elif change == "params":
+                step.params["user_request"] = "未经审阅替换"
+            else:
+                step.params["output_path"] = str(case.workspace / "unowned.json")
+            case.http.repository.save(run)
+
+    review = case.http.client.get(f"/api/agent/runs/{run.run_id}")
+    assert review.status_code == 200
+    if change in {"snapshot", "params", "output"}:
+        change_after_review()
+        response = case.http.client.post(
+            f"/api/agent/runs/{run.run_id}/continue",
+            json={"approval_grant": review.json()["approval"]["grant"]},
+        )
+        assert response.status_code == 403, response.text
+    else:
+        current = _finish_review(case, run.run_id, before_dispatch=change_after_review)
+        assert current.status != "completed"
+        assert current.steps[0].output["success"] is False
+    assert not any(case.workspace.rglob("data.json"))
+
+
+@pytest.mark.parametrize("scope", ["actor", "tenant", "mod"])
+def test_uploaded_file_cannot_cross_owner_scope(employee_http, trusted_actor, scope):
+    case = employee_http
+    if scope == "mod":
+        other = trusted_actor(
+            user_id=case.actor.user_id,
+            tenant_id=case.actor.tenant_id,
+            mod_id="xcagi-planner-excel-tools",
+        )
