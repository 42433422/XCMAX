+    from app.mod_sdk.owner_workspace import owner_workspace
+
+    _bound_actor(context)
+    actor = context["_actor_authorization"]
+    owner = json.dumps(
+        [actor["execution_tenant_id"], actor["user_id"], actor["mod_id"]],
+        separators=(",", ":"),
+    )
+    return owner_workspace(pack_id, owner_id=owner).root
+
+
+def _employee_file_snapshot(path: Path, context: dict[str, Any]) -> dict:
+    from app.application.shipment_excel_etl_security import open_etl_input_file
+
+    digest, size = hashlib.sha256(), 0
+    with open_etl_input_file(path, workspace_root=context.get("workspace_root")) as stream:
+        stat = os.fstat(stream.fileno())
+        while chunk := stream.read(1024 * 1024):
+            digest.update(chunk)
+            size += len(chunk)
+    return {
+        "path": str(path),
+        "sha256": digest.hexdigest(),
+        "size_bytes": size,
+        "mtime_ns": stat.st_mtime_ns,
+        "inode": stat.st_ino,
+    }
+
+
+def _employee_snapshot_body(pack_id: str, params: dict, context: dict, *, action_id=None) -> dict:
+    from app.application.agent_orchestrator.business_action_ledger import canonical_hash
+    from app.application.shipment_excel_etl_security import (
+        resolve_etl_output_path,
+        resolve_etl_path,
+    )
+    from app.infrastructure.auth.agent_mod_scope import _bound_actor
+    from app.infrastructure.workspace import workspace_root
+
+    context = {**context, "workspace_root": str(workspace_root())}
+    _bound_actor(context)
+    pack = load_employee_pack_from_disk(pack_id)
+    pdir = Path(pack["pack_dir"])
+    trusted, reason = verify_direct_python_pack_trust(pdir)
+    if not trusted:
+        raise ValueError(f"employee_python_pack_untrusted:{reason}")
+    files = {}
+    for path in sorted(pdir.rglob("*")):
+        relative = path.relative_to(pdir)
+        if "__pycache__" in relative.parts or any(part.startswith(".") for part in relative.parts):
+            continue
+        if path.is_symlink():
+            raise ValueError("员工代码快照不允许符号链接")
+        if path.is_file():
+            files[relative.as_posix()] = hashlib.sha256(path.read_bytes()).hexdigest()
+    scope = context["_actor_authorization"]
+    task_id = str(context.get("task_id") or "")
+    if not task_id:
+        raise ValueError("员工动作缺少持久任务身份")
+    action_id = str(action_id or context.get("call_id") or "employee_action")
+    owner_root = employee_owner_workspace(context, pack_id)
+    workspace = (
+        owner_root
+        / ("task-" + canonical_hash(task_id)[:24])
+        / ("call-" + canonical_hash(action_id)[:24])
+    )
+    inputs = []
+    payload = {
+        **dict(params.get("input") or {}),
+        **{k: v for k, v in params.items() if k != "input"},
+    }
+    if payload.get("handler") or payload.get("code") or payload.get("python"):
+        raise ValueError("员工包动作不能选择任意 Python 或 specialized handler")
+    for key in ("file_path", "path", "excel_path", "template_path", "template_relpath"):
+        if not payload.get(key):
+            continue
+        path = resolve_etl_path(str(payload[key]), workspace_root=context.get("workspace_root"))
+        allowed = [employee_owner_workspace(context), owner_root]
+        if key.startswith("template"):
+            allowed.append(pdir)
+        if not any(path.is_relative_to(root) for root in allowed):
+            raise ValueError("员工输入文件不属于当前账号、租户和 Mod")
+        inputs.append({"parameter": key, **_employee_file_snapshot(path, context)})
+    rule_path = pdir / "rule_spec.json"
+    rules = json.loads(rule_path.read_text()) if rule_path.is_file() else {}
+    actions = parse_employee_config_v2(pack["manifest"]).get("actions") or {}
+    direct = (actions.get("actions") or actions).get("direct_python") or {}
+    structured = (
+        not rules
+        and direct.get("read_only") is True
+        and direct.get("execution_mode") == "deterministic"
+        and direct.get("implementation") == "employee_module"
+        and isinstance(direct.get("input_schema"), dict)
+    )
+    output_kind = "structured_result" if structured else "artifacts"
+    output_name = Path(
+        str(
+            rules.get("default_output_relpath")
+            or ("structured-result.json" if structured else "outputs/data.json")
+        )
+    ).name
+    requested = str(payload.get("output_path") or payload.get("output_relpath") or "")
+    output = (
+        Path(requested)
+        if requested and Path(requested).is_absolute()
+        else workspace / "outputs" / (requested or output_name)
+    )
+    output = resolve_etl_output_path(output, workspace_root=context.get("workspace_root"))
+    if not output.is_relative_to(owner_root):
+        raise ValueError("员工输出文件不属于当前账号、租户和 Mod")
+    outputs = [output]
+    for key, value in rules.items():
+        if key.endswith("output_relpath") and key != "default_output_relpath":
+            secondary = resolve_etl_output_path(
+                output.parent / Path(str(value)).name, workspace_root=context.get("workspace_root")
+            )
+            if secondary not in outputs:
+                outputs.append(secondary)
+    return {
+        "version": 1,
+        "pack_id": pack_id,
+        "pack_version": str(pack.get("version") or ""),
+        "code_sha256": canonical_hash(files),
+        "scope": [scope["execution_tenant_id"], scope["user_id"], scope["mod_id"]],
+        "task_id": task_id,
+        "action_id": action_id,
+        "params_sha256": canonical_hash(params),
+        "workspace_root": str(workspace),
+        "inputs": inputs,
+        "output_path": str(output),
+        "output_kind": output_kind,
+        "outputs": [
+            {
+                "path": str(path),
+                "before": _employee_file_snapshot(path, context) if path.is_file() else None,
+            }
+            for path in outputs
+        ],
+    }
+
+
+def validate_employee_execution_snapshot(
+    pack_id: str, params: dict, context: dict, *, before=True
+) -> dict:
+    from app.application.agent_orchestrator.approval_grant import _secret
+    from app.application.agent_orchestrator.business_action_ledger import canonical_hash
+
+    raw = dict(params)
+    snapshot = raw.pop("execution_snapshot", None)
+    if not isinstance(snapshot, dict) or not isinstance(snapshot.get("body"), dict):
+        raise ValueError("员工动作缺少已审阅执行快照")
+    body = snapshot["body"]
+    proof = hmac.new(
+        _secret().encode(),
+        ("employee.execution.v1:" + canonical_hash(body)).encode(),
+        hashlib.sha256,
+    ).hexdigest()
+    if not hmac.compare_digest(proof, str(snapshot.get("proof") or "")):
+        raise ValueError("员工执行快照签名无效")
+    current = _employee_snapshot_body(pack_id, raw, context, action_id=body.get("action_id"))
+    if not before:
+        for current_output, original in zip(current["outputs"], body.get("outputs") or []):
+            current_output["before"] = original.get("before")
+    if current != body:
+        raise ValueError("员工代码、输入或目标已变化，需要重新审阅")
+    return body
+
+
+def prepare_employee_tool_call(
+    tool_id: str, action: str, params: dict, context: dict
+) -> tuple[str, str, dict]:
+    """Prepare once before durable approval; background dispatch only validates it."""
+    from app.application.agent_orchestrator.approval_grant import _secret
+    from app.application.agent_orchestrator.business_action_ledger import canonical_hash
+    from app.application.agent_orchestrator.business_harness import ensure_business_harness_context
+    from app.mod_sdk.employee_tool_registry import resolve_tool_to_pack_id
+
+    raw = dict(params)
+    if action != "execute" or (tool_id != "employee" and resolve_pack_dir(tool_id) is None):
+        return tool_id, action, raw
+    if tool_id == "employee" and action == "execute":
+        pack_id = resolve_employee_call_pack_id(raw)
+        payload = dict(raw.get("input") or {})
+        payload.update(
+            {
+                k: v
+                for k, v in raw.items()
+                if k not in {"employee_id", "pack_id", "tool_name", "id", "input"}
+            }
+        )
+        task = str(payload.pop("task", None) or payload.get("user_request") or "执行员工")
+        raw = {
+            key: payload.pop(key)
+            for key in ("file_path", "user_request", "output_path")
+            if key in payload
+        }
+        raw.setdefault("user_request", task)
+        if payload:
+            raw["input"] = payload
+        tool_id = pack_id
+    pack_id = resolve_tool_to_pack_id(tool_id) if action == "execute" else None
+    if not pack_id or resolve_pack_dir(pack_id) is None:
+        return tool_id, action, raw
+    pack = load_employee_pack_from_disk(pack_id)
+    if "direct_python" not in manifest_actions_handlers(pack["manifest"]):
+        return pack_id, action, raw
+    from app.infrastructure.workspace import workspace_root
+
+    context["workspace_root"] = str(workspace_root())
+    if "execution_snapshot" not in raw and context.get("run_id") and context.get("step_id"):
+        from app.application.agent_orchestrator.run_repository import get_agent_run_repository
+        from app.application.agent_orchestrator.unified_task import _assert_reused_run_scope
+
+        run = get_agent_run_repository().get(str(context["run_id"]))
+        if run is not None:
+            _assert_reused_run_scope(
+                run,
+                user_id=str(context["user_id"]),
+                tenant_id=str(context.get("tenant_id") or ""),
+                runtime_context=context,
+            )
+            stored = next(
+                (step for step in run.steps if step.step_id == str(context["step_id"])), None
+            )
+            if (
+                stored is not None
+                and stored.tool_id == pack_id
+                and stored.action == action
+                and "execution_snapshot" in stored.params
+            ):
+                saved = dict(stored.params)
+                saved.pop("execution_snapshot")
+                if canonical_hash(saved) != canonical_hash(raw):
+                    raise ValueError("员工业务参数已绑定原持久步骤，不能替换")
+                context["task_id"] = str(
+                    (run.metadata.get("task_context") or {}).get("task_id")
+                    or context.get("task_id")
+                    or ""
+                )
+                validate_employee_execution_snapshot(pack_id, stored.params, context)
+                return pack_id, action, dict(stored.params)
+    if "execution_snapshot" in raw:
+        validate_employee_execution_snapshot(pack_id, raw, context)
+        return pack_id, action, raw
+    context.update(ensure_business_harness_context(context))
+    body = _employee_snapshot_body(pack_id, raw, context)
+    proof = hmac.new(
+        _secret().encode(),
+        ("employee.execution.v1:" + canonical_hash(body)).encode(),
+        hashlib.sha256,
+    ).hexdigest()
+    return pack_id, action, {**raw, "execution_snapshot": {"body": body, "proof": proof}}
+
+
+def resolve_employee_call_pack_id(params: dict) -> str:
+    """One host registry identity for authorization and prepared dispatch."""
+    from app.mod_sdk.employee_tool_registry import resolve_tool_to_pack_id
+
+    ids = [
+        resolve_tool_to_pack_id(str(params[key]))
+        for key in ("employee_id", "pack_id", "tool_name", "id")
+        if params.get(key)
+    ]
+    if not ids or not all(ids) or len(set(ids)) != 1 or ids[0] == "employee":
+        raise ValueError("员工包未注册或别名身份冲突")
+    return ids[0]
+
+
 def build_employee_context(employee_id: str, input_data: dict[str, Any]) -> dict[str, Any]:
     return {"employee_id": employee_id, "input_data": input_data or {}}
 
