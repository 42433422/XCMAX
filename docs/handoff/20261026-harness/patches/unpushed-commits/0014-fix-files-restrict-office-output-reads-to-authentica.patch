+"""Output reads retain real actor, tenant and active Mod ownership at the file handle."""
+
+import json
+import os
+from datetime import timedelta
+from types import SimpleNamespace
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from app.application.employee_runtime.loader import employee_owner_workspace
+from app.application.office_parse_app_service import read_workspace_output_files
+from app.fastapi_routes.platform_shell_routes import router
+from tests.fixtures.backend_ci_isolation import reviewed_agent_http as reviewed_agent_http
+from tests.fixtures.backend_ci_isolation import trusted_actor as trusted_actor
+from tests.test_application.test_employee_python_governed import employee_http as employee_http
+from tests.test_infrastructure.test_employee_signed_archive import (
+    signed_employee_pack as signed_employee_pack,
+)
+
+
+@pytest.fixture
+def owned_output(tmp_path, monkeypatch, trusted_actor):
+    monkeypatch.setenv("WORKSPACE_ROOT", str(tmp_path))
+    actor = trusted_actor(mod_id="csv-full-read-employee")
+    root = employee_owner_workspace(actor.context, "csv-full-read-employee")
+    path = root / "task" / "outputs" / "data.json"
+    path.parent.mkdir(parents=True)
+    path.write_text(json.dumps({"value": "SYNTHETIC-PRIVATE-OWNER-RESULT"}))
+    app = FastAPI()
+    app.include_router(router)
+    client = TestClient(app)
+    return SimpleNamespace(actor=actor, path=path, client=client, workspace=tmp_path)
+
+
+def _read(case, headers):
+    return case.client.post(
+        "/api/platform-shell/workspace-read-files",
+        headers=headers,
+        json={"workspace_root": str(case.workspace), "file_paths": [str(case.path)]},
+    )
+
+
+def test_actual_owner_can_read_output_without_trusting_body_workspace(owned_output):
+    case = owned_output
+    response = case.client.post(
+        "/api/platform-shell/workspace-read-files",
+        headers=case.actor.headers,
+        json={"workspace_root": "/untrusted-body-root", "file_paths": [str(case.path)]},
+    )
+    assert response.status_code == 200
+    assert response.json()["data"]["files"][0]["json"] == {
+        "value": "SYNTHETIC-PRIVATE-OWNER-RESULT"
+    }
+
+
+def test_anonymous_and_forged_identity_headers_never_read_output(owned_output):
+    case = owned_output
+    for headers in ({}, {"X-User-ID": str(case.actor.user_id), "X-Tenant-ID": "7"}):
+        response = _read(case, headers)
+        assert response.status_code == 401
+        assert "SYNTHETIC-PRIVATE-OWNER-RESULT" not in response.text
+
+
+@pytest.mark.parametrize("scope", ["actor", "tenant", "mod"])
+def test_real_other_scope_cannot_read_known_owner_path(owned_output, trusted_actor, scope):
+    case = owned_output
+    other = trusted_actor(
+        user_id=case.actor.user_id if scope == "mod" else None,
+        tenant_id=99 if scope == "tenant" else case.actor.tenant_id,
+        mod_id="xcagi-planner-excel-tools" if scope == "mod" else "csv-full-read-employee",
+    )
+    response = _read(case, other.headers)
+    assert response.status_code == 200
+    assert response.json()["data"]["files"][0]["error"] == "invalid_path"
+    assert "SYNTHETIC-PRIVATE-OWNER-RESULT" not in response.text
+    assert case.path.is_file()
+
+
+@pytest.mark.parametrize("state", ["expired", "revoked"])
+def test_session_must_remain_valid_and_entitled_at_read_time(owned_output, state):
+    from app.db.models.user import Session as UserSession
+    from app.utils.time import utc_now_naive
+
+    case = owned_output
+    with case.actor.factory.begin() as db:
+        session = db.get(UserSession, case.actor.session_row_id)
+        if state == "expired":
+            session.expires_at = utc_now_naive() - timedelta(seconds=1)
+        else:
+            session.entitled_mod_ids_json = "[]"
+    response = _read(case, case.actor.headers)
+    assert response.status_code in {401, 403}
+    assert "SYNTHETIC-PRIVATE-OWNER-RESULT" not in response.text
+
+
+@pytest.mark.parametrize("link", ["file_symlink", "directory_symlink", "hardlink", "fifo"])
+def test_output_handle_rejects_links_and_special_files(owned_output, link):
+    case = owned_output
+    original = case.path
+    target = case.workspace / "legacy-unowned.json"
+    target.write_text('"SYNTHETIC-UNOWNED-RESULT"')
+    original.unlink()
+    if link == "file_symlink":
+        original.symlink_to(target)
+    elif link == "hardlink":
+        os.link(target, original)
+    elif link == "fifo":
+        os.mkfifo(original)
+    else:
+        original.parent.rmdir()
+        original.parent.symlink_to(target.parent, target_is_directory=True)
+        case.path = original.parent / target.name
+    response = _read(case, case.actor.headers)
+    assert response.status_code == 200
+    assert response.json()["data"]["files"][0]["error"] == "invalid_path"
+    assert "SYNTHETIC-UNOWNED-RESULT" not in response.text
+
+
+def test_legacy_global_file_is_preserved_without_inferred_owner(owned_output):
+    case = owned_output
+    case.path = case.workspace / "outputs" / "data.json"
+    case.path.parent.mkdir()
+    case.path.write_text('"SYNTHETIC-LEGACY-UNOWNED"')
+    response = _read(case, case.actor.headers)
+    assert response.json()["data"]["files"][0]["error"] == "invalid_path"
+    assert case.path.read_text() == '"SYNTHETIC-LEGACY-UNOWNED"'
+
+
+@pytest.mark.parametrize("leaf", ["..", "bad\x00.json", "../data.json"])
+def test_malformed_file_components_never_open_output(owned_output, leaf):
+    case = owned_output
+    case.path = case.path.parent / leaf
+    response = _read(case, case.actor.headers)
+    assert response.status_code == 200
+    assert response.json()["data"]["files"][0]["error"] == "invalid_path"
+    assert "SYNTHETIC-PRIVATE-OWNER-RESULT" not in response.text
+
+
+def test_owner_prefix_cannot_hide_traversal_into_another_real_accounts_file(
+    owned_output, trusted_actor
+):
+    case = owned_output
+    other = trusted_actor(mod_id="csv-full-read-employee")
+    foreign = employee_owner_workspace(other.context, "csv-full-read-employee") / "foreign.json"
+    foreign.parent.mkdir(parents=True)
+    foreign.write_text('{"value":"SYNTHETIC-FORBIDDEN-PEER"}')
+    case.path = case.path.parent / "../../../../../" / foreign.relative_to(case.workspace)
+    response = _read(case, case.actor.headers)
+    assert response.status_code == 200
+    assert "SYNTHETIC-FORBIDDEN-PEER" not in response.text
+    assert response.json()["data"]["files"][0]["error"] == "invalid_path"
+
+
+@pytest.mark.parametrize("replacement", ["before_pin", "after_pin"])
+def test_directory_replacement_cannot_redirect_the_open_file(
+    owned_output, monkeypatch, replacement
+):
+    from app.application import shipment_excel_etl_security as security
+
+    case = owned_output
+    foreign = case.workspace / "other-account-output"
+    foreign.mkdir()
+    (foreign / case.path.name).write_text('"SYNTHETIC-OTHER-ACCOUNT"')
+    original = security._open_directory_under_root
+
+    def replace(directory):
+        directory.rename(directory.with_name("original-output"))
+        directory.symlink_to(foreign, target_is_directory=True)
+
+    def pin(base, directory, **kwargs):
+        if replacement == "before_pin":
+            replace(directory)
+        handle = original(base, directory, **kwargs)
+        if replacement == "after_pin":
+            replace(directory)
+        return handle
+
+    monkeypatch.setattr(security, "_open_directory_under_root", pin)
+    response = _read(case, case.actor.headers)
+    assert response.status_code == 200
+    row = response.json()["data"]["files"][0]
+    if replacement == "before_pin":
+        assert row["error"] == "invalid_path"
+    else:
+        assert row["json"] == {"value": "SYNTHETIC-PRIVATE-OWNER-RESULT"}
+    assert "SYNTHETIC-OTHER-ACCOUNT" not in response.text
+
+
+def test_file_read_is_bounded_before_loading_entire_output(owned_output, monkeypatch):
+    case = owned_output
+    case.path.write_text("0123456789" * 100)
+    actual_fdopen, reads = os.fdopen, []
+
+    class BoundedStream:
+        def __init__(self, stream):
+            self.stream = stream
+
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *args):
+            self.stream.close()
+
+        def fileno(self):
+            return self.stream.fileno()
+
+        def read(self, size):
+            reads.append(size)
+            return self.stream.read(size)
+
+    monkeypatch.setattr(os, "fdopen", lambda *args: BoundedStream(actual_fdopen(*args)))
+    rows = read_workspace_output_files(
+        str(case.workspace), [str(case.path)], runtime_context=case.actor.context, max_bytes=16
+    )
+    assert rows[0]["text"] == "0123456789012345"
+    assert reads == [16]
+
+
+def test_real_signed_employee_artifact_is_readable_only_by_its_actual_owner(
+    employee_http, trusted_actor
+):
+    case = employee_http
+    created = case.http.request(
+        "POST",
+        f"/api/mod/{case.pack.pack_id}/employees/{case.pack.pack_id}/run",
+        json={"file_path": case.upload()["file_path"], "user_request": "读取 CSV"},
+    )
+    assert created.run.status == "completed", created.output
+    proof = created.output["business_verification"]
+    assert proof["verified"] is True
+    body = {"file_paths": [proof["artifacts"][0]["path"]]}
+    own = case.http.client.post("/api/platform-shell/workspace-read-files", json=body)
+    assert own.status_code == 200
+    assert own.json()["data"]["files"][0]["json"]["rows"] == [{"a": "1", "b": "2"}]
+    other = trusted_actor(mod_id=case.pack.pack_id)
+    denied = case.http.client.post(
+        "/api/platform-shell/workspace-read-files", headers=other.headers, json=body
+    )
+    assert denied.json()["data"]["files"][0]["error"] == "invalid_path"
+    assert '"rows"' not in denied.text
