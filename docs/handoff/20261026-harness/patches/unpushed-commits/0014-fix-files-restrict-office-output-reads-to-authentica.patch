+def _read_pinned_output(base: Path, path: Path, *, max_bytes: int) -> bytes:
+    import os
+    import re
+    import stat
+
+    from app.application.shipment_excel_etl_security import (
+        _open_directory_under_root,
+        _windows_open_relative,
+    )
+
+    name = path.name
+    if not re.fullmatch(r"[^/\\]+", name) or name in (".", "..") or "\x00" in name:
+        raise ValueError("output must be one path component")
+    parent = _open_directory_under_root(base, path.parent, create=False)
+    descriptor = None
+    try:
+        descriptor = (
+            _windows_open_relative(parent, name, directory=False, create=False, for_input=True)
+            if os.name == "nt"
+            else os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
+        )
+        stream = os.fdopen(descriptor, "rb")
+        descriptor = None
+        with stream:
+            info = os.fstat(stream.fileno())
+            if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
+                raise ValueError("output must be a private regular file")
+            return stream.read(max_bytes)
+    finally:
+        if descriptor is not None:
+            os.close(descriptor)
+        os.close(parent)
