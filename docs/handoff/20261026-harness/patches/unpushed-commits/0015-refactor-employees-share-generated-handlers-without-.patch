+def test_pack_instances_keep_prompts_and_dispatch_isolated(worker, monkeypatch):
+    spec = importlib.util.spec_from_file_location("second_employee", worker.module.__file__)
+    second = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(second)
+    other = getattr(second, "_worker", second)
+    config_value = {"employee_config_v2": config("llm_md")}
+    for target in (worker.impl, other):
+        monkeypatch.setattr(target, "_load_manifest", lambda: config_value)
+    if hasattr(second, "_worker"):
+        monkeypatch.setattr(other, "system_prompt", "second prompt")
+    else:
+        monkeypatch.setattr(second, "SYSTEM_PROMPT", "second prompt")
+    prompts = []
+
+    async def callback(messages, **_kwargs):
+        prompts.append(messages[0]["content"])
+        await asyncio.sleep(0)
+        return {"ok": True, "content": messages[0]["content"]}
+
+    async def together():
+        return await asyncio.gather(
+            worker.impl.run({}, {"call_llm": callback}),
+            other.run({}, {"call_llm": callback}),
+        )
+
+    results = asyncio.run(together())
+    assert prompts[0].startswith(worker.module.SYSTEM_PROMPT)
+    assert prompts[1].startswith("second prompt") and results[0] != results[1]
+    assert worker.impl._DISPATCH is not other._DISPATCH
+    worker.record(results)
