+@pytest.mark.parametrize(
+    "kind", ["ok", "empty", "failed", "unknown", "none", "list", "timeout", "exception"]
+)
+@pytest.mark.parametrize("handler", ["llm_md", "webhook", "agent"])
+def test_handlers_results_failures_and_timeouts(worker, monkeypatch, handler, kind):
+    calls = []
+    result = {
+        "ok": True,
+        "content": "  content  ",
+        "summary": "summary",
+        "rounds": 2,
+        "tool_calls": [{"tool": "read"}],
+        "status": 201,
+        "text": "body",
+    }
+    result = {
+        "empty": {},
+        "failed": {"ok": False, "error": "denied", "rounds": 3},
+        "unknown": {"ok": False, "outcome": "unknown", "error": "核对原任务", "retryable": False},
+        "none": None,
+        "list": [1],
+    }.get(kind, result)
+
+    async def callback(*args, **kwargs):
+        calls.append([args, kwargs])
+        if kind == "timeout":
+            raise TimeoutError("timeout")
+        if kind == "exception":
+            raise OSError("offline")
+        return result
+
+    actual_wait = asyncio.wait_for
+    timeouts = []
+
+    async def checked_wait(awaitable, timeout):
+        timeouts.append(timeout)
+        return await actual_wait(awaitable, timeout=timeout)
+
+    monkeypatch.setattr(asyncio, "wait_for", checked_wait)
+    ctx = {
+        "call_llm": callback,
+        "http_post": callback,
+        "agent_runner": SimpleNamespace(run=callback),
+    }
+    v2 = config(handler, webhook={"url": "https://example.invalid/hook"})
+    v2["cognition"] = {
+        "agent": {"system_prompt": "## approved", "model": {"max_tokens": 17, "temperature": 0}}
+    }
+    if kind == "list" or (handler == "agent" and kind == "none"):
+        with pytest.raises(AttributeError) as exc:
+            invoke(
+                worker,
+                handler,
+                monkeypatch,
+                payload={"handler": handler, "task": "task"},
+                ctx=ctx,
+                v2=v2,
+            )
+        out = {"exception": type(exc.value).__name__, "message": str(exc.value)}
+    else:
+        out = invoke(
+            worker,
+            handler,
+            monkeypatch,
+            payload={"handler": handler, "task": "task"},
+            ctx=ctx,
+            v2=v2,
+        )
+        assert out["ok"] is (kind == "ok")
+        if kind == "ok":
+            assert out["meta"]["chosen_handler"] == handler
+            if handler == "llm_md":
+                assert out["summary"] == "content" and calls[0][1] == {
+                    "max_tokens": 17,
+                    "temperature": 0.0,
+                }
+            elif handler == "agent":
+                assert out["meta"]["tools_used"] == ["read"] and out["meta"]["rounds"] == 2
+            else:
+                assert out["items"] == [{"status": 201, "text": "body"}]
+        else:
+            assert out["error"]
+    assert timeouts == [{"llm_md": 120.0, "webhook": 30.0, "agent": 300.0}[handler]]
+    worker.record([out, calls, timeouts])
+
