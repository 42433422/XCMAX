+@pytest.mark.parametrize("value", [None, "x" * 4100, [1, 2], {"a": 1}, 3])
+def test_result_envelopes(worker, value):
+    ok = worker.impl._ok(value, warnings=["w"], meta={"m": 1})
+    expected_items = value if isinstance(value, list) else ([] if value is None else [value])
+    assert ok["items"] == expected_items and ok["warnings"] == ["w"] and ok["meta"] == {"m": 1}
+    assert (
+        ok["summary"]
+        == (
+            ""
+            if value is None
+            else value
+            if isinstance(value, str)
+            else json.dumps(value, ensure_ascii=False)
+        )[:4000]
+    )
+    error = worker.impl._err("e" * 1100)
+    assert len(error["summary"]) == 400 and len(error["error"]) == 1000
+    assert error["items"] == [] and error["warnings"] == [] and error["meta"] == {}
+    worker.record([ok, error])
