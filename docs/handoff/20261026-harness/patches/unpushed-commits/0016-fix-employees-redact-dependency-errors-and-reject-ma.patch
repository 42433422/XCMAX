+@pytest.mark.parametrize("handler", ["llm_md", "webhook", "agent"])
+@pytest.mark.parametrize("failure", ["exception", "response"])
+def test_dependency_errors_never_expose_credentials_in_results_or_logs(
+    worker, monkeypatch, caplog, handler, failure
+):
+    import logging
+
+    secret = "SYNTHETIC-EMPLOYEE-PRIVATE-TOKEN"
+
+    async def callback(*_args, **_kwargs):
+        if failure == "exception":
+            raise OSError(secret)
+        return {"ok": False, "error": secret, "rounds": secret}
+
+    caplog.set_level(logging.INFO)
+    result = invoke(
+        worker,
+        handler,
+        monkeypatch,
+        payload={secret: "private", "task": "task"},
+        ctx={
+            "call_llm": callback,
+            "http_post": callback,
+            "agent_runner": SimpleNamespace(run=callback),
+        },
+        v2=config(handler, webhook={"url": "https://example.invalid/hook?token=" + secret}),
+    )
+    assert result["ok"] is False and result["error"]
+    assert secret not in str(result)
+    assert secret not in caplog.text
+
+
+def test_invalid_model_settings_do_not_echo_config_values(worker):
+    secret = "SYNTHETIC-INVALID-MODEL-SECRET"
+    with pytest.raises(ValueError, match="员工模型参数无效") as error:
+        worker.impl._agent_model({"cognition": {"agent": {"model": {"max_tokens": secret}}}})
+    assert secret not in str(error.value)
