diff --git a/FHD/app/mod_sdk/generated_employee_worker.py b/FHD/app/mod_sdk/generated_employee_worker.py
index 81342f0307..e188346efd 100644
--- a/FHD/app/mod_sdk/generated_employee_worker.py
+++ b/FHD/app/mod_sdk/generated_employee_worker.py
@@ -8,6 +8,7 @@ import logging
 from pathlib import Path
 from typing import Any, Dict, List, Optional
 
+from app.application.agent_orchestrator.tool_receipt import tool_receipt_outcome
 from app.mod_sdk.errors import BOUNDARY_ERRORS
 
 DEFAULT_README_SECTIONS = "## 用途\n## 输入\n## 输出\n## 示例\n## 异常与边界\n"
@@ -75,6 +76,32 @@ class GeneratedEmployeeWorker:
                 return cand
         return None
 
+    def _dependency_error(
+        self, result: Any, handler: str, message: str = "员工依赖未成功完成"
+    ) -> Optional[Dict[str, Any]]:
+        receipt = (
+            {
+                **result,
+                "success": result.get("success", result.get("ok")),
+                "reconciliation_required": result.get("reconciliation_required")
+                or result.get("requires_reconciliation"),
+            }
+            if isinstance(result, dict)
+            else None
+        )
+        outcome = tool_receipt_outcome(receipt)
+        if outcome == "success":
+            return None
+        return {
+            **self._err(message, meta={"handler": handler}),
+            "outcome": outcome,
+            "retryable": False,
+            "reconciliation_required": outcome == "unknown",
+            "pending": outcome == "pending",
+            "pending_approval": outcome == "waiting_approval",
+            "cancelled": outcome == "cancelled",
+        }
+
     def _load_manifest(self) -> Optional[Dict[str, Any]]:
         mp = self._manifest_path()
         if not mp:
@@ -158,12 +185,12 @@ class GeneratedEmployeeWorker:
                 timeout=120.0,
             )
         except TimeoutError:
-            return self._err("LLM 调用超时（120s）", meta={"handler": "llm_md"})
+            return self._dependency_error(None, "llm_md", "LLM 调用超时（120s）")
         except BOUNDARY_ERRORS as exc:  # noqa: BLE001
             self.logger.warning("employee LLM failed (%s)", type(exc).__name__)
-            return self._err("LLM 调用异常", meta={"handler": "llm_md"})
-        if not isinstance(res, dict) or not res.get("ok"):
-            return self._err("LLM 调用失败", meta={"handler": "llm_md"})
+            return self._dependency_error(None, "llm_md", "LLM 调用异常")
+        if error := self._dependency_error(res, "llm_md"):
+            return error
         content = str(res.get("content") or "").strip()
         return self._ok(content, meta={"handler": "llm_md", "max_tokens": cfg["max_tokens"]})
 
@@ -186,12 +213,12 @@ class GeneratedEmployeeWorker:
         try:
             r = await asyncio.wait_for(http_post(url, json_body=payload or {}), timeout=30.0)
         except TimeoutError:
-            return self._err("webhook 超时（30s）", meta={"handler": "webhook"})
+            return self._dependency_error(None, "webhook", "webhook 超时（30s）")
         except BOUNDARY_ERRORS as exc:  # noqa: BLE001
             self.logger.warning("employee webhook failed (%s)", type(exc).__name__)
-            return self._err("webhook 异常", meta={"handler": "webhook"})
-        if not isinstance(r, dict) or not r.get("ok"):
-            return self._err("webhook 调用失败", meta={"handler": "webhook"})
+            return self._dependency_error(None, "webhook", "webhook 异常")
+        if error := self._dependency_error(r, "webhook"):
+            return error
         return self._ok(
             {"status": r.get("status"), "text": r.get("text")},
             meta={"handler": "webhook"},
@@ -219,15 +246,12 @@ class GeneratedEmployeeWorker:
                 timeout=300.0,
             )
         except TimeoutError:
-            return self._err("agent 执行超时（300s）", meta={"handler": "agent"})
+            return self._dependency_error(None, "agent", "agent 执行超时（300s）")
         except BOUNDARY_ERRORS as exc:  # noqa: BLE001
             self.logger.warning("employee agent failed (%s)", type(exc).__name__)
-            return self._err("agent 执行异常", meta={"handler": "agent"})
-        if not isinstance(result, dict) or not result.get("ok"):
-            return self._err(
-                "agent 执行失败",
-                meta={"handler": "agent"},
-            )
