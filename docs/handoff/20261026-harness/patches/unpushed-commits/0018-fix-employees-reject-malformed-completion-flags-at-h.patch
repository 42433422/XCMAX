diff --git a/FHD/app/application/employee_runtime/result_verifier.py b/FHD/app/application/employee_runtime/result_verifier.py
index 2880c2e484..fd6f444716 100644
--- a/FHD/app/application/employee_runtime/result_verifier.py
+++ b/FHD/app/application/employee_runtime/result_verifier.py
@@ -4,6 +4,18 @@ from __future__ import annotations
 
 from typing import Any
 
+_APPROVAL_STATES = {"waiting_approval", "waiting_user", "awaiting_approval"}
+
+
+def _invalid_completion_flag(data: dict[str, Any]) -> bool:
+    return any(key in data and type(data[key]) is not bool for key in ("success", "ok"))
+
+
+def _states(data: dict[str, Any]) -> set[str]:
+    return {
+        str(data.get(key) or "").strip().lower() for key in ("execution_state", "status", "outcome")
+    }
+
 
 def verify_employee_run_result(
     employee_id: str,
@@ -37,11 +49,12 @@ def execution_result_error(data: dict[str, Any]) -> str:
     """Inspect canonical result envelopes, never infer success from HTTP delivery."""
     if data.get("error"):
         return str(data["error"])
-    states = {
-        str(data.get(key) or "").strip().lower() for key in ("execution_state", "status", "outcome")
-    }
+    if _invalid_completion_flag(data):
+        return "员工执行回执状态无效，需核对原任务"
+    states = _states(data)
     if (
         states & {"unknown", "pending", "accepted", "running", "failed", "blocked", "cancelled"}
+        or states & _APPROVAL_STATES
         or data.get("reconciliation_required")
         or data.get("requires_reconciliation")
         or data.get("pending_approval")
@@ -68,11 +81,10 @@ def execution_result_error(data: dict[str, Any]) -> str:
 
 def execution_result_requires_reconciliation(data: dict[str, Any]) -> bool:
     """Preserve unknown identity through the same envelopes used by verification."""
-    states = {
-        str(data.get(key) or "").strip().lower() for key in ("execution_state", "status", "outcome")
-    }
+    states = _states(data)
     if (
         states & {"unknown", "accepted", "pending", "running"}
+        or _invalid_completion_flag(data)
         or data.get("reconciliation_required")
         or data.get("requires_reconciliation")
     ):
@@ -89,7 +101,7 @@ def execution_result_requires_reconciliation(data: dict[str, Any]) -> bool:
 
 
 def execution_result_awaits_approval(data: dict[str, Any]) -> bool:
-    if data.get("pending_approval"):
+    if data.get("pending_approval") or _states(data) & _APPROVAL_STATES:
         return True
     children = [data.get("result"), data.get("output")]
     outputs = data.get("outputs")
diff --git a/FHD/tests/application/test_employee_result_verifier.py b/FHD/tests/application/test_employee_result_verifier.py
index 69ab799c75..6c63c3f94c 100644
--- a/FHD/tests/application/test_employee_result_verifier.py
+++ b/FHD/tests/application/test_employee_result_verifier.py
@@ -1,5 +1,10 @@
 from __future__ import annotations
 
+import asyncio
+import json
+
+import pytest
+
 from app.application.employee_runtime.result_verifier import verify_employee_run_result
 
 
@@ -87,3 +92,77 @@ def test_unknown_identity_variants_are_not_verified_and_require_reconciliation()
         for result in (child, {"success": True, "result": {"outputs": [{"output": child}]}}):
             assert verify_employee_run_result("employee", result)[0] is False
             assert execution_result_requires_reconciliation(result) is True
+
+
+@pytest.mark.parametrize("flag", ["ok", "success"])
+@pytest.mark.parametrize("value", ["false", "true", 1, 0, None, [], {}])
+def test_non_boolean_completion_flags_never_prove_success(flag, value):
+    from app.application.employee_runtime.result_verifier import (
+        execution_result_requires_reconciliation,
+    )
+
+    result = {"success": True, "result": {"summary": "done", "output": {flag: value}}}
+    assert verify_employee_run_result("employee", result)[0] is False
+    assert execution_result_requires_reconciliation(result) is True
+
+
+@pytest.mark.parametrize("state", ["waiting_approval", "waiting_user", "awaiting_approval"])
+@pytest.mark.parametrize("key", ["status", "outcome", "execution_state"])
+def test_approval_states_survive_result_wrappers(key, state):
+    from app.application.employee_runtime.result_verifier import execution_result_awaits_approval
+
+    result = {"success": True, "result": {"summary": "done", "outputs": [{key: state}]}}
+    assert verify_employee_run_result("employee", result)[0] is False
+    assert execution_result_awaits_approval(result) is True
+
+
+@pytest.mark.parametrize(
+    "receipt,outcome",
+    [
+        ({"ok": True, "summary": "done"}, "success"),
+        ({"success": True}, "success"),
+        ({"ok": "false"}, "unknown"),
+        ({"ok": 1}, "unknown"),
+        ({"ok": True, "success": False}, "failure"),
+        ({"ok": True, "pending": True}, "pending"),
+        ({"ok": True, "outcome": "unknown"}, "unknown"),
+        ({"ok": True, "pending_approval": True}, "waiting_approval"),
+        ({}, "unknown"),
+        ("plain string", "unknown"),
+    ],
+)
+def test_actual_module_result_keeps_canonical_state(tmp_path, receipt, outcome):
+    from app.application.employee_runtime.executor import _action_direct_python_module
+
+    workers = tmp_path / "backend" / "employees"
+    workers.mkdir(parents=True)
+    (workers / "worker.py").write_text(f"def run(payload, ctx):\n    return {receipt!r}\n")
+    result = _action_direct_python_module(tmp_path, "employee", {}, {}, "task", str(tmp_path))
+    assert result["output"] == receipt
+    assert result["ok"] is (outcome == "success")
+    assert result["outcome"] == outcome
+
+
+@pytest.mark.parametrize("failure", ["exception", "response", "truthy", "pending", "unknown"])
+def test_llm_callback_boundary_preserves_state_and_hides_credentials(monkeypatch, failure):
+    from app.application.employee_runtime.executor import _build_enriched_ctx
+
+    secret = "SYNTHETIC-LLM-CALLBACK-PRIVATE-TOKEN"
+
+    async def completion(**_kwargs):
+        if failure == "exception":
+            raise OSError(secret)
+        return {
+            "response": {"success": False, "error": secret},
+            "truthy": {"success": "false", "content": secret},
+            "pending": {"success": True, "pending": True, "content": secret},
+            "unknown": {"success": True, "outcome": "unknown", "content": secret},
+        }[failure]
+
+    monkeypatch.setattr("app.mod_sdk.mod_employee_llm.mod_employee_complete", completion)
+    result = asyncio.run(_build_enriched_ctx("employee", "/tmp")["call_llm"]([{}]))
+    assert result["ok"] is False
+    assert secret not in json.dumps(result)
+    assert result["outcome"] == (
+        "failure" if failure == "response" else "pending" if failure == "pending" else "unknown"
+    )
