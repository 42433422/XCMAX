+            return {**receipt, "error": "LLM 调用未成功完成"}
+        except RECOVERABLE_ERRORS as exc:  # noqa: BLE001  LLM 调用边界：异常转结构化结果
+            logger.warning("employee LLM callback failed (%s)", type(exc).__name__)
             return {
                 "ok": False,
-                "error": result.get("error", "LLM 调用失败")
-                if isinstance(result, dict)
-                else "未知错误",
+                "outcome": "unknown",
+                "reconciliation_required": True,
+                "retryable": False,
+                "error": "LLM 调用异常，执行状态待核对",
             }
-        except RECOVERABLE_ERRORS as exc:  # noqa: BLE001  LLM 调用边界：异常转结构化结果
-            return {"ok": False, "error": repr(exc)}
 
     ctx["call_llm"] = _call_llm
     ctx["http_get"], ctx["http_post"] = build_http_helpers()
     return ctx
 
 
+def _handler_output(handler: str, output: Any) -> dict[str, Any]:
+    receipt = (
+        {
+            **output,
+            "success": output.get("success", output.get("ok")),
+            "reconciliation_required": output.get("reconciliation_required")
+            or output.get("requires_reconciliation"),
+        }
+        if isinstance(output, dict)
+        else None
+    )
+    outcome = tool_receipt_outcome(receipt)
+    return {
+        "handler": handler,
+        "ok": outcome == "success",
+        "outcome": outcome,
+        "output": output,
+        "retryable": False,
+        "reconciliation_required": outcome == "unknown",
+        "pending_approval": outcome == "waiting_approval",
+    }
+
