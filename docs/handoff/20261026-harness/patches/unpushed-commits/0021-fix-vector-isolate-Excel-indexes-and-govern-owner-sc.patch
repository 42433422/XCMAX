+class ScopedExcelVectorStore(VectorStorePort):
+    """Project a verified actor's namespace over the existing storage port."""
+
+    def __init__(self, store: VectorStorePort, runtime_context: dict[str, Any]) -> None:
+        self._store = store
+        self._context = _owner_context(runtime_context)
+        self._prefix = self._scope_prefix()
+
+    def _scope_prefix(self) -> str:
+        from app.infrastructure.auth.agent_mod_scope import _bound_actor
+
+        _bound_actor(self._context)
+        actor = self._context["_actor_authorization"]
+        scope = [actor["execution_tenant_id"], actor["user_id"], actor["mod_id"]]
+        return "excel-owner-v1:" + hashlib.sha256(json.dumps(scope).encode()).hexdigest() + ":"
+
+    def _authorize(self, action: str) -> None:
+        from app.infrastructure.auth.agent_mod_scope import (
+            AgentModAuthorizationError,
+            authorize_agent_tool,
+        )
+
+        if self._scope_prefix() != self._prefix or authorize_agent_tool(
+            "excel_vector_index", action, {}, self._context
+        ):
+            raise AgentModAuthorizationError("Excel vector authorization unavailable")
+
+    def _key(self, index_id: str, action: str = "query") -> str:
+        self._authorize(action)
+        if not isinstance(index_id, str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,128}", index_id):
+            raise ValueError("invalid Excel vector index id")
+        return self._prefix + index_id
+
+    def create_or_update_index(self, index_id: str, name: str, source_file: str) -> None:
+        self._store.create_or_update_index(self._key(index_id, "execute"), name, source_file)
+
+    def upsert_chunks(self, index_id: str, chunks: list[dict[str, Any]]) -> int:
+        key = self._key(index_id, "execute")
+        return self._store.upsert_chunks(
+            key, [{**chunk, "chunk_id": key + ":" + str(chunk["chunk_id"])} for chunk in chunks]
+        )
+
+    def query(self, index_id, query_vector, top_k=5, filters=None):
+        key = self._key(index_id)
+        return [
+            {**hit, "chunk_id": hit["chunk_id"][len(key) + 1 :]}
+            for hit in self._store.query(key, query_vector, top_k=top_k, filters=filters)
+            if str(hit.get("chunk_id") or "").startswith(key + ":")
+        ]
+
+    def list_indexes(self):
+        self._authorize("list")
+        return [
+            {**row, "index_id": row["index_id"][len(self._prefix) :]}
+            for row in self._store.list_indexes()
+            if str(row.get("index_id") or "").startswith(self._prefix)
+        ]
+
+    def delete_index(self, index_id):
+        return self._store.delete_index(self._key(index_id, "delete"))
+
+
+MAX_EXCEL_VECTOR_BYTES = 32 * 1024 * 1024
+
+
+def read_owned_excel_bytes(file_path: str, runtime_context: dict[str, Any]) -> bytes:
+    from app.application.employee_runtime.loader import employee_owner_workspace
+    from app.application.office_parse_app_service import _read_pinned_output
+    from app.infrastructure.workspace import workspace_root
+
+    base = workspace_root()
+    owner_parts = employee_owner_workspace(runtime_context).parent.relative_to(base).parts
+    raw = str(file_path).replace("\\", "/")
+    base_text = base.as_posix().rstrip("/") + "/"
+    if raw.startswith(base_text):
+        raw = raw[len(base_text) :]
+    parts = raw.split("/")
+    if (
+        any(part in {"", ".", ".."} for part in parts)
+        or tuple(parts[: len(owner_parts)]) != owner_parts
+    ):
+        raise ValueError("Excel input must belong to the authenticated owner")
+    blob = _read_pinned_output(base, base.joinpath(*parts), max_bytes=MAX_EXCEL_VECTOR_BYTES + 1)
+    if len(blob) > MAX_EXCEL_VECTOR_BYTES:
+        raise ValueError("Excel vector input exceeds size limit")
+    return blob
+
