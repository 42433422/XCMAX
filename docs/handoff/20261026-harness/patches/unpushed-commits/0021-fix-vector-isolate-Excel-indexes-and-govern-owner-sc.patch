+"""Real SQLite/XLSX ownership, HTTP approval and synthetic embedding transport."""
+
+import json
+import os
+import subprocess
+import sys
+from io import BytesIO
+from pathlib import Path
+
+import pandas as pd
+import pytest
+
+from app.application import excel_vector_app_service as vector
+from app.application.ai_chat.context_enrichment import inject_excel_vector_context
+from tests.fixtures.excel_vector import excel_vector_case as excel_vector_case
+from tests.fixtures.excel_vector import reviewed_agent_http as reviewed_agent_http
+from tests.fixtures.excel_vector import trusted_actor as trusted_actor
+
+
+@pytest.mark.parametrize(
+    "method,path,payload",
+    [
+        ("GET", "/api/excel/vector/indexes", None),
+        ("DELETE", "/api/excel/vector/indexes/known-index", None),
+        ("POST", "/api/excel/vector/query", {"index_id": "known-index", "query": "private"}),
+        ("POST", "/api/excel/vector/ingest", {"file_path": "/tmp/private.xlsx"}),
+    ],
+)
+def test_unsigned_http_never_lists_reads_deletes_or_uploads(
+    excel_vector_case, method, path, payload
+):
+    excel_vector_case.seed()
+    response = excel_vector_case.http.client.request(
+        method, path, json=payload, headers={"X-User-Id": "41", "X-Session-ID": ""}
+    )
+    assert response.status_code in {401, 403}, response.text
+    assert "OWNER_A_PRIVATE_ROW" not in response.text
+    assert (
+        len(
+            vector.get_excel_vector_search_app_service(
+                excel_vector_case.owner.context
+            ).list_indexes()["indexes"]
+        )
+        == 1
+    )
+
+
+@pytest.mark.parametrize("other", [0, 1, 2])
+def test_known_id_http_chat_and_delete_do_not_cross_actor_tenant_or_mod(excel_vector_case, other):
+    excel_vector_case.seed()
+    actor = excel_vector_case.others[other]
+    headers = {**actor.headers, "X-User-Id": str(excel_vector_case.owner.user_id)}
+    indexes = excel_vector_case.http.client.get("/api/excel/vector/indexes", headers=headers)
+    assert indexes.status_code == 200, indexes.text
+    assert indexes.json()["indexes"] == []
+    queried = excel_vector_case.http.client.post(
+        "/api/excel/vector/query",
+        json={"index_id": "known-index", "query": "private"},
+        headers=headers,
+    )
+    assert queried.status_code == 200, queried.text
+    assert queried.json()["hits"] == []
+    context = inject_excel_vector_context(
+        "private",
+        {
+            **actor.context,
+            "excel_index_id": "known-index",
+            "excel_vector_context": {"hits": ["stale-owner-data"]},
+        },
+    )
+    assert context["excel_vector_context"]["hits"] == []
+    deleted = excel_vector_case.http.request(
+        "DELETE", "/api/excel/vector/indexes/known-index", headers=headers
+    )
+    assert deleted.response.status_code == 202, deleted.response.text
+    assert deleted.receipt["success"] is False
+    own = excel_vector_case.http.client.post(
+        "/api/excel/vector/query", json={"index_id": "known-index", "query": "private"}
+    )
+    assert "OWNER_A_PRIVATE_ROW" in own.text
+    assert "excel-owner-v1:" not in own.text
+    assert "proof" not in own.text and "_actor_authorization" not in own.text
+
+
+def test_real_uploaded_xlsx_waits_for_formal_grant_then_independent_readback(excel_vector_case):
+    blob = BytesIO()
+    pd.DataFrame({"product": ["SYNTHETIC_XLSX"], "quantity": [9]}).to_excel(blob, index=False)
+    pending = excel_vector_case.http.client.post(
+        "/api/excel/vector/ingest",
+        files={"excel_file": ("input.xlsx", blob.getvalue())},
+        data={"index_id": "reviewed-index"},
+    )
+    assert pending.status_code == 202, pending.text
+    run_id = pending.json()["run_id"]
+    run = excel_vector_case.http.repository.get(run_id)
+    assert run.status == "waiting_user"
+    assert Path(run.steps[0].params["file_path"]).is_file()
+    assert (
+        vector.get_excel_vector_search_app_service(excel_vector_case.owner.context).list_indexes()[
+            "indexes"
+        ]
+        == []
+    )
+    review = excel_vector_case.http.client.get(f"/api/agent/runs/{run_id}")
+    resumed = excel_vector_case.http.client.post(
+        f"/api/agent/runs/{run_id}/continue",
+        json={"approval_grant": review.json()["approval"]["grant"]},
+    )
+    assert resumed.status_code == 202, resumed.text
+    claim = excel_vector_case.http.queue.claim("vector-test", lease_seconds=60)
+    assert claim.run_id == run_id
+    from app.application.agent_orchestrator import AgentOrchestrator
+
+    completed = AgentOrchestrator().execute_dispatched_run(run_id)
+    assert completed.status == "completed", completed.to_dict()
+    output = completed.steps[0].output
+    assert output["business_verification"]["verified"] is True
+    assert output["index_id"] == "reviewed-index"
+    queried = excel_vector_case.http.client.post(
+        "/api/excel/vector/query", json={"index_id": "reviewed-index", "query": "SYNTHETIC_XLSX"}
+    )
+    assert queried.status_code == 200 and "SYNTHETIC_XLSX" in queried.text
+    store = vector.get_sqlite_vector_store()
+    with store._get_conn() as db:
+        assert (
+            db.execute("SELECT count(*) FROM excel_vector_chunks").fetchone()[0]
+            == output["chunk_count"]
+        )
+    from app.application.agent_orchestrator.tool_executor import AgentToolExecutor
+
+    step = completed.steps[0]
+    context = {
+        **completed.metadata["runtime_context"],
+        "run_id": run_id,
+        "step_id": step.step_id,
+        "node_id": step.node_id,
+    }
+    before = store.list_indexes()
+    replayed = AgentToolExecutor().execute(step, runtime_context=context)
+    assert replayed["success"] is True and replayed["index_id"] == "reviewed-index"
+    assert store.list_indexes() == before
+
+
+@pytest.mark.parametrize(
+    "kind", ["traversal", "symlink", "parent-symlink", "hardlink", "other-owner"]
+)
+def test_ingest_pins_only_owner_regular_inputs(excel_vector_case, kind):
+    owned = excel_vector_case.workbook()
+    other = excel_vector_case.workbook(excel_vector_case.others[0], "OTHER_PRIVATE")
+    if kind == "traversal":
+        path = str(owned.parent) + "/../../" + other.relative_to(other.parents[2]).as_posix()
+    elif kind == "symlink":
+        path = owned.parent / "linked.xlsx"
+        path.symlink_to(other)
+    elif kind == "parent-symlink":
+        directory = owned.parent / "other-folder"
+        directory.symlink_to(other.parent, target_is_directory=True)
+        path = directory / other.name
+    elif kind == "hardlink":
+        path = owned.parent / "linked.xlsx"
+        os.link(other, path)
+    else:
+        path = other
+    response = excel_vector_case.http.client.post(
+        "/api/excel/vector/ingest", json={"file_path": str(path)}
+    )
+    assert response.status_code == 403, response.text
+    assert (
+        vector.get_excel_vector_search_app_service(excel_vector_case.owner.context).list_indexes()[
+            "indexes"
+        ]
+        == []
+    )
+
+
+@pytest.mark.parametrize("revocation", ["expiry", "account", "tenant", "mod", "permission"])
+def test_retained_service_rechecks_real_session_and_permissions_before_embedding(
+    excel_vector_case, revocation, monkeypatch
+):
+    from datetime import timedelta
+
+    from app.db.models.permission import Role
+    from app.db.models.user import Session as UserSession
+    from app.db.models.user import User
+    from app.infrastructure.auth.agent_mod_scope import AgentModAuthorizationError
+    from app.utils.time import utc_now_naive
+
+    excel_vector_case.seed()
+    retained = vector.get_excel_vector_search_app_service(excel_vector_case.owner.context)
+    calls = []
+    monkeypatch.setattr(excel_vector_case.embedder, "embed_query", lambda text: calls.append(text))
+    with excel_vector_case.owner.factory.begin() as db:
+        if revocation == "expiry":
+            db.get(UserSession, excel_vector_case.owner.session_row_id).expires_at = (
+                utc_now_naive() - timedelta(seconds=1)
+            )
+        elif revocation == "account":
+            db.get(User, excel_vector_case.owner.user_id).is_active = False
+        elif revocation == "tenant":
+            db.get(User, excel_vector_case.owner.user_id).tenant_id = 99
+        elif revocation == "mod":
+            db.get(UserSession, excel_vector_case.owner.session_row_id).entitled_mod_ids_json = "[]"
+        else:
+            role = db.query(Role).filter_by(name="user").one()
+            role.permissions = [p for p in role.permissions if p.code != "etl.read"]
+    with pytest.raises(AgentModAuthorizationError):
+        retained.query("known-index", "private")
+    assert calls == []
