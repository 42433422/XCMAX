+@pytest.mark.parametrize(
+    "corruption", ["content", "metadata", "source", "name", "chunk_id", "count", "other-scope"]
+)
+def test_independent_readback_rejects_forged_success_and_mismatched_rows(
+    excel_vector_case, corruption
+):
+    output = excel_vector_case.seed()
+    params = {"file_path": str(excel_vector_case.workbook()), "index_id": "known-index"}
+    scoped = vector.get_vector_store(excel_vector_case.owner.context)
+    key = scoped._key("known-index")
+    with vector.get_sqlite_vector_store()._get_conn() as db:
+        if corruption == "chunk_id":
+            db.execute(
+                "UPDATE excel_vector_chunks SET chunk_id = 'FORGED:' || chunk_id WHERE index_id = ?",
+                (key,),
+            )
+        elif corruption in {"content", "metadata"}:
+            db.execute(
+                f"UPDATE excel_vector_chunks SET {corruption} = ? WHERE index_id = ?",
+                ("{}" if corruption == "metadata" else "FORGED", key),
+            )
+        elif corruption in {"source", "name"}:
+            db.execute(
+                f"UPDATE excel_vector_indexes SET {'source_file' if corruption == 'source' else 'name'} = ? WHERE index_id = ?",
+                ("FORGED", key),
+            )
+        db.commit()
+    if corruption == "count":
+        output["chunk_count"] += 1
+    context = (
+        excel_vector_case.others[0].context
+        if corruption == "other-scope"
+        else excel_vector_case.owner.context
+    )
+    output["business_verification"] = {"verified": True, "method": "caller_flag"}
+    checked, verified = vector.verify_excel_vector_result("execute", params, output, context)
+    assert verified is False
+    assert checked["business_verification"] == {
+        "verified": False,
+        "method": "excel_vector_owner_readback",
+        "index_id": "known-index",
+    }
