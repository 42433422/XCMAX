+def verify_excel_vector_result(action, params, result, runtime_context) -> tuple[dict, bool]:
+    """Reopen the scoped store and original pinned workbook; ignore caller success proofs."""
+    verified = False
+    try:
+        index_id = result.get("index_id")
+        store = get_vector_store(runtime_context)
+        key = store._key(index_id, action)
+        # A write's technical readback requires its write grant, not an unrelated read permission.
+        row = next((item for item in store._store.list_indexes() if item["index_id"] == key), None)
+        if action == "delete":
+            verified = index_id == params.get("index_id") and row is None
+        elif action == "execute" and row:
+            file_path = params["file_path"]
+            blob = read_owned_excel_bytes(file_path, runtime_context)
+            parser = ExcelVectorIngestApplicationService(
+                vector_store=store, embedder=HashEmbedder()
+            )
+            expected = parser._build_chunks(
+                pd.read_excel(BytesIO(blob), sheet_name=None), Path(file_path).name
+            )
+            hits = store._store.query(key, [0.0] * 256, top_k=len(expected) + 1)
+
+            def contents(items):
+                return sorted(
+                    json.dumps({"content": item.content, "metadata": item.metadata}, sort_keys=True)
+                    for item in items
+                )
+
+            actual = sorted(
+                json.dumps({"content": hit["content"], "metadata": hit["metadata"]}, sort_keys=True)
+                for hit in hits
+            )
+            verified = (
+                bool(expected)
+                and (not params.get("index_id") or params["index_id"] == index_id)
+                and result.get("chunk_count") == row["chunk_count"] == len(expected)
+                and row["source_file"] == Path(file_path).name
+                and row["name"] == (params.get("index_name") or Path(file_path).stem).strip()
+                and all(str(hit.get("chunk_id") or "").startswith(key + ":") for hit in hits)
+                and contents(expected) == actual
+            )
+    except RECOVERABLE_ERRORS:
+        verified = False
+    return {
+        **result,
+        "business_verification": {
+            "verified": bool(verified),
+            "method": "excel_vector_owner_readback",
+            "index_id": result.get("index_id"),
+        },
+    }, bool(verified)
