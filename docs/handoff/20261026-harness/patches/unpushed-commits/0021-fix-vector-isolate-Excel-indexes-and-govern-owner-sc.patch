+def _safe_vector_errors(operation):
+    @wraps(operation)
+    def call(*args, **kwargs):
+        from app.infrastructure.auth.agent_mod_scope import AgentModAuthorizationError
+
+        try:
+            return operation(*args, **kwargs)
+        except AgentModAuthorizationError:
+            raise
+        except ValueError:
+            raise ValueError("Invalid Excel vector input") from None
+        except RECOVERABLE_ERRORS:
+            # Application instrumentation publishes exception strings; keep payloads out of it.
+            raise ExcelVectorUnavailableError("Excel vector service unavailable") from None
+
+    return call
