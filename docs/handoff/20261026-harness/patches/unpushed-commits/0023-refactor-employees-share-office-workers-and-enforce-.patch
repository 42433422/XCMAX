+        }
+        if mode in {"explicit", "absolute"}
+        else {}
+    )
+    if mode == "fallback":
+        monkeypatch.delitem(rule, "default_output_relpath", raising=False)
+    fallback = "outputs/filled.xlsx" if worker.special else "outputs/employee_output.xlsx"
+    expected = Path(payload.get("output_relpath") or rule.get("default_output_relpath") or fallback)
+    expected = expected if expected.is_absolute() else tmp_path / expected
+    result = worker.impl._resolve_output(payload, {"workspace_root": str(tmp_path)})
+    assert result == expected and result.parent.is_dir()
