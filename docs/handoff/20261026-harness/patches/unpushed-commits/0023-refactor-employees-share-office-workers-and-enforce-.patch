+@pytest.mark.parametrize(
+    "mode", ["file_path", "path", "alternate", "absolute", "missing", "empty", "plan"]
+)
+def test_input_resolution(worker, tmp_path, mode):
+    source = touch(tmp_path / "input.json")
+    key = "plan_path" if worker.special else "excel_path"
+    payload = {
+        key if mode == "alternate" else mode: str(source) if mode == "absolute" else source.name
+    }
+    if mode == "absolute":
+        payload = {"file_path": str(source)}
+    if mode in {"missing", "empty", "plan"}:
+        payload = (
+            {"file_path": "absent"} if mode == "missing" else {"plan": {}} if mode == "plan" else {}
+        )
+    if mode in {"missing", "empty", "plan"} and not (worker.special and mode == "plan"):
+        with pytest.raises(FileNotFoundError) as error:
+            worker.impl._resolve_input(payload, {"workspace_root": str(tmp_path)})
+        worker.record(str(error.value))
+    else:
+        result = worker.impl._resolve_input(payload, {"workspace_root": str(tmp_path)})
+        assert result == (None if mode == "plan" else source)
+        worker.record(str(result))
