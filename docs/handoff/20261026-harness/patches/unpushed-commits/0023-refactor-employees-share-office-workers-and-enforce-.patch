+"""Preserve office entrypoint behavior while sharing its file-transform plumbing."""
+
+from __future__ import annotations
+
+import asyncio
+import importlib.util
+import json
+import os
+import shutil
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+PACKS = (
+    "csv-full-read",
+    "csv-generate",
+    "excel-full-read",
+    "excel-generate",
+    "excel-template-write",
+    "pdf-full-read",
+    "pdf-generate",
+    "ppt-full-read",
+    "ppt-generate",
+    "word-generate",
+)
+ROOT = Path(
+    os.environ.get("OFFICE_WORKER_CHARACTERIZATION_ROOT") or Path(__file__).resolve().parents[2]
+)
+OBSERVED = {}
+
+
+@pytest.fixture(scope="session", autouse=True)
+def save_behavior_proof():
+    yield
+    if destination := os.environ.get("OFFICE_WORKER_BEHAVIOR_PROOF"):
+        Path(destination).write_text(
+            json.dumps(OBSERVED, ensure_ascii=False, sort_keys=True, indent=2)
+        )
+
+
+@pytest.fixture(params=PACKS)
+def worker(request, tmp_path, monkeypatch):
+    name = request.param + "-employee"
+    source = (
+        ROOT / "mods/_employees" / name / "backend/employees" / (name.replace("-", "_") + ".py")
+    )
+    spec = importlib.util.spec_from_file_location("characterized_" + name, source)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    impl = getattr(module, "_worker", module)
+    staged = tmp_path / "installed/backend/employees/entry.py"
+    staged.parent.mkdir(parents=True)
+    shutil.copyfile(source, staged)
+    monkeypatch.setattr(
+        impl, "source_file" if hasattr(module, "_worker") else "__file__", str(staged)
+    )
+    monkeypatch.setattr(sys, "path", sys.path.copy())
+
+    def record(value):
+        OBSERVED[request.node.nodeid] = json.loads(
+            json.dumps(value, ensure_ascii=False, default=str).replace(str(tmp_path), "$TMP")
+        )
+        return value
+
+    return SimpleNamespace(
+        module=module,
+        impl=impl,
+        root=staged.parents[1],
+        record=record,
+        special=request.param == "excel-template-write",
+        pdf=request.param == "pdf-full-read",
+    )
+
+
+def touch(path, text="input"):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(text)
+    return path
+
