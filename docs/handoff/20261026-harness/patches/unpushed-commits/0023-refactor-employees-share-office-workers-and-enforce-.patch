+def employee_host_dependency_error(manifest: dict[str, Any]) -> str:
+    """Check only the employee's host SDK requirement, using the native version gate."""
+    from .manifest import ModMetadata, host_xcagi_version, validate_dependencies
+
+    metadata = ModMetadata.from_dict(
+        {"id": manifest.get("id"), "dependencies": manifest.get("dependencies")}
+    )
+    metadata.dependencies = {
+        key: value for key, value in metadata.dependencies.items() if key == "xcagi"
+    }
+    if validate_dependencies(metadata, []):
+        return ""
+    return (
+        f"员工包 {metadata.id} 需要 xcagi {metadata.dependencies['xcagi']}，"
+        f"当前宿主 {host_xcagi_version()}"
+    )
+
