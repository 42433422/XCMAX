diff --git a/FHD/app/mod_sdk/office_employee_worker.py b/FHD/app/mod_sdk/office_employee_worker.py
new file mode 100644
index 0000000000..1131a68ad5
--- /dev/null
+++ b/FHD/app/mod_sdk/office_employee_worker.py
@@ -0,0 +1,236 @@
+"""File-transform entrypoint shared by office packs with source-local rules."""
+
+from __future__ import annotations
+
+import asyncio
+import importlib
+import json
+import sys
+from pathlib import Path
+from typing import Any, Dict, List, Optional
+
+from app.mod_sdk.errors import BOUNDARY_ERRORS
+
+
+class OfficeEmployeeWorker:
+    """Keep each pack's anchor, converter, identity and mutable rules independent."""
+
+    def __init__(
+        self,
+        source_file: str,
+        employee_id: str,
+        label: str,
+        system_prompt: str,
+        rule_spec: Dict[str, Any],
+        converter_module: str,
+        *,
+        template_write: bool = False,
+        json_fallback: bool = False,
+    ):
+        self.source_file = source_file
+        self.employee_id = employee_id
+        self.label = label
+        self.system_prompt = system_prompt
+        self.rule_spec = rule_spec
+        self.converter_module = converter_module
+        self.template_write = template_write
+        self.json_fallback = json_fallback
+
+    def _ok(
+        self,
+        data: Any,
+        *,
+        warnings: Optional[List[str]] = None,
+        meta: Optional[Dict[str, Any]] = None,
+    ) -> Dict[str, Any]:
+        return {
+            "ok": True,
+            "summary": self._summary(data),
+            "items": data if isinstance(data, list) else [data],
+            "warnings": list(warnings or []),
+            "error": "",
+            "meta": dict(meta or {}),
+        }
+
+    def _err(
+        self,
+        msg: str,
+        *,
+        warnings: Optional[List[str]] = None,
+        meta: Optional[Dict[str, Any]] = None,
+    ) -> Dict[str, Any]:
+        return {
+            "ok": False,
+            "summary": msg[:400],
+            "items": [],
+            "warnings": list(warnings or []),
+            "error": msg[:1000],
+            "meta": dict(meta or {}),
+        }
+
+    def _summary(self, data: Any) -> str:
+        if isinstance(data, str):
+            return data[:4000]
+        try:
+            return json.dumps(data, ensure_ascii=False)[:4000]
+        except TypeError:
+            return str(data)[:4000]
+
+    def _pack_root(self) -> Path:
+        return Path(self.source_file).resolve().parents[1]
+
+    def _workspace_root(self, ctx: Dict[str, Any], payload: Dict[str, Any]) -> Path:
+        raw = payload.get("workspace_root") or ctx.get("workspace_root") or Path.cwd()
+        return Path(str(raw)).expanduser()
+
+    def _resolve_input(self, payload: Dict[str, Any], ctx: Dict[str, Any]) -> Optional[Path]:
+        raw = str(
+            payload.get("file_path")
+            or payload.get("path")
+            or payload.get("plan_path" if self.template_write else "excel_path")
+            or ""
+        ).strip()
+        if not raw:
+            if self.template_write:
+                if isinstance(payload.get("plan"), dict):
+                    return None
+                raise FileNotFoundError(
+                    "缺少 file_path：请上传 plan.json 写入计划，或在 payload.plan 传入计划对象。"
+                )
+            raise FileNotFoundError("缺少 file_path：请上传或指定要处理的文件。")
+        p = Path(raw).expanduser()
+        if not p.is_absolute():
+            p = self._workspace_root(ctx, payload) / raw
+        if not p.is_file():
+            raise FileNotFoundError(f"文件不存在：{p}")
+        return p
+
+    def _resolve_output(self, payload: Dict[str, Any], ctx: Dict[str, Any]) -> Path:
+        rel = str(
+            payload.get("output_relpath")
+            or self.rule_spec.get("default_output_relpath")
+            or ("outputs/filled.xlsx" if self.template_write else "outputs/employee_output.xlsx")
+        ).strip()
+        p = Path(rel).expanduser()
+        if not p.is_absolute():
+            p = self._workspace_root(ctx, payload) / rel
+        p.parent.mkdir(parents=True, exist_ok=True)
+        return p
+
+    def _resolve_template(self, payload: Dict[str, Any], ctx: Dict[str, Any]) -> Optional[Path]:
+        raw = str(
+            (payload.get("template_path") if self.template_write else None)
+            or payload.get("template_relpath")
+            or self.rule_spec.get("default_template_relpath")
+            or self.rule_spec.get("template_relpath")
+            or ""
+        ).strip()
+        if not raw and not self.template_write:
+            return None
+        candidates = []
+        if raw:
+            p = Path(raw).expanduser()
+            if p.is_absolute():
+                candidates.append(p)
+            else:
+                candidates.append(self._workspace_root(ctx, payload) / raw)
+                candidates.append(self._pack_root() / raw)
+                candidates.append(self._pack_root() / "backend" / "templates" / raw)
+                if raw.startswith("backend/"):
+                    candidates.append(self._pack_root() / raw[len("backend/") :])
+        for cand in candidates:
+            if cand.is_file():
+                return cand
+        bundled_templates = (
+            sorted((self._pack_root() / "templates").rglob("*.xls*"))
+            if (self._pack_root() / "templates").is_dir()
+            else []
+        )
+        if bundled_templates:
+            return bundled_templates[0]
+        return None
+
+    async def run(self, payload: Dict[str, Any], ctx: Dict[str, Any]) -> Dict[str, Any]:
+        payload = dict(payload or {})
+        ctx = dict(ctx or {})
+        action = (
+            str(payload.get("action") or self.rule_spec.get("default_action") or "convert")
+            .strip()
+            .lower()
+        )
+        if action in ("help", "说明", "status"):
+            return self._ok(
+                {"employee": self.label, "rule_spec": self.rule_spec},
+                meta={"handler": "direct_python", "action": "help"},
+            )
+        allowed = (
+            ("convert", "upload", "转换", "回填", "")
+            if self.template_write
+            else ("convert", "upload", "转换", "")
+        )
+        if action not in allowed:
+            return self._err(
+                f"不支持的 action：{action}", meta={"handler": "direct_python", "action": action}
+            )
+        try:
+            vendor_dir = self._pack_root() / "vendor"
+            if str(vendor_dir) not in sys.path:
+                sys.path.insert(0, str(vendor_dir))
+            convert_file = importlib.import_module(self.converter_module).convert_file
+            src = self._resolve_input(payload, ctx)
+            out = self._resolve_output(payload, ctx)
+            template = self._resolve_template(payload, ctx)
+            result = convert_file(
+                src, out, template_path=template, payload=payload, ctx=ctx, rule_spec=self.rule_spec
+            )
+            if asyncio.iscoroutine(result):
+                result = await result
+            run_warnings = []
+            if isinstance(result, dict):
+                result.setdefault("output_path", str(out))
+                result.setdefault("template_path", str(template or ""))
+                if self.template_write:
+                    run_warnings = [str(w) for w in result.get("warnings") or []]
+            else:
+                result = {
+                    "output_path": str(out),
+                    "template_path": str(template or ""),
+                    "result": result,
+                }
+            if (
+                self.json_fallback
+                and not out.is_file()
+                and out.suffix.lower() == ".json"
+                and isinstance(result, dict)
+            ):
+                out.write_text(json.dumps(result, ensure_ascii=False, indent=2), encoding="utf-8")
+            produced = Path(str(result.get("output_path") or out)) if self.template_write else out
+            if not produced.is_file():
+                verb = "回填" if self.template_write else "转换"
+                return self._err(
+                    f"{verb}未生成输出文件：{produced}",
+                    meta={"handler": "direct_python", "action": "convert"},
+                )
+            return self._ok(
+                result,
+                warnings=run_warnings,
+                meta={
+                    "handler": "direct_python",
+                    "action": "convert",
+                    "runtime": "generated_python",
+                },
+            )
+        except BOUNDARY_ERRORS as exc:  # noqa: BLE001
+            return self._err(
+                str(exc),
+                warnings=[
+                    "请检查 plan.json 写入计划、模板文件与 sheet 名是否匹配。"
+                    if self.template_write
+                    else "请检查输入文件、模板文件和题目规则是否匹配。"
+                ],
+                meta={
+                    "handler": "direct_python",
+                    "action": "convert",
+                    "runtime": "generated_python",
+                },
+            )
