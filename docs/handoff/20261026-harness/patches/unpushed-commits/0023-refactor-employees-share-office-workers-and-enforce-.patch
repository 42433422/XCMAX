+@pytest.mark.parametrize("value", [None, "x" * 4100, [1, 2], {"a": 1}, {1}])
+def test_result_envelopes(worker, value):
+    impl = worker.impl
+    result = impl._ok(value, warnings=["w"], meta={"m": 1})
+    assert result["items"] == (value if isinstance(value, list) else [value])
+    assert result["summary"] == impl._summary(value) and len(result["summary"]) <= 4000
+    error = impl._err("e" * 1100, warnings=["w"], meta={"m": 1})
+    assert len(error["summary"]) == 400 and len(error["error"]) == 1000
+    assert error["items"] == [] and error["warnings"] == ["w"] and error["meta"] == {"m": 1}
+    worker.record([result, error])
