+@pytest.mark.parametrize(
+    "kind",
+    [
+        "dict",
+        "async",
+        "scalar",
+        "none",
+        "no_output",
+        "missing_other",
+        "alternate_output",
+        "warnings",
+        "error",
+        "import_error",
+        "vendor_cached",
+        "empty_payload",
+    ],
+)
+def test_converter_receipts_and_failures(worker, tmp_path, monkeypatch, kind):
+    calls = []
+    source = touch(tmp_path / "input.json")
+    out = tmp_path / "result.json"
+    payload = {"file_path": source.name, "output_relpath": str(out)}
+    ctx = {"workspace_root": str(tmp_path)}
+    if kind == "missing_other":
+        out = tmp_path / "result.txt"
+        payload["output_relpath"] = str(out)
+    if kind == "empty_payload":
+        payload, ctx = None, None
+    vendor = str(worker.root / "vendor")
+    if kind == "vendor_cached":
+        sys.path.insert(0, vendor)
+
+    def convert(src, output, **kwargs):
+        calls.append([str(src), str(output), kwargs])
+        if kind == "error":
+            raise OSError("converter rejected input")
+        if kind not in {"no_output", "missing_other", "alternate_output"}:
+            touch(output, "converted")
+        if kind == "scalar":
+            return ["scalar", 2]
+        if kind == "none":
+            return None
+        result = {"converted": True}
+        if kind == "alternate_output":
+            result["output_path"] = str(touch(tmp_path / "actual.xlsx"))
+        if kind == "warnings":
+            result["warnings"] = ["one", 2]
+            result["template_path"] = "converter-owned-template"
+        return result
+
+    async def async_convert(*args, **kwargs):
+        return convert(*args, **kwargs)
+
+    package = worker.module.EMPLOYEE_ID.removesuffix("-employee").replace("-", "_")
+    monkeypatch.setitem(
+        sys.modules,
+        package + ".convert",
+        None
+        if kind == "import_error"
+        else SimpleNamespace(convert_file=async_convert if kind == "async" else convert),
+    )
+    result = asyncio.run(worker.impl.run(payload, ctx))
+    successful = kind not in {"error", "import_error", "empty_payload", "missing_other"}
+    if kind in {"no_output", "alternate_output"}:
+        successful = worker.pdf or (worker.special and kind == "alternate_output")
+    assert result["ok"] is successful
+    assert result["warnings"] == (
+        ["one", "2"]
+        if worker.special and kind == "warnings"
+        else []
+        if successful or kind in {"no_output", "missing_other", "alternate_output"}
+        else [
+            "请检查 plan.json 写入计划、模板文件与 sheet 名是否匹配。"
+            if worker.special
+            else "请检查输入文件、模板文件和题目规则是否匹配。"
+        ]
+    )
+    if calls:
+        assert calls[0][2]["rule_spec"] is worker.module.RULE_SPEC
+        assert calls[0][2]["payload"] == payload and calls[0][2]["ctx"] == ctx
+        assert sys.path.count(vendor) == 1
+    worker.record(
+        {"result": result, "calls": calls, "output": out.read_text() if out.is_file() else None}
+    )
