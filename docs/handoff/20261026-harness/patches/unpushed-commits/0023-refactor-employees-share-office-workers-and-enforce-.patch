+def test_template_candidates_and_order(worker, tmp_path, monkeypatch, mode):
+    impl, root = worker.impl, worker.root
+    for key in ("default_template_relpath", "template_relpath"):
+        monkeypatch.delitem(worker.module.RULE_SPEC, key, raising=False)
+    raw, expected = "chosen.xlsx", None
+    locations = {
+        "absolute": tmp_path / "absolute.xlsx",
+        "workspace": tmp_path / raw,
+        "pack": root / raw,
+        "nested": root / "backend/templates" / raw,
+        "backend": root / raw,
+        "rule_default": tmp_path / raw,
+        "rule_legacy": tmp_path / raw,
+        "template_path": tmp_path / raw,
+    }
+    if mode in locations:
+        expected = touch(locations[mode])
+    if mode == "absolute":
+        raw = str(expected)
+    if mode == "backend":
+        raw = "backend/" + raw
+    payload = {"template_relpath": raw}
+    if mode in {"none", "empty_dir"}:
+        payload = {}
+    if mode == "empty_dir":
+        (root / "templates").mkdir()
+    if mode == "fallback":
+        touch(root / "templates/z.xlsm")
+        expected = touch(root / "templates/a.xlsx")
+    if mode.startswith("rule_"):
+        monkeypatch.setitem(
+            worker.module.RULE_SPEC,
+            "default_template_relpath" if mode == "rule_default" else "template_relpath",
+            raw,
+        )
+        payload = {}
+    if mode == "template_path":
+        payload = {"template_path": str(expected)}
+        if not worker.special:
+            expected = None
+    result = impl._resolve_template(payload, {"workspace_root": str(tmp_path)})
