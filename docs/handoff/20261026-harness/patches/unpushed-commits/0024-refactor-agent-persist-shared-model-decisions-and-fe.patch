-        "trajectory": trajectory,
-        "exit_status": "max_iterations",
-    }
+    try:
+        require_api_key()
+        client = get_openai_compatible_client()
+    except RECOVERABLE_ERRORS:
+        return {
+            "handler": "agent",
+            "ok": False,
+            "degraded": True,
+            "error": "LLM 不可用，agent 多轮循环已降级",
+            "error_code": "employee_llm_not_configured",
+            "retryable": False,
+            "output": "",
+            "rounds": 0,
+            "tool_calls": [],
+            "trajectory": [],
+            "exit_status": "llm_unavailable",
+        }
+    context = dict(runtime_context or {})
+    run_id = str(context.get("_employee_run_id") or "")
+    pack_digest = None
+    if run_id:
+        from .loader import load_employee_pack_from_disk
+
+        pack_digest = canonical_hash(load_employee_pack_from_disk(employee_id)["manifest"])
+    policy = EmployeeModelPolicy(
+        context,
+        client,
+        model or resolve_chat_model(),
+        employee_id=employee_id,
+        task=task,
+        candidates=tools if tools is not None else default_employee_tools(),
+        workspace_root=workspace_root,
+        gate=gate,
+        pack_digest=pack_digest,
+        gate_input=input_data,
+    )
