 ]
+
+
+def _durable_model_owner(context: dict[str, Any]) -> tuple[dict[str, str], Any]:
+    from app.db import HostSessionLocal
+    from app.db.models.user import Session as UserSession
+    from app.infrastructure.auth.agent_mod_scope import _bound_actor
+
+    _bound_actor(context)
+    binding = context["_actor_authorization"]
+    scope = {key: str(binding[key]) for key in ("user_id", "execution_tenant_id", "mod_id")}
+    with HostSessionLocal() as db:
+        row = db.get(UserSession, binding["session_row_id"])
+        if row is None:
+            raise ValueError("模型任务的登录会话不存在")
+        return scope, {
+            "market_user_id": row.market_user_id,
+            "market_access_token": row.market_access_token,
+        }
+
+
+def _model_endpoint(value: Any) -> str:
+    from urllib.parse import urlsplit
+
+    url = str(value or "https://api.openai.com/v1").rstrip("/")
+    parsed = urlsplit(url)
+    if (
+        not parsed.scheme
+        or not parsed.netloc
+        or parsed.username
+        or parsed.password
+        or parsed.query
+        or parsed.fragment
+    ):
+        raise ValueError("持久模型引用不能包含签名地址或嵌入凭据")
+    return url
+
+
+def capture_durable_model_reference(context: dict[str, Any], client: Any, model: str) -> dict:
+    """Persist a verified configuration/owner reference, never SDK credentials."""
+    import hmac
+
+    scope, session = _durable_model_owner(context)
+    if not isinstance(model, str) or not model.strip() or len(model) > 256:
+        raise ValueError("持久模型引用缺少明确模型")
+    reference = {"version": 1, "scope": scope, "model": model}
+    if getattr(client, "is_modstore_openai_compatible", False) is True:
+        adapter = client.adapter
+        token = session["market_access_token"]
+        if (
+            type(session["market_user_id"]) is not int
+            or session["market_user_id"] <= 0
+            or not isinstance(token, str)
+            or not token
+            or not hmac.compare_digest(token, str(adapter.auth_token))
+        ):
+            raise ValueError("当前模型凭据不属于已验证的登录会话")
+        return {
+            **reference,
+            "kind": "market_session",
+            "market_user_id": session["market_user_id"],
+            "endpoint": _model_endpoint(adapter.platform_url),
+            "provider": str(adapter.default_provider),
+        }
+    key, base = _first_api_key()
+    if (
+        not key
+        or not isinstance(getattr(client, "api_key", None), str)
+        or not hmac.compare_digest(key, client.api_key)
+        or _model_endpoint(client.base_url) != _model_endpoint(base)
+    ):
+        raise ValueError("临时模型客户端没有可恢复的同源配置引用")
+    return {
+        **reference,
+        "kind": "host_env",
+        "profile": "openai_compatible",
+        "endpoint": _model_endpoint(base),
+    }
+
+
+def resolve_durable_model_client(context: dict[str, Any], reference: dict) -> tuple[Any, str]:
+    """Resolve only the current verified session and the original provider profile."""
+    scope, session = _durable_model_owner(context)
+    if not isinstance(reference, dict):
+        raise ValueError("持久模型引用必须是明确对象")
+    common = {"version", "scope", "model", "kind", "endpoint"}
+    expected = common | (
+        {"market_user_id", "provider"} if reference.get("kind") == "market_session" else {"profile"}
+    )
+    if set(reference) != expected or type(reference.get("version")) is not int:
+        raise ValueError("持久模型引用字段或版本无效")
+    if reference.get("version") != 1 or reference.get("scope") != scope:
+        raise ValueError("不能更改持久模型任务的账号、租户或 Mod")
+    model = reference.get("model")
+    if not isinstance(model, str) or not model.strip():
+        raise ValueError("持久模型引用无效")
+    if reference.get("kind") == "market_session":
+        from app.domain.shared_services.conversation.modstore_adapter import (
+            ModstoreOpenAICompatibleClient,
+            ModstorePlatformAdapter,
+        )
+
+        if (
+            type(reference.get("market_user_id")) is not int
+            or not isinstance(reference.get("provider"), str)
+            or not reference["provider"].strip()
+            or session["market_user_id"] != reference.get("market_user_id")
+            or not session["market_access_token"]
+        ):
+            raise ValueError("原模型账号不可用，请重新连接同一账号")
+        adapter = ModstorePlatformAdapter(
+            platform_url=_model_endpoint(reference["endpoint"]),
+            auth_token=session["market_access_token"],
+            default_provider=reference["provider"],
+        )
+        adapter.user_id = None
+        adapter.default_provider = reference["provider"]
+        adapter.default_model = model.split("/", 1)[-1]
+        return ModstoreOpenAICompatibleClient(adapter), model
+    if reference.get("kind") != "host_env" or reference.get("profile") != "openai_compatible":
+        raise ValueError("没有可恢复的模型配置")
+    key, base = _first_api_key()
+    if not key or _model_endpoint(base) != reference.get("endpoint"):
+        raise ValueError("原模型配置已变化，不能回退其他模型服务")
+    from openai import OpenAI
+
+    return OpenAI(
+        api_key=key,
+        base_url=base,
+        timeout=_resolve_openai_timeout_seconds(),
+        max_retries=_resolve_openai_max_retries(),
+    ), model
