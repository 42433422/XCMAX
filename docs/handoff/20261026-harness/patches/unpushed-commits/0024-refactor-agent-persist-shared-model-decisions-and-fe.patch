+def admit_employee_case(case, *, task=TASK):
+    """Admit before standalone loop tests; all identity and scope remain real."""
+    context = ensure_business_harness_context(case.actor.context, message=task)
+    context["task_id"] = "employee-model-" + uuid.uuid4().hex
+    run, created = _run_service(case.http.repository).claim_employee_run(
+        message=task,
+        runtime_context=context,
+        employee_id=case.pack.pack_id,
+        fingerprint="fixture-existing-agent-task",
+        response_kind="business_action",
+    )
+    assert created
+    return run, dict(run.metadata["runtime_context"])
+
+
+def _calls():
+    return [
+        ("read-before", "business_db_read", {"entity": "customers"}),
+        (
+            "create",
+            "business_db_write",
+            {
+                "entity": "customers",
+                "operation": "create",
+                "payload": {"unit_name": "employee approved customer"},
+            },
+        ),
+        ("read-after", "business_db_read", {"entity": "customers"}),
+    ]
+
+
+def _transport(monkeypatch, *, calls=None, assert_offered=True):
+    requests = []
+    calls = _calls() if calls is None else calls
+
+    def respond(request):
+        assert request.url.host == "employee-model.invalid"
+        assert request.headers["Authorization"] == f"Bearer {MODEL_KEY}"
+        payload = json.loads(request.read())
+        requests.append(payload)
+        if not payload.get("tools"):
+            message = {
+                "role": "assistant",
+                "content": "按原任务读取客户；写入等待正式审批，再核对。",
+            }
+        elif any(row["role"] == "tool" for row in payload["messages"]):
+            receipts = [row for row in payload["messages"] if row["role"] == "tool"]
+            assert [row["tool_call_id"] for row in receipts] == [
+                "read-before",
+                "create",
+                "read-after",
+            ]
+            assert json.loads(receipts[1]["content"])["business_verification"]["verified"] is True
+            message = {"role": "assistant", "content": "原任务写入并读回完成。"}
+        else:
+            offered = {row["function"]["name"] for row in payload["tools"]}
+            if assert_offered:
+                assert {name for _, name, _ in calls} <= offered
+            message = {
+                "role": "assistant",
+                "content": "原始有序客户批次",
+                "tool_calls": [
+                    {
+                        "id": identity,
+                        "type": "function",
+                        "function": {"name": name, "arguments": json.dumps(params)},
+                    }
+                    for identity, name, params in calls
+                ],
+            }
+        return httpx.Response(
+            200,
+            request=request,
+            json={
+                "id": "synthetic-employee-completion",
+                "object": "chat.completion",
+                "created": 1,
+                "model": MODEL_NAME,
+                "choices": [{"index": 0, "message": message, "finish_reason": "stop"}],
+                "usage": {"prompt_tokens": 12, "completion_tokens": 7, "total_tokens": 19},
+            },
+        )
+
+    def sync_handle(_transport, request):
+        return respond(request)
+
+    async def async_handle(_transport, request):
+        return respond(request)
+
+    monkeypatch.setattr(httpx.HTTPTransport, "handle_request", sync_handle)
+    monkeypatch.setattr(httpx.AsyncHTTPTransport, "handle_async_request", async_handle)
+    return requests
+
+
+def _standalone_loop(case):
+    from app.application.employee_runtime.agent_loop import run_employee_agent_loop
+
+    run, context = admit_employee_case(case)
+    manifest = load_employee_pack_from_disk(case.pack.pack_id)["manifest"]
+    config = parse_employee_config_v2(manifest)
+    agent = EmployeeAgent(case.pack.pack_id)
+    with llm_client.llm_client_scope(case.model, MODEL_NAME):
+        result = run_employee_agent_loop(
+            employee_id=case.pack.pack_id,
+            system_prompt="依照实际工具回执完成原客户任务",
+            task=TASK,
+            tools=agent._build_agent_tools(manifest, config),
+            gate=agent._build_agent_gate(
+                manifest, config, str(case.workspace), {}, runtime_context=context
+            ),
+            runtime_context=context,
+            workspace_root=str(case.workspace),
+            model=MODEL_NAME,
+        )
+    return result, case.http.repository.get(run.run_id)
+
+
+def _approve_and_resume(case, run):
+    review = case.http.client.get(f"/api/agent/runs/{run.run_id}")
+    assert review.status_code == 200, review.text
+    continued = case.http.client.post(
+        f"/api/agent/runs/{run.run_id}/continue",
+        json={"approval_grant": review.json()["approval"]["grant"]},
+    )
+    assert continued.status_code == 202, continued.text
+    execution = case.http.queue.claim_run(run.run_id, "employee-kernel-test", lease_seconds=60)
+    assert execution is not None
+    fenced = ClaimedRunRepository(case.http.repository, execution, "employee-kernel-test")
+    final = AgentOrchestrator(repository=fenced).execute_dispatched_run(run.run_id)
+    case.http.queue.finish(
+        run.run_id,
+        "employee-kernel-test",
+        "completed" if final.status == "completed" else "blocked",
+        execution_count=execution.execution_count,
+    )
+    return final
+
