+@pytest.fixture(autouse=True)
+def isolated_profiles(monkeypatch):
+    for key in (
+        "XCAUTO_API_KEY",
+        "XCAUTO_PAT",
+        "XIUCI_API_KEY",
+        "XCAUTO_MODEL",
+        "XCAUTO_BASE_URL",
+        "XCAUTO_API_BASE",
+        "XCAUTO_API_URL",
+        "XCAUTO_CHAT_COMPLETIONS_URL",
+        "DEEPSEEK_API_KEY",
+        "LLM_PROVIDER",
+        "XCAGI_LLM_PROVIDER",
+        "LLM_MODEL",
+        "OPENAI_MODEL",
+        "MODSTORE_USER_ID",
+    ):
+        monkeypatch.delenv(key, raising=False)
+    monkeypatch.setenv("OPENAI_API_KEY", HOST_KEY)
+    monkeypatch.setenv("OPENAI_BASE_URL", ENDPOINT)
+    monkeypatch.setenv("MODSTORE_AUTH_TOKEN", "synthetic-unrelated-environment-token-canary")
