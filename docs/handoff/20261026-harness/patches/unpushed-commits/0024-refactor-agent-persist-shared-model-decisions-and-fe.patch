+                self.checkpoint()
+                yield {"type": "result", "result": self.finish("failure")}
+                return
+            request = self.policy.request(self.messages(), self.state)
+            self.state.update(
+                phase="model_inflight",
+                round=self.state["round"] + 1,
+                request_id=uuid.uuid4().hex,
+                request_view=safe_value(
+                    {
+                        **{key: value for key, value in request.items() if key != "tools"},
