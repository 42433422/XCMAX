+    ).execute_dispatched_run(stored.run_id)
+    assert final.status == "blocked"
+    assert all(call.call_id != "read-after" for call in final.tool_calls)
+    with tenant_scope(actor.tenant_id), actor.factory() as db:
+        assert db.query(PurchaseUnit).filter_by(unit_name="kernel approved customer").count() == 0
