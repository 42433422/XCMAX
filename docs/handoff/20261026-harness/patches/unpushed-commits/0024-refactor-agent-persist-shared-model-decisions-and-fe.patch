+HOST_KEY = "synthetic-host-profile-key-canary"
+MARKET_TOKEN = "synthetic-current-session-market-token-canary"
+ROTATED_TOKEN = "synthetic-rotated-same-account-token-canary"
+ENDPOINT = "https://host-profile.invalid/v1"
+MARKET_ENDPOINT = "https://original-market.invalid"
+MODEL = "original-provider/original-model"
