+"""Real SQL/process checks for the model driver's existing queue lease boundary."""
+
+from __future__ import annotations
+
+import copy
+import multiprocessing
+import os
+import time
+from concurrent.futures import ThreadPoolExecutor
+from datetime import UTC, datetime, timedelta
+from pathlib import Path
+
+import pytest
+from sqlalchemy import create_engine, event
+from sqlalchemy.exc import OperationalError
+from sqlalchemy.orm import Session, sessionmaker
+
+from app.application.agent_orchestrator.business_write_guard import (
+    capture_worker_claim,
+    worker_claim_scope,
+    worker_write_guard,
+)
+from app.application.agent_orchestrator.run_models import AgentRun, AgentStep, ToolCall
+from app.application.agent_orchestrator.run_sql_repository import SQLAlchemyAgentRunRepository
+from app.application.agent_orchestrator.task_execution_repository import (
+    InMemoryTaskExecutionRepository,
+    SQLAlchemyTaskExecutionRepository,
+)
+from app.application.agent_orchestrator.tool_executor import (
+    AgentToolExecutor,
+    execute_with_tool_deadline,
+)
+from app.application.agent_orchestrator.worker_repository import (
+    ClaimedRunRepository,
+    WorkerLeaseLost,
+    model_turn_lease_scope,
+)
+from app.db.models import InventoryLedger, InventoryTransaction, Product, Warehouse
+from app.db.models.agent import AgentTaskExecutionRecord
+from app.infrastructure.tenant_scope import tenant_scope
+from tests.fixtures.backend_ci_isolation import trusted_actor as trusted_actor
+
+
+def _run(actor, message="model task"):
+    run = AgentRun(user_id=str(actor.user_id), message=message, status="running")
+    run.metadata["runtime_context"] = {"tenant_id": actor.tenant_id}
+    return run
+
+
+def _intent(run):
+    run = copy.deepcopy(run)
+    step = AgentStep(node_id="write", tool_id="business_db", action="write", status="running")
+    run.steps.append(step)
+    run.tool_calls.append(
+        ToolCall(
+            step_id=step.step_id,
+            node_id=step.node_id,
+            tool_id=step.tool_id,
+            action=step.action,
+            params={"entity": "customers"},
+            metadata={"read_only": False},
+        )
+    )
+    return run
+
+
+def _claim_exact(url, run_id, owner, ready, start, results):
+    engine = create_engine(url)
+    queue = SQLAlchemyTaskExecutionRepository(
+        session_factory=sessionmaker(bind=engine), auto_create=False
+    )
+    try:
+        ready.put(owner)
+        if not start.wait(20):
+            raise RuntimeError("exact claim barrier timed out")
+        claim = queue.claim_run(run_id, owner, lease_seconds=60)
+        results.put((owner, claim.run_id if claim else None))
+    finally:
+        engine.dispose()
+
+
+def test_two_processes_claim_only_exact_run_and_never_consume_other_queue_work(trusted_actor):
+    actor = trusted_actor()
+    queue = SQLAlchemyTaskExecutionRepository(session_factory=actor.factory)
+    run = _run(actor)
+    decoy = _run(actor, "higher priority unrelated task")
+    queue.enqueue(decoy, priority=1)
+    queue.enqueue(run, priority=100)
+    ctx = multiprocessing.get_context("spawn")
+    ready, results, start = ctx.Queue(), ctx.Queue(), ctx.Event()
+    workers = [
+        ctx.Process(
+            target=_claim_exact,
+            args=(str(actor.factory.kw["bind"].url), run.run_id, owner, ready, start, results),
+        )
+        for owner in ("one", "two")
+    ]
+    try:
+        for worker in workers:
+            worker.start()
+        assert {ready.get(timeout=20), ready.get(timeout=20)} == {"one", "two"}
+        start.set()
+        claims = [results.get(timeout=20), results.get(timeout=20)]
+        assert sorted(value is not None for _, value in claims) == [False, True]
+        assert {value for _, value in claims if value} == {run.run_id}
+        for worker in workers:
+            worker.join(timeout=20)
+            assert worker.exitcode == 0
+        assert queue.get(decoy.run_id).state == "queued"
+        assert queue.get(run.run_id).execution_count == 1
+        assert queue.claim_run("missing", "third", lease_seconds=60) is None
+        assert queue.get(decoy.run_id).state == "queued"
+    finally:
+        for worker in workers:
+            if worker.is_alive():
+                worker.terminate()
+                worker.join(timeout=5)
+        ready.close()
+        results.close()
+
+
+def _inline_scope_process(url, run_id, ready, start, release, results):
+    engine = create_engine(url)
+    factory = sessionmaker(bind=engine)
+    runs = SQLAlchemyAgentRunRepository(session_factory=factory, auto_create=False)
+    queue = SQLAlchemyTaskExecutionRepository(session_factory=factory, auto_create=False)
+    ready.put(os.getpid())
+    if not start.wait(20):
+        raise RuntimeError("inline start barrier timed out")
+    try:
+        run = runs.get(run_id)
+        with model_turn_lease_scope(runs, run, execution_repository=queue) as claimed:
+            results.put("won")
+            if not release.wait(20):
+                raise RuntimeError("inline release barrier timed out")
+            run.metadata["inline_checkpoint_pid"] = os.getpid()
+            run.status = "paused"
+            claimed.save(run)
+    except WorkerLeaseLost:
+        results.put("lost")
+    finally:
+        engine.dispose()
+
+
+def test_two_processes_first_inline_enqueue_share_one_existing_run_lease(trusted_actor):
+    actor = trusted_actor()
+    runs = SQLAlchemyAgentRunRepository(session_factory=actor.factory)
+    queue = SQLAlchemyTaskExecutionRepository(session_factory=actor.factory)
+    run = _run(actor)
+    runs.save(run)
+    assert queue.get(run.run_id) is None
+    ctx = multiprocessing.get_context("spawn")
+    ready, results = ctx.Queue(), ctx.Queue()
+    start, release = ctx.Event(), ctx.Event()
+    processes = [
+        ctx.Process(
+            target=_inline_scope_process,
+            args=(str(actor.factory.kw["bind"].url), run.run_id, ready, start, release, results),
+        )
+        for _ in range(2)
+    ]
+    try:
+        for process in processes:
+            process.start()
+        assert len({ready.get(timeout=20), ready.get(timeout=20)}) == 2
+        start.set()
+        assert {results.get(timeout=20), results.get(timeout=20)} == {"won", "lost"}
+        release.set()
+        for process in processes:
+            process.join(timeout=20)
+            assert process.exitcode == 0
+        assert queue.get(run.run_id).execution_count == 1
+        assert queue.get(run.run_id).state == "paused"
+        assert runs.get(run.run_id).metadata["inline_checkpoint_pid"] in {p.pid for p in processes}
+    finally:
+        release.set()
+        for process in processes:
+            if process.is_alive():
+                process.terminate()
+                process.join(timeout=5)
+        ready.close()
+        results.close()
+
