+def test_employee_agent_entry_preserves_original_batch_after_fresh_http_grant_and_spawn(
+    employee_case,
+    monkeypatch,
+):
+    case = employee_case
+    requests = _transport(monkeypatch)
+    context = {**case.actor.context, "task_id": "employee-original-task"}
+    with llm_client.llm_client_scope(case.model, MODEL_NAME):
+        initial = EmployeeAgent(case.pack.pack_id).run(
+            TASK,
+            runtime_context=context,
+            user_id=case.actor.user_id,
+            workspace_root=str(case.workspace),
+            session_id=case.actor.session_id,
+        )
+    assert initial["pending_approval"] is True, initial
+    run = case.http.repository.get(initial["run_id"])
+    assert run.status == "waiting_user"
+    assert [call.call_id for call in run.tool_calls] == ["read-before", "create"]
+    state = run.metadata[STATE_KEY]
+    assert state["kernel"] == "employee_agent" and state["next_call_index"] == 1
+    assert len(state["batch"]) == 3
+    assert MODEL_KEY not in json.dumps(state)
+    with tenant_scope(case.actor.tenant_id), case.actor.factory() as db:
+        assert db.query(PurchaseUnit).filter_by(unit_name="employee approved customer").count() == 0
+    review = case.http.client.get(f"/api/agent/runs/{run.run_id}")
+    assert STATE_KEY not in json.dumps(review.json())
+    final = _approve_and_resume(case, run)
+    assert final.status == "completed", final.to_dict()
+    assert [call.call_id for call in final.tool_calls] == ["read-before", "create", "read-after"]
+    assert final.metadata[STATE_KEY]["phase"] == "terminal"
+    assert len(final.metadata[STATE_KEY]["delivered"]) == 3
+    assert len(requests) == 3  # Full Employee cognition, original batch, final model round.
+    delivered = [row for row in requests[-1]["messages"] if row["role"] == "tool"]
+    assert [json.loads(row["content"]) for row in delivered] == [
+        call.output for call in final.tool_calls
+    ]
+    with tenant_scope(case.actor.tenant_id), case.actor.factory() as db:
+        assert db.query(PurchaseUnit).filter_by(unit_name="employee approved customer").count() == 1
+    with llm_client.llm_client_scope(case.model, MODEL_NAME):
+        replay = EmployeeAgent(case.pack.pack_id).run(
+            TASK,
+            runtime_context=context,
+            user_id=case.actor.user_id,
+            workspace_root=str(case.workspace),
+            session_id=case.actor.session_id,
+        )
+    assert replay["run_id"] == final.run_id and replay["success"] is True and len(requests) == 3
+
