+@pytest.mark.parametrize("memory", [False, True])
+def test_exact_claim_fences_reused_owner_heartbeat_and_finish(trusted_actor, memory):
+    actor = trusted_actor()
+    queue = (
+        InMemoryTaskExecutionRepository()
+        if memory
+        else SQLAlchemyTaskExecutionRepository(session_factory=actor.factory)
+    )
+    run = _run(actor)
+    queue.enqueue(run)
+    first = queue.claim_run(run.run_id, "same-owner", lease_seconds=1)
+    later = (datetime.now(UTC) + timedelta(minutes=5)).isoformat()
+    replacement = queue.claim_run(run.run_id, "same-owner", lease_seconds=60, now=later)
+    assert replacement.execution_count == first.execution_count + 1
+    assert replacement.recovery_count == 1
+    assert not queue.heartbeat(
+        run.run_id,
+        "same-owner",
+        lease_seconds=60,
+        execution_count=first.execution_count,
+    )
+    assert (
+        queue.finish(
+            run.run_id,
+            "same-owner",
+            "failed",
+            execution_count=first.execution_count,
+        )
+        is None
+    )
+    assert queue.get(run.run_id).state == "claimed"
+    assert queue.heartbeat(
+        run.run_id,
+        "same-owner",
+        lease_seconds=60,
+        execution_count=replacement.execution_count,
+    )
+    assert (
+        queue.finish(
+            run.run_id,
+            "same-owner",
+            "completed",
+            execution_count=replacement.execution_count,
+        ).state
+        == "completed"
+    )
+
+
+def _expire(factory, run_id):
+    with factory.begin() as db:
+        db.query(AgentTaskExecutionRecord).filter_by(run_id=run_id).update(
+            {"lease_expires_at": "2000-01-01T00:00:00+00:00"}
+        )
+
