+def _message(content="", calls=()):
+    return SimpleNamespace(
+        choices=[
+            SimpleNamespace(
+                finish_reason="tool_calls" if calls else "stop",
+                message=SimpleNamespace(
+                    content=content,
+                    tool_calls=[
+                        SimpleNamespace(
+                            id=identity,
+                            function=SimpleNamespace(name=name, arguments=json.dumps(params)),
+                        )
+                        for identity, name, params in calls
+                    ],
+                ),
+            )
+        ],
+        usage=None,
+    )
+
+
+def _calls():
+    return [
+        ("read-before", "business_db_read", {"entity": "customers"}),
+        (
+            "create",
+            "business_db_write",
+            {
+                "entity": "customers",
+                "operation": "create",
+                "payload": {"unit_name": "kernel approved customer"},
