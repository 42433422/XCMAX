+def test_claimed_intent_save_and_business_transaction_reject_old_count(trusted_actor):
+    actor = trusted_actor()
+    runs = SQLAlchemyAgentRunRepository(session_factory=actor.factory)
+    queue = SQLAlchemyTaskExecutionRepository(session_factory=actor.factory)
+    run = _run(actor)
+    runs.save(run)
+    queue.enqueue(run)
+    first = queue.claim_run(run.run_id, "same-owner", lease_seconds=60)
+    stale = ClaimedRunRepository(runs, first, "same-owner")
+    _expire(actor.factory, run.run_id)
+    replacement = queue.claim_run(run.run_id, "same-owner", lease_seconds=60)
+    # Mutating the caller's old model cannot refresh a wrapper or active scope.
+    with worker_claim_scope(runs, first, "same-owner"):
+        first.execution_count = replacement.execution_count
+        assert capture_worker_claim()[2] != replacement.execution_count
+        with actor.factory() as db, pytest.raises(WorkerLeaseLost), worker_write_guard(db):
+            db.add(Product(name="must not be written", tenant_id=actor.tenant_id))
+            db.commit()
+    for method in (stale.save, stale.save_tool_intent):
+        with pytest.raises(WorkerLeaseLost):
+            method(_intent(run))
+    assert not runs.get(run.run_id).tool_calls
+    fresh = ClaimedRunRepository(runs, replacement, "same-owner")
+    intended = _intent(run)
+    assert fresh.save_tool_intent(intended) is None
+    reopened = SQLAlchemyAgentRunRepository(session_factory=actor.factory).get(run.run_id)
+    assert reopened.tool_calls[0].call_id == intended.tool_calls[0].call_id
+    with pytest.raises(WorkerLeaseLost, match="another run"):
+        fresh.save_tool_intent(_intent(_run(actor, "other")))
+    for forbidden in (
+        "save_in_session",
+        "save_claimed",
+        "transaction",
+        "clear",
+        "claim_first_task_run",
+    ):
+        with pytest.raises(AttributeError):
+            getattr(fresh, forbidden)
+
