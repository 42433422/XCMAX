+@pytest.fixture
+def employee_case(tmp_path, monkeypatch, signed_employee_pack, trusted_actor, reviewed_agent_http):
+    """Real signed agent pack + entitled actor + original host DB and review routes."""
+    from app.application.tools.workflow import invalidate_workflow_tool_registry
+    from app.infrastructure.llm.providers import registry
+
+    pack = signed_employee_pack(pack_id="model-turn-employee", install=False)
+    manifest = json.loads((pack.source_dir / "manifest.json").read_text())
+    actions = {"handlers": ["agent"], "agent": {"tools": ["business_db_read", "business_db_write"]}}
+    manifest["actions"] = actions
+    config = manifest["employee_config_v2"]
+    config["actions"] = actions
+    config["tools"] = ["business_db_read", "business_db_write"]
+    config["perception"] = {"type": "text"}
+    config["cognition"]["agent"]["system_prompt"] = (
+        "依据真实客户工具回执完成任务；写入必须等待正式审批。"
+    )
+    config["cognition"]["skills"] = [{"name": "customers", "brief": "客户读取与正式审批写入"}]
+    config["risk_level"] = "medium"
+    manifest["employee"]["capabilities"] = ["customers.read", "customers.write"]
+    for row in manifest.get("workflow_employees", []):
+        row["id"] = pack.pack_id
+        row["api_base_path"] = f"employees/{pack.pack_id}"
+    (pack.source_dir / "manifest.json").write_text(json.dumps(manifest, ensure_ascii=False))
+    package = ModPackage(str(pack.source_dir)).create_package(
+        str(tmp_path / "agent-packages"),
+        include_signature=True,
+        private_key=str(pack.private_key_path),
+    )
+    installed = pack.registry.install_from_package(package, verify_signature=True)
+    assert installed[0], installed
+    assert load_employee_pack_from_disk(pack.pack_id)["manifest"]["actions"]["handlers"] == [
+        "agent"
+    ]
+    actor = trusted_actor(mod_id=pack.pack_id)
+    workspace = tmp_path / "workspace"
+    workspace.mkdir()
+    monkeypatch.setenv("WORKSPACE_ROOT", str(workspace))
+    monkeypatch.setenv(
+        "XCAGI_MOD_DATABASE_URLS", json.dumps({pack.pack_id: str(actor.factory.kw["bind"].url)})
+    )
+    for name in (
+        "XCAUTO_API_KEY",
+        "XCAUTO_PAT",
+        "XIUCI_API_KEY",
+        "DEEPSEEK_API_KEY",
+        "LLM_ROUTING_ORDER",
