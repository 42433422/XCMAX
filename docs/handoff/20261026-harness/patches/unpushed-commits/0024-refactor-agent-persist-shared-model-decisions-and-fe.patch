+@pytest.mark.parametrize("corruption", ["missing", "changed"])
+def test_delivered_receipt_corruption_blocks_approval_and_remaining_calls(
+    trusted_actor, reviewed_agent_http, model, monkeypatch, corruption
+):
+    from app.application.agent_orchestrator.orchestrator import AgentOrchestrator
