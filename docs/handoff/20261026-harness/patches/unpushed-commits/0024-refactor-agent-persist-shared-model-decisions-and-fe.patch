+def _pause_claimed_intent(url, run_id, ready, resume, result):
+    engine = create_engine(url)
+    factory = sessionmaker(bind=engine)
+    runs = SQLAlchemyAgentRunRepository(session_factory=factory, auto_create=False)
+    queue = SQLAlchemyTaskExecutionRepository(session_factory=factory, auto_create=False)
+    claim = queue.claim_run(run_id, "intent-writer", lease_seconds=60)
+
+    def pause_after_fence(_connection, _cursor, statement, _parameters, _context, _many):
+        if statement.startswith("UPDATE agent_task_executions"):
+            ready.put(claim.execution_count)
+            if not resume.wait(20):
+                raise RuntimeError("intent transaction barrier timed out")
+
+    event.listen(engine, "after_cursor_execute", pause_after_fence)
+    try:
+        pending = _intent(runs.get(run_id))
+        conflict = ClaimedRunRepository(runs, claim, "intent-writer").save_tool_intent(pending)
+        result.put((conflict, pending.tool_calls[0].call_id))
+    finally:
+        engine.dispose()
+
+
+def test_fenced_intent_holds_queue_lock_until_same_transaction_commits(trusted_actor):
+    actor = trusted_actor()
+    runs = SQLAlchemyAgentRunRepository(session_factory=actor.factory)
+    queue = SQLAlchemyTaskExecutionRepository(session_factory=actor.factory)
+    run = _run(actor)
+    runs.save(run)
+    queue.enqueue(run)
+    ctx = multiprocessing.get_context("spawn")
+    ready, result, resume = ctx.Queue(), ctx.Queue(), ctx.Event()
+    url = str(actor.factory.kw["bind"].url)
+    process = ctx.Process(
+        target=_pause_claimed_intent, args=(url, run.run_id, ready, resume, result)
+    )
+    contender_engine = create_engine(url, connect_args={"timeout": 0.1})
+    contender = SQLAlchemyTaskExecutionRepository(
+        session_factory=sessionmaker(bind=contender_engine), auto_create=False
+    )
+    future = (datetime.now(UTC) + timedelta(minutes=5)).isoformat()
+    try:
+        process.start()
+        assert ready.get(timeout=20) == 1
+        with pytest.raises(OperationalError, match="locked"):
+            contender.claim_run(run.run_id, "takeover", lease_seconds=60, now=future)
+        assert not runs.get(run.run_id).tool_calls
+        resume.set()
+        conflict, call_id = result.get(timeout=20)
+        assert conflict is None
+        process.join(timeout=20)
+        assert process.exitcode == 0
+        replacement = contender.claim_run(run.run_id, "takeover", lease_seconds=60, now=future)
+        assert replacement.execution_count == 2
+        assert runs.get(run.run_id).tool_calls[0].call_id == call_id
+    finally:
+        resume.set()
+        if process.is_alive():
+            process.terminate()
+            process.join(timeout=5)
+        ready.close()
+        result.close()
+        contender_engine.dispose()
+
