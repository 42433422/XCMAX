+"""Two real processes compete to continue one formally approved original batch."""
+
+import copy
+import json
+import multiprocessing
+from types import SimpleNamespace
+
+import pytest
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+
+from tests.fixtures.backend_ci_isolation import reviewed_agent_http as reviewed_agent_http
+from tests.fixtures.backend_ci_isolation import trusted_actor as trusted_actor
+from tests.test_application.test_model_turn_runtime import _calls, _message
+from tests.test_application.test_model_turn_runtime import model as model
+
+
+def _resume_original_batch(url, run_id, owner, ready, start, outcomes):
+    from openai.resources.chat.completions import Completions
+
+    from app import db as host_db
+    from app.application.agent_orchestrator import run_repository, task_execution_repository
+    from app.application.agent_orchestrator.orchestrator import AgentOrchestrator
+    from app.application.agent_orchestrator.run_sql_repository import SQLAlchemyAgentRunRepository
+    from app.application.agent_orchestrator.task_execution_sql_repository import (
+        SQLAlchemyTaskExecutionRepository,
+    )
+    from app.application.agent_orchestrator.worker_repository import ClaimedRunRepository
+
+    engine = create_engine(url)
+    factory = sessionmaker(bind=engine)
+    host_db.HostSessionLocal = factory
+    runs = SQLAlchemyAgentRunRepository(session_factory=factory, auto_create=False)
+    queue = SQLAlchemyTaskExecutionRepository(session_factory=factory, auto_create=False)
+    run_repository._agent_run_repository = runs
+    task_execution_repository._task_execution_repository = queue
+    model_receipts = []
+
+    def complete(self, **request):
+        receipts = [
+            json.loads(row["content"]) for row in request["messages"] if row["role"] == "tool"
+        ]
+        assert len(receipts) == 3 and receipts[1]["business_verification"]["verified"] is True
+        model_receipts.append(receipts)
+        return _message("original batch finished in the winning process")
+
+    Completions.create = complete
+    ready.put(owner)
+    try:
+        if not start.wait(25):
+            raise RuntimeError("resume barrier timed out")
+        execution = queue.claim_run(run_id, owner, lease_seconds=60)
+        if execution is None:
+            outcomes.put({"owner": owner, "claimed": False, "model_rounds": 0})
+            return
+        final = AgentOrchestrator(
+            repository=ClaimedRunRepository(runs, execution, owner)
+        ).execute_dispatched_run(run_id)
+        queue.finish(run_id, owner, final.status, execution_count=execution.execution_count)
+        outcomes.put(
+            {
+                "owner": owner,
+                "claimed": True,
+                "status": final.status,
+                "model_rounds": len(model_receipts),
+                "receipts": model_receipts,
+                "call_ids": [call.call_id for call in final.tool_calls],
+            }
+        )
+    finally:
+        engine.dispose()
+
+
+def _waiting_batch(actor, http, model, monkeypatch):
