+def test_two_processes_resume_one_approved_batch_with_one_write_and_next_round(
+    trusted_actor, reviewed_agent_http, model, monkeypatch
+):
+    from app.application.agent_orchestrator.run_models import AgentRun
+    from app.db.models.purchase_unit import PurchaseUnit
+    from app.infrastructure.tenant_scope import tenant_scope
+
+    actor = trusted_actor()
+    http = reviewed_agent_http(actor)
+    waiting = _waiting_batch(actor, http, model, monkeypatch)
+    reviewed = http.client.get(f"/api/agent/runs/{waiting.run_id}")
+    assert reviewed.status_code == 200
+    approved = http.client.post(
+        f"/api/agent/runs/{waiting.run_id}/continue",
+        json={"approval_grant": reviewed.json()["approval"]["grant"]},
+    )
+    assert approved.status_code == 202, approved.text
+    unrelated = AgentRun(user_id=str(actor.user_id), message="unrelated higher priority task")
+    unrelated.metadata["runtime_context"] = copy.deepcopy(actor.context)
+    http.queue.enqueue(unrelated, priority=1)
+    ctx = multiprocessing.get_context("spawn")
+    ready, outcomes, start = ctx.Queue(), ctx.Queue(), ctx.Event()
+    workers = [
+        ctx.Process(
+            target=_resume_original_batch,
+            args=(str(actor.factory.kw["bind"].url), waiting.run_id, owner, ready, start, outcomes),
+        )
+        for owner in ("resume-one", "resume-two")
+    ]
+    try:
+        for process in workers:
+            process.start()
+        assert {ready.get(timeout=25), ready.get(timeout=25)} == {"resume-one", "resume-two"}
+        start.set()
+        values = [outcomes.get(timeout=45), outcomes.get(timeout=45)]
+        assert sorted(value["claimed"] for value in values) == [False, True]
+        winner = next(value for value in values if value["claimed"])
+        assert winner["status"] == "completed" and winner["model_rounds"] == 1
+        assert winner["call_ids"] == ["read-before", "create", "read-after"]
+        for process in workers:
+            process.join(timeout=20)
+            assert process.exitcode == 0
+        final = http.repository.get(waiting.run_id)
+        assert winner["receipts"] == [[call.output for call in final.tool_calls]]
+        assert (
+            http.queue.get(waiting.run_id).execution_count == 2
+        )  # Initial turn plus one continuation.
+        assert http.queue.get(unrelated.run_id).state == "queued"
+        with tenant_scope(actor.tenant_id), actor.factory() as db:
+            assert (
+                db.query(PurchaseUnit).filter_by(unit_name="kernel approved customer").count() == 1
+            )
+    finally:
+        start.set()
+        for process in workers:
+            if process.is_alive():
+                process.terminate()
+                process.join(timeout=5)
+        ready.close()
+        outcomes.close()
+
