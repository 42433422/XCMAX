+def _execute_approved_and_crash_before_cursor(url, run_id, crash_after_intent=False):
+    from app.application.agent_orchestrator.business_write_guard import worker_claim_scope
+    from app.application.employee_runtime.agent_loop import EmployeeModelPolicy
+    from app.infrastructure.llm.client import resolve_durable_model_client
+
+    engine = create_engine(url)
+    factory = sessionmaker(bind=engine)
+    if crash_after_intent:
+        intent = {"committing": False}
+
+        def observe_run_write(_connection, _cursor, statement, parameters, _context, _many):
+            if not statement.startswith("UPDATE agent_runs"):
+                return
+            for value in parameters:
+                if not isinstance(value, str) or not value.startswith("{"):
+                    continue
+                payload = json.loads(value)
+                steps, calls = payload.get("steps", []), payload.get("tool_calls", [])
+                if len(steps) == 2 and steps[1]["status"] == "running" and len(calls) == 2:
+                    intent["committing"] = calls[1]["output"].get("pending_approval") is True
+
+        def crash_after_real_commit(_session):
+            if intent["committing"]:
+                os._exit(74)
+
+        event.listen(engine, "after_cursor_execute", observe_run_write)
+        event.listen(factory.class_, "after_commit", crash_after_real_commit)
+    runs = SQLAlchemyAgentRunRepository(session_factory=factory, auto_create=False)
+    queue = SQLAlchemyTaskExecutionRepository(session_factory=factory, auto_create=False)
+    execution = queue.get(run_id)
+    run = runs.get(run_id)
+    state = copy.deepcopy(run.metadata[STATE_KEY])
+    context = dict(run.metadata["runtime_context"])
+    client, model = resolve_durable_model_client(context, state["model_reference"])
+    policy = EmployeeModelPolicy.restore(state["policy"], context, client, model)
+    fenced = ClaimedRunRepository(runs, execution, execution.lease_owner)
+    driver = ModelTurnDriver(policy, repository=fenced, run_id=run_id, context=context, state=state)
+    driver.initialize([], limits={})
+    with worker_claim_scope(runs, execution, execution.lease_owner):
+        driver.execute_approved(
+            AgentOrchestrator(repository=fenced), run.metadata["dispatch"]["approved_step_id"]
+        )
+    saved = runs.get(run_id)
+    assert saved.metadata[STATE_KEY]["phase"] == "waiting_approval"
+    assert saved.metadata[STATE_KEY]["next_call_index"] == 1
+    assert saved.tool_calls[1].call_id == "create" and saved.tool_calls[1].status == "completed"
+    assert saved.tool_calls[1].output["business_verification"]["verified"] is True
+    client.close()
+    engine.dispose()
+    os._exit(73)
