+def test_claimed_intent_retains_unresolved_write_conflict(trusted_actor):
+    actor = trusted_actor()
+    runs = SQLAlchemyAgentRunRepository(session_factory=actor.factory)
+    queue = SQLAlchemyTaskExecutionRepository(session_factory=actor.factory)
+    original = _intent(_run(actor, "unknown customer write"))
+    runs.save(original)
+    candidate = _run(actor, "new write")
+    runs.save(candidate)
+    queue.enqueue(candidate)
+    claim = queue.claim_run(candidate.run_id, "worker", lease_seconds=60)
+    assert (
+        ClaimedRunRepository(runs, claim, "worker").save_tool_intent(_intent(candidate))
+        == original.run_id
+    )
+    assert not runs.get(candidate.run_id).tool_calls
