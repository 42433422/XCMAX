+"""Unit model fixtures use real installed Employee ownership and durable admission.
+
+Only model output and explicitly patched read-tool transports are synthetic.
+Fresh provider call IDs and terminal markers describe valid SDK completions;
+malformed/duplicate provider decisions have separate real-kernel regressions.
+"""
+
+import copy
+from unittest.mock import MagicMock
+
+import pytest
+
+
+@pytest.fixture(autouse=True)
+def employee_transport(monkeypatch, request, employee_case, trusted_actor):
+    from app.application.employee_runtime import agent_loop
+    from app.infrastructure.auth.agent_mod_scope import _bound_actor
+    from app.infrastructure.llm import client as llm_client
+    from tests.test_application.test_employee_model_turn import admit_employee_case
+
+    original = agent_loop.run_employee_agent_loop
+
+    def invoke(**options):
+        context = dict(options.get("runtime_context") or {})
+        if context.get("_actor_authorization"):
+            user = _bound_actor(context)
+            employee_case.actor = trusted_actor(
+                user_id=user.id, tenant_id=user.tenant_id, mod_id=employee_case.pack.pack_id
+            )
+        run, context = admit_employee_case(employee_case, task=options.get("task") or "unit task")
+        run.metadata["response_kind"] = (
+            "conversation"  # This scaffold tests transport, not business completion.
+        )
+        employee_case.http.repository.save(run)
+        options.update(employee_id=employee_case.pack.pack_id, runtime_context=context)
+        try:
+            model = llm_client.get_openai_compatible_client()
+        except (RuntimeError, OSError):
+            return original(**options)  # Exercise the production unavailable-LLM result.
+        if isinstance(model, MagicMock):
+            model.api_key, model.base_url = (
+                employee_case.model.api_key,
+                employee_case.model.base_url,
+            )
+            model.is_modstore_openai_compatible = False
+            create = model.chat.completions.create
+            seen, round_number = set(), 0
+
+            def complete(**payload):
+                nonlocal round_number
+                round_number += 1
+                response = copy.deepcopy(create(**payload))
+                for choice in response.choices:
+                    calls = getattr(choice.message, "tool_calls", None) or []
+                    if not isinstance(getattr(choice, "finish_reason", None), str):
+                        choice.finish_reason = "tool_calls" if calls else "stop"
+                    for call in calls:
+                        if call.id in seen:
+                            call.id = f"{call.id}-round-{round_number}"
+                        seen.add(call.id)
+                return response
+
+            model.chat.completions.create = MagicMock(side_effect=complete)
+        return original(**options)
+
+    monkeypatch.setattr(request.module, "run_employee_agent_loop", invoke)
