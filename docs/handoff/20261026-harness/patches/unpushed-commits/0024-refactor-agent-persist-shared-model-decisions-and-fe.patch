+@pytest.mark.parametrize(
+    "cut", ["before_batch", "after_batch", "after_intent", "after_receipt", "after_terminal"]
+)
+def test_crash_boundaries_resume_original_decision_without_redispatch(
+    trusted_actor, reviewed_agent_http, model, monkeypatch, cut
+):
+    from openai.resources.chat.completions import Completions
+
+    from app.application.agent_orchestrator.model_turn_runtime import STATE_KEY, ModelTurnDriver
+    from app.application.agent_orchestrator.orchestrator import AgentOrchestrator
+    from app.application.agent_orchestrator.run_sql_repository import SQLAlchemyAgentRunRepository
+    from app.application.agent_orchestrator.worker_repository import ClaimedRunRepository
+    from app.legacy.chat import legacy_chat_adapter as adapter
+
+    actor = trusted_actor()
+    http = reviewed_agent_http(actor)
+    requests, dispatched = [], []
+    original_execute = adapter._resolve_chat_execute_tool()
+
+    def execute(*args, **kwargs):
+        dispatched.append(args[0])
+        return original_execute(*args, **kwargs)
+
+    monkeypatch.setattr(adapter, "_resolve_chat_execute_tool", lambda: execute)
+
+    def complete(self, **request):
+        requests.append(request)
+        return _message(
+            "terminal saved" if len(requests) > 1 else "",
+            [] if len(requests) > 1 else [_calls()[0]],
+        )
+
+    monkeypatch.setattr(Completions, "create", complete)
+    checkpoint = ModelTurnDriver.checkpoint
+    save_claimed = SQLAlchemyAgentRunRepository.save_claimed
+    tripped = []
+
+    def fail_checkpoint(driver):
+        state = driver.state
+        match = (
+            (
+                cut in {"before_batch", "after_batch"}
+                and state["phase"] == "tool_batch"
+                and not state["next_call_index"]
+            )
+            or (
+                cut == "after_receipt"
+                and state["phase"] == "tool_batch"
+                and state["next_call_index"] == 1
+            )
+            or (cut == "after_terminal" and state["phase"] == "terminal")
+        )
+        if match and not tripped:
+            tripped.append(True)
+            if cut in {"after_batch", "after_terminal"}:
+                checkpoint(driver)
+            raise SystemExit("simulated process death")
+        return checkpoint(driver)
+
+    def fail_intent(repository, run, **kwargs):
+        result = save_claimed(repository, run, **kwargs)
+        if (
+            cut == "after_intent"
+            and run.tool_calls
+            and not run.tool_calls[-1].output
+            and not tripped
+        ):
+            tripped.append(True)
+            raise SystemExit("simulated process death after intent commit")
+        return result
+
+    monkeypatch.setattr(ModelTurnDriver, "checkpoint", fail_checkpoint)
+    monkeypatch.setattr(SQLAlchemyAgentRunRepository, "save_claimed", fail_intent)
+    context = {**actor.context, "conversation_id": "crash", "turn_id": cut}
+    with pytest.raises(SystemExit):
+        adapter.chat("query", runtime_context=context, client=model, model="fixture-model")
+    monkeypatch.setattr(ModelTurnDriver, "checkpoint", checkpoint)
+    monkeypatch.setattr(SQLAlchemyAgentRunRepository, "save_claimed", save_claimed)
+    run = http.repository.list_recent(user_id=str(actor.user_id))[0]
+    if cut == "after_terminal":
+        reply = adapter.chat("query", runtime_context=context, client=model, model="fixture-model")
+        assert reply["success"] and reply["text"] == "terminal saved"
+        assert len(requests) == 2 and dispatched == ["business_db_read"]
+        return
+    http.queue.enqueue(run)
+    execution = http.queue.claim_run(run.run_id, "crash-test", lease_seconds=60)
+    assert execution is not None
+    final = AgentOrchestrator(
+        repository=ClaimedRunRepository(http.repository, execution, "crash-test")
+    ).execute_dispatched_run(run.run_id, recovered=True)
+    if cut in {"before_batch", "after_intent"}:
+        assert final.status == "blocked" and final.metadata[STATE_KEY]["phase"] == "reconciliation"
+        assert not dispatched and len(requests) == 1
+    else:
+        assert final.status == "completed", final.error
+        assert dispatched == ["business_db_read"] and len(requests) == 2
+        assert len(final.tool_calls) == 1
+
