+def test_employee_model_cannot_expand_original_allowed_catalog(employee_case, monkeypatch):
+    case = employee_case
+    requests = _transport(
+        monkeypatch,
+        calls=[
+            (
+                "outside-catalog",
+                "generate_office_document",
+                {"doc_type": "docx", "title": "outside"},
+            )
+        ],
+        assert_offered=False,
+    )
+    result, run = _standalone_loop(case)
+    assert result["success"] is False and result["execution_state"] == "failed", result
+    assert not run.tool_calls and not run.steps
+    assert run.status == "failed" and run.metadata[STATE_KEY]["phase"] == "terminal"
+    assert len(requests) == 1
+    assert not list(case.workspace.rglob("*.docx"))
