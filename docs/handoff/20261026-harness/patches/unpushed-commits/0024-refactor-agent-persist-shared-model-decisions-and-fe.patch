+def test_fresh_same_scope_host_session_can_resolve_same_market_account(trusted_actor):
+    original = trusted_actor()
+    reference = capture_durable_model_reference(original.context, _market(original), MODEL)
+    fresh = trusted_actor(user_id=original.user_id)
+    _market(fresh, token=ROTATED_TOKEN)
+    with original.factory.begin() as db:
+        db.get(UserSession, original.session_row_id).expires_at = utc_now_naive() - timedelta(
+            seconds=1
+        )
+    restored, model = resolve_durable_model_client(fresh.context, reference)
+    assert model == MODEL and restored.adapter.auth_token == ROTATED_TOKEN
+    with pytest.raises(ValueError):
+        resolve_durable_model_client(original.context, reference)
+
