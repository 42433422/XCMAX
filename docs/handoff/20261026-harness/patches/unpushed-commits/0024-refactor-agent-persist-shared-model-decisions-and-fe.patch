+    other = trusted_actor()
+    _market(other, token="synthetic-newest-other-owner-token")
+    context = copy.deepcopy(actor.context)
+    with actor.factory.begin() as db:
+        if invalid == "expired":
+            db.get(UserSession, actor.session_row_id).expires_at = utc_now_naive() - timedelta(
+                seconds=1
