+def _market(actor, *, token=MARKET_TOKEN, market_user_id=71, endpoint=MARKET_ENDPOINT):
+    with actor.factory.begin() as db:
+        row = db.get(UserSession, actor.session_row_id)
+        row.market_user_id = market_user_id
+        row.market_access_token = token
+    return ModstoreOpenAICompatibleClient(
+        ModstorePlatformAdapter(
+            platform_url=endpoint,
+            auth_token=token,
+            default_provider="original-provider",
+            default_model="original-model",
+        )
+    )
+
+
+def _store_reference(actor, reference):
+    state = decode_state(
+        {
+            "version": 1,
+            "kernel": "legacy",
+            "phase": "ready_model",
+            "revision": 0,
+            "round": 0,
+            "next_call_index": 0,
+            "messages": [],
+            "batch": [],
+            "request_view": None,
+            "delivered": [],
+            "fingerprints": [],
+            "limits": {"rounds": 8, "calls": 32, "repeat": 0, "seconds": 300},
+            "active_seconds": 0.0,
+            "policy": {},
+            "model_reference": safe_value(
+                reference, secrets=(HOST_KEY, MARKET_TOKEN, ROTATED_TOKEN)
+            ),
+        }
+    )
+    run = AgentRun(user_id=str(actor.user_id), message="reference recovery check")
+    run.metadata["runtime_context"] = {"tenant_id": actor.tenant_id}
+    run.metadata[STATE_KEY] = state
+    runs = SQLAlchemyAgentRunRepository(session_factory=actor.factory)
+    runs.save(run)
+    saved = SQLAlchemyAgentRunRepository(session_factory=actor.factory).get(run.run_id)
+    encoded = json.dumps(saved.metadata[STATE_KEY])
+    for forbidden in (
+        HOST_KEY,
+        MARKET_TOKEN,
+        ROTATED_TOKEN,
+        actor.session_id,
+        actor.context["_actor_authorization"]["proof"],
+    ):
+        assert forbidden not in encoded
+    assert "api_key" not in encoded and "auth_token" not in encoded
+    return decode_state(saved.metadata[STATE_KEY])["model_reference"]
+
