+            # text and durable decision pass the same credential boundary.
+            safe_value(
+                "".join(event["text"] for event in text_events), secrets=self.policy.secrets()
+            )
+            self._accept_decision(decision)
+            yield from text_events
+            if self.state["phase"] == "terminal":
+                yield {"type": "result", "result": self.finish(self.state["outcome"])}
+                return
