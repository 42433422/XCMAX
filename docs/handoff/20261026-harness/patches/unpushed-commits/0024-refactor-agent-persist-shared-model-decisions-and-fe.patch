+
+def run_model_turn(
+    policy,
+    *,
+    messages=None,
+    limits=None,
+    context=None,
+    repository=None,
+    run_id="",
+    approved_controller=None,
+    approved_step_id="",
+):
+    """Own one exact-run lease for either inline or queued execution."""
+    from contextlib import nullcontext
+
+    from .context_window_manager import ContextBudgetExceeded
+    from .worker_repository import model_turn_lease_scope
+
+    run = repository.get(run_id) if repository else None
+    lease = model_turn_lease_scope(repository, run) if run else nullcontext(repository)
+    with lease as fenced:
+        saved = fenced.get(run_id).metadata.get(STATE_KEY) if fenced else None
+        driver = ModelTurnDriver(
+            policy, repository=fenced, run_id=run_id, context=context, state=saved
+        )
+        try:
+            driver.initialize(messages or [], limits=limits or {})
+            if controlled := driver.apply_control():
+                yield {"type": "result", "result": controlled}
+                return
+            if approved_controller:
+                # The background controller already owns this exact fenced repository.
+                driver.execute_approved(approved_controller, approved_step_id)
+            yield from driver.drive()
+        except (ModelTurnError, ContextBudgetExceeded) as exc:
+            if driver.state is None:
+                raise
+            if isinstance(exc, (ModelTurnRejected, ContextBudgetExceeded)):
+                driver.state.update(
+                    phase="terminal",
+                    outcome="failure",
+                    final_text="",
+                    notice=str(exc),
+                    exit_status=getattr(exc, "error_code", "tool_blocked"),
+                )
+                driver.checkpoint()
+                yield {
+                    "type": "result",
+                    "result": driver.finish(
+                        "failure", receipt={"message": str(exc), "retryable": False}
+                    ),
+                }
+                return
+            driver.state["blocked_model_recovery"] = True
+            driver.state["exit_status"] = getattr(exc, "error_code", "model_turn_contract_invalid")
+            yield {
+                "type": "result",
+                "result": driver._suspend(
+                    "unknown", {"message": str(exc), "error_code": "model_turn_contract_invalid"}
+                ),
+            }
+
+
+def resume_model_turn(controller, run, *, approved_step_id=""):
+    from app.infrastructure.auth.agent_mod_scope import validate_actor_context
+    from app.infrastructure.llm.client import resolve_durable_model_client
+
+    state = decode_state(run.metadata[STATE_KEY])
+    context = dict(run.metadata.get("runtime_context") or {})
+    if validate_actor_context(context):
+        raise ModelTurnError("持久模型任务登录授权失效")
+    client, model = resolve_durable_model_client(context, state["model_reference"])
+    if state["kernel"] == "legacy":
+        from app.legacy.chat.legacy_chat_runtime import LegacyModelPolicy
+
+        from .trace_runs import LegacyExecutionLease
+
+        context["_legacy_execution_lease"] = LegacyExecutionLease(run.run_id)
+        policy = LegacyModelPolicy.restore(state["policy"], context, client, model)
+    else:
+        from app.application.employee_runtime.agent_loop import EmployeeModelPolicy
+
+        policy = EmployeeModelPolicy.restore(state["policy"], context, client, model)
+    for event in run_model_turn(
+        policy,
+        context=context,
+        repository=controller._repo,
+        run_id=run.run_id,
+        approved_controller=controller,
+        approved_step_id=approved_step_id,
+    ):
+        if event["type"] == "result":
+            return controller._repo.get(run.run_id)
+    raise ModelTurnError("模型恢复没有保存结果")
+
+
+def terminal_model_payload(run):
+    """Rebuild a final response after the terminal checkpoint/HTTP crash boundary."""
+    state = decode_state(run.metadata[STATE_KEY])
+    if state["phase"] != "terminal":
+        return None
+    if state["kernel"] == "legacy":
+        from app.legacy.chat.legacy_chat_runtime import LegacyModelPolicy
+
+        policy = LegacyModelPolicy.restore(
+            state["policy"], {}, None, state["model_reference"]["model"]
+        )
+    else:
+        from app.application.employee_runtime.agent_loop import EmployeeModelPolicy
+
+        snapshot = dict(state["policy"])
+        snapshot["candidates"] = json.loads(snapshot.pop("candidates_json"))
+        policy = EmployeeModelPolicy({}, None, state["model_reference"]["model"], **snapshot)
+    for call in run.tool_calls:
+        policy.observe(
+            {
+                "id": call.call_id,
+                "name": call.metadata.get("model_tool_name", call.tool_id),
+                "params": call.metadata.get("model_params", call.params),
+            },
+            copy.deepcopy(call.output),
+        )
+    return policy.result(state, state["outcome"], {})
