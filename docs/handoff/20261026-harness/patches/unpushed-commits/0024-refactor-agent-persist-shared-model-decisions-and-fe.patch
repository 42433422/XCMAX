+def test_employee_saved_manifest_change_blocks_approved_write_and_later_model(
+    employee_case, monkeypatch
+):
+    case = employee_case
+    requests = _transport(monkeypatch)
+    result, waiting = _standalone_loop(case)
+    assert result["pending_approval"] is True
+    manifest_path = case.pack.pack_dir / "manifest.json"
+    manifest = json.loads(manifest_path.read_text())
+    manifest["employee_config_v2"]["workspace_policy"] = {"read_only": True}
+    manifest_path.write_text(json.dumps(manifest))
+    final = _approve_and_resume(case, waiting)
+    assert final.status == "blocked", final.to_dict()
+    assert final.metadata[STATE_KEY]["phase"] == "reconciliation"
+    assert len(requests) == 1
+    assert [call.call_id for call in final.tool_calls] == ["read-before", "create"]
+    with tenant_scope(case.actor.tenant_id), case.actor.factory() as db:
+        assert db.query(PurchaseUnit).filter_by(unit_name="employee approved customer").count() == 0
+
