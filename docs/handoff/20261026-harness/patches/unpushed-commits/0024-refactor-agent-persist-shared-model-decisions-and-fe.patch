+def run_employee_agent_loop(
+    *,
+    employee_id,
+    system_prompt,
+    task,
+    input_data=None,
+    tools=None,
+    workspace_root=None,
+    max_iterations=_DEFAULT_MAX_ITERATIONS,
+    wall_time_limit_sec=300.0,
+    repeat_limit=3,
+    gate=None,
+    model=None,
+    runtime_context=None,
+):
+    from app.application.agent_orchestrator.business_action_ledger import canonical_hash
+    from app.application.agent_orchestrator.chat_trace import _run_service
+    from app.application.agent_orchestrator.model_turn_runtime import run_model_turn
+    from app.infrastructure.llm.client import (
+        get_openai_compatible_client,
+        require_api_key,
+        resolve_chat_model,
+    )
 
