+
+    def _suspend(self, outcome, receipt):
+        self.state["phase"] = {"waiting_approval": "waiting_approval", "pending": "pending"}.get(
+            outcome, "reconciliation"
+        )
+        self.state["outcome"] = outcome
+        self.state["notice"] = str(
+            receipt.get("message") or receipt.get("error") or "工具结果尚未完成，请查询原任务核对"
+        )
+        self.checkpoint()
+        return self.finish(outcome, receipt=receipt)
+
+    def finish(self, outcome, *, receipt=None):
+        result = self.policy.result(self.state, outcome, receipt or {})
+        if self.persist_state and (run := self._run()):
+            phase = self.state["phase"]
+            if phase in {"pending", "reconciliation"}:
+                run.status = "blocked"
+            elif phase == "waiting_approval":
+                run.status = "waiting_user"
+            elif phase == "terminal":
+                run.status = (
+                    "completed"
+                    if self.state["outcome"] == "success"
+                    else "cancelled"
+                    if self.state["outcome"] == "cancelled"
+                    else "failed"
+                )
+            key = "employee_result" if self.policy.kernel == "employee_agent" else "chat_payload"
+            stored = run.final_output.get(key)
+            if (
+                self.policy.kernel == "employee_agent"
+                and isinstance(stored, dict)
+                and isinstance(stored.get("result"), dict)
+            ):
+                envelope = copy.deepcopy(stored)
+                outputs = envelope["result"].get("outputs", [])
+                envelope["result"]["outputs"] = [
+                    result if item.get("handler") == "agent" else item for item in outputs
+                ]
+                envelope.update(
+                    success=result["ok"],
+                    outcome=outcome,
+                    pending_approval=outcome == "waiting_approval",
+                    business_completed=outcome == "success" and bool(run.tool_calls),
+                )
+                run.final_output[key] = envelope
+            else:
+                run.final_output[key] = copy.deepcopy(result)
+            run.metadata["execution"] = {"state": "idle"}
+            run.add_event(
+                "model_turn." + self.state["phase"],
+                "模型任务状态已保存",
+                {
+                    "version": 1,
+                    "phase": self.state["phase"],
+                    "round": self.state["round"],
+                    "next_call_index": self.state["next_call_index"],
+                },
+            )
+            self.repository.save(run)
+            from .trace_payloads import trace_reply_payload
+
+            return trace_reply_payload(run, result)
+        return result
+
+    def apply_control(self):
+        if self.repository:
+            from .orchestrator import AgentOrchestrator
+
+            run = self._run()
+            if AgentOrchestrator(repository=self.repository)._apply_requested_control(run):
+                if run.status == "cancelled":
+                    self.state.update(
+                        phase="terminal",
+                        outcome="cancelled",
+                        final_text="请求已取消，未开始的调用已停止",
+                    )
+                    self.checkpoint()
+                return self.finish(
+                    "cancelled" if run.status == "cancelled" else "pending",
+                    receipt={"message": "任务已暂停或取消，未执行后续调用"},
+                )
+        return None
+
+    def assert_active_budget(self):
+        elapsed = self._active_previous + time.monotonic() - self._active_started
+        if elapsed >= self.state["limits"]["seconds"]:
+            raise ModelTurnRejected(
+                "任务有效执行时间已达预算，未派发后续调用", error_code="wall_time_limit"
+            )
+
+    def execute_approved(self, controller, step_id):
+        if not step_id:
+            return
+        if self.state["phase"] != "waiting_approval" or self.state["next_call_index"] >= len(
+            self.state["batch"]
+        ):
+            raise ModelTurnError("审批步骤不属于原模型批次游标")
+        call = self.state["batch"][self.state["next_call_index"]]
+        stored = self.receipt(call)
+        if stored is None or stored.step_id != step_id:
+            raise ModelTurnError("审批未绑定原模型调用")
+        run = self._run()
+        stored = next(item for item in run.tool_calls if item.call_id == call["id"])
+        step = next(item for item in run.steps if item.step_id == step_id)
+        outcome = tool_receipt_outcome(stored.output)
+        if outcome in {"success", "failure", "cancelled"}:
+            # StepExecution may have committed before the driver cursor did.
+            # Reuse that exact receipt, including its original usage identity.
+            return
+        if outcome == "waiting_approval" and step.status == "running":
+            stored.output = step.output = {
+                "success": False,
+                "outcome": "unknown",
+                "reconciliation_required": True,
+                "retryable": False,
+                "message": "原获批调用已提交执行意图但缺少完成回执，请核对原动作",
+            }
+            stored.status, step.status = "failed", "failed"
+            self.repository.save(run)
+            self.state.update(
+                phase="reconciliation", outcome="unknown", notice=stored.output["message"]
+            )
+            self.checkpoint()
+            return
+        if outcome != "waiting_approval" or step.status != "pending":
+            return  # Missing/unknown/pending evidence never authorizes another attempt.
+        self.assert_active_budget()
+        self.policy.validate_call(call, approved=True)
+        from app.infrastructure.llm.client import llm_client_scope
+
+        from .task_background import task_execution_context
+
+        execution_context = {
+            key: value for key, value in self.context.items() if key != "_legacy_execution_lease"
+        }
+        with llm_client_scope(self.policy.client, self.policy.model):
+            controller._execute_step(
+                run,
+                step,
+                runtime_context={**execution_context, **task_execution_context(run, step)},
+                node_outputs={
+                    item.node_id: item.output for item in run.steps if item.status == "completed"
+                },
+            )
+        self.repository.save(run)
+
+    def drive(self):
+        from app.infrastructure.llm.client import llm_client_scope
+
+        if self.state["phase"] == "terminal":
+            yield {"type": "result", "result": self.finish(self.state["outcome"])}
+            return
+        if self.state["phase"] == "model_inflight":
+            self.state["blocked_model_recovery"] = True
+            yield {
+                "type": "result",
+                "result": self._suspend(
+                    "unknown", {"message": "原模型请求中断，尚无完整决策；未重新请求模型或工具"}
+                ),
+            }
+            return
+        while True:
+            if controlled := self.apply_control():
+                yield {"type": "result", "result": controlled}
+                return
+            self.policy.check_control()
+            if self.state["phase"] in {"pending", "waiting_approval", "reconciliation"}:
+                if self.state.get("blocked_model_recovery"):
+                    yield {"type": "result", "result": self.finish("unknown")}
+                    return
+                current = (
+                    self.state["batch"][self.state["next_call_index"]]
+                    if self.state["batch"]
+                    else None
+                )
+                stored = self.receipt(current) if current else None
+                if stored is None or tool_receipt_outcome(stored.output) not in {
+                    "success",
+                    "failure",
+                    "cancelled",
+                }:
+                    yield {
+                        "type": "result",
+                        "result": self.finish(
+                            self.state.get("outcome", "unknown"),
+                            receipt=stored.output if stored else {},
+                        ),
+                    }
+                    return
+                self.state["phase"] = "tool_batch"
+            if self.state["phase"] == "tool_batch":
+                index = self.state["next_call_index"]
+                if index == len(self.state["batch"]):
+                    if terminal := self.policy.after_batch(self.state):
+                        self.state.update(
+                            phase="terminal", outcome=terminal[0], final_text=terminal[1]
+                        )
+                        self.checkpoint()
+                        yield {"type": "result", "result": self.finish(terminal[0])}
+                        return
+                    events = getattr(self.policy, "after_batch_events", lambda state: iter(()))
+                    yield from events(self.state)
+                    self.state["phase"] = "ready_model"
+                    self.checkpoint()
+                    continue
+                call = self.state["batch"][index]
+                stored = self.receipt(call)
+                if stored:
+                    output = copy.deepcopy(stored.output) or {
+                        "success": False,
+                        "outcome": "unknown",
+                    }
+                elif not self.repository:
+                    output = {
+                        "success": False,
+                        "error_code": "tool_identity_required",
+                        "outcome": "failure",
+                        "retryable": False,
+                        "message": "工具调用需要登录并关联服务端持久任务，未执行工具",
+                    }
+                else:
+                    self.assert_active_budget()
+                    repeat = self.state["limits"]["repeat"]
+                    fingerprints = self.state["fingerprints"] + [call["fingerprint"]]
+                    if (
+                        repeat >= 2
+                        and len(fingerprints) >= repeat
+                        and len(set(fingerprints[-repeat:])) == 1
+                    ):
+                        raise ModelTurnRejected(
+                            "工具重复调用超过任务预算", error_code="stuck_repeating_action"
+                        )
+                    self.policy.validate_call(call, approved=False)
+                    yield from self.policy.before_call(call)
+                    from contextlib import nullcontext
+
+                    scope = (
+                        llm_client_scope(self.policy.client, self.policy.model)
+                        if self.policy.client is not None
+                        else nullcontext()
+                    )
+                    with scope:
+                        output = self.policy.dispatch(call, self.repository)
+                    stored = self.receipt(call)
+                    if stored is None:
+                        # An admission failure with no intent is terminal, never a new call.
+                        self.state.update(phase="terminal", outcome="failure", final_text="")
+                        self.checkpoint()
+                        yield {"type": "result", "result": self.finish("failure", receipt=output)}
+                        return
+                safe_value(output, secrets=self.policy.secrets())
+                outcome = tool_receipt_outcome(output)
+                if (
+                    outcome == "success"
+                    and stored
+                    and stored.metadata.get("independent_verification", {}).get("verified")
+                    is not True
+                ):
+                    yield {
+                        "type": "result",
+                        "result": self._suspend(
+                            "unknown", {"message": "原工具回执缺少独立完成核验，不能继续后续调用"}
+                        ),
+                    }
+                    return
+                self.policy.observe(call, output)
+                if outcome in {"unknown", "pending", "waiting_approval"}:
+                    yield {"type": "result", "result": self._suspend(outcome, output)}
+                    return
+                if outcome == "cancelled" or (
+                    outcome == "failure" and output.get("retryable") is False
+                ):
+                    self.state.update(phase="terminal", outcome=outcome, final_text="")
+                    self.checkpoint()
+                    yield {"type": "result", "result": self.finish(outcome, receipt=output)}
+                    return
+                if stored:
+                    ref = {
+                        "run_id": self.run_id,
+                        "call_id": call["id"],
+                        "output_digest": canonical_hash(output),
+                        "serializer_version": 1,
+                    }
+                    self.state["messages"].append({"receipt": ref})
+                    self.state["delivered"].append(ref)
+                else:
+                    self.state["messages"].append(
+                        {"role": "tool", "tool_call_id": call["id"], "content": exact_json(output)}
+                    )
