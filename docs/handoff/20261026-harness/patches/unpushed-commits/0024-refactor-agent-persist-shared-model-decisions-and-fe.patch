+def test_delayed_enqueue_cannot_reset_a_claim_acquired_after_its_read(trusted_actor):
+    import threading
+
+    actor = trusted_actor()
+    queue = SQLAlchemyTaskExecutionRepository(session_factory=actor.factory)
+    run = _run(actor)
+    queue.enqueue(run)
+    engine = create_engine(str(actor.factory.kw["bind"].url))
+    ready, resume = threading.Event(), threading.Event()
+
+    class ObservedSession(Session):
+        def get(self, entity, ident, **kwargs):
+            record = super().get(entity, ident, **kwargs)
+            if entity is AgentTaskExecutionRecord:
+                ready.set()
+                if not resume.wait(10):
+                    raise RuntimeError("enqueue read barrier timed out")
+            return record
+
+    delayed = SQLAlchemyTaskExecutionRepository(
+        session_factory=sessionmaker(bind=engine, class_=ObservedSession),
+        auto_create=False,
+    )
+    try:
+        with ThreadPoolExecutor(max_workers=1) as executor:
+            pending = executor.submit(delayed.enqueue, run)
+            assert ready.wait(10)
+            claim = queue.claim_run(run.run_id, "winner", lease_seconds=60)
+            assert claim is not None
+            resume.set()
+            assert pending.result(timeout=10).state == "claimed"
+        after = queue.get(run.run_id)
+        assert (after.lease_owner, after.execution_count) == ("winner", 1)
+    finally:
+        resume.set()
+        engine.dispose()
+
