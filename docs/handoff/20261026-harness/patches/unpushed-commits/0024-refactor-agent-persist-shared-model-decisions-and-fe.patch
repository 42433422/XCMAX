+def test_host_profile_reference_survives_sql_reopen_and_resolves_rotated_key(
+    trusted_actor,
+    monkeypatch,
+):
+    actor = trusted_actor()
+    with OpenAI(api_key=HOST_KEY, base_url=ENDPOINT) as initial:
+        reference = capture_durable_model_reference(actor.context, initial, "original-model")
+    assert reference["kind"] == "host_env"
+    assert reference["scope"]["user_id"] == str(actor.user_id)
+    reference = _store_reference(actor, reference)
+    rotated = "synthetic-rotated-host-key-canary"
+    monkeypatch.setenv("OPENAI_API_KEY", rotated)
+    restored, model = resolve_durable_model_client(actor.context, reference)
+    try:
+        assert restored.api_key == rotated
+        assert str(restored.base_url).rstrip("/") == ENDPOINT
+        assert model == "original-model"
+        assert rotated not in json.dumps(reference)
+    finally:
+        restored.close()
+
+
+def test_market_reference_uses_current_same_account_token_and_original_model_after_sql_reopen(
+    trusted_actor,
+    monkeypatch,
+):
+    actor = trusted_actor()
+    initial = _market(actor)
+    reference = _store_reference(
+        actor, capture_durable_model_reference(actor.context, initial, MODEL)
+    )
+    _market(actor, token=ROTATED_TOKEN)
+    monkeypatch.setenv("MODSTORE_PLATFORM_URL", "https://unrelated-environment.invalid")
+    monkeypatch.setenv("LLM_PROVIDER", "unrelated-provider")
+    monkeypatch.setenv("LLM_MODEL", "unrelated-model")
+    restored, model = resolve_durable_model_client(actor.context, reference)
+    assert model == MODEL
+    assert restored.adapter.auth_token == ROTATED_TOKEN
+    assert restored.adapter.platform_url == MARKET_ENDPOINT
+    assert restored.adapter.default_provider == "original-provider"
+    assert restored.adapter.default_model == "original-model"
+    assert restored.adapter.user_id is None
+
