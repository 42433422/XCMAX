+++ b/FHD/app/application/agent_orchestrator/model_turn_runtime.py
@@ -0,0 +1,1036 @@
+"""One durable model decision/batch cursor for chat and Employee agent mode.
+
+Transport and product policies are adapters. Only this driver owns model rounds,
+ordered dispatch, receipt delivery and suspension. ToolCall.output remains the
+receipt authority; future batch entries never create placeholder ToolCalls.
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+import math
+import re
+import time
+import uuid
+from collections.abc import Iterator
+from typing import Any
+
+from .business_action_ledger import canonical_hash
+from .tool_receipt import tool_receipt_outcome
+
+STATE_KEY = "_model_turn_state"
+_PHASES = {
+    "ready_model",
+    "model_inflight",
+    "tool_batch",
+    "waiting_approval",
+    "pending",
+    "reconciliation",
+    "terminal",
+}
+_FORBIDDEN_KEYS = {
+    "api_key",
+    "approval_grant",
+    "grant",
+    "session_token",
+    "bearer_token",
+    "market_access_token",
+    "market_refresh_token",
+    "access_token",
+    "refresh_token",
+    "auth_token",
+    "authorization",
+    "proxy-authorization",
+    "x-api-key",
+    "x-auth-token",
+    "set-cookie",
+    "cookie",
+    "cookies",
+    "db_read_token",
+    "db_write_token",
+    "password",
+    "_actor_authorization",
+    "_mod_authorization",
+    "_tool_approval_grants",
+    "_legacy_execution_lease",
+    "runtime_context",
+}
+_SECRET = re.compile(
+    r'(?i)(?:bearer\s+\S+|(?:[?&])(?:token|signature|sig|x-amz-credential|x-amz-signature)=|["\']?(?:api_key|password|access_token|refresh_token|auth_token|db_write_token|db_read_token|approval_grant|session_token|market_access_token|market_refresh_token)["\']?\s*[:=]\s*["\'][^"\']+)'
+)
+
+
+class ModelTurnError(ValueError):
+    def __init__(self, message, *, error_code="model_turn_contract_invalid"):
+        super().__init__(message)
+        self.error_code = error_code
+
+
+class ModelTurnRejected(ModelTurnError):
+    """A proven admission failure, before dispatch of the current action."""
+
+    def __init__(self, message, *, error_code="tool_blocked"):
+        super().__init__(message)
+        self.error_code = error_code
+
+
+def exact_json(value: Any) -> str:
+    return json.dumps(
+        value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False
+    )
+
+
+def safe_value(value: Any, *, secrets: tuple[str, ...] = (), depth: int = 0) -> Any:
+    """Reject an unsafe/oversized exact contract; never truncate recovery data."""
+    if depth > 40:
+        raise ModelTurnError("模型持久内容嵌套过深，未执行后续调用")
+    if value is None or type(value) in {bool, int}:
+        return value
+    if type(value) is float and math.isfinite(value):
+        return value
+    if isinstance(value, str):
+        if _SECRET.search(value) or any(secret and secret in value for secret in secrets):
+            raise ModelTurnError("模型持久内容含凭据，需使用安全引用，未执行后续调用")
+        return value
+    if isinstance(value, list):
+        return [safe_value(item, secrets=secrets, depth=depth + 1) for item in value]
+    if isinstance(value, dict) and all(isinstance(key, str) for key in value):
+        if any(key.lower() in _FORBIDDEN_KEYS for key in value):
+            raise ModelTurnError("模型持久内容含授权或凭据字段，未执行后续调用")
+        return {
+            key: safe_value(item, secrets=secrets, depth=depth + 1) for key, item in value.items()
+        }
+    raise ModelTurnError("模型持久内容必须是明确的 JSON 数据")
+
+
+def decode_state(value: Any, *, durable: bool = True) -> dict[str, Any]:
+    if (
+        not isinstance(value, dict)
+        or type(value.get("version")) is not int
+        or value["version"] != 1
+    ):
+        raise ModelTurnError("不支持此持久模型状态版本，不能重建或重试原决策")
+    state = safe_value(value)
+    required = {
+        "version",
+        "kernel",
+        "phase",
+        "revision",
+        "round",
+        "messages",
+        "request_view",
+        "batch",
+        "next_call_index",
+        "delivered",
+        "limits",
+        "active_seconds",
+        "fingerprints",
+        "model_reference",
+        "policy",
+    }
+    optional = {
+        "outcome",
+        "notice",
+        "final_text",
+        "request_id",
+        "blocked_model_recovery",
+        "exit_status",
+    }
+    if not required.issubset(state) or set(state) - required - optional:
+        raise ModelTurnError("持久模型状态字段不完整或不受支持")
+    if len(exact_json(state).encode()) > 8 * 1024 * 1024:
+        raise ModelTurnError("模型持久内容超过安全容量，未执行后续调用")
+    if state["phase"] not in _PHASES or state["kernel"] not in {"legacy", "employee_agent"}:
+        raise ModelTurnError("持久模型状态无效")
+    for field in ("revision", "round", "next_call_index"):
+        if type(state[field]) is not int or state[field] < 0:
+            raise ModelTurnError("持久模型游标无效")
+    limits = state["limits"]
+    if not isinstance(limits, dict) or set(limits) != {"rounds", "calls", "repeat", "seconds"}:
+        raise ModelTurnError("持久模型预算无效")
+    for key, minimum, maximum in (("rounds", 0, 128), ("calls", 1, 256), ("repeat", 0, 256)):
+        if type(limits[key]) is not int or not minimum <= limits[key] <= maximum:
+            raise ModelTurnError("持久模型预算无效")
+    for number in (state["active_seconds"], limits["seconds"]):
+        if type(number) not in {float, int} or not math.isfinite(number) or number < 0:
+            raise ModelTurnError("持久模型有效执行时间无效")
+    if not 0 < limits["seconds"] <= 86400:
+        raise ModelTurnError("持久模型有效执行时间预算无效")
+    if not isinstance(state["policy"], dict) or (
+        durable and not isinstance(state["model_reference"], dict)
+    ):
+        raise ModelTurnError("持久模型策略或模型引用缺失")
+    if not isinstance(state["fingerprints"], list) or any(
+        not isinstance(item, str) for item in state["fingerprints"]
+    ):
+        raise ModelTurnError("持久模型动作计数无效")
+    if (
+        not isinstance(state["messages"], list)
+        or not isinstance(state["batch"], list)
+        or state["next_call_index"] > len(state["batch"])
+    ):
+        raise ModelTurnError("持久模型批次无效")
+    seen = set()
+    for call in state["batch"]:
+        if (
+            not isinstance(call, dict)
+            or set(call) != {"id", "name", "arguments", "params", "fingerprint"}
+            or any(
+                not isinstance(call[key], str) for key in ("id", "name", "arguments", "fingerprint")
+            )
+            or not isinstance(call["params"], dict)
+        ):
+            raise ModelTurnError("持久模型调用结构无效")
+        if (
+            not call["id"].strip()
+            or len(call["id"]) > 256
+            or not call["name"].strip()
+            or len(call["name"]) > 256
+            or call["id"] in seen
+            or call["fingerprint"] != canonical_hash([call["name"], call["params"]])
+        ):
+            raise ModelTurnError("持久模型调用身份或参数摘要无效")
+        seen.add(call["id"])
+    if "outcome" in state and state["outcome"] not in {
+        "success",
+        "failure",
+        "cancelled",
+        "unknown",
+        "pending",
+        "waiting_approval",
+    }:
+        raise ModelTurnError("持久模型结果状态无效")
+    if state["phase"] == "terminal" and (
+        state.get("outcome") not in {"success", "failure", "cancelled"}
+        or not isinstance(state.get("final_text"), str)
+    ):
+        raise ModelTurnError("持久模型终态缺少明确结果")
+    references = []
+    declared_ids = set()
+    for message in state["messages"]:
+        if not isinstance(message, dict):
+            raise ModelTurnError("持久模型消息无效")
+        if "receipt" in message:
+            ref = message["receipt"]
+            if (
+                set(message) != {"receipt"}
+                or not isinstance(ref, dict)
+                or set(ref) != {"run_id", "call_id", "output_digest", "serializer_version"}
+                or type(ref["serializer_version"]) is not int
+                or ref["serializer_version"] != 1
+                or any(
+                    not isinstance(ref[key], str) or not ref[key]
+                    for key in ("run_id", "call_id", "output_digest")
+                )
+            ):
+                raise ModelTurnError("持久模型回执引用无效")
+            references.append(ref)
+        elif (
+            message.get("role") not in {"system", "developer", "user", "assistant", "tool"}
+            or "content" not in message
+        ):
+            raise ModelTurnError("持久模型消息角色或正文无效")
+        if durable and message.get("role") == "tool":
+            raise ModelTurnError("持久模型工具消息必须引用原调用回执")
+        if message.get("role") == "assistant":
+            calls = message.get("tool_calls")
+            if calls is not None and not isinstance(calls, list):
+                raise ModelTurnError("持久模型助手调用无效")
+            for call in calls or []:
+                if (
+                    not isinstance(call, dict)
+                    or not isinstance(call.get("function"), dict)
+                    or not isinstance(call.get("id"), str)
+                    or not call["id"].strip()
+                    or call["id"] in declared_ids
+                    or not all(
+                        isinstance(call["function"].get(key), str) for key in ("name", "arguments")
+                    )
+                ):
+                    raise ModelTurnError("持久模型助手调用身份无效")
+                declared_ids.add(call["id"])
+    if state["delivered"] != references or len({ref["call_id"] for ref in references}) != len(
+        references
+    ):
+        raise ModelTurnError("持久模型回执交付游标无效")
+    view = state["request_view"]
+    if view is not None:
+        if (
+            not isinstance(view, dict)
+            or set(view) != {"messages", "tools_json", "tool_choice"}
+            or not isinstance(view["messages"], list)
+            or not isinstance(view["tools_json"], str)
+        ):
+            raise ModelTurnError("持久模型请求视图无效")
+        try:
+            tools = json.loads(view["tools_json"])
+        except ValueError as exc:
+            raise ModelTurnError("持久模型工具视图无效") from exc
+        if tools is not None and not isinstance(tools, list):
+            raise ModelTurnError("持久模型工具视图无效")
+    return state
+
+
+def policy_secrets(context, client, *extra):
+    binding = context.get("_actor_authorization") or {}
+    values = [
+        getattr(client, "api_key", None),
+        getattr(getattr(client, "adapter", None), "auth_token", None),
+        binding.get("proof"),
+        context.get("db_read_token"),
+        context.get("db_write_token"),
+        *extra,
+    ]
+    if type(binding.get("session_row_id")) is int:
+        from app.db import HostSessionLocal
+        from app.db.models.user import Session as UserSession
+
+        with HostSessionLocal() as db:
+            row = db.get(UserSession, binding["session_row_id"])
+            if row is not None:
+                values.extend([row.session_id, row.market_access_token, row.market_refresh_token])
+    return tuple(value for value in values if isinstance(value, str) and value)
+
+
+def normalize_decision(message: Any) -> dict[str, Any]:
+    return {
+        "content": str(getattr(message, "content", "") or ""),
+        "calls": [
+            {
+                "id": str(getattr(call, "id", "") or ""),
+                "name": str(getattr(getattr(call, "function", None), "name", "") or ""),
+                "arguments": str(getattr(getattr(call, "function", None), "arguments", "") or ""),
+            }
+            for call in (getattr(message, "tool_calls", None) or [])
+        ],
+    }
+
+
+def model_transport(
+    client: Any, model: str, request: dict, *, stream: bool = False, check=lambda: None
+) -> Iterator[dict]:
+    """SDK transport only; provider indices determine order, never chunk arrival."""
+    check()
+    completion = client.chat.completions.create(
+        model=model, **request, **({"stream": True} if stream else {})
+    )
+    if not stream:
+        check()
+        yield {"type": "usage", "completion": completion}
+        choice = completion.choices[0]
+        if getattr(choice, "finish_reason", None) not in {"stop", "tool_calls"}:
+            raise ModelTurnError("模型未确认完整结束，已停止工具派发")
+        yield {"type": "decision", "decision": normalize_decision(choice.message)}
+        return
+    calls, text, finish_reason = {}, [], None
+    for chunk in completion:
+        check()
+        if not chunk.choices:
+            continue
+        choice = chunk.choices[0]
+        if reason := getattr(choice, "finish_reason", None):
+            finish_reason = str(reason)
+        delta = getattr(choice, "delta", None)
+        if delta is None:
+            continue
+        if content := getattr(delta, "content", None):
+            text.append(str(content))
+            yield {"type": "text", "text": str(content), "assistant_delta": True}
+        for position, call in enumerate(getattr(delta, "tool_calls", None) or []):
+            index = getattr(call, "index", None)
+            index = position if index is None else int(index)
+            row = calls.setdefault(index, {"id": "", "name": "", "arguments": ""})
+            if identity := getattr(call, "id", None):
+                if row["id"] and row["id"] != identity:
+                    raise ModelTurnError("流式模型改变了原调用 ID")
+                row["id"] = str(identity)
+            function = getattr(call, "function", None)
+            if name := getattr(function, "name", None):
+                fragment = str(name)
+                if fragment.startswith(row["name"]):
+                    row["name"] = fragment
+                elif fragment != row["name"]:
+                    row["name"] += fragment
+            row["arguments"] += str(getattr(function, "arguments", "") or "")
+    if finish_reason not in {"stop", "tool_calls"}:
+        raise ModelTurnError("流式模型未确认完整结束，已停止工具派发")
+    yield {
+        "type": "decision",
+        "decision": {"content": "".join(text), "calls": [calls[index] for index in sorted(calls)]},
+    }
+
+
+class ModelTurnDriver:
+    def __init__(
+        self, policy, *, repository=None, run_id="", context=None, state=None, persist_state=True
+    ):
+        self.policy, self.repository, self.run_id = policy, repository, run_id
+        self.persist_state = persist_state
+        self.context = dict(context or {})
+        self.state = (
+            decode_state(state, durable=bool(repository and persist_state))
+            if state is not None
+            else None
+        )
+        self._active_started = time.monotonic()
+        self._active_previous = 0.0
+
+    def _run(self):
+        run = self.repository.get(self.run_id) if self.repository else None
+        if self.repository and run is None:
+            raise ModelTurnError("原模型任务不存在，不能创建替代任务")
+        return run
+
+    def checkpoint(self):
+        self.state["revision"] += 1
+        self.state["active_seconds"] = (
+            self._active_previous + time.monotonic() - self._active_started
+        )
+        self.state = decode_state(self.state, durable=bool(self.repository and self.persist_state))
+        if self.persist_state and (run := self._run()):
+            run.metadata[STATE_KEY] = copy.deepcopy(self.state)
+            phase = self.state["phase"]
+            run.status = (
+                "waiting_user"
+                if phase == "waiting_approval"
+                else "blocked"
+                if phase in {"pending", "reconciliation"}
+                else "running"
+            )
+            if phase == "terminal":
+                run.status = (
+                    "completed"
+                    if self.state["outcome"] == "success"
+                    else "cancelled"
+                    if self.state["outcome"] == "cancelled"
+                    else "failed"
+                )
+            self.repository.save(run)
+
+    def initialize(self, messages, *, limits):
+        if self.state is None:
+            reference = None
+            if self.repository:
+                from app.infrastructure.llm.client import capture_durable_model_reference
+
+                reference = capture_durable_model_reference(
+                    self.context, self.policy.client, self.policy.model
+                )
+            self.state = {
+                "version": 1,
+                "kernel": self.policy.kernel,
+                "phase": "ready_model",
+                "revision": 0,
+                "round": 0,
+                "messages": safe_value(messages, secrets=self.policy.secrets()),
+                "request_view": None,
+                "batch": [],
+                "next_call_index": 0,
+                "delivered": [],
+                "limits": limits,
+                "active_seconds": 0.0,
+                "fingerprints": [],
+                "model_reference": reference,
+                "policy": safe_value(self.policy.snapshot(), secrets=self.policy.secrets()),
+            }
+            self.checkpoint()
+        self._active_previous = float(self.state["active_seconds"])
+        if self.repository:
+            from app.infrastructure.llm.client import capture_durable_model_reference
+
+            if (
+                capture_durable_model_reference(self.context, self.policy.client, self.policy.model)
+                != self.state["model_reference"]
+            ):
+                raise ModelTurnError("原模型任务的账号、模型或配置引用已变化")
+        self.policy.validate_saved(self.state)
+        # Recovery may execute an approved cursor before asking the model again.
+        # Validate every previously delivered receipt before that side effect.
+        self.messages()
+        if run := self._run():
+            for call in run.tool_calls:
+                safe_value(call.to_dict(), secrets=self.policy.secrets())
+                self.policy.observe(
+                    {
+                        "id": call.call_id,
+                        "name": call.metadata.get("model_tool_name", call.tool_id),
+                        "params": copy.deepcopy(call.metadata.get("model_params", call.params)),
+                    },
+                    copy.deepcopy(call.output),
+                )
+
+    def receipt(self, call):
+        run = self._run()
+        found = (
+            next((row for row in run.tool_calls if row.call_id == call["id"]), None)
+            if run
+            else None
+        )
+        if found and canonical_hash(
+            [found.metadata.get("model_tool_name"), found.metadata.get("model_params")]
+        ) != canonical_hash([call["name"], call["params"]]):
+            raise ModelTurnError("工具调用 ID 已绑定不同动作，原回执与模型批次不匹配")
+        return found
+
+    def messages(self):
+        result = []
+        for message in self.state["messages"]:
+            if "receipt" not in message:
+                result.append(copy.deepcopy(message))
+                continue
+            ref = message["receipt"]
+            run = self._run()
+            call = (
+                next((item for item in run.tool_calls if item.call_id == ref["call_id"]), None)
+                if run
+                else None
+            )
+            if (
+                call is None
+                or not call.output
+                or canonical_hash(call.output) != ref["output_digest"]
+                or ref["run_id"] != self.run_id
+                or ref["serializer_version"] != 1
+            ):
+                raise ModelTurnError("原工具回执缺失或已改变，不能继续模型")
+            output = safe_value(call.output, secrets=self.policy.secrets())
+            result.append(
+                {"role": "tool", "tool_call_id": call.call_id, "content": exact_json(output)}
+            )
+        return result
+
+    def _accept_decision(self, decision):
+        from app.application.tools.workflow_tools.dispatch import parse_arguments
+
+        safe_value(decision, secrets=self.policy.secrets())
+        seen = {
+            call["id"]
+            for message in self.state["messages"]
+            for call in (message.get("tool_calls") or [])
+        }
+        batch = []
+        for call in decision["calls"]:
+            identity, name = call["id"], call["name"]
+            if not identity.strip() or not name.strip() or identity in seen:
+                raise ModelTurnRejected("模型工具调用 ID 为空或重复，整批未执行")
+            seen.add(identity)
+            try:
+                params = self.policy.prepare_arguments(name, parse_arguments(call["arguments"]))
+            except ValueError as exc:
