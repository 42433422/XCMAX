diff --git a/FHD/tests/fixtures/compat_stream.py b/FHD/tests/fixtures/compat_stream.py
new file mode 100644
index 0000000000..6dff6924db
--- /dev/null
+++ b/FHD/tests/fixtures/compat_stream.py
@@ -0,0 +1,43 @@
+"""Patch the SSE transport seam without changing request identity fixtures."""
+
+from contextlib import ExitStack, contextmanager
+from types import SimpleNamespace
+from unittest.mock import DEFAULT, patch
+
+
+@contextmanager
+def planner_stream_transport(
+    api,
+    *,
+    tier,
+    events=DEFAULT,
+    event_error=DEFAULT,
+    authorize=DEFAULT,
+    client=DEFAULT,
+    mode=False,
+    patches=None,
+):
+    configs = {
+        "planner_workflow_interrupt_reply": {"return_value": None},
+        "_ensure_vector_index_if_needed": {"return_value": None},
+        "create_modstore_openai_client_from_request": {},
+        "runtime_context_with_tier": {"side_effect": tier},
+    }
+    if authorize is not DEFAULT:
+        configs["_ensure_chat_db_read_authorized"] = {"return_value": authorize}
+    if events is not DEFAULT:
+        configs["_xcagi_guarded_planner_stream_events"] = {"return_value": events}
+    if event_error is not DEFAULT:
+        configs["_xcagi_guarded_planner_stream_events"] = {"side_effect": event_error}
+    if client is not DEFAULT:
+        configs["create_modstore_openai_client_from_request"] = {"return_value": client}
+    if mode:
+        configs["set_llm_mode"] = {}
+    configs.update(patches or {})
+    with ExitStack() as stack:
+        yield SimpleNamespace(
+            **{
+                name: stack.enter_context(patch.object(api, name, **kwargs))
+                for name, kwargs in configs.items()
+            }
+        )
