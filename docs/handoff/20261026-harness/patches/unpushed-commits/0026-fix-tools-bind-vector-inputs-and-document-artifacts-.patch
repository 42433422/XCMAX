+    )
+    _, copied = vector._snapshot_file(params["execution_snapshot"]["body"])
+    replacement = case.workbook(text="REOPENED_REPLACEMENT").read_bytes()
+    read = office_parse_app_service._read_pinned_output
+    calls = []
+
+    def replace_after_pinned_read(base, path, **kwargs):
+        blob = read(base, path, **kwargs)
+        calls.append(path)
+        copied.chmod(0o600)
+        copied.write_bytes(replacement)
+        return blob
+
+    monkeypatch.setattr(office_parse_app_service, "_read_pinned_output", replace_after_pinned_read)
+    output = vector.get_excel_vector_ingest_app_service(context).ingest_excel(**params)
+    assert output["success"] is True
+    assert calls == [copied]
+    hits = vector.get_excel_vector_search_app_service(case.owner.context).query(
+        "same-bytes", "bytes"
