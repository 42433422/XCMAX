@@ -0,0 +1,419 @@
+"""Real reviewed XLSX bytes survive path changes, recovery and entrypoint differences."""
+
+import hashlib
+import json
+import os
+import subprocess
+import sys
+from copy import deepcopy
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from app.application import excel_vector_app_service as vector
+from app.application.agent_orchestrator import AgentOrchestrator
+from app.application.agent_orchestrator.tool_executor import (
+    AgentToolExecutor,
+    execute_registered_tool,
+)
+from app.application.tools.workflow import execute_workflow_tool
+from app.application.workflow.workflow_types import PlanGraph, WorkflowNode
+from tests.fixtures.excel_vector import excel_vector_case as excel_vector_case
+from tests.fixtures.excel_vector import reviewed_agent_http as reviewed_agent_http
+from tests.fixtures.excel_vector import trusted_actor as trusted_actor
+
+
+def _plan(params):
+    return PlanGraph(
+        plan_id="vector-snapshot",
+        intent="vector-snapshot",
+        nodes=[
+            WorkflowNode(
+                node_id="vector-node", tool_id="excel_vector_index", action="execute", params=params
+            )
+        ],
+    )
+
+
+def _admit(case, entry):
+    params = {
+        "file_path": str(case.workbook(text="ORIGINAL_REVIEWED_BYTES")),
+        "index_id": "reviewed-index",
+    }
+    if entry == "http":
+        pending = case.http.client.post("/api/excel/vector/ingest", json=params)
+        assert pending.status_code == 202, pending.text
+        run_id = pending.json()["run_id"]
+    elif entry == "model":
+        pending = json.loads(
+            execute_workflow_tool("excel_vector_index", params, runtime_context=case.owner.context)
+        )
+        assert pending["outcome"] == "waiting_approval", pending
+        run_id = pending["run_id"]
+    elif entry == "registered":
+        pending = execute_registered_tool(
+            "excel_vector_index", "execute", {**params, "_runtime_context": case.owner.context}
+        )
+        assert pending["outcome"] == "waiting_approval", pending
+        run_id = pending["run_id"]
+    elif entry == "trace":
+        from app.application.agent_orchestrator import chat_trace
+        from app.application.agent_orchestrator.trace_runs import legacy_execution_context
+        from app.legacy.chat.legacy_chat_adapter import append_tool_messages
+
+        run = chat_trace.start_legacy_chat_run(
+            message="索引当前文件",
+            runtime_context={
+                **case.owner.context,
+                "conversation_id": "vector-snapshot",
+                "turn_id": "turn-1",
+            },
+        )
+        context = legacy_execution_context(run)
+        call = SimpleNamespace(
+            id="vector-call",
+            function=SimpleNamespace(name="excel_vector_index", arguments=json.dumps(params)),
+        )
+        append_tool_messages(
+            [],
+            [call],
+            workspace_root=None,
+            runtime_context=context,
+            execute_tool=execute_workflow_tool,
+        )
+        run_id = run.run_id
+    else:
+        runtime = AgentOrchestrator()
+        run = (
+            runtime.start_task_from_plan if entry == "unified-task" else runtime.start_run_from_plan
+        )(
+            user_id=str(case.owner.user_id),
+            message="索引当前文件",
+            plan=_plan(params),
+            runtime_context=case.owner.context,
+        )
+        assert run.status == "waiting_user", run.to_dict()
+        run_id = run.run_id
+    run = case.http.repository.get(run_id)
+    assert run.status == "waiting_user"
+    snapshot = run.steps[0].params["execution_snapshot"]
+    assert (
+        snapshot["body"]["content_sha256"]
+        == hashlib.sha256(Path(params["file_path"]).read_bytes()).hexdigest()
+    )
+    assert snapshot["body"]["task_id"] == (
+        (run.metadata.get("task_context") or {}).get("task_id")
+        or run.metadata["runtime_context"].get("task_id")
+        or run.run_id
+    )
+    assert snapshot["body"]["node_id"] == run.steps[0].node_id
+    assert vector.get_sqlite_vector_store().list_indexes() == []
+    return run
+
+
+@pytest.mark.parametrize("entry", ["http", "model", "registered", "trace", "dag", "unified-task"])
+@pytest.mark.parametrize("mutation", ["replace", "remove"])
+def test_all_entrypoints_execute_the_original_approved_bytes(excel_vector_case, entry, mutation):
+    case = excel_vector_case
+    waiting = _admit(case, entry)
+    snapshot = deepcopy(waiting.steps[0].params["execution_snapshot"])
+
+    def mutate():
+        if mutation == "replace":
+            case.workbook(text="REPLACED_AFTER_APPROVAL")
+        else:
+            Path(waiting.steps[0].params["file_path"]).unlink()
+
+    run = case.approve(waiting.run_id, before_dispatch=mutate)
+    assert run.status == "completed", run.to_dict()
+    assert run.steps[0].params["execution_snapshot"] == snapshot
+    assert run.steps[0].output["business_verification"]["verified"] is True
+    hits = vector.get_excel_vector_search_app_service(case.owner.context).query(
+        "reviewed-index", "bytes"
+    )["hits"]
+    assert "ORIGINAL_REVIEWED_BYTES" in json.dumps(hits)
+    assert "REPLACED_AFTER_APPROVAL" not in json.dumps(hits)
+
+
+@pytest.mark.parametrize("mutation", ["missing", "corrupt", "hardlink", "symlink"])
+def test_approved_snapshot_never_rebuilds_from_the_mutable_original(excel_vector_case, mutation):
+    case = excel_vector_case
+    waiting = _admit(case, "http")
+    snapshot = waiting.steps[0].params["execution_snapshot"]
+    _, copied = vector._snapshot_file(snapshot["body"])
+
+    def mutate():
+        case.workbook(text="REPLACEMENT_MUST_NOT_BE_COPIED")
+        if mutation == "missing":
+            copied.unlink()
+        elif mutation == "corrupt":
+            copied.chmod(0o600)
+            copied.write_bytes(b"corrupted-copy")
+        elif mutation == "hardlink":
+            os.link(copied, copied.with_suffix(".linked"))
+        else:
+            copied.unlink()
+            copied.symlink_to(waiting.steps[0].params["file_path"])
+
+    run = case.approve(waiting.run_id, before_dispatch=mutate)
+    assert run.status != "completed"
+    assert run.steps[0].output["success"] is False
+    assert run.steps[0].params["execution_snapshot"] == snapshot
+    assert vector.get_sqlite_vector_store().list_indexes() == []
+
+
+@pytest.mark.parametrize("change", ["task", "node", "actor", "tenant", "mod", "params", "proof"])
+def test_sealed_snapshot_cannot_move_to_another_task_call_or_owner(excel_vector_case, change):
+    case = excel_vector_case
+    waiting = _admit(case, "http")
+    params = deepcopy(waiting.steps[0].params)
+    context = {
+        **waiting.metadata["runtime_context"],
+        "task_id": params["execution_snapshot"]["body"]["task_id"],
+        "node_id": waiting.steps[0].node_id,
+    }
+    if change in {"task", "node"}:
+        context[change + "_id"] = "different"
+    elif change in {"actor", "tenant", "mod"}:
+        context.update(case.others[{"actor": 0, "tenant": 1, "mod": 2}[change]].context)
+    elif change == "params":
+        params["index_id"] = "different"
+    else:
+        params["execution_snapshot"]["proof"] = "0" * 64
+    with pytest.raises(ValueError):
+        vector.prepare_excel_vector_input(params, context)
+    assert vector.get_sqlite_vector_store().list_indexes() == []
+
+
+@pytest.mark.parametrize("ledger_state", ["completed", "unknown"])
+def test_completed_receipt_precedes_snapshot_file_read_on_replay(excel_vector_case, ledger_state):
+    case = excel_vector_case
+    waiting = _admit(case, "http")
+    run = case.approve(waiting.run_id)
+    assert run.status == "completed"
+    _, copied = vector._snapshot_file(run.steps[0].params["execution_snapshot"]["body"])
+    copied.unlink()
+    Path(run.steps[0].params["file_path"]).unlink()
+    step = run.steps[0]
+    if ledger_state == "unknown":
+        from app.db.models.agent import AgentBusinessActionRecord
+
+        # Preserve an unresolved durable claim after a side effect; receipt existence is not completion.
+        with case.owner.factory.begin() as db:
