     return blob
 
 
+def _snapshot_proof(body: dict) -> str:
+    from app.application.agent_orchestrator.approval_grant import _secret
+    from app.application.agent_orchestrator.business_action_ledger import canonical_hash
+
+    return hmac.new(
+        _secret().encode(),
+        ("excel.vector.input.v1:" + canonical_hash(body)).encode(),
+        hashlib.sha256,
+    ).hexdigest()
+
+
+def _snapshot_file(body: dict) -> tuple[Path, Path]:
+    from app.application.agent_orchestrator.business_action_ledger import canonical_hash
+
+    base = Path(get_app_data_dir()) / "vectors" / "input-snapshots"
+    path = (
+        base
+        / canonical_hash(body["scope"])
+        / canonical_hash(body["task_id"])
+        / canonical_hash(body["node_id"])
+        / (body["snapshot_id"] + ".bin")
+    )
+    return base, path
+
+
+def validate_excel_vector_snapshot(params: dict, context: dict) -> dict:
+    """Validate sealed metadata without rereading input or shadowing a durable receipt."""
+    from app.application.agent_orchestrator.business_action_ledger import canonical_hash
+    from app.infrastructure.auth.agent_mod_scope import _bound_actor
+
+    _bound_actor(context)
+    snapshot = params.get("execution_snapshot")
+    if not isinstance(snapshot, dict) or not isinstance(snapshot.get("body"), dict):
+        raise ValueError("Excel vector input needs a new reviewed snapshot")
+    body = snapshot["body"]
+    actor = context["_actor_authorization"]
+    raw = {key: value for key, value in params.items() if key != "execution_snapshot"}
+    if (
+        not hmac.compare_digest(_snapshot_proof(body), str(snapshot.get("proof") or ""))
+        or body.get("version") != 1
+        or body.get("scope") != [actor["execution_tenant_id"], actor["user_id"], actor["mod_id"]]
+        or not context.get("task_id")
+        or body.get("task_id") != context["task_id"]
+        or not context.get("node_id")
+        or body.get("node_id") != context["node_id"]
+        or body.get("params_sha256") != canonical_hash(raw)
+        or body.get("params") != raw
+        or body.get("source_path") != params.get("file_path")
+        or not re.fullmatch(r"[0-9a-f]{32}", str(body.get("snapshot_id") or ""))
+        or not re.fullmatch(r"[0-9a-f]{64}", str(body.get("content_sha256") or ""))
+        or type(body.get("size_bytes")) is not int
+        or not 0 < body["size_bytes"] <= MAX_EXCEL_VECTOR_BYTES
+    ):
+        raise ValueError("Excel vector snapshot does not match the original task and input")
+    return body
+
+
+def read_excel_vector_snapshot(params: dict, context: dict) -> bytes:
+    from app.application.office_parse_app_service import _read_pinned_output
+
+    body = validate_excel_vector_snapshot(params, context)
+    base, path = _snapshot_file(body)
+    blob = _read_pinned_output(base, path, max_bytes=MAX_EXCEL_VECTOR_BYTES + 1)
+    if (
+        len(blob) != body["size_bytes"]
+        or hashlib.sha256(blob).hexdigest() != body["content_sha256"]
+    ):
+        raise ValueError("Excel vector reviewed input is missing or changed")
+    return blob
+
+
+def prepare_excel_vector_input(params: dict, context: dict) -> dict:
+    """Freeze owner input once; resumed calls can only reuse their original sealed input."""
+    from app.application.agent_orchestrator.business_action_ledger import canonical_hash
+    from app.application.agent_orchestrator.business_harness import ensure_business_harness_context
+    from app.infrastructure.auth.agent_mod_scope import (
+        AgentModAuthorizationError,
+        authorize_agent_tool,
+    )
+
+    if authorize_agent_tool("excel_vector_index", "execute", {}, context):
+        raise AgentModAuthorizationError("Excel vector authorization unavailable")
+    raw = dict(params)
+    if set(raw) - {"file_path", "index_name", "index_id", "execution_snapshot"}:
+        raise ValueError("Excel vector input has unsupported parameters")
+    if any(not isinstance(value, str) for key, value in raw.items() if key != "execution_snapshot"):
+        raise ValueError("Excel vector input parameters must be strings")
+    if "execution_snapshot" not in raw:
+        raw = {key: str(value).strip() for key, value in raw.items()}
+    run_id, step_id = context.get("run_id"), context.get("step_id")
+    if run_id and step_id:
+        from app.application.agent_orchestrator.run_repository import get_agent_run_repository
+        from app.application.agent_orchestrator.unified_task import _assert_reused_run_scope
+
+        run = get_agent_run_repository().get(str(run_id))
+        if run is None:
+            raise ValueError("Excel vector original task is unavailable")
+        _assert_reused_run_scope(
+            run,
+            user_id=str(context["user_id"]),
+            tenant_id=str(context.get("tenant_id") or ""),
+            runtime_context=context,
+        )
+        stored = next((step for step in run.steps if step.step_id == str(step_id)), None)
+        if stored is None or (stored.tool_id, stored.action) != ("excel_vector_index", "execute"):
+            raise ValueError("Excel vector original call does not match")
+        context["task_id"] = str(
+            (run.metadata.get("task_context") or {}).get("task_id")
+            or (run.metadata.get("runtime_context") or {}).get("task_id")
+            or run.run_id
+        )
+        context["node_id"] = stored.node_id
+        saved = dict(stored.params)
+        if "execution_snapshot" not in saved:
+            raise ValueError("Excel vector input needs a new reviewed snapshot")
+        if canonical_hash(
+            {k: v for k, v in saved.items() if k != "execution_snapshot"}
+        ) != canonical_hash({k: v for k, v in raw.items() if k != "execution_snapshot"}):
+            raise ValueError("Excel vector parameters are bound to the original call")
+        if "execution_snapshot" in raw and canonical_hash(raw) != canonical_hash(saved):
+            raise ValueError("Excel vector snapshot cannot replace the original call")
+        raw = saved
+    if "execution_snapshot" in raw:
+        validate_excel_vector_snapshot(raw, context)
+        return raw
+    context.update(ensure_business_harness_context(context))
+    context.setdefault("node_id", str(context.get("call_id") or "excel_vector_execute"))
+    file_path = str(raw.get("file_path") or "")
+    blob = read_owned_excel_bytes(file_path, context)
+    actor = context["_actor_authorization"]
+    body = {
+        "version": 1,
+        "scope": [actor["execution_tenant_id"], actor["user_id"], actor["mod_id"]],
+        "task_id": context["task_id"],
+        "node_id": context["node_id"],
+        "params_sha256": canonical_hash(raw),
+        "params": raw,
+        "source_path": file_path,
+        "content_sha256": hashlib.sha256(blob).hexdigest(),
+        "size_bytes": len(blob),
+        "snapshot_id": uuid.uuid4().hex,
+    }
+    from app.application.shipment_excel_etl_security import _open_directory_under_root
+
+    base, path = _snapshot_file(body)
+    parent = _open_directory_under_root(base, path.parent, create=True)
+    try:
+        descriptor = os.open(
+            path.name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=parent
+        )
+        with os.fdopen(descriptor, "wb") as stream:
+            stream.write(blob)
+            stream.flush()
+            os.fsync(stream.fileno())
+            os.fchmod(stream.fileno(), 0o400)
+        os.fsync(parent)
+    finally:
+        os.close(parent)
+    return {**raw, "execution_snapshot": {"body": body, "proof": _snapshot_proof(body)}}
+
+
+def prepare_excel_vector_step(run, step, *, allow_new: bool, initial_plan: bool = False) -> None:
+    """Prepare a resolved host plan node before its first approval checkpoint."""
+    if (step.tool_id, step.action) != ("excel_vector_index", "execute"):
+        return
+    context = {
+        **(run.metadata.get("runtime_context") or {}),
+        "task_id": str(
+            (run.metadata.get("task_context") or {}).get("task_id")
+            or (run.metadata.get("runtime_context") or {}).get("task_id")
+            or run.run_id
+        ),
+        "node_id": step.node_id,
+    }
+    if "execution_snapshot" in step.params:
+        validate_excel_vector_snapshot(step.params, context)
+        return
+    parent_id = context.get("parent_run_id")
+    if parent_id:
+        from app.application.agent_orchestrator.run_repository import get_agent_run_repository
+        from app.application.agent_orchestrator.unified_task import _assert_reused_run_scope
+
+        parent = get_agent_run_repository().get(str(parent_id))
+        if parent is None:
+            raise ValueError("Excel vector original task is unavailable")
+        _assert_reused_run_scope(
+            parent,
+            user_id=str(context["user_id"]),
+            tenant_id=str(context.get("tenant_id") or ""),
+            runtime_context=context,
+        )
+        parent_task = str(
+            (parent.metadata.get("task_context") or {}).get("task_id") or parent.run_id
+        )
+        if parent_task != context["task_id"]:
+            raise ValueError("Excel vector retry must retain the original task")
+        original = next(
+            (
+                item
+                for item in parent.steps
+                if item.node_id == step.node_id
+                and item.tool_id == step.tool_id
+                and item.action == step.action
+            ),
+            None,
+        )
+        if original is not None:
+            step.params = prepare_excel_vector_input(
+                step.params, {**context, "run_id": parent.run_id, "step_id": original.step_id}
+            )
