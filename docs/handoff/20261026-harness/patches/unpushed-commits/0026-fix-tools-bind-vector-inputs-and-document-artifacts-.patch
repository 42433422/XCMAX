+def test_owned_document_two_processes_consume_one_original_receipt(owned_document_case, tmp_path):
+    import subprocess
+    import sys
+
+    case = owned_document_case()
+    assert case.result["success"] is True
+    script = """
+import json, sys, time
+from pathlib import Path
+from app.domain.shared_services.kitten_ai_document.pickup import pop_document_pickup
+body = json.loads(sys.stdin.read())
+ready, gate = Path(sys.argv[1]), Path(sys.argv[2])
+ready.touch()
+deadline = time.monotonic() + 20
+while not gate.exists():
+    if time.monotonic() > deadline:
+        raise RuntimeError("test barrier timed out")
+    time.sleep(.01)
+item = pop_document_pickup(body["token"], runtime_context=body["context"])
+print(json.dumps({"downloaded": item is not None, "size": len(item[0]) if item else 0}))
+"""
+    gate = tmp_path / "consume-go"
+    environment = {**os.environ, "XCAGI_AGENT_RUN_REQUIRE_DURABLE": "1"}
+    workers = []
+    try:
+        for index in range(2):
+            worker = subprocess.Popen(
+                [sys.executable, "-c", script, str(tmp_path / f"ready-{index}"), str(gate)],
+                stdin=subprocess.PIPE,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE,
+                text=True,
+                env=environment,
+            )
+            worker.stdin.write(
+                json.dumps({"token": case.result["pickup_token"], "context": case.actor.context})
+            )
+            worker.stdin.close()
+            worker.stdin = None
+            workers.append(worker)
+        deadline = time.monotonic() + 20
+        while not all((tmp_path / f"ready-{index}").exists() for index in range(2)):
+            assert time.monotonic() < deadline, "pickup consumers did not reach the barrier"
+            time.sleep(0.01)
+        gate.touch()
+        receipts = []
+        for worker in workers:
+            output, error = worker.communicate(timeout=20)
+            assert worker.returncode == 0, error
+            receipts.append(json.loads(output.splitlines()[-1]))
+        assert sorted(item["downloaded"] for item in receipts) == [False, True]
+        assert sum(item["size"] > 0 for item in receipts) == 1
+    finally:
+        for worker in workers:
+            if worker.poll() is None:
+                worker.kill()
+                worker.communicate(timeout=5)
+
+
+@pytest.mark.parametrize(
+    "shape", ["missing_body", "missing_table_grid", "empty_body", "text_and_table"]
+)
+def test_owned_docx_requires_readable_body_and_tables(owned_document_case, monkeypatch, shape):
+    from io import BytesIO
+    from xml.etree import ElementTree
+    from zipfile import ZipFile
+
+    from docx import Document
+
+    from app.domain.shared_services.kitten_ai_document import generate
+
+    document = Document()
+    document.add_paragraph("可读段落")
+    document.add_table(rows=1, cols=1).cell(0, 0).text = "可读表格"
+    original = BytesIO()
+    document.save(original)
+    output = BytesIO()
+    with ZipFile(BytesIO(original.getvalue())) as source, ZipFile(output, "w") as destination:
+        for member in source.infolist():
+            content = source.read(member.filename)
+            if member.filename == "word/document.xml":
+                root = ElementTree.fromstring(content)
+                body = root.find(
+                    "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}body"
+                )
+                if shape == "missing_body":
+                    root.remove(body)
+                elif shape == "empty_body":
+                    body.clear()
+                elif shape == "missing_table_grid":
+                    table = body.find(
+                        "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}tbl"
+                    )
+                    table.remove(
+                        table.find(
+                            "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}tblGrid"
+                        )
+                    )
+                content = ElementTree.tostring(root)
+            destination.writestr(member, content)
+    monkeypatch.setattr(
+        generate, "generate_office_file", lambda *args: (output.getvalue(), "contract.docx")
+    )
+    case = owned_document_case()
+    if shape.startswith("missing"):
+        assert case.result["success"] is False
+        assert case.result["outcome"] == "unknown"
+        assert case.result["retryable"] is False
+        assert "artifacts" not in case.result
+    else:
+        assert case.result["success"] is True
+        assert _verify_case(case)[1] is True
+        content, _, _ = pop_document_pickup(
+            case.result["pickup_token"], runtime_context=case.actor.context
+        )
+        opened = Document(BytesIO(content))
+        if shape == "empty_body":
+            assert opened.paragraphs == []
+            assert opened.tables == []
+        else:
+            assert [paragraph.text for paragraph in opened.paragraphs] == ["可读段落"]
+            assert opened.tables[0].rows[0].cells[0].text == "可读表格"
