@@ -0,0 +1,230 @@
+"""Credential-free worker entrypoint; launched before importing any employee code."""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import importlib.util
+import inspect
+import json
+import logging
+import os
+import resource
+import socket
+import subprocess
+import sys
+import types
+from pathlib import Path
+
+MAX_MESSAGE = 8 * 1024 * 1024
+BOUNDARY_ERRORS = (Exception,)
+
+
+class IsolationUnavailable(RuntimeError):
+    pass
+
+
+def _unique_object(pairs):
+    value = dict(pairs)
+    if len(value) != len(pairs):
+        raise ValueError("duplicate leaf JSON key")
+    return value
+
+
+def _read(stream):
+    line = stream.readline(MAX_MESSAGE + 1)
+    if not line or len(line) > MAX_MESSAGE or not line.endswith(b"\n"):
+        raise ValueError("invalid leaf frame")
+    value = json.loads(line, object_pairs_hook=_unique_object)
+    json.dumps(value, allow_nan=False)
+    return value
+
+
+def _write(stream, value):
+    data = json.dumps(value, ensure_ascii=False, allow_nan=False).encode() + b"\n"
+    if len(data) > MAX_MESSAGE:
+        raise ValueError("leaf frame limit")
+    stream.write(data)
+    stream.flush()
+
+
+def _load(path, label):
+    spec = importlib.util.spec_from_file_location(label, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _sdk(root):
+    # Never import the host app/__init__, DB, HTTP/model clients or host_services.
+    for name in ("app", "app.mod_sdk", "app.application", "app.application.agent_orchestrator"):
+        module = types.ModuleType(name)
+        module.__path__ = [str(Path(root).joinpath(*name.split(".")))]
+        sys.modules[name] = module
+    errors = types.ModuleType("app.mod_sdk.errors")
+    errors.BOUNDARY_ERRORS = (Exception,)
+    errors.RECOVERABLE_ERRORS = (OSError, ValueError, RuntimeError, ImportError, LookupError)
+    sys.modules[errors.__name__] = errors
+
+
+def _assert_isolation(config):
+    config["bootstrap_check"] = "native_runtime"
+    import ctypes
+
+    config["bootstrap_check"] = "file"
+    try:
+        with open(config["denial_canary"], "rb"):
+            pass
+    except PermissionError:
+        pass
+    else:
+        raise IsolationUnavailable("file")
+    config["bootstrap_check"] = "native_file"
+    library = ctypes.CDLL(None, use_errno=True)
+    descriptor = library.open(os.fsencode(config["denial_canary"]), 0)
+    if descriptor >= 0:
+        os.close(descriptor)
+        raise IsolationUnavailable("native_file")
+    if ctypes.get_errno() not in {1, 13}:
+        raise IsolationUnavailable("native_errno")
+    config["bootstrap_check"] = "network"
+    try:
+        with socket.socket() as client:
+            client.connect(("127.0.0.1", 9))
+    except PermissionError:
+        pass
+    else:
+        raise IsolationUnavailable("network")
+    config["bootstrap_check"] = "process_exec"
+    try:
+        subprocess.run(["/bin/echo", "isolation-canary"], check=True, capture_output=True)
+    except PermissionError:
+        pass
+    else:
+        raise IsolationUnavailable("process_exec")
+    config["bootstrap_check"] = "process_fork"
+    try:
+        child = os.fork()
+    except PermissionError:
+        pass
+    else:
+        if child == 0:
+            os._exit(0)
+        os.waitpid(child, 0)
+        raise IsolationUnavailable("process_fork")
+
+
+def _run(config, send, receive):
+    config["bootstrap_check"] = "limits"
+    for kind, limit in (
+        (resource.RLIMIT_CPU, 60),
+        (resource.RLIMIT_FSIZE, 64 * 1024 * 1024),
+        (resource.RLIMIT_NOFILE, 64),
+        (resource.RLIMIT_CORE, 0),
+    ):
+        resource.setrlimit(kind, (limit, limit))
+    _assert_isolation(config)
+    config["bootstrap_check"] = "sdk"
+    _write(send, {"type": "ready", "checks": ["file", "native_file", "network", "process"]})
+    _sdk(config["sdk_root"])
+    sys.path.extend(config["dependency_roots"])
+    payload = config["payload"]
+    pack = Path(config["pack_root"])
+    workspace = Path(config["workspace_root"])
+    ctx = {"employee_id": config["employee_id"], "workspace_root": str(workspace)}
+    if config["model_broker"]:
+        calls = 0
+
+        async def complete(messages, max_tokens=4000, temperature=0.7):
+            nonlocal calls
+            calls += 1
+            _write(
+                send,
+                {
+                    "type": "model.complete",
+                    "id": calls,
+                    "messages": messages,
+                    "max_tokens": max_tokens,
+                    "temperature": temperature,
+                },
+            )
+            reply = _read(receive)
+            if reply.get("type") != "model.reply" or reply.get("id") != calls:
+                raise ValueError("invalid model broker reply")
+            return reply["result"]
+
+        ctx["call_llm"] = complete
+    module_path = pack / config["module"]
+    generate = "generate" in config["employee_id"].lower()
+    has_file = bool(str(payload.get("file_path") or payload.get("path") or "").strip())
+    if (generate and not has_file and payload.get("user_request")) or not module_path.is_file():
+        converters = sorted((pack / "backend").rglob("convert.py"))
+        converter = next((p for p in converters if "vendor" in p.parts), None)
+        if converter is None:
+            raise ValueError("employee converter missing")
+        src = Path(str(payload.get("file_path") or payload.get("path") or workspace / "input.json"))
+        if not src.is_file():
+            if not generate:
+                raise ValueError("employee input missing")
+            src.write_text("{}", encoding="utf-8")
+        fn = _load(converter, "_employee_converter").convert_file
+        rules = pack / "rule_spec.json"
+        rules = json.loads(rules.read_bytes()) if rules.is_file() else {}
+        result = fn(
+            src,
+            Path(payload["output_path"]),
+            template_path=None,
+            payload=payload,
+            ctx=ctx,
+            rule_spec=rules,
+        )
+        result = asyncio.run(result) if inspect.isawaitable(result) else result
+        return {"ok": True, "output": result, "output_path": payload["output_path"]}
+    else:
+        fn = _load(module_path, "_employee_worker").run
+        result = fn(payload, ctx)
+    return asyncio.run(result) if inspect.isawaitable(result) else result
+
+
+def main():
+    send, receive = sys.stdout.buffer, sys.stdin.buffer
+    config = {}
+    try:
+        config = _read(receive)
+        # Library/pack print() is diagnostic data, never a protocol message.
+        with contextlib.redirect_stdout(sys.stderr):
+            result = _run(config, send, receive)
+        _write(send, {"type": "result", "result": result})
+        return 0
+    except (
+        BOUNDARY_ERRORS
+    ) as error:  # Process boundary; never expose raw exceptions or credentials.
+        logging.disable(logging.CRITICAL)
+        _write(
+            send,
+            {
+                "type": "error",
+                "error_code": "employee_leaf_failed",
+                "exception_type": type(error).__name__,
+                "isolation_check": (
+                    config.get("bootstrap_check", "")
+                    if config.get("bootstrap_check")
+                    in {
+                        "native_runtime",
+                        "file",
+                        "native_file",
+                        "network",
+                        "process_exec",
+                        "process_fork",
+                        "limits",
+                        "sdk",
+                    }
+                    else ""
+                ),
+            },
+        )
+        return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
