diff --git a/FHD/app/application/employee_runtime/leaf_process.py b/FHD/app/application/employee_runtime/leaf_process.py
new file mode 100644
index 0000000000..f938558b1e
--- /dev/null
+++ b/FHD/app/application/employee_runtime/leaf_process.py
@@ -0,0 +1,540 @@
+"""Trusted staging and deny-default macOS launch for credential-free employee code."""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import importlib.util
+import json
+import math
+import os
+import re
+import selectors
+import signal
+import stat
+import subprocess
+import sys
+import tempfile
+import time
+from concurrent.futures import ThreadPoolExecutor
+from contextlib import contextmanager, suppress
+from contextvars import copy_context
+from pathlib import Path
+
+import psutil
+
+MAX_MESSAGE = 8 * 1024 * 1024
+MAX_FILE = 64 * 1024 * 1024
+MAX_STAGE = 256 * 1024 * 1024
+DEPENDENCIES = (
+    "docx",
+    "openpyxl",
+    "pptx",
+    "xlsxwriter",
+    "pypdf",
+    "reportlab",
+    "PIL",
+    "lxml",
+    "numpy",
+    "et_xmlfile",
+    "charset_normalizer",
+    "chardet",
+    "defusedxml",
+    "typing_extensions",
+)
+
+
+class LeafUnavailable(ValueError):
+    """No employee code was launched; there is no unsandboxed fallback."""
+
+
+def _pinned_bytes(path: Path, *, limit=MAX_FILE) -> bytes:
+    from app.application.office_parse_app_service import _read_pinned_output
+
+    try:
+        data = _read_pinned_output(Path(path.anchor), path, max_bytes=limit + 1)
+    except OSError as error:
+        raise LeafUnavailable("employee stage file is unavailable or linked") from error
+    if len(data) > limit:
+        raise LeafUnavailable("employee stage file exceeds limit")
+    return data
+
+
+def stage_employee(pack: Path, snapshot: dict, payload: dict, stage: Path) -> dict:
+    """Copy only reviewed bytes; never grant an original code/input directory."""
+    from app.application.agent_orchestrator.business_action_ledger import canonical_hash
+
+    code, total = {}, 0
+    for source in sorted(pack.rglob("*")):
+        rel = source.relative_to(pack)
+        if "__pycache__" in rel.parts or any(p.startswith(".") for p in rel.parts):
+            continue
+        if source.is_symlink():
+            raise LeafUnavailable("employee stage contains a link")
+        if source.is_dir():
+            continue
+        data = _pinned_bytes(source)
+        total += len(data)
+        if total > MAX_STAGE:
+            raise LeafUnavailable("employee stage exceeds limit")
+        code[rel.as_posix()] = hashlib.sha256(data).hexdigest()
+        dest = stage / "pack" / rel
+        dest.parent.mkdir(parents=True, exist_ok=True)
+        dest.write_bytes(data)
+        dest.chmod(0o400)
+    if canonical_hash(code) != snapshot["code_sha256"]:
+        raise LeafUnavailable("employee code changed after approval")
+    rewritten = dict(payload)
+    for index, item in enumerate(snapshot["inputs"]):
+        data = _pinned_bytes(Path(item["path"]))
+        total += len(data)
+        if total > MAX_STAGE or hashlib.sha256(data).hexdigest() != item["sha256"]:
+            raise LeafUnavailable("employee input changed after approval")
+        if len(data) != item["size_bytes"]:
+            raise LeafUnavailable("employee input size changed after approval")
+        dest = stage / "inputs" / str(index) / Path(item["path"]).name
+        dest.parent.mkdir(parents=True, exist_ok=True)
+        dest.write_bytes(data)
+        dest.chmod(0o400)
+        rewritten[item["parameter"]] = str(dest)
+    for name in ("work", "work/outputs", "tmp", "home"):
+        (stage / name).mkdir(parents=True, exist_ok=True)
+    rewritten.update(
+        workspace_root=str(stage / "work"),
+        output_path=str(stage / "work/outputs" / Path(snapshot["output_path"]).name),
+    )
+    rewritten["output_relpath"] = rewritten["output_path"]
+    return rewritten
+
+
+def stage_sdk(stage: Path) -> Path:
+    """Explicit portable projections; do not expose the dynamic host SDK facade."""
+    host = Path(__file__).resolve().parents[3]
+    projection = {
+        "app/mod_sdk/office_employee_worker.py": "app/mod_sdk/office_employee_worker.py",
+        "app/mod_sdk/generated_employee_worker.py": "app/mod_sdk/generated_employee_worker.py",
+        "app/mod_sdk/host_services.py": "app/application/office_plaintext_generate.py",
+        "app/application/agent_orchestrator/tool_receipt.py": "app/application/agent_orchestrator/tool_receipt.py",
+    }
+    root = stage / "sdk"
+    for target, source in projection.items():
+        dest = root / target
+        dest.parent.mkdir(parents=True, exist_ok=True)
+        dest.write_bytes(_pinned_bytes(host / source))
+        dest.chmod(0o400)
+    return root
+
+
+def _runtime():
+    if sys.platform != "darwin" or not Path("/usr/bin/sandbox-exec").is_file():
+        raise LeafUnavailable("tool_os_isolation_unavailable")
+    if getattr(sys, "frozen", False):
+        helper = Path(sys.executable).parent / "employee-leaf/xcagi-employee-leaf"
+        if not helper.is_file() or helper.is_symlink():
+            raise LeafUnavailable("packaged_employee_leaf_missing")
+        return [str(helper)], [helper.parent], []
+    interpreter = Path(sys.executable).resolve()
+    bootstrap = Path(__file__).resolve().parents[2] / "mod_sdk/employee_leaf.py"
+    roots, search = [Path(sys.base_prefix).resolve(), bootstrap], set()
+    for name in DEPENDENCIES:
+        spec = importlib.util.find_spec(name)
+        if spec is None or spec.origin is None:
+            continue
+        path = Path(spec.origin).resolve()
+        root = path.parent if spec.submodule_search_locations else path
+        roots.append(root)
+        search.add(str(path.parent.parent if spec.submodule_search_locations else path.parent))
+    return [str(interpreter), "-I", "-S", str(bootstrap)], roots, sorted(search)
+
+
+def _profile(command, read_roots, stage):
+    def rule(kind, path):
+        return f"({kind} {json.dumps(str(path))})"
+
+    ancestors = {parent for path in [*read_roots, stage] for parent in path.parents}
+    return "\n".join(
+        [
+            "(version 1)",
+            "(deny default)",
+            f"(allow process-exec {rule('literal', command[0])})",
+            "(allow sysctl-read "
+            + " ".join(
+                rule("sysctl-name", name)
+                for name in (
+                    "kern.ostype",
+                    "kern.osrelease",
+                    "kern.version",
+                    "kern.hostname",
+                    "hw.machine",
+                )
+            )
+            + ")",
+            "(allow file-read-metadata "
+            + " ".join(rule("literal", p) for p in sorted(ancestors))
+            + ")",
+            "(allow file-read* "
+            + " ".join(
+                rule("subpath" if p.is_dir() else "literal", p)
+                for p in [
+                    Path("/System/Library"),
+                    Path("/usr/lib"),
+                    *read_roots,
+                    stage / "pack",
+                    stage / "inputs",
+                    stage / "sdk",
+                ]
+            )
+            + ' (literal "/dev/urandom"))',
+            '(allow file-read-data (literal "/"))',
+            "(allow file-read* file-write* "
+            + " ".join(rule("subpath", stage / name) for name in ("work", "tmp", "home"))
+            + ' (literal "/dev/null"))',
+        ]
+    )
+
+
+def _frame(value):
+    encoded = json.dumps(value, ensure_ascii=False, allow_nan=False).encode() + b"\n"
+    if len(encoded) > MAX_MESSAGE:
+        raise LeafUnavailable("employee_leaf_message_limit")
+    return encoded
+
+
+def _unique_object(pairs):
+    value = dict(pairs)
+    if len(value) != len(pairs):
+        raise ValueError("duplicate leaf JSON key")
+    return value
+
+
+def _model_request(frame, call_number, callback):
+    if set(frame) != {"type", "id", "messages", "max_tokens", "temperature"}:
+        raise ValueError("invalid leaf model request")
+    if type(frame["id"]) is not int or frame["id"] != call_number or call_number > 8:
+        raise ValueError("leaf model budget exceeded")
+    if type(frame["max_tokens"]) is not int or not 1 <= frame["max_tokens"] <= 4000:
+        raise ValueError("invalid leaf model token budget")
+    temperature = frame["temperature"]
+    if (
+        type(temperature) not in (int, float)
+        or not math.isfinite(temperature)
+        or not 0 <= temperature <= 2
+    ):
+        raise ValueError("invalid leaf temperature")
+    messages = frame["messages"]
+    if not isinstance(messages, list) or not 1 <= len(messages) <= 64 or callback is None:
+        raise ValueError("leaf model capability unavailable")
+    text_bytes = image_bytes = 0
+    for message in messages:
+        if (
+            not isinstance(message, dict)
+            or set(message) != {"role", "content"}
+            or not isinstance(message["role"], str)
+            or message["role"] not in {"system", "user", "assistant"}
+        ):
+            raise ValueError("invalid leaf model message")
+        content = message["content"]
+        parts = [{"type": "text", "text": content}] if isinstance(content, str) else content
+        if not isinstance(parts, list) or len(parts) > 64:
+            raise ValueError("invalid leaf model content")
+        for part in parts:
+            if not isinstance(part, dict):
+                raise ValueError("invalid leaf model content")
+            if (
+                set(part) == {"type", "text"}
+                and part["type"] == "text"
+                and isinstance(part["text"], str)
+            ):
+                text_bytes += len(part["text"].encode("utf-8"))
+            elif set(part) == {"type", "image_url"} and part["type"] == "image_url":
+                image = part["image_url"]
+                if (
+                    not isinstance(image, dict)
+                    or set(image) != {"url"}
+                    or not isinstance(image["url"], str)
+                ):
+                    raise ValueError("invalid leaf model image")
+                encoded = re.fullmatch(
+                    r"data:image/(?:png|jpeg|webp|gif);base64,([A-Za-z0-9+/]+={0,2})", image["url"]
+                )
+                if encoded is None:
+                    raise ValueError("invalid leaf model image")
+                image_bytes += len(base64.b64decode(encoded[1], validate=True))
+            else:
+                raise ValueError("invalid leaf model content")
+            if text_bytes > 256 * 1024 or image_bytes > 4 * 1024 * 1024:
+                raise ValueError("leaf model input budget exceeded")
+    reply = callback(messages, frame["max_tokens"], temperature)
+    if (
+        not isinstance(reply, dict)
+        or type(reply.get("success", reply.get("ok"))) is not bool
+        or any(type(reply[key]) is not bool for key in ("success", "ok") if key in reply)
+        or ("success" in reply and "ok" in reply and reply["success"] != reply["ok"])
+        or not isinstance(reply.get("content", ""), str)
+    ):
+        raise ValueError("invalid leaf model reply")
+    from app.application.agent_orchestrator.tool_receipt import tool_receipt_outcome
+
+    outcome = tool_receipt_outcome({**reply, "success": reply.get("success", reply.get("ok"))})
+    return {
+        "success": outcome == "success",
+        "ok": outcome == "success",
+        "content": reply.get("content", "") if outcome == "success" else "",
+        "outcome": outcome,
+        "retryable": False,
+        "reconciliation_required": outcome == "unknown",
+    }
+
+
+@contextmanager
+def _pin_output_roots(stage: Path):
+    from app.application.shipment_excel_etl_security import _open_directory_under_root
+
+    stage_fd = _open_directory_under_root(
+        Path(stage.anchor), stage, create=False, list_directory=True
+    )
+    roots = {}
+    try:
+        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
+        for name in ("work", "tmp", "home"):
+            roots[name] = os.open(name, flags, dir_fd=stage_fd)
+        yield stage_fd, roots
+    finally:
+        for descriptor in (*roots.values(), stage_fd):
+            with suppress(OSError):
+                os.close(descriptor)
+
+
+def _scan_output_roots(pinned, deadline):
+    stage_fd, roots = pinned
+    size = entries = 0
+
+    def current_roots():
+        for name, descriptor in roots.items():
+            held = os.fstat(descriptor)
+            named = os.stat(name, dir_fd=stage_fd, follow_symlinks=False)
+            if not stat.S_ISDIR(named.st_mode) or (named.st_dev, named.st_ino) != (
+                held.st_dev,
+                held.st_ino,
+            ):
+                raise ValueError("employee_leaf_output_root_changed")
+
+    def walk(descriptor, depth):
+        nonlocal size, entries
+        with os.scandir(descriptor) as children:
+            for child in children:
+                if time.monotonic() >= deadline:
+                    raise TimeoutError("employee_leaf_deadline")
+                entries += 1
+                if entries > 10000:
+                    raise ValueError("employee_leaf_output_count")
+                try:
+                    entry = os.stat(child.name, dir_fd=descriptor, follow_symlinks=False)
+                except FileNotFoundError:
+                    continue  # A converter may remove its own transient files.
+                if stat.S_ISREG(entry.st_mode):
+                    if entry.st_nlink != 1:
+                        raise ValueError("employee_leaf_output_link")
+                    size += entry.st_size
+                    if size > MAX_STAGE:
+                        raise ValueError("employee_leaf_disk_limit")
+                elif stat.S_ISDIR(entry.st_mode):
+                    if depth >= 64:
+                        raise ValueError("employee_leaf_output_depth")
+                    try:
+                        nested = os.open(
+                            child.name,
+                            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
+                            dir_fd=descriptor,
+                        )
+                    except FileNotFoundError:
+                        continue
+                    try:
+                        opened = os.fstat(nested)
+                        if (opened.st_dev, opened.st_ino) != (entry.st_dev, entry.st_ino):
+                            raise ValueError("employee_leaf_output_directory_changed")
+                        walk(nested, depth + 1)
+                    finally:
+                        os.close(nested)
+                else:
+                    raise ValueError("employee_leaf_output_type")
+
+    if time.monotonic() >= deadline:
+        raise TimeoutError("employee_leaf_deadline")
+    current_roots()
+    for descriptor in roots.values():
+        walk(descriptor, 0)
+    current_roots()
+    return {"entries": entries, "bytes": size}
+
+
+def spawn_leaf(config, stage: Path, *, deadline: float, model_callback=None):
+    """Only protocol pipes survive launch. The trusted parent retains all credentials."""
+    runtime = _runtime()
+    with _pin_output_roots(stage) as pinned:
+        _scan_output_roots(pinned, deadline)
+        return _spawn_leaf(
+            config,
+            stage,
+            deadline=deadline,
+            model_callback=model_callback,
+            runtime=runtime,
+            pinned=pinned,
+        )
+
+
+def _spawn_leaf(config, stage, *, deadline, model_callback, runtime, pinned):
+    command, roots, search = runtime
+    config = {**config, "dependency_roots": search, "model_broker": model_callback is not None}
+    policy = _profile(command, roots, stage)
+    env = {
+        "HOME": str(stage / "home"),
+        "TMPDIR": str(stage / "tmp"),
+        "LANG": "en_US.UTF-8",
+        "PATH": "/usr/bin:/bin",
+        "PYTHONDONTWRITEBYTECODE": "1",
+    }
+    _frame(config)  # Reject malformed or oversized inputs before allocating a process or canary.
+    descriptor, denial_canary = tempfile.mkstemp(prefix="xcagi-leaf-deny-", dir=stage.parent)
+    os.close(descriptor)
+    config["denial_canary"] = denial_canary
+    broker = None
+    try:
+        sending = _frame(config)
+        broker = ThreadPoolExecutor(max_workers=1)
+        process = subprocess.Popen(
+            ["/usr/bin/sandbox-exec", "-p", policy, *command],
+            cwd=stage / "work",
+            env=env,
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            close_fds=True,
+            start_new_session=True,
+        )
+    except BaseException:
+        if broker is not None:
+            broker.shutdown(wait=False, cancel_futures=True)
+        Path(denial_canary).unlink()
+        raise
+    buffers, stderr_bytes, received, calls, ready = {"out": b""}, 0, None, 0, False
+    pending = None
+    try:
+        with selectors.DefaultSelector() as selector:
+            os.set_blocking(process.stdin.fileno(), False)
+            selector.register(process.stdin, selectors.EVENT_WRITE, "in")
+            for stream, name in ((process.stdout, "out"), (process.stderr, "err")):
+                os.set_blocking(stream.fileno(), False)
+                selector.register(stream, selectors.EVENT_READ, name)
+            monitor = psutil.Process(process.pid)
+            while selector.get_map():
+                if time.monotonic() >= deadline:
+                    raise TimeoutError("employee_leaf_deadline")
+                if pending is not None and pending.done():
+                    sending = _frame(
+                        {"type": "model.reply", "id": calls, "result": pending.result()}
+                    )
+                    pending = None
+                    selector.register(process.stdin, selectors.EVENT_WRITE, "in")
+                try:
+                    if monitor.memory_info().rss > 512 * 1024 * 1024:
+                        raise ValueError("employee_leaf_memory_limit")
+                except psutil.NoSuchProcess:
+                    pass
+                _scan_output_roots(pinned, deadline)
+                for key, _mask in selector.select(min(0.1, max(0, deadline - time.monotonic()))):
+                    if key.data == "in":
+                        try:
+                            sending = sending[os.write(key.fileobj.fileno(), sending[:65536]) :]
+                        except BlockingIOError:
+                            continue
+                        if not sending:
+                            selector.unregister(key.fileobj)
+                        continue
+                    chunk = os.read(key.fileobj.fileno(), 65536)
+                    if not chunk:
+                        selector.unregister(key.fileobj)
+                        continue
+                    if key.data == "err":
+                        stderr_bytes += len(chunk)
+                        if stderr_bytes > 65536:
+                            raise ValueError("employee_leaf_diagnostic_limit")
+                        continue  # Pack diagnostics never become a public raw error.
+                    buffers["out"] += chunk
+                    if len(buffers["out"]) > MAX_MESSAGE:
+                        raise ValueError("employee_leaf_reply_limit")
+                    while b"\n" in buffers["out"]:
+                        line, buffers["out"] = buffers["out"].split(b"\n", 1)
+                        message = json.loads(line, object_pairs_hook=_unique_object)
+                        _frame(message)  # A malicious worker must not inject NaN/Infinity.
+                        if not isinstance(message, dict) or received is not None:
+                            raise ValueError("employee_leaf_protocol_invalid")
+                        if not ready:
+                            if message != {
+                                "type": "ready",
+                                "checks": ["file", "native_file", "network", "process"],
+                            }:
+                                if message.get(
+                                    "exception_type"
+                                ) == "IsolationUnavailable" and message.get("isolation_check") in {
+                                    "file",
+                                    "native_file",
+                                    "native_errno",
+                                    "network",
+                                    "process_exec",
+                                    "process_fork",
+                                }:
+                                    raise ValueError(
+                                        "employee_leaf_isolation_not_proven:"
+                                        + message["isolation_check"]
+                                    )
+                                raise ValueError("employee_leaf_isolation_not_proven")
+                            ready = True
+                        elif message.get("type") == "model.complete":
+                            if pending is not None or sending:
+                                raise ValueError("employee_leaf_model_request_overlap")
+                            calls += 1
+                            pending = broker.submit(
+                                copy_context().run, _model_request, message, calls, model_callback
+                            )
+                        elif message.get("type") in {"result", "error"}:
+                            if pending is not None or sending:
+                                raise ValueError("employee_leaf_model_result_unresolved")
+                            received = message
+                        else:
+                            raise ValueError("employee_leaf_protocol_invalid")
+        process.wait(timeout=max(0.01, deadline - time.monotonic()))
+        _scan_output_roots(pinned, deadline)
+        if (
+            buffers["out"]
+            or received is None
+            or process.returncode != 0
+            or received.get("type") != "result"
+        ):
+            raise ValueError("employee_leaf_incomplete")
+        return received["result"], {
+            "profile_sha256": hashlib.sha256(policy.encode()).hexdigest(),
+            "model_calls": calls,
+            "os_build": os.uname().release,
+            "helper": command[0],
+        }
+    finally:
+        # Provider cancellation is not proven. The enclosing trusted tool worker
+        # must retain its unknown receipt and be reaped by its existing boundary.
+        try:
+            if pending is not None:
+                pending.cancel()
+            broker.shutdown(wait=False, cancel_futures=True)
+        finally:
+            try:
+                if process.poll() is None:
+                    with suppress(ProcessLookupError):
+                        os.killpg(process.pid, signal.SIGKILL)
+            finally:
+                try:
+                    process.wait()
+                finally:
+                    for stream in (process.stdin, process.stdout, process.stderr):
+                        with suppress(OSError):
+                            stream.close()
+                    Path(denial_canary).unlink(missing_ok=True)
diff --git a/FHD/app/mod_sdk/employee_leaf.py b/FHD/app/mod_sdk/employee_leaf.py
