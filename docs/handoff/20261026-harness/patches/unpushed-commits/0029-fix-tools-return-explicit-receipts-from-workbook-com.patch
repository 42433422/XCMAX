+@pytest.mark.parametrize(
+    "action", ["join", "diff", "diff_no_keys", "missing_left", "missing_right", "bad_action"]
+)
+def test_comparison_host_projection_has_explicit_success_only_after_calculation(tmp_path, action):
+    import pandas as pd
+
+    from app.application.tools.workflow import _excel_io
+    from app.application.tools.workflow_tools.excel_operations import WorkbookOperations
+
+    first, second = tmp_path / "left.xlsx", tmp_path / "right.xlsx"
+    pd.DataFrame({"key": ["A", "B"], "value": [1, 2]}).to_excel(first, index=False)
+    pd.DataFrame({"key": ["A", "B"], "value": [1, 3]}).to_excel(second, index=False)
+    if action == "missing_left":
+        first = tmp_path / "missing.xlsx"
+    if action == "missing_right":
+        second = tmp_path / "missing.xlsx"
+    params = {
+        "action": "join" if action == "join" else "bad" if action == "bad_action" else "diff",
+        "file_paths": [str(first), str(second)],
+        "join_keys": ["key"],
+        "file_path_a": str(first),
+        "file_path_b": str(second),
+        "key_columns": [] if action == "diff_no_keys" else ["key"],
+    }
+    result = WorkbookOperations(_excel_io(), pd.read_excel, Mock(), Mock()).join_compare(
+        params, str(tmp_path)
+    )
+    if action in {"missing_left", "missing_right", "bad_action"}:
+        assert result["success"] is False
+        assert "error" in result
+    else:
+        assert result["success"] is True
+        assert result["action"] == params["action"]
+        if action == "join":
+            assert result["row_count"] == 2
+        elif action == "diff":
+            assert result["rows_with_value_changes"]["count"] == 1
+        else:
+            assert result["row_count"] == 2
+
+
+@pytest.mark.parametrize("missing", [False, True])
+def test_comparison_native_formal_join_and_failure(tmp_path, trusted_actor, missing):
+    import pandas as pd
+
+    from app.application.tools.workflow import execute_workflow_tool
+
+    first, second = tmp_path / "left.xlsx", tmp_path / "right.xlsx"
+    pd.DataFrame({"key": ["A", "B"], "left": [1, 2]}).to_excel(first, index=False)
+    pd.DataFrame({"key": ["A", "B"], "right": [3, 4]}).to_excel(second, index=False)
+    if missing:
+        second = tmp_path / "missing.xlsx"
+    actor = trusted_actor(mod_id="xcagi-planner-excel-tools")
+    params = {"action": "join", "file_paths": [str(first), str(second)], "join_keys": ["key"]}
+    result = json.loads(
+        execute_workflow_tool(
+            "excel_join_compare",
+            params,
+            workspace_root=str(tmp_path),
+            runtime_context=actor.context,
+        )
+    )
+    assert result["source"] == "mod:xcagi-planner-excel-tools"
+    assert result["success"] is (not missing)
+    if missing:
+        assert "file not found" in result["error"]
+    else:
+        assert result["action"] == "join"
+        assert result["row_count"] == 2
+        assert set(result["columns"]) == {"key", "left", "right"}
