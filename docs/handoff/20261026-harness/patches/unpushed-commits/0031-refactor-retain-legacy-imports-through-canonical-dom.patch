@@ -0,0 +1,75 @@
+from __future__ import annotations
+
+import pickle
+from types import SimpleNamespace
+
+import pytest
+
+import app.application.excel_imports as legacy_excel
+from app.domain import value_objects_industry as industry
+from app.domain.app_pure import excel_imports
+from app.legacy.domain import value_objects_compat as legacy_vo
+
+
+@pytest.mark.parametrize(
+    "name", ["Money", "Quantity", "Price", "ContactInfo", "OrderNumber", "ModelNumber"]
+)
+def test_old_pickle_globals_remain_resolvable(name):
+    original_global = f"capp.legacy.domain.value_objects_compat\n{name}\n.".encode()
+    assert pickle.loads(original_global) is getattr(legacy_vo, name)
+
+
+def test_industry_configuration_is_loaded_for_each_quantity(monkeypatch):
+    monkeypatch.setattr(industry, "get_current_industry", lambda: "synthetic")
+    for label in ("First", "Second"):
+        config = {
+            "primary": "piece",
+            "secondary": "box",
+            "primary_label": label,
+            "primary_field": "pieces",
+            "secondary_field": "boxes",
+            "spec_field": "size",
+            "conversion": {"piece_to_box": 7.0},
+        }
+        monkeypatch.setattr(
+            "resources.config.industry_config.get_industry_profile",
+            lambda _industry, config=config: SimpleNamespace(units=config),
+        )
+        qty = legacy_vo.Quantity.from_primary_and_spec(2, 3)
+        assert qty.primary_label == label
+        assert qty.to_dict() == {"pieces": 2, "boxes": 14.0, "size": 3.0}
+
+
+def test_eval_dict_override_and_removal_do_not_mutate_canonical_excel(monkeypatch):
+    original = excel_imports._parse_price
+    monkeypatch.setitem(legacy_excel.__dict__, "_parse_price", lambda _value: 0.0)
+    assert legacy_excel._parse_price("15") == 0.0
+    assert excel_imports._parse_price("15") == 15.0
+    monkeypatch.delitem(legacy_excel.__dict__, "_parse_price")
+    with pytest.raises(AttributeError, match="module 'app.application.excel_imports'"):
+        _ = legacy_excel._parse_price
+    assert excel_imports._parse_price is original
+    assert legacy_excel.__all__ == excel_imports.__all__
+    assert legacy_excel.__all__ is not excel_imports.__all__
+
+
+@pytest.mark.parametrize(
+    ("name", "error", "message"),
+    [
+        (
+            "run_customers_excel_import_bytes",
+            ImportError,
+            "'run_customers_excel_import_bytes' is not implemented in app.application.excel_imports; "
+            "this function was lost in the backend → legacy-layer cleanup.",
+        ),
+        (
+            "missing",
+            AttributeError,
+            "module 'app.application.excel_imports' has no attribute 'missing'",
+        ),
+    ],
+)
+def test_legacy_excel_failure_messages_remain_exact(name, error, message):
+    with pytest.raises(error) as caught:
+        getattr(legacy_excel, name)
+    assert str(caught.value) == message
