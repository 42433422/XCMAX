diff --git a/FHD/app/application/employee_runtime/leaf_action.py b/FHD/app/application/employee_runtime/leaf_action.py
new file mode 100644
index 0000000000..f3802918fe
--- /dev/null
+++ b/FHD/app/application/employee_runtime/leaf_action.py
@@ -0,0 +1,262 @@
+"""Trusted Mac employee admission and publication around the credential-free leaf."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import stat
+import tempfile
+import time
+import uuid
+from pathlib import Path
+
+from app.application.employee_runtime.leaf_process import (
+    MAX_STAGE,
+    LeafUnavailable,
+    _pinned_bytes,
+    spawn_leaf,
+    stage_employee,
+    stage_sdk,
+)
+from app.utils.async_bridge import run_async
+from app.utils.operational_errors import RECOVERABLE_ERRORS
+
+
+def _model_complete(messages, max_tokens, temperature):
+    from app.infrastructure.llm.client import _scoped_client
+    from app.mod_sdk.mod_employee_llm import mod_employee_complete
+
+    if _scoped_client.get() is None:
+        return {"success": False, "outcome": "failure", "content": ""}
+    return run_async(
+        mod_employee_complete(messages, max_tokens=max_tokens, temperature=temperature)
+    )
+
+
+def _publish_outputs(stage, body, result, *, deadline):
+    """A returned path is a claim, never authority to read or overwrite a host file."""
+    from app.application.shipment_excel_etl_security import (
+        _open_directory_under_root,
+        open_etl_output_file,
+    )
+
+    output_root = stage / "work/outputs"
+    sidecars = Path(body["workspace_root"]) / "outputs" / ("leaf-" + uuid.uuid4().hex)
+    approved = {Path(item["path"]).name: Path(item["path"]) for item in body["outputs"]}
+    if len(approved) != len(body["outputs"]):
+        raise ValueError("employee output names collide")
+    files, mapping, directories, total = {}, {}, [], 0
+    for source in sorted(output_root.rglob("*")):
+        if time.monotonic() >= deadline:
+            raise TimeoutError("employee publication deadline")
+        mode = source.lstat().st_mode
+        if stat.S_ISDIR(mode):
+            target = sidecars / source.relative_to(output_root)
+            directories.append(target)
+            mapping[str(source)] = str(target)
+            continue
+        if not stat.S_ISREG(mode):
+            raise ValueError("employee artifact is linked or not regular")
+        relative = source.relative_to(output_root)
+        target = (approved.get(relative.name) if len(relative.parts) == 1 else None) or (
+            sidecars / relative
+        )
+        files[source] = _pinned_bytes(source)
+        total += len(files[source])
+        if total > MAX_STAGE:
+            raise ValueError("employee artifact budget exceeded")
+        mapping[str(source)] = str(target)
+    if body["output_kind"] != "structured_result" and not set(approved.values()).issubset(
+        {Path(value) for value in mapping.values()}
+    ):
+        raise ValueError("employee approved output missing")
+    output_paths = {str(source) for source in files}
+    mapping[str(output_root)] = str(Path(body["workspace_root"]) / "outputs")
+    mapping.update(
+        {
+            str(stage / "inputs" / str(i) / Path(item["path"]).name): item["path"]
+            for i, item in enumerate(body["inputs"])
+        }
+    )
+    embedded_path = re.compile(
+        "(?:"
+        + "|".join(re.escape(path) for path in sorted(mapping, key=len, reverse=True))
+        + r""")(?=$|[\s"'<>),;:\]}])"""
+    )
+
+    def rewrite(
+        value,
+        *,
+        source_parent=output_root,
+        target_parent=Path(body["output_path"]).parent,
+        field="",
+    ):
+        if isinstance(value, dict):
+            if any(
+                key.endswith("output_path")
+                and (not isinstance(item, str) or item not in output_paths)
+                for key, item in value.items()
+            ):
+                raise ValueError("employee returned an unapproved artifact claim")
+            keys = [
+                rewrite(key, source_parent=source_parent, target_parent=target_parent)
+                for key in value
+            ]
+            if len(set(keys)) != len(keys):
+                raise ValueError("employee metadata keys collide after publication")
+            return {
+                key: rewrite(
+                    item, source_parent=source_parent, target_parent=target_parent, field=original
+                )
+                for key, original, item in zip(keys, value, value.values())
+            }
+        if isinstance(value, list):
+            return [
+                rewrite(item, source_parent=source_parent, target_parent=target_parent, field=field)
+                for item in value
+            ]
+        if isinstance(value, str):
+            if value in mapping:
+                return mapping[value]
+            if value == str(stage / "work"):
+                return body["workspace_root"]
+            if (
+                field in {"relpath", "path", "src", "file", "image_path", "image_relpath"}
+                and not Path(value).is_absolute()
+            ):
+                original = os.path.normpath(str(source_parent / value))
+                if original in output_paths:
+                    return os.path.relpath(mapping[original], target_parent)
+            # Worker summaries often contain encoded JSON. Reconcile their
+            # path claims with the same map as the actual artifact metadata.
+            if value.lstrip().startswith(("{", "[")):
+                try:
+                    parsed = json.loads(value)
+                except ValueError:
+                    pass
+                else:
+                    if isinstance(parsed, (dict, list)):
+                        return json.dumps(
+                            rewrite(
+                                parsed, source_parent=source_parent, target_parent=target_parent
+                            ),
+                            ensure_ascii=False,
+                            allow_nan=False,
+                        )
+            value = embedded_path.sub(lambda match: mapping[match[0]], value)
+            if str(stage) in value:
+                raise ValueError("employee returned unpublished private path")
+        return value
+
+    rewritten = rewrite(result)
+    prepared = []
+    for source, data in files.items():
+        if time.monotonic() >= deadline:
+            raise TimeoutError("employee publication deadline")
+        if source.suffix.lower() == ".json":
+            data = json.dumps(
+                rewrite(
+                    json.loads(data),
+                    source_parent=source.parent,
+                    target_parent=Path(mapping[str(source)]).parent,
+                ),
+                ensure_ascii=False,
+                allow_nan=False,
+            ).encode()
+        prepared.append((Path(mapping[str(source)]), data))
+    for directory in directories:
+        descriptor = _open_directory_under_root(
+            Path(body["workspace_root"]), directory, create=True
+        )
+        os.close(descriptor)
+    artifacts = []
+    for target, data in prepared:
+        if time.monotonic() >= deadline:
+            raise TimeoutError("employee publication deadline")
+        with open_etl_output_file(target, workspace_root=body["workspace_root"]) as stream:
+            stream.write(data)
+        if _pinned_bytes(target) != data:
+            raise ValueError("employee artifact readback changed")
+        artifacts.append(
+            {
+                "path": str(target),
+                "sha256": hashlib.sha256(data).hexdigest(),
+                "size_bytes": len(data),
+            }
+        )
+    return rewritten, artifacts
+
+
+def execute_mac_employee_leaf(pack_root, employee_id, actions, payload, context):
+    from app.application.agent_orchestrator.tool_executor import registered_dispatch_is_controlled
+    from app.application.agent_orchestrator.tool_process import current_tool_worker_workspace
+    from app.application.employee_runtime.executor import _handler_output
+    from app.application.employee_runtime.loader import validate_employee_execution_snapshot
+    from app.application.tool_execution_deadline import _DEADLINE
+
+    launched = False
+    try:
+        if not registered_dispatch_is_controlled(employee_id, "execute"):
+            raise LeafUnavailable("employee_tool_control_required")
+        params = context.get("_employee_action_params")
+        if not isinstance(params, dict):
+            raise LeafUnavailable("employee_execution_snapshot_required")
+        body = validate_employee_execution_snapshot(employee_id, params, context)
+        direct = actions.get("direct_python") or {}
+        module = str(direct.get("module") or "worker").strip()
+        if not module.isidentifier():
+            raise LeafUnavailable("employee_module_invalid")
+        module = "backend/employees/" + module + ".py"
+        if not (pack_root / module).is_file():
+            candidates = sorted((pack_root / "backend/employees").glob("*.py"))
+            module = next(
+                (
+                    p.relative_to(pack_root).as_posix()
+                    for p in candidates
+                    if not p.name.startswith("_")
+                ),
+                module,
+            )
+        budget = _DEADLINE.get()
+        deadline = min(time.monotonic() + 60, budget.deadline) if budget else time.monotonic() + 60
+        if deadline <= time.monotonic():
+            raise LeafUnavailable("employee_deadline_expired")
+        with tempfile.TemporaryDirectory(
+            prefix="xcagi-employee-leaf-", dir=current_tool_worker_workspace()
+        ) as temporary:
+            stage = Path(temporary).resolve()
+            staged = stage_employee(pack_root, body, payload, stage)
+            config = {
+                "sdk_root": str(stage_sdk(stage)),
+                "pack_root": str(stage / "pack"),
+                "workspace_root": str(stage / "work"),
+                "payload": staged,
+                "employee_id": employee_id,
+                "module": module,
+            }
+            launched = True
+            result, audit = spawn_leaf(
+                config, stage, deadline=deadline, model_callback=_model_complete
+            )
+            output = _handler_output("direct_python", result)
+            if output["ok"]:
+                validate_employee_execution_snapshot(employee_id, params, context)
+                output["output"], artifacts = _publish_outputs(
+                    stage, body, result, deadline=deadline
+                )
+                output["isolation"] = {**audit, "artifacts": artifacts}
+            return output
+    except RECOVERABLE_ERRORS:
+        return {
+            "handler": "direct_python",
+            "ok": False,
+            "outcome": "unknown" if launched else "failure",
+            "error_code": "employee_leaf_incomplete" if launched else "employee_leaf_unavailable",
+            "error": "员工执行未获确认，请核对原任务"
+            if launched
+            else "员工隔离环境或已审阅快照不可用",
+            "retryable": False,
+            "reconciliation_required": launched,
+        }
