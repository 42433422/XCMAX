+                    for path in folder.rglob("data.json"):
+                        data = json.loads(path.read_text())
+                        if data.get("marker") == "synthetic-unpublished-partial":
+                            entered.append(data["pid"])
+                            return
+                except (OSError, ValueError):
+                    pass
+
+    monkeypatch.setattr(tool_process, "execute_isolated", bounded)
+    monkeypatch.setattr(tempfile, "mkdtemp", track)
+    watcher = threading.Thread(target=observe)
+    watcher.start()
+    try:
+        run = _start(employee_http)
+        completed = _finish_review(employee_http, run.run_id)
+    finally:
+        stop.set()
+        watcher.join(timeout=2)
+    assert entered, "the real leaf must enter before the forced timeout"
+    assert created and all(not folder.exists() for folder in created)
+    assert not any(psutil.pid_exists(pid) for pid in entered)
+    assert completed.status != "completed"
+    assert completed.steps[0].output["success"] is False
+    assert not Path(run.steps[0].params["execution_snapshot"]["body"]["output_path"]).exists()
