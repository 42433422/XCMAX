+def test_outer_timeout_removes_entered_leaf_and_its_private_input_copies(
+    employee_http, monkeypatch
+):
+    import tempfile
+    import threading
+    import time
+
+    import psutil
+
+    from app.application.agent_orchestrator import tool_process
+
+    original_execute, original_temp = tool_process.execute_isolated, tempfile.mkdtemp
+    created, entered = [], []
+    stop = threading.Event()
+
+    def bounded(executor, step, context, deadline):
+        return original_execute(executor, step, context, min(deadline, time.monotonic() + 5))
+
+    def track(*args, **kwargs):
+        folder = original_temp(*args, **kwargs)
+        if kwargs.get("prefix") == "xcagi-tool-":
+            created.append(Path(folder))
+        return folder
+
+    def observe():
