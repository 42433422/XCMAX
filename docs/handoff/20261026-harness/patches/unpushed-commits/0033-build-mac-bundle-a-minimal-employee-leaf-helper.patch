+def _actual_pack_call(
+    runtime,
+    packaged_runtime,
+    tmp_path,
+    monkeypatch,
+    record_property,
+    pack_id,
+    *,
+    source=None,
+    payload=None,
+):
+    """Portable pack/publication boundary; real caller approval is tested elsewhere."""
+    from app.application.agent_orchestrator.business_action_ledger import canonical_hash
+    from app.application.employee_runtime.leaf_action import _publish_outputs
+    from app.mod_sdk.employee_tool_registry import _office_output_paths
+
+    pack = Path(__file__).resolve().parents[1] / "mods/_employees" / pack_id
+    rules = json.loads((pack / "rule_spec.json").read_bytes())
+    manifest = json.loads((pack / "manifest.json").read_bytes())
+    module = manifest["employee_config_v2"]["actions"]["direct_python"]["module"]
+    workspace = tmp_path.resolve() / "trusted-workspace"
+    workspace.mkdir()
+    monkeypatch.setenv("WORKSPACE_ROOT", str(workspace))
+    primary = workspace / rules["default_output_relpath"]
+    reviewed = {
+        "code_sha256": canonical_hash(
+            {
+                p.relative_to(pack).as_posix(): hashlib.sha256(p.read_bytes()).hexdigest()
+                for p in pack.rglob("*")
+                if p.is_file()
+                and "__pycache__" not in p.parts
+                and not any(part.startswith(".") for part in p.relative_to(pack).parts)
+            }
+        ),
+        "inputs": []
+        if source is None
+        else [
+            {
+                "parameter": "file_path",
+                "path": str(source),
+                "sha256": hashlib.sha256(source.read_bytes()).hexdigest(),
+                "size_bytes": source.stat().st_size,
+            }
+        ],
+        "output_path": str(primary),
+        "workspace_root": str(workspace),
+        "output_kind": "artifacts",
+        "outputs": [{"path": str(primary), "before": None}],
+    }
+    stage = tmp_path.resolve() / "actual-pack-stage"
+    stage.mkdir(mode=0o700)
+    staged = leaf.stage_employee(pack, reviewed, dict(payload or {}), stage)
+    if runtime == "frozen":
+        selected = packaged_runtime["runtime"]
+        monkeypatch.setattr(leaf, "_runtime", lambda: selected)
+        sdk = _stage_frozen_sdk(packaged_runtime, stage)
+    else:
+        sdk = leaf.stage_sdk(stage)
+    result, audit = leaf.spawn_leaf(
+        {
+            "sdk_root": str(sdk),
+            "pack_root": str(stage / "pack"),
+            "workspace_root": str(stage / "work"),
+            "payload": staged,
+            "employee_id": pack_id,
+            "module": f"backend/employees/{module}.py",
+        },
+        stage,
+        deadline=time.monotonic() + 30,
+    )
+    assert result["ok"] is True
+    published, artifacts = _publish_outputs(stage, reviewed, result, deadline=time.monotonic() + 30)
+    assert str(stage) not in json.dumps(published)
+    paths = {artifact["path"] for artifact in artifacts}
+    claims = _office_output_paths(pack_id, {"result": {"outputs": [{"output": published}]}})
+    assert claims and set(claims).issubset(paths)
+    for artifact in artifacts:
+        target = Path(artifact["path"])
+        assert target.is_relative_to(workspace) and not target.is_symlink()
+        data = target.read_bytes()
+        assert hashlib.sha256(data).hexdigest() == artifact["sha256"]
+        assert len(data) == artifact["size_bytes"]
+    record_property("runtime", runtime)
+    record_property("profile_sha256", audit["profile_sha256"])
+    record_property("helper_sha256", hashlib.sha256(Path(audit["helper"]).read_bytes()).hexdigest())
+    record_property("frozen_candidate_sha256", packaged_runtime["helper_sha256"])
+    record_property("pack_code_sha256", reviewed["code_sha256"])
+    return primary, artifacts, workspace
+
