+def test_actual_ppt_reader_publishes_resolvable_image_references(
+    runtime, packaged_runtime, tmp_path, monkeypatch, record_property
+):
+    from PIL import Image
+    from pptx import Presentation
+
+    image_path = tmp_path / "approved-image.png"
+    Image.new("RGB", (32, 32), (34, 102, 170)).save(image_path)
+    image_sha = hashlib.sha256(image_path.read_bytes()).hexdigest()
+    presentation = Presentation()
+    slide = presentation.slides.add_slide(presentation.slide_layouts[6])
+    slide.shapes.add_textbox(0, 0, 3000000, 1000000).text = "asset-fixture"
+    slide.shapes.add_picture(str(image_path), 0, 1000000)
+    original = tmp_path / "approved.pptx"
+    presentation.save(original)
+    original_sha = hashlib.sha256(original.read_bytes()).hexdigest()
+    primary, artifacts, workspace = _actual_pack_call(
+        runtime,
+        packaged_runtime,
+        tmp_path,
+        monkeypatch,
+        record_property,
+        "ppt-full-read-employee",
+        source=original,
+    )
+    assert "asset-fixture" in primary.read_text()
+    owners = set()
+
+    def inspect(value, owner):
+        if isinstance(value, dict):
+            for key, item in value.items():
+                if key == "relpath" and isinstance(item, str) and item.endswith(".png"):
+                    assert not Path(item).is_absolute()
+                    target = owner.parent / item
+                    assert target.resolve().is_relative_to(workspace)
+                    assert hashlib.sha256(target.read_bytes()).hexdigest() == image_sha
+                    with Image.open(target) as image:
+                        image.verify()
+                    owners.add(owner.name)
+                inspect(item, owner)
+        elif isinstance(value, list):
+            for item in value:
+                inspect(item, owner)
+
+    for artifact in artifacts:
+        owner = Path(artifact["path"])
+        if owner.suffix == ".json":
+            inspect(json.loads(owner.read_bytes()), owner)
+    assert {"presentation_full.json", "images_index.json"}.issubset(owners)
+    assert hashlib.sha256(original.read_bytes()).hexdigest() == original_sha
