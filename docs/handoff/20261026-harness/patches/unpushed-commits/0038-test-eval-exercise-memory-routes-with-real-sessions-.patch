+@contextmanager
+def _authenticated_eval_host(task, folder, permissions, *, mod_id):
+    """Create actual isolated host credentials; dataset identity labels grant nothing."""
+    from datetime import timedelta
+    from uuid import uuid4
+
+    from sqlalchemy import create_engine
+    from sqlalchemy.orm import sessionmaker
+    from starlette.requests import Request
+
+    from app import db as host_db
+    from app.application.agent_orchestrator.run_sql_repository import SQLAlchemyAgentRunRepository
+    from app.application.agent_orchestrator.task_execution_sql_repository import (
+        SQLAlchemyTaskExecutionRepository,
+    )
+    from app.db.db_base import Base
+    from app.db.models.permission import Permission, Role
+    from app.db.models.user import Session as UserSession
+    from app.db.models.user import User
+    from app.domain.shared_services.session_service import SessionService
+    from app.fastapi_routes.domains.agent.route_support import authenticated_runtime_context
+    from app.infrastructure.auth.agent_principal import require_agent_principal
+    from app.utils.time import utc_now_naive
+
+    with ExitStack() as stack:
+        database_url = f"sqlite:///{folder / 'host.sqlite'}"
+        stack.enter_context(
+            patch.dict(
+                os.environ,
+                {
+                    "DATABASE_URL": database_url,
+                    "WORKSPACE_ROOT": str(folder / "workspace"),
+                    "XCAGI_DATA_DIR": str(folder / "data"),
+                    "XCAGI_DESKTOP_DATA_DIR": str(folder / "data"),
+                    "SECRET_KEY": "synthetic-offline-eval-host-key-only",
+                    "FHD_ALLOW_X_USER_ID_HEADER": "",
+                    "MODEL_USAGE_LEDGER_PATH": str(folder / "usage.json"),
+                    "MODEL_USAGE_WALLET_BACKEND": "audit",
+                    "MODEL_USAGE_WALLET_REQUIRED": "",
+                },
+                clear=False,
+            )
+        )
+        engine = create_engine(database_url)
+        stack.callback(engine.dispose)
+        Base.metadata.create_all(engine)
+        factory = sessionmaker(bind=engine)
+        stack.enter_context(patch.object(host_db, "HostSessionLocal", factory))
+        stack.enter_context(
+            patch("app.application.facades.session_facade.get_session_service", SessionService)
+        )
+        repo = SQLAlchemyAgentRunRepository(session_factory=factory, auto_create=False)
+        queue = SQLAlchemyTaskExecutionRepository(session_factory=factory, auto_create=False)
+        stack.enter_context(
+            patch("app.application.agent_orchestrator.run_repository._agent_run_repository", repo)
+        )
+        stack.enter_context(
+            patch(
+                "app.application.agent_orchestrator.task_execution_repository._task_execution_repository",
+                queue,
+            )
+        )
+        stack.enter_context(
+            patch("app.fastapi_routes.domains.agent.agent_routes.notify_agent_task_dispatcher")
+        )
+        session_id = uuid4().hex
+        with factory.begin() as db:
+            role = Role(name="user")
+            role.permissions = [Permission(code=code, name=code) for code in permissions]
+            db.add(role)
+            user = User(
+                username=str(task.get("user_id") or "offline-eval"),
+                password="unused",
+                tenant_id=7,
+                role="user",
+                tier="enterprise",
+            )
+            db.add(user)
+            db.flush()
+            db.add(
+                UserSession(
+                    session_id=session_id,
+                    user_id=user.id,
+                    expires_at=utc_now_naive() + timedelta(hours=1),
+                    entitled_mod_ids_json=json.dumps([mod_id]),
+                )
+            )
+        headers = {"X-Session-ID": session_id, "X-XCAGI-Active-Mod-Id": mod_id}
+        principal = require_agent_principal(
+            Request(
+                {
+                    "type": "http",
+                    "method": "POST",
+                    "path": "/api/agent/runs",
+                    "headers": [(k.lower().encode(), v.encode()) for k, v in headers.items()],
+                }
+            ),
+            x_user_id=None,
+        )
+        yield SimpleNamespace(
+            factory=factory,
+            repo=repo,
+            queue=queue,
+            principal=principal,
+            context=authenticated_runtime_context({}, principal),
+            headers=headers,
+        )
+
