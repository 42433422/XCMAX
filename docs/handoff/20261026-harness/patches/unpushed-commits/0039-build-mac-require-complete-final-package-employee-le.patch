+
+def test_original_evidence_is_bound_to_all_files_and_source(candidate):
+    _, archive, dmg, evidence, proof = candidate
+    result = gate.verify_candidate_evidence(
+        archive,
+        dmg,
+        evidence,
+        sha="a" * 40,
+        version="1.0.0.6",
+        arch="arm64",
+        run={"id": 11, "run_attempt": 1},
+    )
+    assert result["proof_sha256"] == gate.file_digest(evidence / "employee-leaf.json")
+    assert result["bundle_sha256"] == proof["bundle"]["sha256"]
+    assert result["helper_sha256"] == proof["bundle"]["helper_sha256"]
+
+
+@pytest.mark.parametrize(
+    "fault",
+    [
+        "failure",
+        "error",
+        "skipped",
+        "partial",
+        "duplicate",
+        "class",
+        "file",
+        "profile",
+        "candidate",
+        "sdk",
+        "properties",
+    ],
+)
+def test_success_exit_or_edited_counters_cannot_hide_bad_junit(candidate, fault):
+    _, _, _, _, proof = candidate
+    root = ET.fromstring(_junit(proof["bundle"]))
+    suite = root.find("testsuite")
+    case = suite.find("testcase")
+    if fault in {"failure", "error", "skipped"}:
+        ET.SubElement(case, fault)
+    elif fault == "partial":
+        suite.remove(case)
+    elif fault == "duplicate":
+        suite.append(ET.fromstring(ET.tostring(case)))
+    elif fault in {"class", "file"}:
+        case.set("classname" if fault == "class" else "file", "other_test.py")
+    else:
+        properties = case.find("properties")
+        name = {
+            "profile": "profile_sha256",
+            "candidate": "frozen_helper_sha256",
+            "sdk": "frozen_sdk_sha256",
+            "properties": "profile_sha256",
+        }[fault]
+        field = next(p for p in properties if p.get("name") == name)
+        if fault == "properties":
+            properties.append(ET.fromstring(ET.tostring(field)))
+        else:
+            field.set("value", "{}" if fault == "sdk" else "wrong")
+    with pytest.raises(ValueError):
+        gate.junit_summary(ET.tostring(root), proof["bundle"])
+
+
+@pytest.mark.parametrize(
+    "fault",
+    [
+        "attempt",
+        "run_bool",
+        "adhoc",
+        "team",
+        "runtime",
