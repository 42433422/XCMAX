@@ -0,0 +1,649 @@
+"""Evidence/parser contracts use synthetic Mach-O headers, never signing receipts."""
+
+import hashlib
+import json
+import os
+import plistlib
+import runpy
+import stat
+import struct
+import subprocess
+import sys
+import xml.etree.ElementTree as ET
+import zipfile
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from scripts.package import verify_employee_leaf_evidence as gate
+
+
+def _junit(bundle):
+    root = ET.Element("testsuites")
+    suite = ET.SubElement(root, "testsuite")
+    for name in sorted(gate.EXPECTED_CASES):
+        case = ET.SubElement(
+            suite,
+            "testcase",
+            name=name,
+            classname="tests.test_packaged_employee_leaf",
+            file=gate.TEST_FILE,
+        )
+        properties = ET.SubElement(case, "properties")
+        for key, value in {
+            "frozen_helper_sha256": bundle["helper_sha256"],
+            "frozen_sdk_sha256": json.dumps(bundle["sdk"]),
+            "profile_sha256": "f" * 64,
+        }.items():
+            ET.SubElement(properties, "property", name=key, value=value)
+    return ET.tostring(root)
+
+
+@pytest.fixture
+def candidate(tmp_path):
+    bundle = tmp_path / "XCAGI.app/Contents/Resources/backend/employee-leaf"
+    files = {name: (gate.ROOT / source).read_bytes() for name, source in gate.SDK_SOURCES.items()}
+    for name, content in files.items():
+        path = bundle / "_internal/leaf_sdk" / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_bytes(content)
+        path.chmod(0o644)
+    for name in (gate.HELPER, "_internal/libpython3.11.dylib"):
+        path = bundle / name
+        path.write_bytes(struct.pack("<II", 0xFEEDFACF, 0x100000C) + b"SYNTHETIC UNIT HEADER")
+        path.chmod(0o755)
+    archive = tmp_path / "candidate.zip"
+    with zipfile.ZipFile(archive, "w") as package:
+        for path in bundle.rglob("*"):
+            if path.is_file():
+                package.write(path, gate.PREFIX + path.relative_to(bundle).as_posix())
+    dmg = tmp_path / "candidate.dmg"
+    dmg.write_bytes(b"SYNTHETIC UNIT DMG, not signed")
+    evidence = tmp_path / "acceptance-evidence"
+    evidence.mkdir()
+    snapshot = gate.snapshot_directory(bundle, "arm64")
+    assert snapshot == gate.snapshot_zip(archive, "arm64")
+    junit = _junit(snapshot)
+    (evidence / "employee-leaf-junit.xml").write_bytes(junit)
+    (evidence / "employee-leaf.log").write_text(
+        "Synthetic proof unit fixture; no runtime/signing PASS"
+    )
+    proof = {
+        "schema": gate.SCHEMA,
+        "source_sha": "a" * 40,
+        "version": "1.0.0.6",
+        "architecture": "arm64",
+        "run_id": 11,
+        "run_attempt": 1,
+        "job": "macos-ota",
+        "os_build": "25.3.0",
+        "source_hashes": gate.source_hashes(),
+        "dmg": gate._payload(dmg),
+        "archive": gate._payload(archive),
+        "bundle": snapshot,
+        "signature": {
+            "team_id": gate.TEAM,
+            "adhoc": False,
+            "hardened_runtime": True,
+            "entitlements": plistlib.loads(
+                (gate.ROOT / "desktop/build/entitlements.mac.plist").read_bytes()
+            ),
+        },
+        "pytest": gate.junit_summary(junit, snapshot),
+        "junit_sha256": gate.file_digest(evidence / "employee-leaf-junit.xml"),
+        "log_sha256": gate.file_digest(evidence / "employee-leaf.log"),
+    }
+    (evidence / "employee-leaf.json").write_text(json.dumps(proof))
+    return bundle, archive, dmg, evidence, proof
