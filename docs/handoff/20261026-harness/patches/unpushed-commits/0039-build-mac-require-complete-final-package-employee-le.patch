diff --git a/FHD/scripts/package/verify_employee_leaf_evidence.py b/FHD/scripts/package/verify_employee_leaf_evidence.py
new file mode 100644
index 0000000000..7c72a15afc
--- /dev/null
+++ b/FHD/scripts/package/verify_employee_leaf_evidence.py
@@ -0,0 +1,564 @@
+"""Produce native final-package leaf evidence and verify it during frozen promotion."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import platform
+import plistlib
+import re
+import stat
+import struct
+import subprocess
+import sys
+import xml.etree.ElementTree as ET
+import zipfile
+from pathlib import Path, PurePosixPath
+
+ROOT = Path(__file__).resolve().parents[2]
+SCHEMA = "employee-leaf-validation/v1"
+TEAM = "G26WSH472M"
+TEST_FILE = "tests/test_packaged_employee_leaf.py"
+PREFIX = "XCAGI.app/Contents/Resources/backend/employee-leaf/"
+PREFIX_ANCESTORS = {
+    str(path)
+    for path in (PurePosixPath(PREFIX), *PurePosixPath(PREFIX).parents)
+    if str(path) != "."
+}
+PREFIX_ANCESTORS_CASEFOLD = {name.casefold() for name in PREFIX_ANCESTORS}
+HELPER = "xcagi-employee-leaf"
+FRAMEWORK_BINARY = "_internal/Python.framework/Versions/3.11/Python"
+FRAMEWORK_LINKS = {
+    "_internal/Python": "Python.framework/Versions/3.11/Python",
+    "_internal/Python.framework/Python": "Versions/Current/Python",
+    "_internal/Python.framework/Resources": "Versions/Current/Resources",
+    "_internal/Python.framework/Versions/Current": "3.11",
+}
+SDK_SOURCES = {
+    "app/mod_sdk/office_employee_worker.py": "app/mod_sdk/office_employee_worker.py",
+    "app/mod_sdk/generated_employee_worker.py": "app/mod_sdk/generated_employee_worker.py",
+    "app/mod_sdk/host_services.py": "app/application/office_plaintext_generate.py",
+    "app/application/agent_orchestrator/tool_receipt.py": "app/application/agent_orchestrator/tool_receipt.py",
+}
+SOURCE_FILES = (
+    TEST_FILE,
+    "scripts/package/verify_employee_leaf_evidence.py",
+    "app/mod_sdk/employee_leaf.py",
+    "app/application/employee_runtime/leaf_process.py",
+    "desktop/build/entitlements.mac.plist",
+    *dict.fromkeys(SDK_SOURCES.values()),
+)
+EXPECTED_CASES = frozenset(
+    [
+        "test_frozen_helper_imports_only_bundled_portable_sdk",
+        "test_frozen_helper_denies_host_files_native_reads_network_and_children",
+        "test_frozen_helper_model_broker_keeps_host_credentials_outside_leaf",
+        "test_frozen_helper_deadline_reaps_entered_worker_and_removes_canary",
+        "test_frozen_helper_discards_worker_exception_and_printed_secret",
+        "test_frozen_sdk_staging_reads_bundle_without_host_source",
+    ]
+    + [
+        f"test_frozen_helper_writes_readable_csv_and_json_from_pinned_input[{s}]"
+        for s in ("csv", "json")
+    ]
+    + [
+        f"test_frozen_helper_office_dependencies_produce_reopenable_documents[{s}]"
+        for s in ("docx", "xlsx", "pdf", "pptx")
+    ]
+    + [
+        f"test_actual_{name}[{runtime}]"
+        for name in (
+            "excel_natural_language_retains_approved_rows",
+            "ppt_reader_publishes_resolvable_image_references",
+        )
+        for runtime in ("source", "frozen")
+    ]
+)
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
+
+
+def _unique(pairs):
+    result = dict(pairs)
+    if len(result) != len(pairs):
+        raise ValueError("duplicate evidence key")
+    return result
+
+
+def _json(data):
+    def invalid(_):
+        raise ValueError("non-finite evidence")
+
+    return json.loads(data, object_pairs_hook=_unique, parse_constant=invalid)
+
+
+def file_digest(path, algorithm="sha256"):
+    path = Path(path)
+    before = path.lstat()
+    if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
+        raise ValueError("evidence file must be plain and unlinked")
+    digest = hashlib.new(algorithm)
+    with path.open("rb") as stream:
+        identity = lambda info: (
+            info.st_dev,
+            info.st_ino,
+            info.st_size,
+            info.st_mtime_ns,
+            info.st_ctime_ns,
+            info.st_mode,
+            info.st_nlink,
+        )
+        if identity(os.fstat(stream.fileno())) != identity(before):
+            raise ValueError("evidence file changed before read")
+        for chunk in iter(lambda: stream.read(1 << 20), b""):
+            digest.update(chunk)
+        if identity(os.fstat(stream.fileno())) != identity(before) or identity(
+            path.lstat()
+        ) != identity(before):
+            raise ValueError("evidence file changed during read")
+    return digest.hexdigest()
+
+
+def source_hashes():
+    return {name: file_digest(ROOT / name) for name in SOURCE_FILES}
+
+
+def _bundle(records, arch):
+    if arch not in {"arm64", "x64"}:
+        raise ValueError("native architecture required")
+    rows, native = [], []
+    for name, data, mode in records:
+        if len(data) > 64 * 1024 * 1024:
+            raise ValueError("helper file too large")
+        row = {
+            "path": name,
+            "sha256": hashlib.sha256(data).hexdigest(),
+            "size": len(data),
+            "mode": stat.S_IMODE(mode),
+        }
+        rows.append(row)
+        if stat.S_ISLNK(mode):
+            target = data.decode("utf-8")
+            if FRAMEWORK_LINKS.get(name) != target:
+                raise ValueError("unexpected helper symbolic link")
+            row["type"] = "symlink"
+            row["link"] = target
+            continue
+        if data[:4] == b"\xcf\xfa\xed\xfe" or name.endswith((".dylib", ".so")) or name == HELPER:
+            if len(data) < 8 or struct.unpack("<II", data[:8]) != (
+                0xFEEDFACF,
+                {"arm64": 0x100000C, "x64": 0x1000007}[arch],
+            ):
+                raise ValueError("helper native architecture mismatch")
+            native.append(name)
+    rows.sort(key=lambda item: item["path"])
+    by_name = {item["path"]: item for item in rows}
+    if (
+        len(by_name) != len(rows)
+        or HELPER not in native
+        or len({"_internal/libpython3.11.dylib", FRAMEWORK_BINARY} & set(native)) != 1
+    ):
+        raise ValueError("incomplete or duplicate helper bundle")
+    links = {row["path"]: row["link"] for row in rows if "link" in row}
+    if FRAMEWORK_BINARY in native:
+        if links != FRAMEWORK_LINKS or (
+            "_internal/Python.framework/Versions/3.11/Resources/Info.plist" not in by_name
+        ):
+            raise ValueError("incomplete Python framework")
+    elif links:
+        raise ValueError("framework links require the actual framework binary")
+    if any(str(parent) in by_name for name in by_name for parent in PurePosixPath(name).parents):
+        raise ValueError("helper file aliases a file or symbolic link")
+    if len(rows) > 10000 or sum(r["size"] for r in rows) > 512 * 1024 * 1024:
+        raise ValueError("helper bundle limit")
+    sdk = {name: by_name[f"_internal/leaf_sdk/{name}"]["sha256"] for name in SDK_SOURCES}
+    if sdk != {name: file_digest(ROOT / source) for name, source in SDK_SOURCES.items()}:
+        raise ValueError("helper SDK does not match reviewed source")
+    if not by_name[HELPER]["mode"] & 0o111:
+        raise ValueError("helper is not executable")
+    return {
+        "files": rows,
+        "sha256": hashlib.sha256(canonical(rows)).hexdigest(),
+        "helper_sha256": by_name[HELPER]["sha256"],
+        "sdk": sdk,
+        "native_paths": sorted(native),
+    }
+
+
+def snapshot_directory(bundle, arch):
+    if not stat.S_ISDIR(bundle.lstat().st_mode):
+        raise ValueError("helper bundle root must be a real directory")
+    records, total = [], 0
+    for path in sorted(bundle.rglob("*")):
+        mode = path.lstat().st_mode
+        if stat.S_ISDIR(mode):
+            continue
+        name = path.relative_to(bundle).as_posix()
+        if stat.S_ISLNK(mode):
+            target = os.readlink(path)
+            if FRAMEWORK_LINKS.get(name) != target:
+                raise ValueError("unexpected helper symbolic link")
+            records.append((name, target.encode(), mode))
+            continue
+        if not stat.S_ISREG(mode) or path.stat().st_nlink != 1:
+            raise ValueError("helper bundle contains links or special files")
+        total += path.stat().st_size
+        if (
+            path.stat().st_size > 64 * 1024 * 1024
+            or total > 512 * 1024 * 1024
+            or len(records) >= 10000
+        ):
+            raise ValueError("helper bundle limit")
+        digest = file_digest(path)
+        data = path.read_bytes()
+        if hashlib.sha256(data).hexdigest() != digest:
+            raise ValueError("helper bundle changed")
+        records.append((name, data, mode))
+    return _bundle(records, arch)
+
+
+def snapshot_zip(archive, arch):
+    records, directories, total = [], [], 0
+    with zipfile.ZipFile(archive) as package:
+        names = package.namelist()
+        if len(names) != len(set(names)):
+            raise ValueError("duplicate application members")
+        for item in package.infolist():
+            path = PurePosixPath(item.filename)
+            if (
+                path.is_absolute()
+                or ".." in path.parts
+                or "\\" in item.filename
+                or str(path) + ("/" if item.is_dir() else "") != item.filename
+            ):
+                raise ValueError("unsafe application members")
+            mode = item.external_attr >> 16
+            if (
+                str(path).casefold() in PREFIX_ANCESTORS_CASEFOLD
+                and str(path) not in PREFIX_ANCESTORS
+            ) or (
+                item.filename.casefold().startswith(PREFIX.casefold())
+                and not item.filename.startswith(PREFIX)
+            ):
+                raise ValueError("noncanonical helper prefix")
+            if str(path) in PREFIX_ANCESTORS:
+                if (
+                    not item.is_dir()
+                    or stat.S_IFMT(mode) not in (0, stat.S_IFDIR)
+                    or item.file_size
+                ):
+                    raise ValueError("helper ancestor must be a plain empty directory entry")
+                continue
+            if not item.filename.startswith(PREFIX):
+                continue
+            if item.is_dir():
+                if stat.S_IFMT(mode) not in (0, stat.S_IFDIR) or item.file_size:
+                    raise ValueError("helper directory member has unexpected type or data")
+                directories.append(PurePosixPath(item.filename[len(PREFIX) :]))
+                continue
+            if stat.S_IFMT(mode) not in (0, stat.S_IFREG, stat.S_IFLNK):
+                raise ValueError("special helper archive member")
+            if stat.S_ISLNK(mode) and (
+                item.filename[len(PREFIX) :] not in FRAMEWORK_LINKS or item.file_size > 128
+            ):
+                raise ValueError("unexpected helper symbolic link")
+            if item.file_size > 64 * 1024 * 1024:
+                raise ValueError("helper file too large")
+            total += item.file_size
+            if total > 512 * 1024 * 1024 or len(records) >= 10000:
+                raise ValueError("helper bundle limit")
+            records.append((item.filename[len(PREFIX) :], package.read(item), mode))
+    snapshot = _bundle(records, arch)
+    names = {row["path"] for row in snapshot["files"]}
+    if any(
+        str(path) in names for directory in directories for path in (directory, *directory.parents)
+    ):
+        raise ValueError("helper directory aliases a file or symbolic link")
+    return snapshot
+
+
+def junit_summary(data, bundle):
+    root = ET.fromstring(data)
+    cases = root.findall(".//testcase")
+    if root.findall(".//failure") or root.findall(".//error") or root.findall(".//skipped"):
+        raise ValueError("leaf suite contains a failure or skip")
+    names = [case.get("name") for case in cases]
+    if len(names) != 16 or set(names) != EXPECTED_CASES:
+        raise ValueError("complete leaf16 suite required")
+    profiles = {}
+    for case in cases:
+        if (
+            case.get("classname") != "tests.test_packaged_employee_leaf"
+            or case.get("file") != TEST_FILE
+        ):
+            raise ValueError("unexpected leaf test source")
+        properties = _unique(
+            [(p.attrib["name"], p.attrib["value"]) for p in case.findall("./properties/property")]
+        )
+        candidate = properties.get(
+            "frozen_helper_sha256", properties.get("frozen_candidate_sha256")
+        )
+        if candidate != bundle["helper_sha256"]:
+            raise ValueError("tests did not execute this candidate helper")
+        if (
+            "frozen_sdk_sha256" in properties
+            and _json(properties["frozen_sdk_sha256"]) != bundle["sdk"]
+        ):
+            raise ValueError("tested SDK differs from candidate")
+        if case.get("name") != "test_frozen_sdk_staging_reads_bundle_without_host_source":
+            profile = properties.get("profile_sha256", "")
+            if not re.fullmatch(r"[0-9a-f]{64}", profile):
+                raise ValueError("actual sandbox profile evidence required")
+            profiles[case.get("name")] = profile
+    return {
+        "collected": 16,
+        "passed": 16,
+        "failed": 0,
+        "errors": 0,
+        "skipped": 0,
+        "cases": sorted(names),
+        "profiles": profiles,
+    }
+
+
+def _entitlements(value):
+    expected = plistlib.loads((ROOT / "desktop/build/entitlements.mac.plist").read_bytes())
+    extra = set(value) - set(expected)
+    if any(value.get(key) != item for key, item in expected.items()) or extra - {
+        "com.apple.application-identifier",
+        "com.apple.developer.team-identifier",
+    }:
+        raise ValueError("helper entitlements differ from release policy")
+    if (
+        "com.apple.developer.team-identifier" in extra
+        and value["com.apple.developer.team-identifier"] != TEAM
+    ):
+        raise ValueError("helper entitlement team mismatch")
+    if "com.apple.application-identifier" in extra and not str(
+        value["com.apple.application-identifier"]
+    ).startswith(TEAM + "."):
+        raise ValueError("helper application identity mismatch")
+
+
+def _signatures(bundle, snapshot):
+    for name in snapshot["native_paths"]:
+        target = str(bundle / name)
+        subprocess.run(
+            ["codesign", "--verify", "--strict", target], check=True, capture_output=True
+        )
+        result = subprocess.run(
+            ["codesign", "-dv", "--verbose=4", target], check=True, capture_output=True, text=True
+        )
+        display = result.stdout + result.stderr
+        if (
+            "Signature=adhoc" in display
+            or f"TeamIdentifier={TEAM}" not in display
+            or not re.search(r"flags=.*\([^\n]*runtime", display)
+        ):
+            raise ValueError("Developer ID hardened helper signature required")
+    result = subprocess.run(
+        ["codesign", "-d", "--entitlements", ":-", str(bundle / HELPER)],
+        check=True,
+        capture_output=True,
+    )
+    entitlements = plistlib.loads(result.stdout)
+    _entitlements(entitlements)
+    return {"team_id": TEAM, "adhoc": False, "hardened_runtime": True, "entitlements": entitlements}
+
+
+def _payload(path):
+    return {"name": path.name, "sha256": file_digest(path), "size": path.stat().st_size}
+
+
+def verify_candidate_evidence(archive, dmg, evidence_dir, *, sha, version, arch, run):
+    try:
+        proof_path = evidence_dir / "employee-leaf.json"
+        proof = _json(proof_path.read_bytes())
+        bundle = snapshot_zip(archive, arch)
+        junit = evidence_dir / "employee-leaf-junit.xml"
+        log = evidence_dir / "employee-leaf.log"
+        expected = {
+            "schema": SCHEMA,
+            "source_sha": sha,
+            "version": version,
+            "architecture": arch,
+            "run_id": run["id"],
+            "run_attempt": run["run_attempt"],
+            "job": "macos-ota",
+            "source_hashes": source_hashes(),
+            "dmg": _payload(dmg),
+            "archive": _payload(archive),
+            "bundle": bundle,
+            "pytest": junit_summary(junit.read_bytes(), bundle),
+            "junit_sha256": file_digest(junit),
+            "log_sha256": file_digest(log),
+        }
+        if (
+            type(run["id"]) is not int
+            or type(run["run_attempt"]) is not int
+            or min(run["id"], run["run_attempt"]) < 1
+        ):
+            raise ValueError("actual Actions run identity required")
+        if any(canonical(proof.get(key)) != canonical(value) for key, value in expected.items()):
+            raise ValueError("leaf evidence does not match original candidate")
+        signature = proof["signature"]
+        if (
+            signature.get("team_id") != TEAM
+            or signature.get("adhoc") is not False
+            or signature.get("hardened_runtime") is not True
+        ):
+            raise ValueError("final helper signature evidence missing")
+        _entitlements(signature["entitlements"])
+        if not re.fullmatch(r"\d+(?:\.\d+)+", proof["os_build"]):
+            raise ValueError("native OS evidence required")
+        return {
+            "proof_sha256": file_digest(proof_path),
+            "junit_sha256": file_digest(junit),
+            "bundle_sha256": bundle["sha256"],
+            "helper_sha256": bundle["helper_sha256"],
+        }
+    except (KeyError, TypeError, OSError, ET.ParseError, zipfile.BadZipFile) as error:
+        raise ValueError("complete original leaf evidence required") from error
+
+
+def _mounted_bundle(app):
+    path = app
+    try:
+        for part in ("", *PurePosixPath(PREFIX).parts[1:]):
+            path = path / part
+            if not stat.S_ISDIR(path.lstat().st_mode):
+                raise ValueError("mounted helper ancestors must be real directories")
+    except OSError as error:
+        raise ValueError("mounted helper ancestors must be real directories") from error
+    return path
+
+
+def produce(app, dmg, archive, evidence_dir, *, sha, version, arch):
+    if (
+        sys.platform != "darwin"
+        or {"arm64": "arm64", "x86_64": "x64"}.get(platform.machine()) != arch
+    ):
+        raise ValueError("native macOS runner required")
+    if (
+        subprocess.check_output(["git", "-C", str(ROOT), "rev-parse", "HEAD"], text=True).strip()
+        != sha
+    ):
+        raise ValueError("leaf test source must match release SHA")
+    run_id, attempt = os.environ["GITHUB_RUN_ID"], os.environ["GITHUB_RUN_ATTEMPT"]
+    if (
+        not run_id.isdecimal()
+        or not attempt.isdecimal()
+        or min(int(run_id), int(attempt)) < 1
+        or os.environ.get("GITHUB_JOB") not in {"macos-ota", "macos"}
+    ):
+        raise ValueError("actual candidate Actions job required")
+    bundle = _mounted_bundle(app)
+    info = _json((app / "Contents/Resources/build-info.json").read_bytes())
+    if info.get("gitSha") != sha or info.get("version") != version:
+        raise ValueError("mounted app identity mismatch")
+    snapshot = snapshot_directory(bundle, arch)
+    if snapshot != snapshot_zip(archive, arch):
+        raise ValueError("DMG and updater ZIP helpers differ")
+    signature = _signatures(bundle, snapshot)
+    sources, dmg_record, archive_record = source_hashes(), _payload(dmg), _payload(archive)
+    evidence_dir.mkdir(parents=True, exist_ok=True)
+    proof_path = evidence_dir / "employee-leaf.json"
+    junit, log = evidence_dir / "employee-leaf-junit.xml", evidence_dir / "employee-leaf.log"
+    if any(path.exists() or path.is_symlink() for path in (proof_path, junit, log)):
+        raise ValueError("leaf evidence destination must be fresh")
+    env = {
+        key: value
+        for key, value in os.environ.items()
+        if key in {"HOME", "PATH", "TMPDIR", "LANG", "LC_ALL"}
+    }
+    packages = [
+        "xcagi_langgraph_core",
+        "xcagi_langgraph_checkpoint",
+        "xcagi_langgraph_prebuilt",
+        "xcagi_langgraph_sdk",
+        "xcagi_langgraph_checkpoint_backends/checkpoint-sqlite",
+        "xcagi_langgraph_checkpoint_backends/checkpoint-postgres",
+    ]
+    env.update(
+        XCAGI_TEST_EMPLOYEE_LEAF=str(bundle / HELPER),
+        PYTHONPATH=os.pathsep.join(
+            [str(ROOT), *(str(ROOT / "packages" / name) for name in packages)]
+        ),
+        PYTHONDONTWRITEBYTECODE="1",
+        PYTEST_DISABLE_PLUGIN_AUTOLOAD="1",
+    )
+    command = [
+        sys.executable,
+        "-m",
+        "pytest",
+        "-p",
+        "pytest_asyncio.plugin",
+        "--import-mode=importlib",
+        "-oaddopts=",
+        "-o",
+        "junit_family=xunit1",
+        "-q",
+        TEST_FILE,
+        "--junitxml=" + str(junit),
+    ]
+    with log.open("xb") as stream:
+        subprocess.run(
+            command,
+            cwd=ROOT,
+            env=env,
+            stdout=stream,
+            stderr=subprocess.STDOUT,
+            check=True,
+            timeout=180,
+        )
+    summary = junit_summary(junit.read_bytes(), snapshot)
+    if (
+        sources != source_hashes()
+        or dmg_record != _payload(dmg)
+        or archive_record != _payload(archive)
+        or snapshot != snapshot_directory(_mounted_bundle(app), arch)
+    ):
+        raise ValueError("tested source or package changed")
+    proof = {
+        "schema": SCHEMA,
+        "source_sha": sha,
+        "version": version,
+        "architecture": arch,
+        "run_id": int(run_id),
+        "run_attempt": int(attempt),
+        "job": os.environ["GITHUB_JOB"],
+        "os_build": os.uname().release,
+        "source_hashes": sources,
+        "dmg": dmg_record,
+        "archive": archive_record,
+        "bundle": snapshot,
+        "signature": signature,
+        "pytest": summary,
+        "junit_sha256": file_digest(junit),
+        "log_sha256": file_digest(log),
+    }
+    with proof_path.open("x") as stream:
+        stream.write(json.dumps(proof, indent=2) + "\n")
+    return proof
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    for name in ("app", "dmg", "archive", "evidence-dir"):
+        parser.add_argument("--" + name, type=Path, required=True)
+    for name in ("sha", "version", "arch"):
+        parser.add_argument("--" + name, required=True)
+    args = parser.parse_args()
+    produce(
+        args.app.absolute(),
+        args.dmg.resolve(),
+        args.archive.resolve(),
+        args.evidence_dir.resolve(),
+        sha=args.sha,
+        version=args.version,
+        arch=args.arch,
+    )
