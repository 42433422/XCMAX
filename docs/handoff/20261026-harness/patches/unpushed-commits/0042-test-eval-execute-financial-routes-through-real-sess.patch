+@pytest.mark.parametrize(
+    "action", ["create_transaction", "update_transaction", "delete_transaction"]
+)
+def test_finance_route_eval_uses_original_approval_and_actual_tenant_sql(tmp_path, action):
+    from app import db as host_db
+    from app.db import session as db_session
+    from app.infrastructure.db import sync_engine
+
+    original = (host_db.HostSessionLocal, db_session.SessionLocal, sync_engine._engine)
+    task = next(
+        row
+        for row in eval_module.load_tasks()
+        if row["kind"] == "finance_route_agent" and row["route_action"] == action
+    )
+    path = tmp_path / "finance.jsonl"
+    path.write_text(json.dumps(task, ensure_ascii=False) + "\n", encoding="utf-8")
+    result = run_eval(path)
+    item = result["results"][0]
+    assert result["passed"] == 1 and result["failed"] == 0, item
+    details = item["details"]
+    assert details["execution_mode"] == "actual_host_session_sqlite_and_original_approval"
+    assert details["real_model_calls"] == 0
+    assert details["initial_response"]["success"] is False
+    assert details["initial_response"]["agent_status"] == "waiting_user"
+    assert details["run"]["run_id"] == details["initial_response"]["run_id"]
+    assert details["run"]["user_id"] == details["principal_user_id"] != task["user_id"]
+    assert details["run"]["status"] == "completed"
+    assert details["approval_consumption_count"] == 1 and details["step_params_unchanged"] is True
+    assert details["response"]["business_verification"]["verified"] is True
+    before, after = details["readback_before"], details["readback_after"]
+    assert [row for row in after if row["tenant_id"] == 8] == [
+        row for row in before if row["tenant_id"] == 8
+    ]
+    assert len([row for row in after if row["tenant_id"] == 7]) == (
+        0 if action == "delete_transaction" else 1
+    )
+    assert (host_db.HostSessionLocal, db_session.SessionLocal, sync_engine._engine) == original
