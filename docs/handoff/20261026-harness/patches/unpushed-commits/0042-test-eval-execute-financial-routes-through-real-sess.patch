+def test_sql_eval_host_restores_database_bindings_after_exception(tmp_path):
+    import os
+
+    from app import db as host_db
+    from app.db import session as db_session
+    from app.infrastructure.db import sync_engine
+
+    names = ("_engine", "_bound_engine_url", "_read_engine", "_bound_read_engine_url")
+    original = (host_db.HostSessionLocal, db_session.SessionLocal)
+    engines = tuple(getattr(sync_engine, name) for name in names)
+    environment = dict(os.environ)
+    with pytest.raises(RuntimeError, match="fixture restoration probe"):
+        with eval_module._sql_eval_host({}, tmp_path, ("tool.finance.create_transaction",)) as host:
