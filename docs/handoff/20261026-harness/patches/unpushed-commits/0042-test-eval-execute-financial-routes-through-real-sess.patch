+@contextmanager
+def _sql_eval_host(task, folder, permissions):
+    """Bind ORM/raw SQL to one actual isolated database and restore every binding."""
+    from app.db import session as db_session
+    from app.infrastructure.db import sync_engine
+
+    with ExitStack() as stack:
+        host = stack.enter_context(
+            _authenticated_eval_host(task, folder, permissions, mod_id="sql-eval")
+        )
+        with host.factory() as db:
+            engine = db.get_bind()
+        stack.enter_context(
+            patch.dict(
+                os.environ,
+                {
+                    "XCAGI_DESKTOP_MODE": "0",
+                    "XCAGI_MOD_DATABASE_URLS": json.dumps({"sql-eval": str(engine.url)}),
+                    "XCAGI_NEURO_INTENT": "0",
+                },
+                clear=False,
+            )
+        )
+        stack.enter_context(patch.object(db_session, "SessionLocal", host.factory))
+        for name, value in (
+            ("_engine", engine),
+            ("_bound_engine_url", str(engine.url)),
+            ("_read_engine", engine),
+            ("_bound_read_engine_url", str(engine.url)),
+        ):
+            stack.enter_context(patch.object(sync_engine, name, value))
+        (folder / "workspace").mkdir(exist_ok=True)
+        yield host
+
+
+def _continue_eval_sql_route(host, client, response, checks):
+    """Consume the original HTTP grant and execute its original SQL queue row."""
+    from app.application.agent_orchestrator import AgentOrchestrator
+    from app.application.agent_orchestrator.run_sql_repository import SQLAlchemyAgentRunRepository
+    from app.db.models.agent_approval import AgentApprovalConsumption
+    from app.fastapi_routes.domains.agent.route_support import agent_node_output
+
+    initial = response.json()
+    run_id = str(initial.get("run_id") or initial.get("agent_run_id") or "")
+    run = host.repo.get(run_id) if run_id else None
+    _check_equal(checks, "initial.success", initial.get("success"), False)
+    _check_equal(checks, "initial.run_status", run.status if run else None, "waiting_user")
+    _check_equal(checks, "initial.tool_call_count", len(run.tool_calls) if run else None, 0)
+    if run is None or run.status != "waiting_user" or len(run.steps) != 1:
+        return initial, run, {}
+    step_id, params = run.steps[0].step_id, copy.deepcopy(run.steps[0].params)
+    review = client.get(f"/api/agent/runs/{run_id}")
+    _check_equal(checks, "review.status_code", review.status_code, 200)
+    grant = review.json().get("approval", {}).get("grant")
+    _check_equal(checks, "review.grant_present", bool(grant), True)
+    if review.status_code != 200 or not grant:
+        return initial, run, {}
+    accepted = client.post(f"/api/agent/runs/{run_id}/continue", json={"approval_grant": grant})
+    _check_equal(checks, "continue.status_code", accepted.status_code, 202)
+    if accepted.status_code != 202:
+        return initial, run, {}
+    claim = host.queue.claim("sql-route-eval", lease_seconds=60)
+    _check_equal(checks, "queue.original_run", claim.run_id if claim else None, run_id)
+    if claim is None or claim.run_id != run_id:
+        return initial, run, {}
+    run = AgentOrchestrator().execute_dispatched_run(run_id)
+    host.queue.finish(
+        run_id, "sql-route-eval", "completed" if run.status == "completed" else "blocked"
+    )
+    # Reopen the actual stored run instead of accepting an in-memory worker result.
+    reopened = SQLAlchemyAgentRunRepository(session_factory=host.factory, auto_create=False).get(
+        run_id
+    )
+    _check_equal(checks, "reopen.run_id", reopened.run_id if reopened else None, run_id)
+    if reopened is None:
+        return initial, run, {}
+    run = reopened
+    with host.factory() as db:
+        consumed = (
+            db.query(AgentApprovalConsumption).filter_by(run_id=run_id, step_id=step_id).count()
+        )
+    _check_equal(checks, "approval_consumption_count", consumed, 1)
+    _check_equal(checks, "step_id_unchanged", run.steps[0].step_id, step_id)
+    _check_equal(checks, "step_params_unchanged", run.steps[0].params, params)
+    _check_equal(checks, "run.user_id", run.user_id, host.principal.user_id)
+    replay = client.post(f"/api/agent/runs/{run_id}/continue", json={"approval_grant": grant})
+    _check_equal(checks, "approval_replay.status_code", replay.status_code, 403)
+    final_query = client.get(f"/api/agent/runs/{run_id}")
+    _check_equal(checks, "final_query.status_code", final_query.status_code, 200)
+    _check_equal(
+        checks, "final_query.original_run", final_query.json().get("data", {}).get("run_id"), run_id
+    )
+    return (
+        agent_node_output(run, run.steps[0].node_id),
+        run,
+        {
+            "approval_consumption_count": consumed,
+            "step_params_unchanged": run.steps[0].params == params,
+        },
+    )
+
