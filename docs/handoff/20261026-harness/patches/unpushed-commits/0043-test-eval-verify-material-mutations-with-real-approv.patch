@@ -196,3 +196,36 @@ def test_sql_eval_host_restores_database_bindings_after_exception(tmp_path):
     assert (host_db.HostSessionLocal, db_session.SessionLocal) == original
     assert tuple(getattr(sync_engine, name) for name in names) == engines
     assert dict(os.environ) == environment
+
+
+@pytest.mark.parametrize("action", ["create", "update", "delete", "batch_delete"])
+def test_material_route_eval_reads_real_sql_and_preserves_unverified_batch_failure(
+    tmp_path, action
+):
+    task = next(
+        row
+        for row in eval_module.load_tasks()
+        if row["kind"] == "materials_route_agent" and row["route_action"] == action
+    )
+    path = tmp_path / "materials.jsonl"
+    path.write_text(json.dumps(task, ensure_ascii=False) + "\n", encoding="utf-8")
+    result = run_eval(path)
+    item = result["results"][0]
+    assert item["passed"] is (action != "batch_delete"), item
+    details = item["details"]
+    assert details["run"]["run_id"] == details["initial_response"]["run_id"]
+    assert details["approval_consumption_count"] == 1 and details["step_params_unchanged"] is True
+    before, after = details["readback_before"], details["readback_after"]
+    assert [row for row in after if row["tenant_id"] == 8] == [
+        row for row in before if row["tenant_id"] == 8
+    ]
+    if action == "batch_delete":
+        assert details["run"]["status"] == "blocked"
+        assert details["response"]["success"] is False
+        assert details["response"]["outcome"] == "unknown"
+        assert not any(row["is_active"] for row in after if row["tenant_id"] == 7)
+        assert any(check["name"] == "run.status" for check in item["failed_checks"])
+        assert task["expected"]["run_status"] == "completed"
+    else:
+        assert details["run"]["status"] == "completed"
+        assert details["response"]["business_verification"]["verified"] is True
