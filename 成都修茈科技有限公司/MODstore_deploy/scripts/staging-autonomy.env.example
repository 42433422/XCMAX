# XCMAX Autonomy Staging Environment Template
# 用途：让 MODstore self-maintenance 在 staging 默认开启自动 dispatch deploy
# 部署：复制到 ~/Library/Application Support/XCMAX/modstore-daily.env（macOS 本地 runtime）
#       或 /opt/fhd-staging.env（CVM 服务器 staging 环境）
# 注意：production 环境不要复制此文件，保持 MODSTORE_SELF_MAINTENANCE_AUTO_DISPATCH_DEPLOY 未设置

# === P0-1: 自动部署 dispatch（staging 默认开） ===
MODSTORE_SELF_MAINTENANCE_AUTO_DISPATCH_DEPLOY=1
MODSTORE_SELF_MAINTENANCE_AUTO_DISPATCH_DEPLOY_ENVS=staging
# DRY_RUN=1 时只记录日志不真触发 gh workflow run（首次启用建议先 DRY_RUN 跑 1 天）
MODSTORE_SELF_MAINTENANCE_AUTO_DISPATCH_DEPLOY_DRY_RUN=0

# === autonomy callback（P0-2 配套） ===
FHD_API_BASE_URL=https://xiu-ci.com
AUTONOMY_WEBHOOK_TOKEN=<set-me-or-pull-from-secrets>

# === mobile push（P1-1 配套） ===
XCAGI_ADMIN_NOTIFY_USER_ID=<admin-user-id-comma-separated>

# === Neuro Bus 7 开关（P1-2 配套，staging 默认全开） ===
FHD_ENV=staging
XCAGI_NEURO_BUS_DEDUP=1
XCAGI_NEURO_BUS_CIRCUIT=1
XCAGI_NEURO_BUS_RATE_LIMIT=1
XCAGI_NEURO_BUS_LIFELINE=1
XCAGI_NEURO_BUS_TRACE=1
XCAGI_NEURO_BUS_DLQ_AUTO=1
XCAGI_NEURO_BUS_SLA_LOG=1
XCAGI_NEURO_BUS_RETRY=1
